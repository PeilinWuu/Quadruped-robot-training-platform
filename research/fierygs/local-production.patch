@@ -0,0 +1,72 @@
+"""Audit the released FieryGS dual-smoke material mapping without simulation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+
+
+MATERIALS = [
+    "wood", "sand", "metal", "plastic", "glass", "fabric", "foam", "food",
+    "ceramic", "paper", "leather", "plant", "stone", "cement", "concrete",
+    "soil", "clay", "composite", "sky",
+]
+
+
+def native_smoke_color(encoded_material_id: int) -> list[float]:
+    # Exact parity with FireSolver.assign_smoke_color: material grid stores
+    # zero for empty and material_id + 1 for occupied cells.
+    return [0.0, 0.0, 0.0] if encoded_material_id == 4 else [1.0, 1.0, 1.0]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--material-grid", type=Path, required=True)
+    parser.add_argument("--catalog", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    grid = np.load(args.material_grid)
+    catalog = json.loads(args.catalog.read_text(encoding="utf-8"))
+    representatives = {}
+    queries = {"table": "table", "sofa": "sofa", "curtain": "curtain"}
+    for label, query in queries.items():
+        row = next(item for item in catalog if query in str(item.get("object_name", "")).lower())
+        material = row["material"]
+        encoded = MATERIALS.index(material) + 1
+        representatives[label] = {
+            "part_id": int(row["part_id"]),
+            "semantic_name": row["object_name"],
+            "material": material,
+            "encoded_material_id": encoded,
+            "native_smoke_rgb": native_smoke_color(encoded),
+        }
+
+    occupied = grid[grid > 0].astype(np.int64, copy=False)
+    encoded_counts = Counter(map(int, occupied.tolist()))
+    report = {
+        "native_mapping": (
+            "encoded material 4 (plastic) -> black; every other material and "
+            "empty cell -> white, exactly matching FireSolver.assign_smoke_color"
+        ),
+        "material_grid_shape": list(grid.shape),
+        "occupied_material_voxels": int(occupied.size),
+        "black_plastic_voxels": int(encoded_counts.get(4, 0)),
+        "white_nonplastic_voxels": int(occupied.size - encoded_counts.get(4, 0)),
+        "representatives": representatives,
+        "conclusion": (
+            "Native dual_smoke is material-aware but binary, not a general smoke "
+            "palette. Table/sofa/curtain all map to white for their current wood/fabric labels."
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
