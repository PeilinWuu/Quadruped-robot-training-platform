+"""Create the stable directory layout for Robot Fire Dataset v1.
+
+This initializer is intentionally idempotent. It creates missing directories and
+updates only the deterministic layout report; it never removes dataset content.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+DIRECTORIES = (
+    "rgb",
+    "depth",
+    "semantic",
+    "fire_masks",
+    "smoke_masks",
+    "metadata",
+    "cameras",
+    "previews",
+    "manifests",
+    "reports",
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    root = args.root.resolve()
+    root.mkdir(parents=True, exist_ok=True)
+
+    created: list[str] = []
+    existing: list[str] = []
+    for name in DIRECTORIES:
+        directory = root / name
+        if directory.exists() and not directory.is_dir():
+            raise NotADirectoryError(directory)
+        if directory.is_dir():
+            existing.append(name)
+        else:
+            directory.mkdir()
+            created.append(name)
+
+    layout = {
+        "dataset_name": "robot_fire_dataset_v1",
+        "layout_version": 1,
+        "root": str(root),
+        "directories": list(DIRECTORIES),
+        "production_profile": {
+            "source_mode": "native_reignite",
+            "xyz2rgb_clip_output": True,
+            "hdr_aces": False,
+            "strength": 0.005,
+            "smoke_strength": 0.2,
+        },
+        "status": "layout_initialized",
+    }
+    report_path = root / "reports" / "dataset_layout.json"
+    report_path.write_text(json.dumps(layout, indent=2), encoding="utf-8")
+
+    result = {
+        "root": str(root),
+        "created": created,
+        "already_existing": existing,
+        "directory_count": len(DIRECTORIES),
+        "layout_report": str(report_path),
+    }
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
