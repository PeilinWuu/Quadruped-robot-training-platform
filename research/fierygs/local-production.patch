@@ -0,0 +1,43 @@
+"""Combine per-scenario dry-run reports and fail if any scenario is invalid."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--validation-root", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    entries = []
+    for report_path in sorted(args.validation_root.glob("*/validation_report.json")):
+        validation = json.loads(report_path.read_text(encoding="utf-8"))
+        scenario_dir = report_path.parent
+        surface = json.loads((scenario_dir / "surface_ignition_report.json").read_text(encoding="utf-8"))
+        propagation = json.loads((scenario_dir / "propagation_object_report.json").read_text(encoding="utf-8"))
+        entries.append({
+            "scenario": validation["metadata"]["scenario_name"], "passed": validation["passed"],
+            "ignition_object_ids": validation["selected_object_ids"],
+            "ignition_voxels": validation["active_ignition_voxels"],
+            "patch_count": surface["patch_count_generated"],
+            "non_target_initial_ignition": surface["accidental_non_target_ignition_count"],
+            "propagation_candidates": propagation["counts"]["propagation_candidates"],
+            "report": str(report_path.resolve()),
+        })
+    summary = {"metadata": {"scenario_name": "office_01_room_fire_batch_dry_run", "timestamp": timestamp(),
+                            "source_files": [entry["report"] for entry in entries]},
+               "passed": bool(entries) and all(entry["passed"] and entry["non_target_initial_ignition"] == 0 for entry in entries),
+               "scenario_count": len(entries), "scenarios": entries, "simulation_started": False}
+    write_json(args.output, summary)
+    print(json.dumps(summary, indent=2))
+    if not summary["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
