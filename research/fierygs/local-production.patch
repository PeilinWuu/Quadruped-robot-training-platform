+"""Summarize a generated Dataset v1 without deleting or modifying samples."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+OUTPUT_KEYS = (
+    "rgb",
+    "depth",
+    "semantic",
+    "fire_contribution",
+    "fire_binary",
+    "smoke_contribution",
+    "smoke_binary",
+    "metadata",
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    manifest_path = args.dataset_root / "manifests" / "dataset_v1_manifest.jsonl"
+    samples = [json.loads(line) for line in manifest_path.read_text(encoding="utf-8").splitlines() if line]
+    missing = []
+    diagnostics = []
+    review = []
+    for sample in samples:
+        absent = [key for key in OUTPUT_KEYS if not Path(sample["outputs"][key]).is_file()]
+        if absent:
+            missing.append({"sample_id": sample["sample_id"], "missing": absent})
+            continue
+        metadata = json.loads(Path(sample["outputs"]["metadata"]).read_text(encoding="utf-8"))
+        row = {"sample_id": sample["sample_id"], **metadata["diagnostics"]}
+        diagnostics.append(row)
+        reasons = []
+        if row["fire_mask_fraction"] == 0:
+            reasons.append("fire_not_visible")
+        if row["fire_mask_fraction"] > 0.70:
+            reasons.append("fire_occupies_over_70_percent")
+        if row["smoke_mask_fraction"] > 0.85:
+            reasons.append("smoke_occupies_over_85_percent")
+        if row["depth_valid_fraction"] < 0.95:
+            reasons.append("depth_validity_below_95_percent")
+        if row["semantic_valid_fraction"] < 0.20:
+            reasons.append("instance_semantic_coverage_below_20_percent")
+        if reasons:
+            review.append({"sample_id": sample["sample_id"], "reasons": reasons})
+
+    dataset_bytes = sum(path.stat().st_size for path in args.dataset_root.rglob("*") if path.is_file())
+    stats = {
+        "expected_samples": len(samples),
+        "complete_samples": len(diagnostics),
+        "missing_samples": len(missing),
+        "dataset_bytes": dataset_bytes,
+        "dataset_gib": dataset_bytes / 1024**3,
+        "scenario_distribution": dict(Counter(sample["scenario"] for sample in samples)),
+        "object_distribution": dict(Counter(sample["ignition_object"] for sample in samples)),
+        "fire_level_distribution": dict(Counter(sample["fire_level"] for sample in samples)),
+        "stage_distribution": dict(Counter(sample["physical_stage"] for sample in samples)),
+        "camera_distribution": dict(Counter(sample["camera_id"] for sample in samples)),
+        "split_distribution": dict(Counter(sample["split"] for sample in samples)),
+        "diagnostic_summary": {},
+        "review_sample_count": len(review),
+        "passed_completeness": len(missing) == 0 and len(diagnostics) == len(samples),
+    }
+    if diagnostics:
+        for key in (
+            "fire_mask_fraction",
+            "smoke_mask_fraction",
+            "depth_valid_fraction",
+            "semantic_valid_fraction",
+            "render_seconds",
+        ):
+            values = np.asarray([row[key] for row in diagnostics], dtype=np.float64)
+            stats["diagnostic_summary"][key] = {
+                "min": float(values.min()),
+                "p50": float(np.percentile(values, 50)),
+                "p95": float(np.percentile(values, 95)),
+                "max": float(values.max()),
+                "mean": float(values.mean()),
+            }
+
+    reports = args.dataset_root / "reports"
+    reports.mkdir(parents=True, exist_ok=True)
+    (reports / "dataset_v1_stats.json").write_text(json.dumps(stats, indent=2), encoding="utf-8")
+    (reports / "dataset_v1_missing.json").write_text(json.dumps(missing, indent=2), encoding="utf-8")
+    (reports / "dataset_v1_review_list.json").write_text(json.dumps(review, indent=2), encoding="utf-8")
+    markdown = f"""# Robot Fire Dataset v1 Report
+
+## Status
+
+- Expected samples: {stats['expected_samples']}
+- Complete samples: {stats['complete_samples']}
+- Missing samples: {stats['missing_samples']}
+- Dataset size: {stats['dataset_gib']:.2f} GiB
+- Samples marked for visual review: {stats['review_sample_count']}
+- Completeness passed: {stats['passed_completeness']}
+
+## Frozen production profile
+
+- source_mode: `native_reignite`
+- XYZ2RGB clipping: enabled
+- hdr_aces: disabled
+- strength: `0.005`
+- smoke_strength: `0.2`
+- native Phong: enabled
+
+## Distribution
+
+```json
+{json.dumps({key: stats[key] for key in ('scenario_distribution', 'fire_level_distribution', 'stage_distribution', 'split_distribution')}, indent=2)}
+```
+
+## Annotation semantics
+
+- Depth is static/solid scene depth in millimetres; zero is invalid. Fire and smoke do not create solid depth.
+- Fire masks come from ray-marched temperature-emission contribution, not RGB color thresholds.
+- Smoke masks come from ray-marched smoke contribution, not white-pixel thresholds.
+- Semantic NPZ files retain Gaussian, instance, part, material, and burnability IDs.
+
+## Review policy
+
+The review list is diagnostic only. No sample is deleted automatically.
+"""
+    (reports / "DATASET_V1_REPORT.md").write_text(markdown, encoding="utf-8")
+    print(json.dumps(stats, indent=2))
+
+
+if __name__ == "__main__":
+    main()
