@@ -0,0 +1,121 @@
+"""Render one InteriorGS frame with the native FieryGS fire renderer."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+
+from adapter.create_scene import create_scene
+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def save_rgb(tensor: torch.Tensor, path: Path) -> None:
+    rgb = tensor.detach().clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    Image.fromarray(rgb, mode="RGB").save(path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--frame", type=int, default=28)
+    parser.add_argument("--disable-volume", action="store_true")
+    parser.add_argument("--coarse-samples", type=int, default=128)
+    parser.add_argument("--fine-samples", type=int, default=1024)
+    parser.add_argument("--strength", type=float, default=0.01)
+    parser.add_argument("--smoke-strength", type=float, default=0.5)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--scenario-name", default="office_table_fire")
+    args = parser.parse_args()
+
+    scene = create_scene(args.ply, args.camera)
+    gaussians = scene.gaussians
+    camera = scene.cameras[0]
+    fuel_np = np.load(args.simulation_dir / "fuel" / f"fuel_{args.frame}.npz")["arr_0"]
+    source_fuel_nonzero = int(np.count_nonzero(fuel_np))
+    if args.disable_volume:
+        fuel_np = np.zeros_like(fuel_np)
+    occupancy_np = np.load(args.simulation_dir / "occupancy" / f"occupancy_{args.frame}.npz")["arr_0"]
+    fuel = torch.from_numpy(fuel_np).cuda().float()
+    query_tensor = fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    gaussian_rows = torch.nonzero(mask, as_tuple=False).squeeze(1)
+    occupancy = torch.from_numpy(occupancy_np).cuda().float()
+    mapped_occupancy = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+    keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+    keep[gaussian_rows] = (mapped_occupancy.abs() >= 0.7) & (mapped_occupancy.abs() <= 1.0)
+    carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), dtype=torch.float32, device="cuda")
+    carbon[gaussian_rows] = mapped_occupancy.unsqueeze(1).repeat(1, 3)
+    gaussians.update_per_frame(keep, 0.7, carbon)
+
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    voxel_report = json.loads(args.voxel_report.read_text(encoding="utf-8"))
+    render_args = Namespace(
+        dual_smoke=False, near=0.1, far=6.0,
+        num_samples_coarse=args.coarse_samples, num_samples_fine=args.fine_samples,
+        sampling_smooth_factor=0.5, sampling_chunk_size=32,
+        spec_intensity=1e-8, strength=args.strength, smoke_strength=args.smoke_strength,
+        sigma_a=1.0, render_smoke=True, darkness=1.0, ks=0.5,
+        bounding_box=voxel_report["bounding_box"],
+    )
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    converter = TemperatureToRGB(T_max=12000, device="cuda")
+    fuel_to_temperature = FuelToTemperatureLUT(device="cuda")
+    torch.cuda.reset_peak_memory_stats()
+    result = render_fire(
+        camera, gaussians, pipeline, background,
+        query_tensor=query_tensor, temp2rgb_converter=converter,
+        args=render_args, scale_ratio=1440 / 12000,
+        add_sepc_light=False, fuel2temp=fuel_to_temperature, color_field=None,
+    )
+    torch.cuda.synchronize()
+    save_rgb(result["render"], args.output)
+    depth_path = args.output.with_name(args.output.stem + "_depth.npy")
+    np.save(depth_path, result["plane_depth"].detach().cpu().numpy())
+    report = {
+        "metadata": {
+            "scenario_name": args.scenario_name, "timestamp": timestamp(),
+            "gaussian_count": int(gaussians.get_xyz.shape[0]),
+            "source_files": [str(path.resolve()) for path in [
+                args.ply, args.camera, args.voxel_report, args.simulation_dir,
+            ]],
+        },
+        "output": str(args.output.resolve()),
+        "frame": args.frame,
+        "samples": [args.coarse_samples, args.fine_samples],
+        "image_shape": list(result["render"].shape),
+        "source_fuel_nonzero_voxels": source_fuel_nonzero,
+        "rendered_fuel_nonzero_voxels": int(np.count_nonzero(fuel_np)),
+        "carbonized_gaussians": int((~keep).sum().item()),
+        "rgb_min": float(result["render"].min().item()),
+        "rgb_max": float(result["render"].max().item()),
+        "depth_min": float(result["plane_depth"].min().item()),
+        "depth_max": float(result["plane_depth"].max().item()),
+        "gs_render_seconds": float(result["GS_render_timing"]),
+        "fire_render_seconds": float(result["fire_render_timing"]),
+        "cuda_peak_memory_mb": round(torch.cuda.max_memory_allocated() / 1024**2, 1),
+        "bounding_box": voxel_report["bounding_box"],
+        "volume_enabled": not args.disable_volume,
+        "strength": args.strength, "smoke_strength": args.smoke_strength,
+    }
+    write_json(args.output.with_suffix(".json"), report)
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
