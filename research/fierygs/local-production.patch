index 0000000..6c34d60
--- /dev/null
+++ b/adapter/fire_visual_quality/diagnose_flame_morphology.py
@@ -0,0 +1,104 @@
+"""Diagnose Table HIGH torch morphology from saved scalars and audited solver code."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import matplotlib.pyplot as plt
+import numpy as np
+import yaml
+
+
+def metrics(field: np.ndarray, spacing: float) -> dict:
+    active = np.argwhere(field > 1e-3)
+    if not len(active):
+        return {"active_voxels": 0}
+    lo, hi = active.min(0), active.max(0)
+    extent = (hi - lo + 1) * spacing
+    weights = field[field > 1e-3].astype(np.float64)
+    centroid = np.average(active, axis=0, weights=weights) * spacing
+    xy_width = float(np.sqrt(extent[0] * extent[1]))
+    return {
+        "active_voxels": int(len(active)), "bbox_min_index": lo.tolist(), "bbox_max_index": hi.tolist(),
+        "bbox_extent_m": extent.tolist(), "weighted_centroid_m_from_grid_origin": centroid.tolist(),
+        "vertical_to_geometric_horizontal_extent": float(extent[2] / max(xy_width, 1e-12)),
+        "touches_top_five_cell_boundary": bool(hi[2] >= field.shape[2] - 5),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--output-plot", type=Path, required=True)
+    parser.add_argument("--output-report", type=Path, required=True)
+    parser.add_argument("--dynamics-report", type=Path, required=True)
+    parser.add_argument("--frames", default="0,20,60,100,140,180,199")
+    args = parser.parse_args()
+    config = yaml.safe_load(args.config.read_text(encoding="utf-8"))
+    spacing = float(config["voxel_grid"]["voxel_size"])
+    frames = [int(x) for x in args.frames.split(",")]
+    rows = []
+    fig, axes = plt.subplots(len(frames), 2, figsize=(10, 3 * len(frames)), constrained_layout=True)
+    for row, frame in enumerate(frames):
+        fields = {name: np.load(args.simulation_dir / name / f"{name}_{frame}.npz")["arr_0"]
+                  for name in ("fuel", "temperature", "occupancy", "wood_temperature")}
+        rows.append({"frame": frame, **{name: metrics(value, spacing) for name, value in fields.items()}})
+        for col, axis in enumerate((1, 0)):
+            projection = fields["fuel"].max(axis=axis).T
+            axes[row, col].imshow(projection, origin="lower", cmap="inferno", vmin=0, vmax=1, aspect="auto")
+            axes[row, col].set_title(f"frame {frame} fuel max projection axis={axis}")
+            axes[row, col].set_xlabel("lateral voxel")
+            axes[row, col].set_ylabel("vertical z voxel")
+    args.output_plot.parent.mkdir(parents=True, exist_ok=True)
+    fig.savefig(args.output_plot, dpi=140)
+    plt.close(fig)
+
+    ignition = config["ignition_box"]
+    md = f"""# Table HIGH flame morphology diagnosis
+
+## Available evidence
+
+The validated 200-frame export contains fuel, solver temperature, occupancy and wood temperature. It does not contain velocity, vertical velocity, curl/vorticity, or vorticity-confinement force. The accompanying run report explicitly records `velocity_exported=false`. This report therefore does not claim measured velocity-force ratios.
+
+Scalar max-projection diagnostics are saved at `{args.output_plot.resolve()}`. The machine-readable per-frame extents and centroids are embedded below.
+
+## Verified solver mechanisms
+
+- Ignition is a broad, shallow rectangular source: index min `{ignition['min']}`, max-exclusive `{ignition['max_exclusive']}`.
+- There is no configured wind and no stochastic forcing in velocity. Perlin noise affects burn rate only.
+- Every ignited solid voxel resets fuel coefficient to exactly 1 every step while wood temperature is above threshold and occupancy remains positive. This creates a persistent table-aligned source rather than a short transient ignition kernel.
+- Buoyancy adds `alpha * temperature * dt` only to vertical velocity. Here `alpha={config['alpha']}` and `dt=0.04`, so the maximum per-step vertical source is approximately `{config['alpha'] * 0.04:.2f}` in solver units.
+- Native vorticity confinement is exposed as `epsilon={config['epsilon']}`, but its force is proportional to existing curl. A symmetric initially stationary plume has little seed curl; no arbitrary turbulence noise exists to break it.
+- Viscosity is `nu={config.get('nu', 0.1)}` and damps velocity gradients.
+- Scalar advection uses trilinear semi-Lagrangian transport, which is numerically diffusive.
+- The grid boundary is five cells thick. Late fuel reaches the upper boundary neighborhood, visibly truncating the plume in the room-scale domain.
+
+## Diagnosis
+
+The stable torch is jointly explained by a persistent rectangular fuel source, deterministic zero-wind initial conditions, vertical-only buoyancy, weakly seeded curl, semi-Lagrangian diffusion and eventual top-boundary contact. The coarse 5 cm grid and render hard masks make that topology more visible, but render reconstruction did not remove it, confirming that the column is primarily in the physical scalar state rather than introduced by ray marching.
+
+The data are sufficient to reject ignition geometry and render sampling as sole causes, but not sufficient to attribute a quantitative percentage to buoyancy versus vorticity. A physical parameter ablation is therefore not justified under the task's evidence rule without an otherwise identical diagnostic rerun exporting velocity/curl/confinement force.
+
+## Scalar timeline JSON
+
+```json
+{json.dumps(rows, indent=2)}
+```
+"""
+    args.output_report.parent.mkdir(parents=True, exist_ok=True)
+    args.output_report.write_text(md, encoding="utf-8")
+    dynamics = {
+        "experiment": "minimal native dynamics ablation",
+        "status": "not_run",
+        "reason": "The existing validated states do not contain velocity/curl/confinement contributions, so changing alpha or epsilon would precede the required causal verification.",
+        "parameters_exposed": {"buoyancy_alpha": config["alpha"], "vorticity_epsilon": config["epsilon"], "viscosity_nu": config.get("nu", 0.1)},
+        "next_valid_experiment": "Re-run a short identical baseline with selected-frame velocity, curl and separated force-term exports; then vary one native parameter only.",
+    }
+    args.dynamics_report.write_text(json.dumps(dynamics, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
