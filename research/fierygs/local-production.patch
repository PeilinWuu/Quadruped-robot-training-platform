@@ -0,0 +1,92 @@
+"""Extract physical metrics from active-buffer FieryGS long-run exports."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def bounds(mask: np.ndarray, voxel_size: float) -> tuple[list[int] | None, list[int] | None, list[float], float]:
+    coords = np.argwhere(mask)
+    if not len(coords):
+        return None, None, [0.0, 0.0, 0.0], 0.0
+    lo, hi = coords.min(0), coords.max(0)
+    extent = (hi - lo + 1) * voxel_size
+    return lo.tolist(), hi.tolist(), extent.tolist(), float(np.prod(extent))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario-name", required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--initial-occupancy", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--voxel-size", type=float, default=0.05)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    frames = sorted(int(p.stem.rsplit("_", 1)[1]) for p in (args.simulation_dir / "fuel").glob("fuel_*.npz"))
+    if not frames or frames != list(range(frames[-1] + 1)):
+        raise ValueError("Simulation frames are missing or non-contiguous")
+    initial_occ = np.load(args.initial_occupancy).astype(np.float32)
+    map_mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy().astype(bool)
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    gaussian_rows = np.flatnonzero(map_mask)
+    mapped_initial = initial_occ[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    records = []
+    first_carbonized = None
+    for frame in frames:
+        fields = {name: np.load(args.simulation_dir / name / f"{name}_{frame}.npz")["arr_0"]
+                  for name in ("fuel", "temperature", "occupancy", "wood_temperature")}
+        fuel, temp, occ, wood = (fields[x] for x in ("fuel", "temperature", "occupancy", "wood_temperature"))
+        active = (fuel > 0) | (temp > 0)
+        lo, hi, extent, volume = bounds(active, args.voxel_size)
+        mapped_occ = occ[indices[:, 0], indices[:, 1], indices[:, 2]]
+        carbonized_local = mapped_initial & (mapped_occ < 0.7)
+        carbonized = int(np.count_nonzero(carbonized_local))
+        if carbonized and first_carbonized is None:
+            first_carbonized = frame
+        active_temp = temp[temp > 0]
+        finite = sum(int(a.size - np.count_nonzero(np.isfinite(a))) for a in fields.values())
+        initially_solid = initial_occ > 0
+        record = {
+            "frame": frame,
+            "active_fuel_voxel_count": int(np.count_nonzero(fuel > 0)),
+            "active_temperature_voxel_count": int(np.count_nonzero(temp > 0)),
+            "maximum_temperature": float(np.max(temp)),
+            "mean_temperature_over_active_region": float(np.mean(active_temp)) if active_temp.size else 0.0,
+            "native_ignited_solid_voxel_count": int(np.count_nonzero((wood >= 1.0) & (occ > 0))),
+            "maximum_wood_temperature": float(np.max(wood)),
+            "remaining_occupancy_voxel_count": int(np.count_nonzero(occ > 0)),
+            "occupancy_sum": float(np.sum(occ)),
+            "mean_occupancy_over_initial_solid": float(np.mean(occ[initially_solid])),
+            "consumed_occupancy_mass": float(np.sum(initial_occ - occ)),
+            "burning_bbox_voxel_min": lo, "burning_bbox_voxel_max": hi,
+            "burning_extent_m": extent, "burning_bbox_volume_m3": volume,
+            "carbonized_gaussian_count": carbonized,
+            "non_finite_value_count": finite,
+        }
+        records.append(record)
+    payload = {
+        "metadata": {"scenario_name": args.scenario_name, "timestamp": timestamp(),
+                     "gaussian_count": int(map_mask.size),
+                     "source_files": [str(args.simulation_dir.resolve()), str(args.initial_occupancy.resolve()), str(args.voxel_dir.resolve())]},
+        "passed": all(x["non_finite_value_count"] == 0 for x in records),
+        "frame_count": len(records), "first_carbonized_frame": first_carbonized,
+        "carbonization_rule": "initially combustible mapped Gaussian with native occupancy < 0.7",
+        "smoke_available": (args.simulation_dir / "color").exists(),
+        "frames": records, "final": records[-1],
+    }
+    write_json(args.output, payload)
+    print(json.dumps({"passed": payload["passed"], "frames": len(records),
+                      "first_carbonized_frame": first_carbonized, "final": records[-1]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
