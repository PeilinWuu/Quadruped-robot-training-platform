@@ -0,0 +1,86 @@
+"""Apply physical and semantic sanity rules to the scene material catalog."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import (
+    BURNABLE_MATERIALS, UNBURNABLE_MATERIALS, metadata, timestamp, write_json,
+)
+
+
+REVIEW_OBJECTS = {
+    "box", "trash_can", "unknown furniture", "wine", "bottle", "cup", "bowl",
+    "dining plate", "dairy", "fruit", "cake", "delicatessen", "tray", "shelf",
+}
+REMOVE_OBJECTS = {
+    "downlights", "chandelier", "window", "microwave oven", "refrigerator", "monitor",
+}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--catalog", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--scenario-name", default="scene_material_filter")
+    args = parser.parse_args()
+
+    catalog = json.loads(args.catalog.read_text(encoding="utf-8"))
+    material_labels_path = args.catalog.parent / "points_materials.npy"
+    if not material_labels_path.exists():
+        raise FileNotFoundError(
+            f"Cannot derive scene Gaussian count because {material_labels_path} is missing"
+        )
+    gaussian_count = int(np.load(material_labels_path, mmap_mode="r").shape[0])
+    confirmed, review, removed = [], [], []
+    for item in catalog:
+        name = item["object_name"].strip().lower()
+        material = item["material"]
+        reasons = []
+        if material in UNBURNABLE_MATERIALS or item["burnability"] != "burnable" or name in REMOVE_OBJECTS:
+            classification = "remove"
+            if material in UNBURNABLE_MATERIALS:
+                reasons.append("physically_unburnable_material")
+            if item["burnability"] != "burnable":
+                reasons.append("final_burnability_is_unburnable")
+            if name in REMOVE_OBJECTS:
+                reasons.append("semantic_nonfuel_object")
+        elif material == "composite" or name in REVIEW_OBJECTS or item.get("review_recommended"):
+            classification = "review"
+            if material == "composite": reasons.append("ambiguous_composite_material")
+            if name in REVIEW_OBJECTS: reasons.append("ambiguous_or_container_object_class")
+            if item.get("review_recommended"): reasons.extend(item.get("review_reasons", []))
+        elif material in BURNABLE_MATERIALS and item.get("gaussian_mapping_status") == "reliable":
+            classification = "confirmed"
+            reasons.append("burnable_material_and_reliable_gaussian_mapping")
+        else:
+            classification = "review"
+            reasons.append("insufficient_evidence_for_confirmed_fuel")
+        output = {
+            "object_id": int(item["instance_id"]), "part_id": int(item["part_id"]),
+            "object_name": item["object_name"], "material": material,
+            "burnable": item["burnability"] == "burnable", "confidence": item.get("confidence"),
+            "gaussian_count": int(item["gaussian_count"]), "classification": classification,
+            "reasons": sorted(set(reasons)), "bbox_center": item.get("bbox_center"),
+        }
+        {"confirmed": confirmed, "review": review, "remove": removed}[classification].append(output)
+
+    payload = {
+        "metadata": {
+            "scenario_name": args.scenario_name, "timestamp": timestamp(),
+            "gaussian_count": gaussian_count,
+            "source_files": [str(args.catalog.resolve()), str(material_labels_path.resolve())],
+        },
+        "counts": {"confirmed": len(confirmed), "review": len(review), "removed": len(removed)},
+        "confirmed": confirmed, "review": review, "removed": removed,
+    }
+    write_json(args.output, payload)
+    print(json.dumps(payload["counts"], indent=2))
+
+
+if __name__ == "__main__":
+    main()
