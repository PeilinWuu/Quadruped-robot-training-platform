@@ -0,0 +1,186 @@
+"""Select 15 physically distributed simulation states for one Dataset v1 scenario."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+FIELDS = ("fuel", "temperature", "occupancy", "wood_temperature", "color")
+STAGE_NAMES = ("ignition", "early", "established", "spread", "late")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario-manifest", type=Path, required=True)
+    parser.add_argument("--scenario-id", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--voxel-size", type=float, default=0.05)
+    return parser.parse_args()
+
+
+def load_field(root: Path, field: str, frame: int) -> np.ndarray:
+    path = root / field / f"{field}_{frame}.npz"
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    return np.load(path)["arr_0"]
+
+
+def first_index(values: list[float], threshold: float, start: int = 0) -> int | None:
+    return next((i for i in range(start, len(values)) if values[i] >= threshold), None)
+
+
+def clamp_boundaries(raw: list[int], last: int) -> list[int]:
+    # Five stages, each with at least three frames.
+    limits = ((2, last - 12), (5, last - 9), (8, last - 6), (11, last - 3))
+    result: list[int] = []
+    for index, candidate in enumerate(raw):
+        lower, upper = limits[index]
+        if result:
+            lower = max(lower, result[-1] + 3)
+        result.append(min(max(int(candidate), lower), upper))
+    return result
+
+
+def three_frames(start: int, end: int) -> list[int]:
+    return np.rint(np.linspace(start, end, 3)).astype(int).tolist()
+
+
+def main() -> None:
+    args = parse_args()
+    manifest = json.loads(args.scenario_manifest.read_text(encoding="utf-8"))
+    scenario = next(
+        (item for item in manifest["scenarios"] if item["scenario_id"] == args.scenario_id), None
+    )
+    if scenario is None:
+        raise KeyError(f"Unknown scenario: {args.scenario_id}")
+    root = Path(scenario["simulation_dir"])
+    frame_count = int(scenario["simulation_frames"])
+    for field in FIELDS:
+        count = len(list((root / field).glob(f"{field}_*.npz"))) if (root / field).is_dir() else 0
+        if count != frame_count:
+            raise RuntimeError(f"{args.scenario_id}: {field} has {count}/{frame_count} frames")
+
+    initial_occ = np.load(scenario["initial_occupancy"]).astype(np.float32)
+    initial_solid = initial_occ > 0
+    metrics = []
+    for frame in range(frame_count):
+        fuel = load_field(root, "fuel", frame)
+        temperature = load_field(root, "temperature", frame)
+        occupancy = load_field(root, "occupancy", frame)
+        active = (fuel > 0) | (temperature > 0)
+        coords = np.argwhere(active)
+        if len(coords):
+            extent = (coords.max(axis=0) - coords.min(axis=0) + 1) * args.voxel_size
+            volume = float(np.prod(extent))
+        else:
+            extent = np.zeros(3, dtype=np.float64)
+            volume = 0.0
+        metrics.append(
+            {
+                "frame": frame,
+                "active_fuel_voxel_count": int(np.count_nonzero(fuel > 0)),
+                "active_temperature_voxel_count": int(np.count_nonzero(temperature > 0)),
+                "maximum_temperature": float(np.max(temperature)),
+                "consumed_occupancy_mass": float(np.sum(initial_occ - occupancy)),
+                "carbonized_solid_voxel_count": int(
+                    np.count_nonzero(initial_solid & (occupancy < 0.7))
+                ),
+                "fire_extent_m": extent.tolist(),
+                "fire_bbox_volume_m3": volume,
+            }
+        )
+
+    temp_counts = [row["active_temperature_voxel_count"] for row in metrics]
+    volumes = [row["fire_bbox_volume_m3"] for row in metrics]
+    consumption = [row["consumed_occupancy_mass"] for row in metrics]
+    peak_temp = max(temp_counts)
+    peak_volume = max(volumes)
+    final_consumption = max(consumption)
+    last = frame_count - 1
+    fallbacks = []
+
+    def milestone(values: list[float], fraction: float, fallback_fraction: float, name: str) -> int:
+        peak = max(values)
+        found = first_index(values, fraction * peak) if peak > 0 else None
+        if found is None:
+            fallbacks.append(name)
+            return int(round(last * fallback_fraction))
+        return found
+
+    ignition_end = milestone(temp_counts, 0.15, 0.10, "ignition_end")
+    early_end = milestone(temp_counts, 0.35, 0.30, "early_end")
+    combined = [
+        min(t / peak_temp if peak_temp else 0.0, v / peak_volume if peak_volume else 0.0)
+        for t, v in zip(temp_counts, volumes)
+    ]
+    established_end = milestone(combined, 0.60, 0.58, "established_end")
+    if final_consumption > 0:
+        spread_end = first_index(consumption, 0.70 * final_consumption)
+    else:
+        spread_end = None
+    if spread_end is None:
+        fallbacks.append("spread_end")
+        spread_end = int(round(last * 0.82))
+    boundaries = clamp_boundaries(
+        [ignition_end, early_end, established_end, spread_end], last
+    )
+    ranges = (
+        (0, boundaries[0]),
+        (boundaries[0] + 1, boundaries[1]),
+        (boundaries[1] + 1, boundaries[2]),
+        (boundaries[2] + 1, boundaries[3]),
+        (boundaries[3] + 1, last),
+    )
+
+    states = []
+    for stage, (start, end) in zip(STAGE_NAMES, ranges):
+        for stage_index, frame in enumerate(three_frames(start, end)):
+            states.append(
+                {
+                    "state_id": f"s{len(states):03d}",
+                    "stage": stage,
+                    "stage_index": stage_index,
+                    "simulation_frame": frame,
+                    "metrics": metrics[frame],
+                }
+            )
+
+    payload = {
+        "scenario_id": args.scenario_id,
+        "simulation_dir": str(root.resolve()),
+        "frame_count": frame_count,
+        "selection_method": "physical_milestones_with_minimum_stage_width",
+        "signals": {
+            "peak_active_temperature_voxels": peak_temp,
+            "peak_fire_bbox_volume_m3": peak_volume,
+            "final_consumed_occupancy_mass": final_consumption,
+        },
+        "fallback_boundaries": fallbacks,
+        "stage_boundaries": {
+            stage: {"start": start, "end": end}
+            for stage, (start, end) in zip(STAGE_NAMES, ranges)
+        },
+        "states": states,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "scenario_id": args.scenario_id,
+                "output": str(args.output.resolve()),
+                "boundaries": payload["stage_boundaries"],
+                "selected_frames": [state["simulation_frame"] for state in states],
+                "fallbacks": fallbacks,
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
