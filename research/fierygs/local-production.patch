@@ -0,0 +1,75 @@
+"""Extract temporal fire stages from physical evolution rather than fixed frame IDs."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def first_at(rows: list[dict], predicate, start: int = 0) -> int | None:
+    return next((x["frame"] for x in rows if x["frame"] >= start and predicate(x)), None)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--metrics", type=Path, required=True)
+    parser.add_argument("--propagation", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    metrics = json.loads(args.metrics.read_text(encoding="utf-8"))
+    propagation = json.loads(args.propagation.read_text(encoding="utf-8"))
+    rows, last = metrics["frames"], metrics["frames"][-1]["frame"]
+    peak_temp_voxels = max(x["active_temperature_voxel_count"] for x in rows)
+    peak_volume = max(x["burning_bbox_volume_m3"] for x in rows)
+    final_consumption = max(x["consumed_occupancy_mass"] for x in rows)
+    fallback = []
+
+    early_end = first_at(rows, lambda x: x["active_temperature_voxel_count"] >= 0.35 * peak_temp_voxels)
+    if early_end is None or early_end < 2:
+        early_end = max(2, int(last * 0.20)); fallback.append("early_end")
+    spread_start = first_at(rows, lambda x: x["active_temperature_voxel_count"] >= 0.70 * peak_temp_voxels and
+                            x["burning_bbox_volume_m3"] >= 0.60 * peak_volume, early_end + 1)
+    if spread_start is None or spread_start >= last - 2:
+        spread_start = max(early_end + 1, int(last * 0.50)); fallback.append("spread_start")
+    late_start = first_at(rows, lambda x: final_consumption > 0 and
+                          x["consumed_occupancy_mass"] >= 0.70 * final_consumption, spread_start + 1)
+    if late_start is None or late_start >= last:
+        late_start = max(spread_start + 1, int(last * 0.75)); fallback.append("late_start")
+    late_start = min(late_start, last)
+
+    stages = {
+        "early": {"start": 0, "end": early_end,
+                  "reason": "active temperature volume first reaches 35% of its observed peak"},
+        "established": {"start": early_end + 1, "end": spread_start - 1,
+                        "reason": "sustained growth after early ignition and before combined temperature/spatial spread"},
+        "spread": {"start": spread_start, "end": late_start - 1,
+                   "reason": "temperature volume >=70% and burning bbox volume >=60% of observed peak"},
+        "late": {"start": late_start, "end": last,
+                 "reason": "solid occupancy consumption reaches 70% of its final 200-frame value"},
+    }
+    for value in stages.values():
+        value["representative_frame"] = (value["start"] + value["end"]) // 2
+    representative = [0, stages["early"]["representative_frame"], stages["established"]["representative_frame"],
+                      stages["spread"]["representative_frame"], last]
+    payload = {
+        "metadata": {"scenario_name": metrics["metadata"]["scenario_name"], "timestamp": timestamp(),
+                     "source_files": [str(args.metrics.resolve()), str(args.propagation.resolve())]},
+        "method": "physical_thresholds" if not fallback else "physical_thresholds_with_frame_fallback",
+        "fallback_boundaries": fallback,
+        "signals": {"peak_temperature_voxel_count": peak_temp_voxels, "peak_burning_bbox_volume_m3": peak_volume,
+                    "final_consumed_occupancy_mass": final_consumption,
+                    "first_surrounding_object_heating_frame": propagation["first_surrounding_object_heating_frame"],
+                    "first_genuine_secondary_ignition_frame": propagation["first_genuine_secondary_ignition_frame"],
+                    "first_carbonization_frame": metrics["first_carbonized_frame"]},
+        "stages": stages, "representative_frames": representative,
+    }
+    write_json(args.output, payload)
+    print(json.dumps({"scenario": payload["metadata"]["scenario_name"], "method": payload["method"],
+                      "stages": stages, "representative_frames": representative}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
