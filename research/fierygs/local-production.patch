@@ -0,0 +1,91 @@
+"""Statically validate material-aware fire initialization without running simulation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from adapter.fire_scenario.common import BURNABLE_MATERIALS, MATERIAL_TO_ID, load_scenario, metadata, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--material-dir", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    instance_ids = np.load(args.material_dir / "gaussian_instance_ids.npy", mmap_mode="r")
+    point_materials = np.load(args.material_dir / "points_materials.npy", mmap_mode="r")
+    point_burnability = np.load(args.material_dir / "points_burnability.npy", mmap_mode="r")
+    material_grid = np.load(args.voxel_dir / "material_grid.npy", mmap_mode="r")
+    burnability_grid = np.load(args.voxel_dir / "burnability_grid.npy", mmap_mode="r")
+    available = np.load(args.output_dir / "available_fuel_grid.npy", mmap_mode="r")
+    fuel = np.load(args.output_dir / "fuel_grid.npy", mmap_mode="r")
+    ignition = np.load(args.output_dir / "ignition_voxel_mask.npy", mmap_mode="r")
+    temperature = np.load(args.output_dir / "initial_temperature_kelvin.npy", mmap_mode="r")
+    solver_path = args.output_dir / "fierygs_solver_config.yaml"
+    solver = yaml.safe_load(solver_path.read_text(encoding="utf-8"))
+    init_report = json.loads(
+        (args.output_dir / "scenario_initialization_report.json").read_text(encoding="utf-8")
+    )
+
+    object_ids = np.asarray(scenario["ignition"]["object_ids"], dtype=np.int32)
+    object_mask = np.isin(instance_ids, object_ids)
+    selected_materials = np.unique(point_materials[object_mask]).astype(int).tolist()
+    selected_burnability = np.unique(point_burnability[object_mask]).astype(int).tolist()
+    ignition_box = solver["ignition_box"]
+    lo, hi = ignition_box["min"], ignition_box["max_exclusive"]
+    box = tuple(slice(int(lo[i]), int(hi[i])) for i in range(3))
+
+    checks = {
+        "gaussian_arrays_same_length": len(instance_ids) == len(point_materials) == len(point_burnability),
+        "voxel_arrays_same_shape": material_grid.shape == burnability_grid.shape == available.shape == fuel.shape == ignition.shape == temperature.shape,
+        "solver_dims_match_arrays": list(available.shape) == solver["voxel_grid"]["dims"],
+        "ignition_object_present": bool(object_mask.any()),
+        "ignition_object_material_is_combustible": bool(selected_materials) and all(
+            material in {MATERIAL_TO_ID[name] for name in BURNABLE_MATERIALS} for material in selected_materials
+        ),
+        "ignition_object_is_burnable": selected_burnability == [0],
+        "ignition_voxels_nonempty": bool(np.any(ignition > 0)),
+        "fuel_equals_scaled_ignition": bool(np.allclose(fuel, ignition * float(scenario["fire_parameters"]["fuel_scale"]))),
+        "ignition_subset_of_available_fuel": not bool(np.any((ignition > 0) & (available <= 0))),
+        "solver_exact_mask_or_box_is_valid": (
+            bool(solver.get("scenario_metadata", {}).get("exact_ignition_required", False))
+            or (bool(np.array_equal((available[box] > 0), (ignition[box] > 0))) and int(ignition.sum()) == int((ignition[box] > 0).sum()))
+        ),
+        "initial_temperature_applied": bool(np.all(temperature[ignition > 0] == float(scenario["initial_temperature"]))),
+        "no_non_target_initial_ignition": init_report.get("accidental_non_target_initial_ignition_count", 0) == 0,
+        "solver_input_paths_exist": all(Path(solver[key]).exists() for key in ["load_path", "load_path_indices_pts_in_grids", "load_path_mask_pts_in_grids", "material_path"]),
+    }
+    report = {
+        "metadata": metadata(scenario, len(instance_ids), [
+            args.scenario, args.material_dir / "gaussian_instance_ids.npy",
+            args.material_dir / "points_materials.npy", args.material_dir / "points_burnability.npy",
+            args.voxel_dir / "material_grid.npy", args.output_dir / "fuel_grid.npy", solver_path,
+        ]),
+        "passed": all(checks.values()),
+        "checks": checks,
+        "selected_object_ids": object_ids.tolist(),
+        "selected_material_ids": selected_materials,
+        "selected_burnability_ids": selected_burnability,
+        "voxel_shape": list(available.shape),
+        "available_combustible_voxels": int((available > 0).sum()),
+        "active_ignition_voxels": int((ignition > 0).sum()),
+        "solver_config": str(solver_path.resolve()),
+        "simulation_started": False,
+    }
+    write_json(args.output_dir / "validation_report.json", report)
+    print(json.dumps(report, indent=2))
+    if not report["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
