new file mode 100644
index 0000000..43fe9b5
--- /dev/null
+++ b/adapter/fire_scenario/scenario_quality_validator/quality_validator.py
@@ -0,0 +1,125 @@
+"""Analyze completed scenario dry-run artifacts without running the solver."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+
+def _load(path: Path) -> np.ndarray:
+    data = np.load(path, allow_pickle=False)
+    if isinstance(data, np.lib.npyio.NpzFile):
+        return data[data.files[0]]
+    return data
+
+
+def _find(root: Path, names: list[str]) -> list[Path]:
+    found = []
+    for name in names:
+        found.extend(root.rglob(name))
+    return sorted(set(found))
+
+
+def analyze_scenario(root: Path) -> dict[str, Any]:
+    result_files = _find(root, ["scenario_result.json"])
+    if not result_files:
+        return {"scenario_name": root.name, "status": "FAIL", "errors": ["missing_scenario_result"]}
+    meta = json.loads(result_files[0].read_text(encoding="utf-8"))
+    config_files = _find(root, ["fierygs_solver_config.yaml"])
+    config = {}
+    if config_files:
+        import yaml
+        config = yaml.safe_load(config_files[0].read_text(encoding="utf-8")) or {}
+    scenario_meta = config.get("scenario_metadata") or {}
+    ignition = config.get("ignition") or {}
+    if meta.get("ignition_object") is None: meta["ignition_object"] = (ignition.get("object_ids") or [None])[0]
+    if meta.get("category") is None: meta["category"] = scenario_meta.get("ignition_category")
+    if meta.get("material") is None: meta["material"] = scenario_meta.get("ignition_material")
+    if meta.get("severity") is None: meta["severity"] = config.get("fire_level")
+    if not meta.get("propagation_targets"): meta["propagation_targets"] = scenario_meta.get("propagation_targets", [])
+    warnings, errors = [], []
+    arrays: dict[str, list[Path]] = {
+        "temperature": _find(root, ["temperature_*.npy", "temperature_*.npz"]),
+        "fuel": _find(root, ["fuel_*.npy", "fuel_*.npz"]),
+        "occupancy": _find(root, ["occupancy_*.npy", "occupancy_*.npz"]),
+    }
+    loaded: dict[str, list[np.ndarray]] = {}
+    for key, paths in arrays.items():
+        loaded[key] = []
+        for path in paths:
+            try:
+                arr = np.asarray(_load(path))
+                if not np.isfinite(arr).all():
+                    errors.append(f"nonfinite_{key}")
+                loaded[key].append(arr)
+            except Exception as exc:
+                errors.append(f"unreadable_{key}")
+    temp = loaded["temperature"]
+    fuel = loaded["fuel"]
+    occ = loaded["occupancy"]
+    max_temperature = float(max((float(a.max()) for a in temp), default=0.0))
+    max_fuel = float(max((float(a.max()) for a in fuel), default=0.0))
+    active = int(sum(np.count_nonzero(a > 0) for a in fuel))
+    initial_occ = float(np.count_nonzero(occ[0])) if occ else 0.0
+    final_occ = float(np.count_nonzero(occ[-1])) if occ else 0.0
+    if not fuel:
+        warnings.append("solver_output_missing_fuel")
+    elif max_fuel <= 0:
+        errors.append("no_fuel")
+    if not temp:
+        warnings.append("solver_output_missing_temperature")
+    elif max_temperature <= 0:
+        errors.append("no_temperature_rise")
+    if occ and initial_occ == 0:
+        warnings.append("empty_initial_occupancy")
+    if temp and len(temp) > 1 and float(np.max(temp[-1] - temp[0])) <= 0:
+        warnings.append("no_propagation")
+    if temp and max_temperature > 0 and max(float(np.count_nonzero(a > 0)) for a in temp) / temp[0].size > 0.95:
+        warnings.append("fire_abnormally_concentrated")
+    carbon = _find(root, ["*carbonized*.npy", "*carbonized*.npz"])
+    carbon_count = None
+    if carbon:
+        carbon_count = int(np.count_nonzero(_load(carbon[-1])))
+    else:
+        warnings.append("carbonization_unavailable")
+    ignition_success = bool(meta.get("success", False) and max_temperature > 0 and max_fuel > 0)
+    if not ignition_success and not temp and not fuel:
+        errors.append("ignition_failed")
+    status = "FAIL" if errors else ("WARNING" if warnings else "PASS")
+    return {"scenario_name": meta.get("scenario_name", root.name), "ignition_object": meta.get("ignition_object"),
+            "category": meta.get("category"), "material": meta.get("material"), "severity": meta.get("severity"),
+            "ignition_success": ignition_success, "initial_temperature_change": float(np.max(temp[-1] - temp[0])) if len(temp)>1 else 0.0,
+            "initial_fuel_exists": bool(fuel and np.count_nonzero(fuel[0]) > 0), "max_temperature": max_temperature,
+            "max_fuel": max_fuel, "active_fire_voxel_count": active, "non_ignition_fire_volume": active,
+            "secondary_ignition_candidate_count": len(meta.get("propagation_targets", [])), "occupancy_initial": initial_occ,
+            "occupancy_final": final_occ, "occupancy_reduction": initial_occ-final_occ, "carbonized_gaussian_count": carbon_count,
+            "carbonization_available": carbon_count is not None, "warnings": sorted(set(warnings)), "errors": sorted(set(errors)), "status": status}
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--input-dir", type=Path, required=True)
+    p.add_argument("--output-dir", type=Path, required=True)
+    args = p.parse_args()
+    scenarios = sorted(d for d in args.input_dir.iterdir() if d.is_dir() and d.name != "batch")
+    reports = []
+    for i, root in enumerate(scenarios, 1):
+        item = analyze_scenario(root); reports.append(item)
+        print(f"[{i}/{len(scenarios)}] analyzing {root.name}", flush=True)
+        print(f"  {item['status']}", flush=True)
+    counts = {s: sum(x["status"] == s for x in reports) for s in ("PASS", "WARNING", "FAIL")}
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    payload = {"total": len(reports), **{k.lower(): v for k, v in counts.items()}, "scenarios": reports}
+    (args.output_dir / "quality_report.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+    md = "# Fire Scenario Quality Summary\n\n" + "\n".join(f"- {k}: {v}" for k, v in [("Total",len(reports)),*counts.items()]) + "\n"
+    (args.output_dir / "quality_summary.md").write_text(md, encoding="utf-8")
+    print("================================\nQuality validation finished")
+    print(f"Total: {len(reports)}\nPASS: {counts['PASS']}\nWARNING: {counts['WARNING']}\nFAIL: {counts['FAIL']}")
+    print(f"Output: {args.output_dir}")
+
+
+if __name__ == "__main__":
+    main()
