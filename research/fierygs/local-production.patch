@@ -0,0 +1,157 @@
+"""Validate a short native FieryGS run and render volume-wide diagnostics."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import yaml
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def field_stats(array: np.ndarray) -> dict:
+    return {
+        "shape": list(array.shape), "finite": bool(np.isfinite(array).all()),
+        "minimum": float(array.min()), "maximum": float(array.max()),
+        "mean": float(array.mean()), "sum": float(array.sum()),
+        "nonzero_voxels": int(np.count_nonzero(array)),
+    }
+
+
+def projection_panel(field: np.ndarray, axis: int, label: str) -> Image.Image:
+    projection = field.max(axis=axis).T[::-1]
+    maximum = float(projection.max())
+    normalized = projection / maximum if maximum > 0 else projection
+    rgb = np.zeros((*projection.shape, 3), dtype=np.uint8)
+    rgb[..., 0] = np.round(255 * normalized).astype(np.uint8)
+    rgb[..., 1] = np.round(220 * np.sqrt(normalized)).astype(np.uint8)
+    rgb[..., 2] = np.round(35 * normalized).astype(np.uint8)
+    scale = max(1, 420 // max(projection.shape))
+    image = Image.fromarray(rgb).resize(
+        (rgb.shape[1] * scale, rgb.shape[0] * scale), Image.Resampling.NEAREST
+    )
+    panel = Image.new("RGB", (image.width, image.height + 28), (8, 12, 16))
+    panel.paste(image, (0, 0))
+    ImageDraw.Draw(panel).text((6, image.height + 6), f"{label}  max={maximum:.4f}", fill=(230, 235, 240))
+    return panel
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--initialization-report", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--export-mode", choices=("native", "adapted"), default="native")
+    parser.add_argument("--expected-frames", type=int)
+    parser.add_argument("--scenario-name")
+    args = parser.parse_args()
+
+    config = yaml.safe_load(args.config.read_text(encoding="utf-8"))
+    initialization = json.loads(args.initialization_report.read_text(encoding="utf-8"))
+    expected_frames = int(args.expected_frames if args.expected_frames is not None else config["sim_frames"])
+    if expected_frames < 1:
+        raise ValueError("Expected frame count must be positive")
+    frames = []
+    arrays = {}
+    for frame in range(expected_frames):
+        frame_data = {}
+        for field in ("temperature", "fuel", "occupancy"):
+            path = args.simulation_dir / field / f"{field}_{frame}.npz"
+            if not path.exists():
+                raise FileNotFoundError(path)
+            array = np.load(path)["arr_0"]
+            arrays[(frame, field)] = array
+            frame_data[field] = field_stats(array)
+        frames.append({"frame": frame, "fields": frame_data})
+
+    final_temperature = arrays[(expected_frames - 1, "temperature")]
+    panels = [
+        projection_panel(final_temperature, 2, "XY temperature max projection"),
+        projection_panel(final_temperature, 1, "XZ temperature max projection"),
+        projection_panel(final_temperature, 0, "YZ temperature max projection"),
+    ]
+    output_image = Image.new(
+        "RGB", (sum(panel.width for panel in panels), max(panel.height for panel in panels)), (8, 12, 16)
+    )
+    cursor = 0
+    for panel in panels:
+        output_image.paste(panel, (cursor, 0)); cursor += panel.width
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    diagnostic_path = args.output_dir / "smoke_test_temperature_projection.png"
+    output_image.save(diagnostic_path)
+
+    temporal_frames = np.linspace(0, expected_frames - 1, min(4, expected_frames), dtype=int)
+    temporal_panels = [
+        projection_panel(arrays[(int(frame), "temperature")], 2, f"frame {int(frame)} XY max")
+        for frame in temporal_frames
+    ]
+    temporal_image = Image.new(
+        "RGB", (sum(panel.width for panel in temporal_panels), max(panel.height for panel in temporal_panels)),
+        (8, 12, 16),
+    )
+    cursor = 0
+    for panel in temporal_panels:
+        temporal_image.paste(panel, (cursor, 0)); cursor += panel.width
+    temporal_path = args.output_dir / "temperature_propagation_timeline.png"
+    temporal_image.save(temporal_path)
+
+    final_fuel = arrays[(expected_frames - 1, "fuel")]
+    checks = {
+        "expected_frame_count_written": len(frames) == expected_frames,
+        "all_fields_finite": all(
+            item["finite"] for frame in frames for item in frame["fields"].values()
+        ),
+        "occupancy_loaded": frames[0]["fields"]["occupancy"]["nonzero_voxels"] == initialization["total_combustible_voxels"],
+        "temperature_activated": bool(np.any(final_temperature > 0)),
+        "fuel_activated": bool(np.any(final_fuel > 0)),
+        "video_written": (args.simulation_dir / "slice.mp4").exists(),
+    }
+    if args.export_mode == "adapted":
+        checks["frame_zero_exports_active_fields"] = (
+            frames[0]["fields"]["temperature"]["nonzero_voxels"] > 0
+            and frames[0]["fields"]["fuel"]["nonzero_voxels"] > 0
+        )
+        checks["no_alternating_zero_exports"] = all(
+            frame["fields"]["temperature"]["nonzero_voxels"] > 0
+            and frame["fields"]["fuel"]["nonzero_voxels"] > 0
+            for frame in frames
+        )
+    report = {
+        "metadata": {
+            "scenario_name": args.scenario_name or config["scene"], "timestamp": timestamp(),
+            "gaussian_count": initialization["metadata"]["gaussian_count"],
+            "source_files": [
+                str(args.config.resolve()), str(args.initialization_report.resolve()),
+                str(args.simulation_dir.resolve()),
+            ],
+        },
+        "passed": all(checks.values()), "checks": checks, "frames": frames,
+        "diagnostic_image": str(diagnostic_path.resolve()),
+        "temporal_diagnostic_image": str(temporal_path.resolve()),
+        "export_mode": args.export_mode,
+        "native_slice_note": (
+            "Native images sample fixed grid midplanes; a black slice does not imply an inactive "
+            "off-center ignition. This max projection covers the complete volume."
+        ),
+        "npz_export_note": (
+            "Adapter export writes temperature_pair.cur and coef_pair.cur; every saved frame is the "
+            "active post-step state and the FieryGS core remains unchanged."
+            if args.export_mode == "adapted" else
+            "Native save_npz writes fixed backing fields while the solver advances TexPair buffers; "
+            "exports can alternate between current and lagged states."
+        ),
+        "long_simulation_started": False,
+    }
+    write_json(args.output_dir / "smoke_test_report.json", report)
+    print(json.dumps(report, indent=2))
+    if not report["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
