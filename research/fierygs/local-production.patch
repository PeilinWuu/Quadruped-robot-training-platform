@@ -0,0 +1,82 @@
+"""Export FieryGS NPZ volumes as a compact browser-friendly voxel animation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import struct
+from pathlib import Path
+
+import numpy as np
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--roi-json", type=Path, required=True)
+    parser.add_argument("--fps", type=float, default=8.0)
+    parser.add_argument("--threshold", type=float, default=0.01)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    roi = json.loads(args.roi_json.read_text(encoding="utf-8"))
+    temperature_files = sorted(
+        (args.simulation_dir / "temperature").glob("temperature_*.npz"),
+        key=lambda path: int(path.stem.rsplit("_", 1)[1]),
+    )
+    if not temperature_files:
+        raise FileNotFoundError("No temperature_*.npz frames found")
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    output_path = args.output_dir / "fire_frames.bin"
+    frame_counts: list[int] = []
+    with output_path.open("wb") as stream:
+        stream.write(b"FGS1")
+        stream.write(struct.pack("<HHf", len(temperature_files), 128, float(roi["grid"]["voxel_size_m"])))
+        for temperature_path in temperature_files:
+            frame = int(temperature_path.stem.rsplit("_", 1)[1])
+            fuel_path = args.simulation_dir / "fuel" / f"fuel_{frame}.npz"
+            temperature = np.load(temperature_path)["arr_0"]
+            fuel = np.load(fuel_path)["arr_0"]
+            if temperature.shape != (128, 128, 128) or fuel.shape != temperature.shape:
+                raise ValueError(f"Unexpected grid shape in frame {frame}: {temperature.shape}, {fuel.shape}")
+            active = np.maximum(temperature, fuel) > args.threshold
+            indices = np.argwhere(active).astype(np.uint8)
+            values = np.column_stack((
+                indices,
+                np.rint(np.clip(temperature[active], 0, 1) * 255).astype(np.uint8),
+                np.rint(np.clip(fuel[active], 0, 1) * 255).astype(np.uint8),
+            ))
+            stream.write(struct.pack("<I", len(values)))
+            stream.write(values.tobytes(order="C"))
+            frame_counts.append(len(values))
+
+    manifest = {
+        "format": "FGS1",
+        "frames": len(temperature_files),
+        "fps": args.fps,
+        "grid_size": 128,
+        "voxel_size_m": roi["grid"]["voxel_size_m"],
+        "grid_lower": roi["grid"]["lower"],
+        "grid_upper": roi["grid"]["upper"],
+        "threshold": args.threshold,
+        "frame_counts": frame_counts,
+        "binary": output_path.name,
+    }
+    (args.output_dir / "fire_manifest.json").write_text(
+        json.dumps(manifest, indent=2), encoding="utf-8"
+    )
+    print(json.dumps({
+        "output": str(output_path),
+        "bytes": output_path.stat().st_size,
+        "frames": len(frame_counts),
+        "min_points": min(frame_counts),
+        "max_points": max(frame_counts),
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/fire_viewer.py b/tools/fire_viewer.py
new file mode 100644
index 0000000..26b1395
--- /dev/null
+++ b/tools/fire_viewer.py
@@ -0,0 +1,383 @@
+"""Interactive native FieryGS viewer for a saved fire simulation sequence.
+
+The Gaussian scene remains resident on the GPU.  A background render worker
+loads the selected fuel/occupancy frame, applies per-Gaussian carbonisation,
+and calls FieryGS' unmodified ``render_fire`` implementation.  DearPyGui stays
+responsive while the CUDA renderer is working and always requests the newest
+camera/timeline state.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import sys
+import threading
+import time
+from argparse import Namespace
+from dataclasses import dataclass
+from pathlib import Path
+from queue import Empty, Queue
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+import dearpygui.dearpygui as dpg
+import numpy as np
+import torch
+import yaml
+
+from adapter.create_scene import look_at_colmap
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from gaussian_renderer.renderer_with_fire import render_fire
+from scene.cameras import Camera
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+from utils.graphics_utils import focal2fov
+
+
+@dataclass(frozen=True)
+class RenderRequest:
+    serial: int
+    frame: int
+    position: tuple[float, float, float]
+    target: tuple[float, float, float]
+    coarse_samples: int
+    fine_samples: int
+    strength: float
+
+
+class OrbitState:
+    def __init__(self, position: np.ndarray, target: np.ndarray, up: np.ndarray):
+        self.position = position.astype(np.float64)
+        self.target = target.astype(np.float64)
+        self.up = up.astype(np.float64) / np.linalg.norm(up)
+
+    @staticmethod
+    def _rotate(vector: np.ndarray, axis: np.ndarray, angle: float) -> np.ndarray:
+        axis = axis / np.linalg.norm(axis)
+        return (
+            vector * math.cos(angle)
+            + np.cross(axis, vector) * math.sin(angle)
+            + axis * np.dot(axis, vector) * (1.0 - math.cos(angle))
+        )
+
+    def orbit(self, dx: float, dy: float) -> None:
+        offset = self.position - self.target
+        offset = self._rotate(offset, self.up, -dx * 0.006)
+        forward = -offset / np.linalg.norm(offset)
+        right = np.cross(forward, self.up)
+        right /= np.linalg.norm(right)
+        pitched = self._rotate(offset, right, -dy * 0.006)
+        # Avoid flipping through the world-up pole.
+        candidate_forward = -pitched / np.linalg.norm(pitched)
+        if abs(np.dot(candidate_forward, self.up)) < 0.985:
+            offset = pitched
+        self.position = self.target + offset
+
+    def pan(self, dx: float, dy: float) -> None:
+        forward = self.target - self.position
+        distance = np.linalg.norm(forward)
+        forward /= distance
+        right = np.cross(forward, self.up)
+        right /= np.linalg.norm(right)
+        camera_up = np.cross(right, forward)
+        shift = (-right * dx + camera_up * dy) * distance * 0.0015
+        self.position += shift
+        self.target += shift
+
+    def zoom(self, wheel: float) -> None:
+        offset = self.position - self.target
+        factor = math.exp(-float(wheel) * 0.12)
+        distance = float(np.clip(np.linalg.norm(offset) * factor, 0.12, 30.0))
+        self.position = self.target + offset / np.linalg.norm(offset) * distance
+
+
+class FireRenderWorker:
+    def __init__(self, args: argparse.Namespace, camera_config: dict, voxel_config: dict):
+        self.args = args
+        self.camera_config = camera_config
+        self.voxel_config = voxel_config
+        self.requests: Queue[RenderRequest | None] = Queue(maxsize=1)
+        self.results: Queue[tuple[str, object]] = Queue()
+        self.thread = threading.Thread(target=self._run, daemon=True, name="fierygs-render")
+
+    def start(self) -> None:
+        self.thread.start()
+
+    def submit(self, request: RenderRequest) -> None:
+        try:
+            while True:
+                self.requests.get_nowait()
+        except Empty:
+            pass
+        self.requests.put_nowait(request)
+
+    def stop(self) -> None:
+        try:
+            while True:
+                self.requests.get_nowait()
+        except Empty:
+            pass
+        self.requests.put_nowait(None)
+
+    def _make_camera(self, request: RenderRequest) -> Camera:
+        width, height = self.args.width, self.args.height
+        base_width = float(self.camera_config["width"])
+        base_height = float(self.camera_config["height"])
+        fx = float(self.camera_config["fx"]) * width / base_width
+        fy = float(self.camera_config["fy"]) * height / base_height
+        rotation, translation = look_at_colmap(
+            np.asarray(request.position), np.asarray(request.target),
+            np.asarray(self.camera_config.get("up", [0, 0, 1]), dtype=np.float64),
+        )
+        return Camera(
+            colmap_id=0, R=rotation, T=translation,
+            FoVx=focal2fov(fx, width), FoVy=focal2fov(fy, height),
+            image=torch.zeros((3, height, width), dtype=torch.float32),
+            gt_alpha_mask=None, image_path="", image_name="interactive_fire", uid=0,
+            cx=width / 2, cy=height / 2, data_device="cuda", preload_img=False,
+        )
+
+    def _run(self) -> None:
+        try:
+            self.results.put(("status", "Loading Gaussian scene on GPU..."))
+            gaussians = load_interiorgs_gaussians(self.args.ply)
+            indices = torch.load(
+                self.args.voxel_dir / "indices_pts_in_grids.pth",
+                map_location="cuda", weights_only=True,
+            )
+            mask = torch.load(
+                self.args.voxel_dir / "mask_pts_in_grids.pth",
+                map_location="cuda", weights_only=True,
+            )
+            gaussian_rows = torch.nonzero(mask, as_tuple=False).squeeze(1)
+            pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+            background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+            converter = TemperatureToRGB(T_max=12000, device="cuda")
+            fuel_to_temperature = FuelToTemperatureLUT(device="cuda")
+            bounds = self.voxel_config["bounding_box"]
+            self.results.put(("status", f"Ready: {gaussians.get_xyz.shape[0]:,} Gaussians"))
+
+            while True:
+                request = self.requests.get()
+                if request is None:
+                    return
+                started = time.perf_counter()
+                self.results.put(("status", f"Rendering simulation frame {request.frame}..."))
+                fuel_np = np.load(
+                    self.args.simulation_dir / "fuel" / f"fuel_{request.frame}.npz"
+                )["arr_0"]
+                occupancy_np = np.load(
+                    self.args.simulation_dir / "occupancy" / f"occupancy_{request.frame}.npz"
+                )["arr_0"]
+                fuel = torch.from_numpy(fuel_np).cuda().float()
+                query_tensor = fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+                occupancy = torch.from_numpy(occupancy_np).cuda().float()
+                mapped = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+                keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+                keep[gaussian_rows] = (mapped.abs() >= 0.7) & (mapped.abs() <= 1.0)
+                carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), dtype=torch.float32, device="cuda")
+                carbon[gaussian_rows] = mapped.unsqueeze(1).repeat(1, 3)
+                gaussians.update_per_frame(keep, 0.7, carbon)
+
+                render_args = Namespace(
+                    dual_smoke=False, near=0.1, far=6.0,
+                    num_samples_coarse=request.coarse_samples,
+                    num_samples_fine=request.fine_samples,
+                    sampling_smooth_factor=0.5, sampling_chunk_size=32,
+                    spec_intensity=1e-8, strength=request.strength, smoke_strength=0.5,
+                    sigma_a=1.0, render_smoke=True, darkness=1.0, ks=0.5,
+                    bounding_box=bounds,
+                )
+                with torch.no_grad():
+                    output = render_fire(
+                        self._make_camera(request), gaussians, pipeline, background,
+                        query_tensor=query_tensor, temp2rgb_converter=converter,
+                        args=render_args, scale_ratio=1440 / 12000,
+                        add_sepc_light=False, fuel2temp=fuel_to_temperature, color_field=None,
+                    )
+                rgb = output["render"].clamp(0, 1).permute(1, 2, 0).cpu().numpy()
+                rgba = np.concatenate(
+                    (rgb, np.ones((self.args.height, self.args.width, 1), dtype=np.float32)), axis=2
+                ).astype(np.float32).ravel()
+                elapsed = time.perf_counter() - started
+                metadata = {
+                    "serial": request.serial,
+                    "frame": request.frame,
+                    "rgba": rgba,
+                    "seconds": elapsed,
+                    "fuel_voxels": int(np.count_nonzero(fuel_np)),
+                    "carbonized": int((~keep).sum().item()),
+                }
+                self.results.put(("frame", metadata))
+        except Exception as exc:  # Surface worker failures in the GUI and terminal.
+            import traceback
+            traceback.print_exc()
+            self.results.put(("error", f"{type(exc).__name__}: {exc}"))
+
+
+class FireViewer:
+    def __init__(self, args: argparse.Namespace):
+        self.args = args
+        self.camera_config = json.loads(args.camera.read_text(encoding="utf-8"))
+        self.voxel_config = yaml.safe_load((args.voxel_dir / "simulation_voxel.yaml").read_text(encoding="utf-8"))
+        position = np.asarray(self.camera_config["position"], dtype=np.float64)
+        target = np.asarray(self.camera_config["target"], dtype=np.float64)
+        up = np.asarray(self.camera_config.get("up", [0, 0, 1]), dtype=np.float64)
+        self.orbit = OrbitState(position, target, up)
+        self.frames = sorted(
+            int(path.stem.rsplit("_", 1)[1])
+            for path in (args.simulation_dir / "fuel").glob("fuel_*.npz")
+        )
+        if not self.frames:
+            raise FileNotFoundError(f"No fuel frames in {args.simulation_dir}")
+        self.frame_set = set(self.frames)
+        self.serial = 0
+        self.playing = False
+        self.last_advance = time.perf_counter()
+        self.worker = FireRenderWorker(args, self.camera_config, self.voxel_config)
+
+    def request_render(self) -> None:
+        frame = int(dpg.get_value("timeline"))
+        if frame not in self.frame_set:
+            frame = min(self.frames, key=lambda value: abs(value - frame))
+            dpg.set_value("timeline", frame)
+        quality = dpg.get_value("quality")
+        samples = {"Fast": (24, 96), "Balanced": (48, 256), "High": (64, 512)}[quality]
+        self.serial += 1
+        self.worker.submit(RenderRequest(
+            serial=self.serial, frame=frame,
+            position=tuple(self.orbit.position), target=tuple(self.orbit.target),
+            coarse_samples=samples[0], fine_samples=samples[1],
+            strength=float(dpg.get_value("strength")),
+        ))
+
+    def _mouse_drag(self, _sender, app_data) -> None:
+        if not dpg.is_item_hovered("render_image"):
+            return
+        button, dx, dy = app_data
+        if button == dpg.mvMouseButton_Left:
+            self.orbit.orbit(dx, dy)
+        elif button == dpg.mvMouseButton_Middle:
+            self.orbit.pan(dx, dy)
+        else:
+            return
+        self.request_render()
+
+    def _mouse_wheel(self, _sender, app_data) -> None:
+        if dpg.is_item_hovered("render_image"):
+            self.orbit.zoom(float(app_data))
+            self.request_render()
+
+    def _toggle_play(self, _sender, app_data) -> None:
+        self.playing = bool(app_data)
+        self.last_advance = time.perf_counter()
+
+    def _reset_camera(self) -> None:
+        self.orbit.position = np.asarray(self.camera_config["position"], dtype=np.float64)
+        self.orbit.target = np.asarray(self.camera_config["target"], dtype=np.float64)
+        self.request_render()
+
+    def build(self) -> None:
+        dpg.create_context()
+        blank = np.zeros((self.args.height, self.args.width, 4), dtype=np.float32).ravel()
+        with dpg.texture_registry(show=False):
+            dpg.add_raw_texture(
+                self.args.width, self.args.height, blank,
+                format=dpg.mvFormat_Float_rgba, tag="render_texture",
+            )
+        with dpg.window(tag="main_window", label="FieryGS Dynamic Viewer"):
+            dpg.add_image("render_texture", tag="render_image")
+            with dpg.group(horizontal=True):
+                dpg.add_checkbox(label="Play", tag="play", callback=self._toggle_play)
+                dpg.add_slider_float(label="Playback FPS", tag="playback_fps", default_value=5.0,
+                                     min_value=0.5, max_value=20.0, width=130)
+                dpg.add_combo(["Fast", "Balanced", "High"], default_value="Fast",
+                              label="Quality", tag="quality", callback=lambda: self.request_render(), width=90)
+            dpg.add_slider_int(
+                label="Simulation frame", tag="timeline", default_value=self.frames[0],
+                min_value=self.frames[0], max_value=self.frames[-1], width=self.args.width - 150,
+                callback=lambda: self.request_render(),
+            )
+            dpg.add_slider_float(
+                label="Fire strength", tag="strength", default_value=self.args.strength,
+                min_value=0.002, max_value=0.04, format="%.3f", width=self.args.width - 150,
+                callback=lambda: self.request_render(),
+            )
+            with dpg.group(horizontal=True):
+                dpg.add_button(label="Reset camera", callback=lambda: self._reset_camera())
+                dpg.add_text("Left drag: orbit | Middle drag: pan | Wheel: zoom", tag="help")
+            dpg.add_text("Starting...", tag="status")
+        with dpg.handler_registry():
+            dpg.add_mouse_drag_handler(callback=self._mouse_drag)
+            dpg.add_mouse_wheel_handler(callback=self._mouse_wheel)
+        dpg.create_viewport(
+            title="FieryGS Dynamic Viewer", width=self.args.width + 40,
+            height=self.args.height + 175, resizable=False,
+        )
+        dpg.setup_dearpygui()
+        dpg.show_viewport()
+        dpg.set_primary_window("main_window", True)
+
+    def run(self) -> None:
+        self.build()
+        self.worker.start()
+        self.request_render()
+        try:
+            while dpg.is_dearpygui_running():
+                now = time.perf_counter()
+                if self.playing:
+                    interval = 1.0 / float(dpg.get_value("playback_fps"))
+                    if now - self.last_advance >= interval:
+                        current = int(dpg.get_value("timeline"))
+                        position = np.searchsorted(self.frames, current, side="right")
+                        if position >= len(self.frames):
+                            position = 0
+                        dpg.set_value("timeline", self.frames[position])
+                        self.last_advance = now
+                        self.request_render()
+                try:
+                    while True:
+                        kind, payload = self.worker.results.get_nowait()
+                        if kind == "status":
+                            dpg.set_value("status", str(payload))
+                        elif kind == "error":
+                            dpg.set_value("status", f"ERROR: {payload}")
+                            self.playing = False
+                            dpg.set_value("play", False)
+                        elif kind == "frame":
+                            dpg.set_value("render_texture", payload["rgba"])
+                            dpg.set_value(
+                                "status",
+                                f"Frame {payload['frame']} | {payload['seconds']:.2f}s | "
+                                f"fuel voxels {payload['fuel_voxels']} | carbonized Gaussians {payload['carbonized']}",
+                            )
+                except Empty:
+                    pass
+                dpg.render_dearpygui_frame()
+        finally:
+            self.worker.stop()
+            dpg.destroy_context()
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--width", type=int, default=480)
+    parser.add_argument("--height", type=int, default=270)
+    parser.add_argument("--strength", type=float, default=0.01)
+    args = parser.parse_args()
+    for path in (args.ply, args.camera, args.voxel_dir, args.simulation_dir):
+        if not path.exists():
+            parser.error(f"Path does not exist: {path}")
+    return args
+
+
+if __name__ == "__main__":
+    FireViewer(parse_args()).run()
