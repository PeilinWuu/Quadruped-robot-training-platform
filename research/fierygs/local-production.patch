@@ -0,0 +1,96 @@
+"""Create FieryGS-native three-panel VLM input for one bridged part."""
+
+from __future__ import annotations
+
+import argparse
+from argparse import Namespace
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.common import decode_ids, load_cameras
+from adapter.semantic_bridge.render_gaussian_maps import make_camera
+from gaussian_renderer import render
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--views-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--part-id", type=int, default=0)
+    parser.add_argument("--object-name", default="table")
+    args = parser.parse_args()
+    labels = np.load(args.labels)
+    selected = labels == args.part_id
+    if not selected.any():
+        raise ValueError(f"No Gaussian has part ID {args.part_id}")
+
+    best_view, best_count = 0, -1
+    selected_ids = np.flatnonzero(selected)
+    for index, _ in enumerate(load_cameras(args.cameras)):
+        ids = decode_ids(np.asarray(Image.open(args.views_dir / f"view_{index:03d}" / "gaussian_id.png").convert("RGB")))
+        count = np.intersect1d(np.unique(ids[ids >= 0]), selected_ids, assume_unique=False).size
+        if count > best_count:
+            best_view, best_count = index, count
+
+    camera_config = load_cameras(args.cameras)[best_view]
+    camera = make_camera(camera_config, best_view)
+    gaussians = load_interiorgs_gaussians(args.ply)
+    filtered = torch.from_numpy(~selected).cuda()
+    output = render(
+        camera, gaussians, Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False),
+        torch.tensor([0.0, 0.0, 0.0], device="cuda"), filtered_mask=filtered,
+    )
+    part = output["render"].detach().clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+    original = np.asarray(Image.open(args.views_dir / f"view_{best_view:03d}" / "rgb.png").convert("RGB"))
+    original_ids = decode_ids(np.asarray(Image.open(args.views_dir / f"view_{best_view:03d}" / "gaussian_id.png").convert("RGB")))
+    foreground = part.mean(axis=2) > 8
+    count, components, stats, _ = cv2.connectedComponentsWithStats(foreground.astype(np.uint8), 8)
+    if count <= 1:
+        raise RuntimeError("Assigned part did not produce a visible component")
+    largest = 1 + int(np.argmax(stats[1:, cv2.CC_STAT_AREA]))
+    mask = components == largest
+    # Keep the overlay depth-aware: foreground instances such as flowers must not
+    # be painted merely because selected table Gaussians exist behind them.
+    mask &= np.isin(original_ids, selected_ids)
+    mask = cv2.morphologyEx(mask.astype(np.uint8), cv2.MORPH_CLOSE, np.ones((3, 3), np.uint8)).astype(bool)
+    x, y, width, height, _ = stats[largest]
+
+    overlay = original.astype(np.float32)
+    blue = np.zeros_like(overlay); blue[..., 0] = 51; blue[..., 1] = 102; blue[..., 2] = 255
+    overlay[mask] = 0.4 * overlay[mask] + 0.6 * blue[mask]
+    overlay = np.clip(overlay, 0, 255).astype(np.uint8)
+    cv2.rectangle(overlay, (x, y), (x + width - 1, y + height - 1), (255, 0, 0), 2)
+
+    crop = part[y:y + height, x:x + width]
+    canvas = np.full_like(original, 255)
+    scale = min(original.shape[0] / height, original.shape[1] / width)
+    resized = cv2.resize(crop, (max(1, int(width * scale)), max(1, int(height * scale))), interpolation=cv2.INTER_LINEAR)
+    top = (canvas.shape[0] - resized.shape[0]) // 2
+    left = (canvas.shape[1] - resized.shape[1]) // 2
+    canvas[top:top + resized.shape[0], left:left + resized.shape[1]] = resized
+
+    gap, header = 20, 50
+    grid = np.full((original.shape[0] + header, original.shape[1] * 3 + gap * 4, 3), 255, dtype=np.uint8)
+    for column, image in enumerate((original, overlay, canvas)):
+        x0 = gap + column * (original.shape[1] + gap)
+        grid[header:, x0:x0 + original.shape[1]] = image
+    result = Image.fromarray(grid, mode="RGB")
+    draw = ImageDraw.Draw(result)
+    draw.text((gap, 15), f"original | masked {args.object_name} | isolated part", fill=(0, 0, 0))
+    target = args.output_dir / "gpt_input_single" / f"{args.part_id:03d}.png"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    result.save(target)
+    (args.output_dir / "gpt_input_mul").mkdir(parents=True, exist_ok=True)
+    print(f"best_view={best_view} visible_assigned={best_count} output={target.resolve()}")
+
+
+if __name__ == "__main__":
+    main()
