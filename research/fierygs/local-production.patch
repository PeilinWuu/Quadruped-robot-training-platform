+"""Resume-safe VLM material understanding and Gaussian mapping for all parts."""
+
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+import json
+import os
+import time
+from pathlib import Path
+
+import numpy as np
+
+from utils.vlm_utils import GPTtools
+from vis_material_seg import BURNABILITY_MAPPING, MATERIAL_MAPPING
+
+
+PROMPT = """The image has three panels: the full scene, a blue mask with a red box,
+and an isolated crop of the same target. Identify the highlighted target, choose
+its dominant material, and decide whether it is burnable under ordinary fire
+conditions. Use the supplied structured response. The material must be one of:
+wood, sand, metal, plastic, glass, fabric, foam, food, ceramic, paper, leather,
+plant, stone, cement, concrete, soil, clay, composite, sky."""
+
+FORCED_BURNABLE = {"wood", "plastic", "fabric", "foam", "food", "paper", "leather", "plant"}
+FORCED_UNBURNABLE = {"sand", "metal", "glass", "ceramic", "stone", "cement", "concrete", "soil", "clay", "sky"}
+
+
+def physically_normalized_predictions(predictions: dict[int, dict]) -> tuple[dict[int, dict], list[dict]]:
+    normalized, corrections = {}, []
+    for part_id, source in predictions.items():
+        item = dict(source)
+        raw = item["burnability"]
+        material = item["material"]
+        if material in FORCED_BURNABLE:
+            final = "burnable"
+        elif material in FORCED_UNBURNABLE:
+            final = "unburnable"
+        else:  # Composite is intentionally left to the visual/material reasoning result.
+            final = raw
+        item["vlm_burnability"] = raw
+        item["burnability"] = final
+        if final != raw:
+            correction = {
+                "part_id": part_id, "instance_id": item.get("instance_id"),
+                "material": material, "vlm_burnability": raw,
+                "final_burnability": final, "rule": "material_physics_consistency",
+            }
+            corrections.append(correction)
+            item["burnability_correction"] = correction["rule"]
+        normalized[part_id] = item
+    return normalized, corrections
+
+
+def parse_result(text: str) -> tuple[str, str, str]:
+    fields = [part.strip() for part in text.rsplit(",", 2)]
+    if len(fields) != 3:
+        raise ValueError(f"Unexpected VLM result: {text!r}")
+    caption, material, burnability = fields
+    material, burnability = material.lower(), burnability.lower()
+    if material not in MATERIAL_MAPPING or burnability not in BURNABILITY_MAPPING:
+        raise ValueError(f"Unsupported VLM result: {text!r}")
+    return caption.replace(",", ";"), material, burnability
+
+
+def load_predictions(path: Path) -> dict[int, dict]:
+    if not path.is_file():
+        return {}
+    result = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        record = json.loads(line)
+        if record.get("status") == "complete":
+            result[int(record["part_id"])] = record
+    return result
+
+
+def write_native_file(path: Path, image_dir: Path, predictions: dict[int, dict]) -> None:
+    lines = []
+    for part_id in sorted(predictions):
+        item = predictions[part_id]
+        lines.append(
+            f"{image_dir / f'{part_id:03d}.png'},{item['caption']},{item['material']},{item['burnability']}"
+        )
+    path.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
+
+
+def map_gaussians(model_dir: Path, manifest: dict, predictions: dict[int, dict], require_complete: bool,
+                  source_instances: dict[str, dict] | None = None) -> dict:
+    predictions, corrections = physically_normalized_predictions(predictions)
+    labels = np.load(model_dir / "points_label_mulscale.npy")
+    background = int(manifest["background_part_id"])
+    expected = {
+        int(part["part_id"]) for part in manifest["parts"]
+        if part.get("instance_id") is not None and part.get("vlm_status") == "ready"
+    }
+    missing = sorted(expected - predictions.keys())
+    if missing and require_complete:
+        raise RuntimeError(f"{len(missing)} parts still lack VLM predictions; resume the API batch first")
+
+    composite = MATERIAL_MAPPING["composite"]
+    unburnable = BURNABILITY_MAPPING["unburnable"]
+    materials = np.full(labels.shape, composite, dtype=np.int32)
+    burnability = np.full(labels.shape, unburnable, dtype=np.int32)
+    mapping = {}
+    for part_id, prediction in predictions.items():
+        mask = labels == part_id
+        materials[mask] = MATERIAL_MAPPING[prediction["material"]]
+        burnability[mask] = BURNABILITY_MAPPING[prediction["burnability"]]
+        mapping[f"{part_id:03d}"] = {
+            "caption": prediction["caption"], "material": prediction["material"],
+            "material_id": int(MATERIAL_MAPPING[prediction["material"]]),
+            "vlm_burnability": prediction["vlm_burnability"],
+            "burnanility": prediction["burnability"],
+            "burnability_id": int(BURNABILITY_MAPPING[prediction["burnability"]]),
+            "burnability_correction": prediction.get("burnability_correction"),
+        }
+    mapping[f"{background:03d}"] = {
+        "caption": "unassigned scene", "material": "composite", "material_id": composite,
+        "burnanility": "unburnable", "burnability_id": unburnable,
+        "adapter_policy": "unprocessed_scene_safe_background",
+    }
+    np.save(model_dir / "points_materials.npy", materials)
+    np.save(model_dir / "points_burnability.npy", burnability)
+    (model_dir / "label_mapping_hierachical.json").write_text(
+        json.dumps(mapping, indent=2) + "\n", encoding="utf-8"
+    )
+    catalog = []
+    for part in manifest["parts"]:
+        instance_id = part.get("instance_id")
+        if instance_id is None:
+            continue
+        part_id = int(part["part_id"])
+        prediction = predictions.get(part_id)
+        record = {
+            "part_id": part_id, "instance_id": instance_id,
+            "object_name": part["object_name"], "gaussian_count": part["gaussian_count"],
+            "gaussian_mapping_status": part.get("gaussian_mapping_status"),
+            "material_status": "complete" if prediction else "pending",
+            "caption": prediction["caption"] if prediction else None,
+            "material": prediction["material"] if prediction else None,
+            "vlm_burnability": prediction["vlm_burnability"] if prediction else None,
+            "burnability": prediction["burnability"] if prediction else None,
+            "burnability_correction": prediction.get("burnability_correction") if prediction else None,
+            "prediction_model": prediction.get("model") if prediction else None,
+        }
+        source = (source_instances or {}).get(str(instance_id))
+        if source and len(source.get("bounding_box", [])) == 8:
+            corners = np.asarray(
+                [[point["x"], point["y"], point["z"]] for point in source["bounding_box"]],
+                dtype=np.float64,
+            )
+            record.update({
+                "bbox_corners": corners.tolist(), "bbox_min": corners.min(axis=0).tolist(),
+                "bbox_max": corners.max(axis=0).tolist(), "bbox_center": corners.mean(axis=0).tolist(),
+            })
+        catalog.append(record)
+
+    class_material_counts: dict[str, Counter] = defaultdict(Counter)
+    class_totals: Counter = Counter()
+    for record in catalog:
+        if record["material_status"] == "complete":
+            class_material_counts[record["object_name"]][record["material"]] += 1
+            class_totals[record["object_name"]] += 1
+    review_items = []
+    for record in catalog:
+        total = class_totals[record["object_name"]]
+        material_count = class_material_counts[record["object_name"]][record["material"]]
+        rarity = material_count / total if total and record["material"] else 0.0
+        record["class_material_frequency"] = rarity if total >= 3 else None
+        rare_material = total >= 5 and rarity < 0.08
+        weak_mapping = record["gaussian_mapping_status"] != "reliable"
+        record["review_recommended"] = bool(rare_material or weak_mapping)
+        record["review_reasons"] = [
+            reason for condition, reason in (
+                (rare_material, "rare_material_within_object_class"),
+                (weak_mapping, "insufficient_gaussian_support"),
+            ) if condition
+        ]
+        record["confidence"] = "low" if rare_material and weak_mapping else (
+            "medium" if rare_material or weak_mapping else "high"
+        )
+        if record["review_recommended"]:
+            review_items.append({
+                key: record[key] for key in (
+                    "part_id", "instance_id", "object_name", "material", "burnability",
+                    "gaussian_count", "confidence", "review_reasons"
+                )
+            })
+    (model_dir / "objects_material_catalog.json").write_text(
+        json.dumps(catalog, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+    quality = {
+        "objects": len(catalog), "models": dict(Counter(
+            item.get("model", "unknown") for item in predictions.values()
+        )),
+        "material_counts": dict(Counter(item["material"] for item in predictions.values())),
+        "vlm_burnability_counts": dict(Counter(item["vlm_burnability"] for item in predictions.values())),
+        "final_burnability_counts": dict(Counter(item["burnability"] for item in predictions.values())),
+        "physical_correction_count": len(corrections), "physical_corrections": corrections,
+        "review_recommended_count": len(review_items), "review_items": review_items,
+        "class_material_distributions": {
+            name: dict(counts) for name, counts in sorted(class_material_counts.items())
+        },
+    }
+    (model_dir / "material_quality_report.json").write_text(
+        json.dumps(quality, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+    return {
+        "expected_predictions": len(expected), "completed_predictions": len(expected & predictions.keys()),
+        "missing_predictions": len(missing), "missing_part_ids": missing,
+        "burnable_parts": sum(item["burnability"] == "burnable" for item in predictions.values()),
+        "burnable_gaussians": int((burnability == BURNABILITY_MAPPING["burnable"]).sum()),
+        "outputs_final": not missing, "object_catalog_count": len(catalog),
+        "physical_correction_count": len(corrections),
+        "review_recommended_count": len(review_items),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model-dir", type=Path, required=True)
+    parser.add_argument("--source-labels", type=Path)
+    parser.add_argument("--execute", action="store_true", help="Actually call the configured API")
+    parser.add_argument("--map-only", action="store_true", help="Rebuild outputs from saved predictions without API calls")
+    parser.add_argument("--limit", type=int, default=0, help="Maximum new API calls; 0 means no limit")
+    parser.add_argument("--retries", type=int, default=3)
+    parser.add_argument("--delay", type=float, default=0.5)
+    parser.add_argument("--allow-partial-map", action="store_true")
+    args = parser.parse_args()
+
+    manifest = json.loads((args.model_dir / "parts.json").read_text(encoding="utf-8"))
+    image_dir = args.model_dir / "gpt_input" / "gpt_input_single"
+    state_path = args.model_dir / "material_predictions.jsonl"
+    predictions = load_predictions(state_path)
+    ready_parts = [
+        part for part in manifest["parts"]
+        if part.get("instance_id") is not None and part.get("vlm_status") == "ready"
+    ]
+    pending = [part for part in ready_parts if int(part["part_id"]) not in predictions]
+    summary = {
+        "model": os.environ.get("OPENAI_MODEL", "gpt-4o"),
+        "api_key_configured": bool(os.environ.get("OPENAI_API_KEY")),
+        "base_url_configured": bool(os.environ.get("OPENAI_BASE_URL")),
+        "ready_parts": len(ready_parts), "already_complete": len(predictions),
+        "pending": len(pending), "execute": args.execute,
+    }
+    print(json.dumps(summary, indent=2))
+    if not args.execute and not args.map_only:
+        print("Dry run only. Add --execute to make billed external API calls.")
+        return
+    if args.execute and not os.environ.get("OPENAI_API_KEY"):
+        raise EnvironmentError("OPENAI_API_KEY is not set in this PowerShell session")
+
+    call_budget = len(pending) if args.limit <= 0 else min(args.limit, len(pending))
+    if args.map_only:
+        call_budget = 0
+    with state_path.open("a", encoding="utf-8") as state:
+        for offset, part in enumerate(pending[:call_budget], 1):
+            part_id = int(part["part_id"])
+            image_path = image_dir / f"{part_id:03d}.png"
+            last_error = None
+            for attempt in range(1, args.retries + 1):
+                try:
+                    caption, material, burnability = parse_result(GPTtools(str(image_path), PROMPT))
+                    record = {
+                        "status": "complete", "part_id": part_id,
+                        "instance_id": part["instance_id"], "object_name": part["object_name"],
+                        "caption": caption, "material": material, "burnability": burnability,
+                        "model": os.environ.get("OPENAI_MODEL", "gpt-4o"),
+                    }
+                    state.write(json.dumps(record, ensure_ascii=False) + "\n")
+                    state.flush()
+                    predictions[part_id] = record
+                    print(
+                        f"[{offset}/{call_budget}] part={part_id:03d} instance={part['instance_id']} "
+                        f"{part['object_name']} -> {material}, {burnability}", flush=True
+                    )
+                    last_error = None
+                    break
+                except Exception as exc:
+                    last_error = exc
+                    print(f"part {part_id:03d} attempt {attempt}/{args.retries} failed: {exc}", flush=True)
+                    status_code = getattr(exc, "status_code", None)
+                    message = str(exc).lower()
+                    permanent_account_error = status_code in {401, 403} or (
+                        status_code == 404 and ("model_not_found" in message or "not supported" in message)
+                    )
+                    if permanent_account_error:
+                        raise RuntimeError(
+                            "Permanent API account/model error; batch stopped without marking this part complete"
+                        ) from exc
+                    if attempt < args.retries:
+                        time.sleep(args.delay * (2 ** (attempt - 1)))
+            if last_error is not None:
+                failure = {
+                    "status": "failed", "part_id": part_id, "instance_id": part["instance_id"],
+                    "object_name": part["object_name"], "error": str(last_error),
+                }
+                state.write(json.dumps(failure, ensure_ascii=False) + "\n")
+                state.flush()
+            time.sleep(args.delay)
+
+    native = image_dir / "gpt_input_single_gpttool.txt"
+    write_native_file(native, image_dir, predictions)
+    source_instances = None
+    if args.source_labels:
+        source_instances = {
+            str(item.get("ins_id")): item
+            for item in json.loads(args.source_labels.read_text(encoding="utf-8"))
+        }
+    report = map_gaussians(
+        args.model_dir, manifest, predictions,
+        require_complete=not args.allow_partial_map,
+        source_instances=source_instances,
+    )
+    report.update({"native_prediction_file": str(native.resolve()), "model": summary["model"]})
+    (args.model_dir / "material_batch_report.json").write_text(
+        json.dumps(report, indent=2) + "\n", encoding="utf-8"
+    )
+    console_report = dict(report)
+    if len(console_report.get("missing_part_ids", [])) > 20:
+        console_report["missing_part_ids"] = console_report["missing_part_ids"][:20] + ["..."]
+    print(json.dumps(console_report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
