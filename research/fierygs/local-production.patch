@@ -0,0 +1,30 @@
+"""Load an InteriorGS explicit PLY into the unmodified FieryGS GaussianModel."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from plyfile import PlyData
+
+from scene.gaussian_model import GaussianModel
+
+
+def infer_sh_degree(ply_path: str | Path) -> int:
+    ply = PlyData.read(str(ply_path), mmap=True)
+    names = [prop.name for prop in ply["vertex"].properties]
+    rest_count = sum(name.startswith("f_rest_") for name in names)
+    for degree in range(4):
+        if rest_count == 3 * (degree + 1) ** 2 - 3:
+            return degree
+    raise ValueError(f"Unsupported SH field count: {rest_count}")
+
+
+def load_interiorgs_gaussians(ply_path: str | Path) -> GaussianModel:
+    """Return a CUDA-backed FieryGS GaussianModel without copying or editing the PLY."""
+    ply_path = Path(ply_path).resolve()
+    if not ply_path.is_file():
+        raise FileNotFoundError(ply_path)
+    model = GaussianModel(infer_sh_degree(ply_path))
+    model.load_ply(str(ply_path))
+    return model
+
