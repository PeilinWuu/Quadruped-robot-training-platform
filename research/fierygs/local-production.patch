+"""Physical initialization presets for comparable room-scale scenarios."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+
+
+FIRE_LEVEL_PRESETS = {
+    "low": {"surface_layers": 1, "patch_count": 1, "target_ignition_voxels": 25, "simulation_frames": 60},
+    "medium": {"surface_layers": 2, "patch_count": 1, "target_ignition_voxels": 50, "simulation_frames": 120},
+    "high": {"surface_layers": 3, "patch_count": 3, "target_ignition_voxels": 150, "simulation_frames": 200},
+}
+
+
+def apply_fire_level(scenario: dict) -> dict:
+    """Fill orchestration defaults without changing native solver/render constants."""
+    result = deepcopy(scenario)
+    level = str(result.get("fire_level", "medium")).lower()
+    if level not in FIRE_LEVEL_PRESETS:
+        raise ValueError(f"Unknown fire_level {level!r}; expected low, medium, or high")
+    preset = FIRE_LEVEL_PRESETS[level]
+    ignition = result.setdefault("ignition", {})
+    simulation = result.setdefault("simulation", {})
+    ignition.setdefault("surface_layers", preset["surface_layers"])
+    ignition.setdefault("patch_count", preset["patch_count"])
+    ignition.setdefault("target_ignition_voxels", preset["target_ignition_voxels"])
+    simulation.setdefault("frames", preset["simulation_frames"])
+    result["fire_level"] = level
+    return result
+
+
+def preset_documentation() -> dict:
+    return {level: {**values, "native_parameters_changed": [], "renderer_parameters_changed": [],
+                    "meaning": "physical initialization coverage and requested propagation duration"}
+            for level, values in FIRE_LEVEL_PRESETS.items()}
