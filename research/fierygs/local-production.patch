+                    camera, gaussians, pipeline, background, query_tensor=tensor,
+                    temp2rgb_converter=converter, args=render_args, scale_ratio=1440 / 12000,
+                    add_sepc_light=False, fuel2temp=fuel2temp, color_field=None,
+                )
