+"""Build grouped Dataset v1 sample and split manifests from states and cameras."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from collections import Counter
+from pathlib import Path
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    parser.add_argument("--allow-incomplete", action="store_true")
+    return parser.parse_args()
+
+
+def state_split(group_id: str) -> str:
+    value = int(hashlib.sha256(f"dataset-v1-seed-42::{group_id}".encode()).hexdigest()[:8], 16) % 100
+    if value < 80:
+        return "train"
+    if value < 90:
+        return "validation"
+    return "test"
+
+
+def main() -> None:
+    args = parse_args()
+    manifest_dir = args.dataset_root / "manifests"
+    scenario_manifest_path = manifest_dir / "scenario_manifest.json"
+    scenario_manifest = json.loads(scenario_manifest_path.read_text(encoding="utf-8"))
+    samples = []
+    skipped = []
+
+    for scenario in scenario_manifest["scenarios"]:
+        scenario_id = scenario["scenario_id"]
+        states_path = args.dataset_root / "metadata" / "temporal" / f"{scenario_id}_states.json"
+        camera_set_path = args.dataset_root / "cameras" / scenario["ignition_object"] / "camera_set.json"
+        if not states_path.is_file():
+            if args.allow_incomplete:
+                skipped.append(scenario_id)
+                continue
+            raise FileNotFoundError(states_path)
+        states = json.loads(states_path.read_text(encoding="utf-8"))["states"]
+        cameras = json.loads(camera_set_path.read_text(encoding="utf-8"))["cameras"]
+        if len(states) != 15 or len(cameras) != 8:
+            raise RuntimeError(f"{scenario_id}: expected 15 states and 8 cameras")
+
+        for state in states:
+            group_id = f"{scenario_id}__{state['state_id']}"
+            split = state_split(group_id)
+            for camera in cameras:
+                camera_id = camera["camera_id"]
+                sample_id = (
+                    f"{scenario_id}__{state['stage']}__{state['state_id']}__{camera_id.split('_')[-1]}"
+                )
+                samples.append(
+                    {
+                        "sample_id": sample_id,
+                        "group_id": group_id,
+                        "split": split,
+                        "scenario": scenario_id,
+                        "ignition_object": scenario["ignition_object"],
+                        "ignition_object_ids": scenario["ignition_object_ids"],
+                        "fire_level": scenario["fire_level"],
+                        "simulation_frame": state["simulation_frame"],
+                        "physical_stage": state["stage"],
+                        "state_id": state["state_id"],
+                        "state_metrics": state["metrics"],
+                        "camera_id": camera_id,
+                        "camera_path": camera["path"],
+                        "simulation_dir": scenario["simulation_dir"],
+                        "simulation_seed": scenario["simulation_seed"],
+                        "source_mode": "native_reignite",
+                        "renderer_profile": "fierygs_robot_fire_production_v1",
+                        "xyz2rgb_clip_output": True,
+                        "hdr_aces": False,
+                        "strength": 0.005,
+                        "smoke_strength": 0.2,
+                        "render_seed": 42,
+                        "outputs": {
+                            "rgb": str((args.dataset_root / "rgb" / f"{sample_id}.png").resolve()),
+                            "depth": str((args.dataset_root / "depth" / f"{sample_id}.png").resolve()),
+                            "semantic": str((args.dataset_root / "semantic" / f"{sample_id}.npz").resolve()),
+                            "fire_contribution": str((args.dataset_root / "fire_masks" / f"{sample_id}.npy").resolve()),
+                            "fire_binary": str((args.dataset_root / "fire_masks" / f"{sample_id}.png").resolve()),
+                            "smoke_contribution": str((args.dataset_root / "smoke_masks" / f"{sample_id}.npy").resolve()),
+                            "smoke_binary": str((args.dataset_root / "smoke_masks" / f"{sample_id}.png").resolve()),
+                            "metadata": str((args.dataset_root / "metadata" / "samples" / f"{sample_id}.json").resolve()),
+                        },
+                    }
+                )
+
+    manifest_path = manifest_dir / "dataset_v1_manifest.jsonl"
+    manifest_path.write_text(
+        "".join(json.dumps(sample, separators=(",", ":")) + "\n" for sample in samples),
+        encoding="utf-8",
+    )
+    split_groups = {}
+    for sample in samples:
+        split_groups[sample["group_id"]] = sample["split"]
+    split_payload = {
+        "policy": "SHA256 deterministic split by complete simulation-state group",
+        "seed": 42,
+        "leakage_rule": "all eight cameras from one simulation state share a split",
+        "groups": split_groups,
+        "group_counts": dict(Counter(split_groups.values())),
+        "sample_counts": dict(Counter(sample["split"] for sample in samples)),
+    }
+    split_path = manifest_dir / "split_proposal.json"
+    split_path.write_text(json.dumps(split_payload, indent=2), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "manifest": str(manifest_path.resolve()),
+                "split_proposal": str(split_path.resolve()),
+                "samples": len(samples),
+                "scenarios": len(set(sample["scenario"] for sample in samples)),
+                "skipped_incomplete_scenarios": skipped,
+                "sample_split_counts": split_payload["sample_counts"],
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
