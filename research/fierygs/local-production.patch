+"""Generate a small reproducible room-fire YAML batch from ranked candidates."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import yaml
+
+from adapter.fire_scenario.fire_level_presets import FIRE_LEVEL_PRESETS, preset_documentation
+
+
+FAMILY_ALIASES = {
+    "table": {"table"},
+    "sofa": {"sofa", "multi person sofa"},
+    "curtain": {"curtain"},
+}
+PREFERRED_IDS = {"table": 113, "sofa": 135, "curtain": 62}
+
+
+def select_family(objects: list[dict], family: str) -> dict:
+    aliases = FAMILY_ALIASES[family]
+    matches = [item for item in objects if item["recommended_for_ignition"] and item["semantic_label"].strip().lower() in aliases]
+    preferred = [item for item in matches if item["object_id"] == PREFERRED_IDS[family]]
+    if preferred:
+        return preferred[0]
+    if not matches:
+        raise RuntimeError(f"No reliable candidate found for family {family}")
+    return max(matches, key=lambda item: (item["quality_status"] == "reliable", item["gaussian_count"], item["bbox_volume_m3"]))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--candidates", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--families", nargs="+", choices=sorted(FAMILY_ALIASES), default=["table"])
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+
+    payload = json.loads(args.candidates.read_text(encoding="utf-8"))
+    allowed_ids = sorted(item["object_id"] for item in payload["objects"] if item["recommended_for_ignition"])
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    generated = []
+    for family in args.families:
+        selected = select_family(payload["objects"], family)
+        for level, preset in FIRE_LEVEL_PRESETS.items():
+            name = f"office_{family}_{level}"
+            scenario = {
+                "name": name, "seed": args.seed,
+                "ignition_lifetime": "initial_only",
+                "ignition": {
+                    "object_ids": [selected["object_id"]], "mode": "object_top_surface",
+                    "surface_layers": preset["surface_layers"], "patch_count": preset["patch_count"],
+                    "target_ignition_voxels": preset["target_ignition_voxels"],
+                },
+                "fire_level": level,
+                "initial_temperature": 1200.0,
+                "simulation": {"frames": preset["simulation_frames"]},
+                "environment": {"wind": {"x": 0.0, "y": 0.0, "z": 0.0}},
+                "propagation": {"enabled": True, "allowed_object_ids": allowed_ids, "blocked_object_ids": []},
+                "render": {"fire_strength": 0.05, "smoke_strength": 1.0},
+                "fire_parameters": {"fuel_scale": 1.0},
+                "solver_parameters": {"k": 0.3, "burn_rate": 0.045, "beta": 50, "alpha": 120, "epsilon": 5, "nu": 0.1},
+                "object_metadata": {"semantic_label": selected["semantic_label"], "material": selected["material"],
+                                    "gaussian_count": selected["gaussian_count"], "quality_status": selected["quality_status"]},
+            }
+            path = args.output_dir / f"{name}.yaml"
+            path.write_text(yaml.safe_dump(scenario, sort_keys=False), encoding="utf-8")
+            generated.append({"family": family, "level": level, "object_id": selected["object_id"], "path": str(path.resolve())})
+    manifest = {"source": str(args.candidates.resolve()), "seed": args.seed,
+                "fire_level_presets": preset_documentation(), "generated": generated}
+    (args.output_dir / "scenario_batch_manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == "__main__":
+    main()
