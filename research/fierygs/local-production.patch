+"""Summarize the limited Table-HIGH sweep and write next-step recommendations."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+FRAMES = (0, 40, 100, 159, 199)
+
+
+def load(path: Path) -> np.ndarray:
+    return np.asarray(Image.open(path).convert("RGB"))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--visual-root", type=Path, required=True)
+    parser.add_argument("--static-baseline", type=Path, required=True)
+    args = parser.parse_args()
+    root = args.visual_root / "renders/table_high"
+    variants = {
+        "baseline": root / "baseline_full/baseline_full_frames",
+        "higher_sampling": root / "diagnostic_variants/higher_sampling/preview_frames",
+        "reduced_brightness": root / "diagnostic_variants/reduced_brightness/preview_frames",
+        "stronger_smoke": root / "diagnostic_variants/stronger_smoke/preview_frames",
+    }
+    static = load(args.static_baseline).astype(np.int16)
+    rows, thumb = [], (320, 180)
+    sheet = Image.new("RGB", (thumb[0] * len(FRAMES), (thumb[1] + 28) * len(variants)), "white")
+    draw = ImageDraw.Draw(sheet)
+    for row, (name, directory) in enumerate(variants.items()):
+        for col, frame in enumerate(FRAMES):
+            image = load(directory / f"frame_{frame:03d}.png")
+            baseline_image = load(variants["baseline"] / f"frame_{frame:03d}.png")
+            new_sat = float(np.mean((image.max(2) >= 250) & (static.max(2) < 250)) * 100)
+            from_baseline = float(np.mean(np.max(np.abs(image.astype(np.int16) - baseline_image.astype(np.int16)), axis=2) > 8) * 100)
+            rows.append({"variant": name, "frame": frame, "new_saturated_pixel_percent": new_sat,
+                         "changed_from_baseline_percent": from_baseline})
+            x, y = col * thumb[0], row * (thumb[1] + 28)
+            sheet.paste(Image.fromarray(image).resize(thumb, Image.Resampling.LANCZOS), (x, y + 28))
+            draw.text((x + 5, y + 8), f"{name} | {frame:03d} | sat {new_sat:.1f}%", fill="black")
+    sheet_path = root / "diagnostic_variants/diagnostic_contact_sheet.png"
+    sheet.save(sheet_path)
+    sweep = {
+        "metadata": {"scenario_name": "table_high_render_diagnostic_sweep", "timestamp": timestamp(),
+                     "source_files": [str(x.resolve()) for x in variants.values()]},
+        "canonical_baseline_unchanged": True, "frames": list(FRAMES), "measurements": rows,
+        "variants": {
+            "higher_sampling": {"parameters": {"samples": [64, 256], "strength": 0.05, "smoke_strength": 1.0},
+                                "finding": "Nearly identical topology and blockiness; sampling is not the primary cause."},
+            "reduced_brightness": {"parameters": {"samples": [32, 128], "strength": 0.025, "smoke_strength": 1.0},
+                                   "finding": "Only small visual change in the already saturated core; strength alone does not solve exposure."},
+            "stronger_smoke": {"parameters": {"samples": [32, 128], "strength": 0.05, "smoke_strength": 1.5},
+                               "finding": "Increases white blocky obscuration and worsens readability."},
+        },
+        "diagnostic_conclusion": {"physics": "Table plume topology is already narrow/columnar in the field evolution.",
+                                  "rendering": "Emission/color transfer saturates internal detail and scalar smoke is too white/blocky.",
+                                  "camera": "Table camera is adequate; framing is not the main table-fire defect."},
+        "contact_sheet": str(sheet_path.resolve()),
+    }
+    write_json(args.visual_root / "reports/table_high_render_diagnostic_sweep.json", sweep)
+    recommendation = {
+        "metadata": {"scenario_name": "office_01_visual_next_step_recommendation", "timestamp": timestamp(),
+                     "source_files": [str((args.visual_root / 'reports/visual_inspection_summary.json').resolve()),
+                                      str((args.visual_root / 'reports/render_issue_diagnosis.json').resolve()),
+                                      str((args.visual_root / 'reports/table_high_render_diagnostic_sweep.json').resolve())]},
+        "ready_for_robot_training_data": False,
+        "reason": "Semantic ignition and temporal physics work, but overexposure, voxel slabs, merged secondary sources, and ambiguous carbonization would teach strong synthetic artifacts to a vision policy.",
+        "optimization_priority": [
+            {"rank": 1, "area": "brightness/exposure", "reason": "Restore flame structure before judging other visual changes."},
+            {"rank": 2, "area": "voxel resolution", "reason": "Current 0.05 m field produces visible slabs and rectangular fire sheets."},
+            {"rank": 3, "area": "smoke visibility", "reason": "Current scalar smoke is white/blocky; dual-smoke state was not simulated."},
+            {"rank": 4, "area": "carbonization visibility", "reason": "Native carbonization exists but is hidden by saturated fire and removal-style mapping."},
+            {"rank": 5, "area": "camera framing", "reason": "Mainly affects curtain; table and sofa defects persist in adequate views."},
+            {"rank": 6, "area": "render sampling", "reason": "64/256 diagnostic sampling was nearly identical to 32/128."},
+        ],
+        "best_current_showcase": {"scenario": "sofa_high", "reason": "It shows the clearest visible spatial growth and best agreement with the physical spread trend."},
+        "best_visual_tuning_case": {"scenario": "table_high", "reason": "Centered object, fixed camera, early-to-late torch transition, and controlled variants make defects easy to measure."},
+        "recommended_next_engineering_phase": "visual quality optimization",
+        "defer": ["more fire scenarios", "virtual Go2 camera", "dataset generation"],
+    }
+    write_json(args.visual_root / "reports/next_step_recommendation.json", recommendation)
+    print(json.dumps({"sweep": str((args.visual_root/'reports/table_high_render_diagnostic_sweep.json').resolve()),
+                      "next": recommendation["recommended_next_engineering_phase"],
+                      "ready": recommendation["ready_for_robot_training_data"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
