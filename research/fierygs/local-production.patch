diff --git a/adapter/fire_scenario/select_fire_candidates.py b/adapter/fire_scenario/select_fire_candidates.py
new file mode 100644
index 0000000..328cde6
--- /dev/null
+++ b/adapter/fire_scenario/select_fire_candidates.py
@@ -0,0 +1,86 @@
+"""Rank reliable, physically meaningful combustible ignition candidates."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import BURNABLE_MATERIALS, timestamp, write_json
+
+
+PREFERRED = {"table", "sofa", "multi person sofa", "curtain", "wardrobe", "cabinet", "bar counter", "plant", "chair", "high chair"}
+REJECT = {"floor mold", "baseboard", "chandelier", "lamp", "downlights", "dish", "plate", "cup", "bowl", "flowers"}
+
+
+def normalized_name(value: str) -> str:
+    return " ".join(value.strip().lower().split())
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--catalog", type=Path, required=True)
+    parser.add_argument("--quality-report", type=Path, required=True)
+    parser.add_argument("--confirmed", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    catalog = json.loads(args.catalog.read_text(encoding="utf-8"))
+    quality = json.loads(args.quality_report.read_text(encoding="utf-8"))
+    confirmed_payload = json.loads(args.confirmed.read_text(encoding="utf-8"))
+    confirmed_ids = {int(item["object_id"]) for item in confirmed_payload["confirmed"]}
+    candidates = []
+    for item in catalog:
+        object_id = int(item["instance_id"])
+        name = normalized_name(item["object_name"])
+        extent = np.asarray(item["bbox_max"], dtype=float) - np.asarray(item["bbox_min"], dtype=float)
+        bbox_volume = float(np.prod(np.maximum(extent, 0)))
+        reasons = []
+        reliable = item.get("gaussian_mapping_status") == "reliable"
+        high_confidence = item.get("confidence") == "high"
+        combustible = item.get("burnability") == "burnable" and item.get("material") in BURNABLE_MATERIALS
+        meaningful_size = int(item["gaussian_count"]) >= 2000 and bbox_volume >= 0.08
+        semantically_rejected = name in REJECT or any(token in name for token in ("mold", "lamp", "chandelier", "dish"))
+        recommended = all((reliable, high_confidence, combustible, meaningful_size, not item.get("review_recommended"), not semantically_rejected, object_id in confirmed_ids))
+        if not reliable: reasons.append("unreliable_gaussian_mapping")
+        if not high_confidence: reasons.append("material_confidence_below_high")
+        if not combustible: reasons.append("not_confirmed_combustible_material")
+        if not meaningful_size: reasons.append("small_gaussian_count_or_bbox_volume")
+        if item.get("review_recommended"): reasons.append("material_review_recommended")
+        if semantically_rejected: reasons.append("semantically_unsuitable_ignition_object")
+        if object_id not in confirmed_ids: reasons.append("not_in_confirmed_fuel_set")
+        priority = (2 if name in PREFERRED else 0) + (1 if recommended else 0)
+        candidates.append({
+            "object_id": object_id, "semantic_label": item["object_name"],
+            "material": item["material"], "burnability": item["burnability"],
+            "gaussian_count": int(item["gaussian_count"]),
+            "bbox_min": item["bbox_min"], "bbox_max": item["bbox_max"],
+            "bbox_center": item["bbox_center"], "bbox_volume_m3": bbox_volume,
+            "quality_status": "reliable" if reliable and high_confidence and not item.get("review_recommended") else "review",
+            "recommended_for_ignition": recommended,
+            "selection_reasons": reasons or ["high_confidence_large_reliable_combustible_object"],
+            "priority_score": priority,
+        })
+    candidates.sort(key=lambda x: (not x["recommended_for_ignition"], -x["priority_score"], -x["gaussian_count"], x["object_id"]))
+    payload = {
+        "metadata": {"scenario_name": "office_01_room_fire_candidates", "timestamp": timestamp(),
+                     "gaussian_count": confirmed_payload["metadata"]["gaussian_count"],
+                     "source_files": [str(args.catalog.resolve()), str(args.quality_report.resolve()), str(args.confirmed.resolve())]},
+        "selection_policy": {"minimum_gaussians": 2000, "minimum_bbox_volume_m3": 0.08,
+                             "combustible_materials": sorted(BURNABLE_MATERIALS),
+                             "quality_report_objects": quality["objects"]},
+        "counts": {"total": len(candidates), "recommended": sum(x["recommended_for_ignition"] for x in candidates),
+                   "review_or_rejected": sum(not x["recommended_for_ignition"] for x in candidates)},
+        "objects": candidates,
+    }
+    write_json(args.output, payload)
+    print(json.dumps({"counts": payload["counts"], "top_recommended": [
+        {k: item[k] for k in ("object_id", "semantic_label", "material", "gaussian_count", "bbox_volume_m3")}
+        for item in candidates if item["recommended_for_ignition"]
+    ][:20]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
