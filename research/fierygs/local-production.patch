+"""Instrumented equivalent of FieryGS' native fire volume integrator.
+
+The default ``mapping='native'`` deliberately preserves the operations in
+``rendering.volume_utils.render_image_fire_smoke``.  Other mappings are
+render-only experiments and never mutate simulation arrays.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass, field
+
+import numpy as np
+import torch
+
+from rendering.volume_utils import interp_data, update_transmittance
+
+
+def _percentiles(values: np.ndarray) -> dict[str, float]:
+    values = np.asarray(values, dtype=np.float64).reshape(-1)
+    values = values[np.isfinite(values)]
+    if not values.size:
+        return {key: 0.0 for key in ("min", "median", "p90", "p95", "p99", "max")}
+    q = np.percentile(values, [0, 50, 90, 95, 99, 100])
+    return dict(zip(("min", "median", "p90", "p95", "p99", "max"), map(float, q)))
+
+
+def summarize(values: torch.Tensor | np.ndarray, include_saturation: bool = False) -> dict[str, float]:
+    if isinstance(values, torch.Tensor):
+        values = values.detach().float().cpu().numpy()
+    result = _percentiles(values)
+    if include_saturation:
+        finite = np.asarray(values)[np.isfinite(values)]
+        result["percentage_ge_1"] = float(100.0 * np.mean(finite >= 1.0)) if finite.size else 0.0
+        result["percentage_le_0"] = float(100.0 * np.mean(finite <= 0.0)) if finite.size else 0.0
+    return result
+
+
+def xyz_to_linear_rgb_unclipped(converter, xyz: torch.Tensor) -> torch.Tensor:
+    """Use FieryGS chromatic adaptation but omit sRGB transfer and clipping."""
+    shape = xyz.shape
+    lms = torch.matmul(xyz.reshape(-1, 3), converter.M_CAT02.T)
+    adapted = lms / converter.LMS_white
+    xyz_adapted = torch.matmul(adapted, converter.M_CAT02_inv.T)
+    return torch.matmul(xyz_adapted, converter.M_XYZ_to_sRGB.T).reshape(shape)
+
+
+def linear_to_srgb(linear: torch.Tensor) -> torch.Tensor:
+    linear = torch.clamp_min(linear, 0.0)
+    return torch.where(
+        linear <= 0.0031308,
+        12.92 * linear,
+        1.055 * torch.pow(linear, 1.0 / 2.4) - 0.055,
+    )
+
+
+def aces(linear: torch.Tensor) -> torch.Tensor:
+    a, b, c, d, e = 2.51, 0.03, 2.43, 0.59, 0.14
+    return torch.clamp((linear * (a * linear + b)) / (linear * (c * linear + d) + e), 0.0, 1.0)
+
+
+@dataclass
+class DiagnosticCollector:
+    strips: list[dict[str, np.ndarray]] = field(default_factory=list)
+
+    def add(self, **items: torch.Tensor) -> None:
+        self.strips.append({name: value.detach().float().cpu().numpy() for name, value in items.items()})
+
+    def summary(self) -> dict[str, dict[str, float]]:
+        names = self.strips[0].keys() if self.strips else []
+        result = {}
+        for name in names:
+            values = np.concatenate([strip[name].reshape(-1) for strip in self.strips])
+            result[name] = _percentiles(values)
+            if name in {"linear_rgb_unclipped", "rgb_before_display_mapping", "fire_rgb", "transmittance"}:
+                result[name]["percentage_ge_1"] = float(100.0 * np.mean(values >= 1.0))
+        return result
+
+
+def make_instrumented_renderer(
+    collector: DiagnosticCollector,
+    mapping: str = "native",
+    exposure: float = 1.0,
+):
+    """Return a drop-in volume renderer for monkey-patching the imported symbol."""
+
+    valid_mappings = {"native", "native_hdr_aces", "linear_exposure", "reinhard", "aces"}
+    if mapping not in valid_mappings:
+        raise ValueError(f"Unknown mapping {mapping!r}; expected {sorted(valid_mappings)}")
+
+    def render_image_fire_smoke(
+        rays_o, rays_d, num_samples, t_vals, query_tensor, temp_converter,
+        batch_size=1024, strength=0.01, sigma_a=0.1, is_norm_samples=False,
+        args=None, depth_map=None, debug_mask=False, scale_ratio=0.12,
+        smoke_color=(1.0, 1.0, 1.0), threshold=0.4, smoke_strengh=1.0,
+        exposure=1.0, render_smoke=True, fuel2temp=None, color_field=None,
+    ):
+        del debug_mask
+        num_batches = (num_samples + batch_size - 1) // batch_size
+        sum_xyz = torch.zeros_like(rays_o)
+        sum_smoke = torch.zeros_like(rays_o)
+        transmittance = torch.ones_like(rays_o[..., :1])
+        delta_t = t_vals[..., 1:] - t_vals[..., :-1]
+        delta_t = torch.cat([delta_t, delta_t[..., -1:]], dim=-1)
+        height, width = rays_o.shape[:2]
+        base_color_default = torch.tensor(smoke_color, device=rays_o.device)
+        temp_query_tensor = fuel2temp(query_tensor)
+
+        if depth_map is not None:
+            depth = depth_map.squeeze().view(height, width, 1)
+            valid_mask = t_vals <= depth
+        else:
+            valid_mask = torch.ones_like(t_vals, dtype=torch.bool)
+
+        for i in range(num_batches):
+            start, end = i * batch_size, min((i + 1) * batch_size, num_samples)
+            batch_mask = valid_mask[..., start:end]
+            points = rays_o.unsqueeze(2) + rays_d.unsqueeze(2) * t_vals[..., start:end].unsqueeze(-1)
+            if is_norm_samples:
+                minimum = torch.tensor(args.bounding_box["min"], dtype=torch.float32, device=points.device)
+                maximum = torch.tensor(args.bounding_box["max"], dtype=torch.float32, device=points.device)
+                points = ((points - minimum) / (maximum - minimum)) * 2.0 - 1.0
+
+            fuel = interp_data(points, query_tensor)
+            temperature = interp_data(points, temp_query_tensor)
+            xyz = temp_converter(temperature * scale_ratio)
+            density = copy.deepcopy(fuel)
+            density[density > 0] = sigma_a
+            sigma_a_dt = density * delta_t[..., start:end]
+            one_minus_sigma = 1 - sigma_a_dt
+            trans = transmittance * torch.cumprod(
+                torch.cat([torch.ones((height, width, 1), device=rays_o.device), one_minus_sigma[..., :-1]], -1), -1
+            )
+            if depth_map is not None:
+                xyz = xyz * batch_mask.unsqueeze(-1)
+            sum_xyz += torch.sum(trans.unsqueeze(-1) * xyz * strength * delta_t[..., start:end].unsqueeze(-1), dim=2)
+
+            smoke = copy.deepcopy(fuel)
+            smoke[smoke > threshold] = 0.0
+            smoke[smoke > 1e-3] = sigma_a
+            smoke_dt = smoke * delta_t[..., start:end]
+            base_color = interp_data(points, color_field) if color_field is not None else base_color_default
+            sum_smoke += torch.sum(
+                base_color * trans.unsqueeze(-1) * smoke_dt.unsqueeze(-1) * smoke_strengh * batch_mask.unsqueeze(-1), dim=-2
+            )
+            transmittance = update_transmittance(trans, batch_mask, transmittance)
+
+        linear_rgb = xyz_to_linear_rgb_unclipped(temp_converter, sum_xyz)
+        gamma_rgb_unclipped = linear_to_srgb(linear_rgb)
+        native_rgb_clipped = temp_converter.XYZ2RGB(sum_xyz)
+        if mapping == "native":
+            pre_display = native_rgb_clipped + (sum_smoke if render_smoke else 0.0)
+            fire_rgb = aces(pre_display * exposure) if render_smoke else native_rgb_clipped
+        elif mapping == "native_hdr_aces":
+            # Exact proposed low-cost recovery: preserve the existing CAT02 and
+            # sRGB conversion math, omit only its early clamp, then use the
+            # already released ACES curve at the same compositing location.
+            pre_display = gamma_rgb_unclipped + (sum_smoke if render_smoke else 0.0)
+            fire_rgb = aces(pre_display * exposure)
+        else:
+            # Both integrated XYZ emission (converted to linear sRGB) and the
+            # native smoke sum are still linear quantities here.  Combine them
+            # before applying exactly one candidate display mapping.
+            nonnegative = torch.clamp_min(linear_rgb * float(exposure), 0.0)
+            combined_linear = nonnegative + (sum_smoke if render_smoke else 0.0)
+            if mapping == "linear_exposure":
+                mapped_linear = torch.clamp(combined_linear, 0.0, 1.0)
+            elif mapping == "reinhard":
+                mapped_linear = combined_linear / (1.0 + combined_linear)
+            else:
+                mapped_linear = aces(combined_linear)
+            fire_rgb = torch.clamp(linear_to_srgb(mapped_linear), 0.0, 1.0)
+            pre_display = combined_linear
+
+        collector.add(
+            integrated_xyz=sum_xyz,
+            linear_rgb_unclipped=linear_rgb,
+            gamma_rgb_unclipped=gamma_rgb_unclipped,
+            native_rgb_after_early_clip=native_rgb_clipped,
+            smoke_rgb=sum_smoke,
+            rgb_before_display_mapping=pre_display,
+            fire_rgb=fire_rgb,
+            transmittance=transmittance,
+        )
+        return fire_rgb, transmittance
+
+    return render_image_fire_smoke
