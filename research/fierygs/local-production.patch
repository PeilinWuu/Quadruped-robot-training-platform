@@ -0,0 +1,53 @@
+"""Inspect a Gaussian PLY without modifying it."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from plyfile import PlyData
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("ply", type=Path)
+    parser.add_argument("--json", type=Path, default=None)
+    args = parser.parse_args()
+
+    ply = PlyData.read(args.ply, mmap=True)
+    vertex = ply["vertex"]
+    fields = [prop.name for prop in vertex.properties]
+    groups = {
+        "xyz": [name for name in fields if name in {"x", "y", "z"}],
+        "opacity": [name for name in fields if name == "opacity"],
+        "scale": sorted((name for name in fields if name.startswith("scale_")), key=lambda x: int(x.rsplit("_", 1)[1])),
+        "rotation": sorted((name for name in fields if name.startswith("rot_")), key=lambda x: int(x.rsplit("_", 1)[1])),
+        "sh_dc": sorted((name for name in fields if name.startswith("f_dc_")), key=lambda x: int(x.rsplit("_", 1)[1])),
+        "sh_rest": sorted((name for name in fields if name.startswith("f_rest_")), key=lambda x: int(x.rsplit("_", 1)[1])),
+    }
+    sh_degree = int(round(np.sqrt((len(groups["sh_rest"]) + 3) / 3) - 1))
+    required_counts = {"xyz": 3, "opacity": 1, "scale": 3, "rotation": 4, "sh_dc": 3}
+    compatible = all(len(groups[key]) == count for key, count in required_counts.items())
+    compatible &= len(groups["sh_rest"]) == 3 * (sh_degree + 1) ** 2 - 3
+    result = {
+        "path": str(args.ply.resolve()),
+        "format": str(ply.text and "ascii" or "binary"),
+        "byte_order": ply.byte_order,
+        "gaussian_count": len(vertex.data),
+        "fields": fields,
+        "field_shapes": {name: list(np.asarray(vertex[name]).shape) for name in fields},
+        "groups": groups,
+        "inferred_sh_degree": sh_degree,
+        "compatible_with_gaussian_model_load_ply": compatible,
+    }
+    output = json.dumps(result, indent=2, ensure_ascii=False)
+    print(output)
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(output + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
