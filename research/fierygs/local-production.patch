+"""Resumable aligned FieryGS Dataset v1 renderer.
+
+RGB uses the frozen production path. Depth is static solid-scene depth. Fire and
+smoke masks come from ray-marched volumetric contributions, never RGB thresholds.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+import traceback
+from argparse import Namespace
+from collections import Counter
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+
+from adapter.create_scene import camera_from_json
+from adapter.fire_scenario.common import MATERIALS
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.render_gaussian_maps import gaussian_id_map
+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+DEFAULT_PLY = Path(r"D:\interiorgs_data\office_01\3dgs_explicit.ply")
+DEFAULT_VOXEL_DIR = Path(
+    r"D:\interiorgs_data\office_01\fire_scenarios\office_table_fire\voxel"
+)
+DEFAULT_LABEL_ROOT = Path(r"D:\interiorgs_data\office_01\semantic_bridge_all")
+REQUIRED_OUTPUT_KEYS = (
+    "rgb",
+    "depth",
+    "semantic",
+    "fire_contribution",
+    "fire_binary",
+    "smoke_contribution",
+    "smoke_binary",
+    "metadata",
+)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    parser.add_argument("--manifest", type=Path)
+    parser.add_argument("--ply", type=Path, default=DEFAULT_PLY)
+    parser.add_argument("--voxel-dir", type=Path, default=DEFAULT_VOXEL_DIR)
+    parser.add_argument("--label-root", type=Path, default=DEFAULT_LABEL_ROOT)
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--limit", type=int)
+    parser.add_argument("--sample-id", action="append", help="Repeat to select multiple exact sample IDs")
+    parser.add_argument("--scenario")
+    parser.add_argument("--fire-threshold", type=float, default=1e-5)
+    parser.add_argument("--smoke-threshold", type=float, default=1e-4)
+    parser.add_argument("--coarse-samples", type=int, default=64)
+    parser.add_argument("--fine-samples", type=int, default=512)
+    return parser.parse_args()
+
+
+def read_jsonl(path: Path) -> list[dict]:
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]
+
+
+def complete(sample: dict) -> bool:
+    return all(Path(sample["outputs"][key]).is_file() and Path(sample["outputs"][key]).stat().st_size > 0
+               for key in REQUIRED_OUTPUT_KEYS)
+
+
+def save_binary(path: Path, mask: np.ndarray) -> None:
+    Image.fromarray(mask.astype(np.uint8) * 255, mode="L").save(path)
+
+
+def save_report(path: Path, report: dict) -> None:
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    temporary.replace(path)
+
+
+def main() -> None:
+    args = parse_args()
+    if args.fire_threshold <= 0 or args.smoke_threshold <= 0:
+        raise ValueError("Contribution thresholds must be positive")
+    manifest_path = args.manifest or args.dataset_root / "manifests" / "dataset_v1_manifest.jsonl"
+    samples = read_jsonl(manifest_path)
+    if args.sample_id:
+        requested_ids = set(args.sample_id)
+        samples = [sample for sample in samples if sample["sample_id"] in requested_ids]
+    if args.scenario:
+        samples = [sample for sample in samples if sample["scenario"] == args.scenario]
+    if args.limit is not None:
+        samples = samples[: args.limit]
+    if not samples:
+        raise RuntimeError("No samples selected")
+
+    for directory in ("rgb", "depth", "semantic", "fire_masks", "smoke_masks", "metadata/samples", "reports"):
+        (args.dataset_root / directory).mkdir(parents=True, exist_ok=True)
+
+    labels = {
+        "instance": np.load(args.label_root / "gaussian_instance_ids.npy", mmap_mode="r"),
+        "part": np.load(args.label_root / "points_label_mulscale.npy", mmap_mode="r"),
+        "material": np.load(args.label_root / "points_materials.npy", mmap_mode="r"),
+        "burnability": np.load(args.label_root / "points_burnability.npy", mmap_mode="r"),
+    }
+    gaussians = load_interiorgs_gaussians(args.ply)
+    gaussian_count = int(gaussians.get_xyz.shape[0])
+    if any(array.shape != (gaussian_count,) for array in labels.values()):
+        raise ValueError("Semantic arrays do not match Gaussian count")
+
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mapped_mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    gaussian_rows = torch.nonzero(mapped_mask, as_tuple=False).squeeze(1)
+    voxel_report = json.loads((args.voxel_dir / "material_voxel_report.json").read_text(encoding="utf-8"))
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    render_args = Namespace(
+        dual_smoke=True,
+        hdr_aces=False,
+        near=0.1,
+        far=6.0,
+        num_samples_coarse=args.coarse_samples,
+        num_samples_fine=args.fine_samples,
