@@ -0,0 +1,52 @@
+"""Build initial combustible solid-air surface diagnostics for bounded sources."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import save_voxel_ply
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--available-grid", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    available = np.load(args.available_grid) > 0
+    air_neighbor = np.zeros_like(available, dtype=bool)
+    padded = np.pad(available, 1, constant_values=False)
+    for axis in range(3):
+        for sign in (-1, 1):
+            shift = [1, 1, 1]
+            shift[axis] += sign
+            sl = tuple(slice(shift[d], shift[d] + available.shape[d]) for d in range(3))
+            air_neighbor |= ~padded[sl]
+    surface = available & air_neighbor
+    interior = available & ~surface
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "solid_surface_source_mask.npy", surface.astype(np.uint8))
+    report = json.loads(args.voxel_report.read_text(encoding="utf-8"))
+    lower = np.asarray(report["bounding_box"]["min"], dtype=float)
+    size = float(report["voxel_size_m"])
+    save_voxel_ply(surface, lower, size, args.output_dir / "solid_surface_source_candidates.ply", (255, 130, 20))
+    np.save(args.output_dir / "solid_surface_source_preview.npy", surface.astype(np.uint8))
+    result = {
+        "surface_source_candidate_count": int(surface.sum()),
+        "interior_combustible_voxel_count": int(interior.sum()),
+        "total_combustible_voxels": int(available.sum()),
+        "surface_fraction": float(surface.sum() / max(available.sum(), 1)),
+        "connectivity": 6,
+        "air_neighbor_definition": "at least one of +/-x,+/-y,+/-z has available-grid value <= 0",
+        "artifacts": ["solid_surface_source_mask.npy", "solid_surface_source_candidates.ply"],
+    }
+    (args.output_dir / "surface_source_report.json").write_text(json.dumps(result, indent=2), encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
