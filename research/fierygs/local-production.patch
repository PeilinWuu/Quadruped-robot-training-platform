@@ -0,0 +1,80 @@
+"""Compare sustained-source and paper-faithful initial-only ignition states."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def bounds(field: np.ndarray, threshold: float = 1e-3) -> dict:
+    active = np.argwhere(field > threshold)
+    if not len(active):
+        return {"active_voxels": 0, "bbox_extent_voxels": [0, 0, 0], "vertical_to_horizontal": 0.0}
+    extent = active.max(0) - active.min(0) + 1
+    horizontal = np.sqrt(extent[0] * extent[1])
+    return {"active_voxels": int(len(active)), "bbox_min": active.min(0).tolist(),
+            "bbox_max": active.max(0).tolist(), "bbox_extent_voxels": extent.tolist(),
+            "vertical_to_horizontal": float(extent[2] / max(horizontal, 1e-12))}
+
+
+def load(directory: Path, field: str, frame: int) -> np.ndarray:
+    return np.load(directory / field / f"{field}_{frame}.npz")["arr_0"]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--sustained-dir", type=Path, required=True)
+    parser.add_argument("--initial-only-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    frames = [0, 1, 5, 10, 20, 40, 59]
+    records = []
+    for frame in frames:
+        modes = {}
+        for name, directory in (("sustained_source", args.sustained_dir), ("initial_only", args.initial_only_dir)):
+            fields = {field: load(directory, field, frame) for field in ("fuel", "temperature", "occupancy", "wood_temperature")}
+            modes[name] = {
+                "fuel": {**bounds(fields["fuel"]), "maximum": float(fields["fuel"].max()), "sum": float(fields["fuel"].sum())},
+                "temperature": {**bounds(fields["temperature"]), "maximum": float(fields["temperature"].max())},
+                "occupancy": {"nonzero": int(np.count_nonzero(fields["occupancy"])), "sum": float(fields["occupancy"].sum()),
+                              "consumed_sum_from_initial": None},
+                "wood_temperature": {**bounds(fields["wood_temperature"]), "maximum": float(fields["wood_temperature"].max())},
+            }
+        for name in modes:
+            first = load(args.sustained_dir if name == "sustained_source" else args.initial_only_dir, "occupancy", 0)
+            current = load(args.sustained_dir if name == "sustained_source" else args.initial_only_dir, "occupancy", frame)
+            modes[name]["occupancy"]["consumed_sum_from_initial"] = float(first.sum() - current.sum())
+        records.append({"frame": frame, "modes": modes})
+
+    report = {
+        "finding": "The exact ignition mask is applied once, but legacy update_coef restores Y=1 every solver step for every hot occupied solid voxel. This is indirect continuous reaction-coordinate injection.",
+        "classification": "B: sustained source through hot-solid coupling",
+        "call_graph": [
+            "AuditedLongFireSolver.run()",
+            "FireSolver.reset(): sets coef/reaction coordinate and gas temperature to zero",
+            "ScenarioFireSolver.init_wood(): loads exact mask once; sets material temperature; initial_only additionally seeds both coef_pair slots once",
+            "for each frame -> FireSolver.step()",
+            "advect coef_pair",
+            "update_wood_temperature(): hot cells remain clamped to T_max_wood",
+            "update_occupancy(): consumes hot solid",
+            "sustained_source -> update_coef(): hot occupied cells set Y=1 every step",
+            "initial_only -> decay_coef_initial_only(): only advected Y decays by k*dt",
+            "update_temperature(): derives gas temperature from Y",
+        ],
+        "temperature_forcibly_reset_each_step_in_ignition_cells": False,
+        "fuel_continuously_injected": True,
+        "reaction_coordinate_continuously_restored": True,
+        "occupancy_used_as_persistent_source_gate": True,
+        "compatibility": "Legacy YAMLs without ignition_lifetime remain sustained_source. New scenario schema defaults to initial_only and emits the key explicitly.",
+        "comparison": records,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(args.output.resolve())
+
+
+if __name__ == "__main__":
+    main()
