new file mode 100644
index 0000000..f5b5386
--- /dev/null
+++ b/adapter/fire_scenario/common.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+import yaml
+from PIL import Image, ImageDraw
+from plyfile import PlyData, PlyElement
+from adapter.fire_scenario.fire_level_presets import apply_fire_level
+
+
+MATERIALS = [
+    "wood", "sand", "leather", "plastic", "glass", "fabric", "foam", "food",
+    "composite", "paper", "metal", "plant", "stone", "soil", "concrete",
+    "cement", "clay", "ceramic", "sky",
+]
+MATERIAL_TO_ID = {name: index for index, name in enumerate(MATERIALS)}
+BURNABLE_MATERIALS = {"wood", "leather", "plastic", "fabric", "foam", "food", "paper", "plant"}
+UNBURNABLE_MATERIALS = {"sand", "glass", "metal", "stone", "soil", "concrete", "cement", "clay", "ceramic", "sky"}
+
+
+def timestamp() -> str:
+    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")
+
+
+def load_scenario(path: Path) -> dict:
+    scenario = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if "fire_level" in scenario or "simulation" in scenario:
+        scenario = apply_fire_level(scenario)
+    ignition = scenario.setdefault("ignition", {})
+    ignition.setdefault("distribution", "compact_patches")
+    if ignition["distribution"] != "compact_patches":
+        raise ValueError("The current adapter supports ignition.distribution=compact_patches")
+    scenario.setdefault("ignition_lifetime", "initial_only")
+    if scenario["ignition_lifetime"] not in {"initial_only", "sustained_source"}:
+        raise ValueError("ignition_lifetime must be initial_only or sustained_source")
+    scenario.setdefault("source_mode", "initial_only" if scenario["ignition_lifetime"] == "initial_only" else "native_reignite")
+    scenario.setdefault("source_model", "state_based")
+    scenario.setdefault("source_eta", 0.0)
+    if "mode" in ignition:
+        scenario.setdefault("ignition_mode", ignition["mode"])
+    if "surface_layers" in ignition:
+        ignition.setdefault("surface_depth_voxels", ignition["surface_layers"])
+    if "simulation" in scenario:
+        scenario.setdefault("duration", scenario["simulation"]["frames"])
+    render = scenario.setdefault("render", {})
+    environment = scenario.setdefault("environment", {})
+    environment.setdefault("wind", {"x": 0.0, "y": 0.0, "z": 0.0})
+    environment.setdefault("smoke_strength", float(render.get("smoke_strength", 1.0)))
+    scenario.setdefault("fire_parameters", {"fuel_scale": 1.0})
+    # Scenario-facing physical names map onto the terse native solver keys.
+    # Existing solver_parameters remain valid and take precedence when both
+    # spellings are supplied, preserving every prior scenario exactly.
+    physics = scenario.setdefault("physics", {})
+    solver = scenario.setdefault("solver_parameters", {})
+    aliases = {
+        "fuel_decay_k": "k", "buoyancy_alpha": "alpha",
+        "thermal_diffusivity_beta": "beta", "vorticity_epsilon": "epsilon",
+        "viscosity_nu": "nu", "burn_rate": "burn_rate",
+    }
+    for descriptive, native in aliases.items():
+        if native not in solver and descriptive in physics:
+            solver[native] = physics[descriptive]
+    scenario.setdefault("initial_temperature", 1200.0)
+    scenario.setdefault("seed", 0)
+    scenario.setdefault("propagation", {"enabled": True, "allowed_object_ids": "auto", "blocked_object_ids": []})
+    required = ["name", "ignition", "ignition_mode", "initial_temperature", "duration", "environment", "fire_parameters"]
+    missing = [key for key in required if key not in scenario]
+    if missing:
+        raise ValueError(f"Scenario is missing required keys: {missing}")
+    object_ids = scenario["ignition"].get("object_ids", [])
+    if not object_ids:
+        raise ValueError("Scenario ignition.object_ids must not be empty")
+    supported_modes = {"object_center", "object_top_surface"}
+    if scenario["ignition_mode"] not in supported_modes:
+        raise ValueError(f"The current adapter supports ignition_mode values: {sorted(supported_modes)}")
+    for key in ("k", "alpha", "beta", "epsilon", "nu", "burn_rate"):
+        if key in solver and float(solver[key]) < 0:
+            raise ValueError(f"solver parameter {key} must be non-negative")
+    return scenario
+
+
+def metadata(scenario: dict, gaussian_count: int, sources: list[Path | str]) -> dict:
+    return {
+        "scenario_name": scenario["name"], "timestamp": timestamp(),
+        "gaussian_count": int(gaussian_count),
+        "source_files": [str(Path(source).resolve()) for source in sources],
+    }
+
+
+def write_json(path: Path, payload: dict | list) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+
+def save_voxel_ply(mask: np.ndarray, lower: np.ndarray, voxel_size: float, path: Path,
+                   color: tuple[int, int, int]) -> None:
+    indices = np.argwhere(mask > 0)
+    centers = lower + (indices + 0.5) * voxel_size
+    data = np.empty(len(centers), dtype=[
+        ("x", "f4"), ("y", "f4"), ("z", "f4"),
+        ("red", "u1"), ("green", "u1"), ("blue", "u1"),
+    ])
+    data["x"], data["y"], data["z"] = centers[:, 0], centers[:, 1], centers[:, 2]
+    data["red"], data["green"], data["blue"] = color
+    PlyData([PlyElement.describe(data, "vertex")]).write(str(path))
+
+
+def save_voxel_preview(available: np.ndarray, ignition: np.ndarray, path: Path) -> None:
+    projections = [
+        (available.max(axis=2).T[::-1], ignition.max(axis=2).T[::-1], "XY top"),
+        (available.max(axis=1).T[::-1], ignition.max(axis=1).T[::-1], "XZ front"),
+        (available.max(axis=0).T[::-1], ignition.max(axis=0).T[::-1], "YZ side"),
+    ]
+    panels = []
+    for fuel, ignite, label in projections:
+        scale = max(1, 512 // max(fuel.shape))
+        rgb = np.zeros((*fuel.shape, 3), dtype=np.uint8)
+        rgb[fuel > 0] = (230, 132, 34)
+        rgb[ignite > 0] = (255, 40, 40)
+        image = Image.fromarray(rgb).resize((rgb.shape[1] * scale, rgb.shape[0] * scale), Image.Resampling.NEAREST)
+        canvas = Image.new("RGB", (image.width, image.height + 24), (8, 12, 16))
+        canvas.paste(image, (0, 0))
+        ImageDraw.Draw(canvas).text((6, image.height + 5), label, fill=(220, 228, 235))
+        panels.append(canvas)
+    output = Image.new("RGB", (sum(panel.width for panel in panels), max(panel.height for panel in panels)), (8, 12, 16))
+    x = 0
+    for panel in panels:
+        output.paste(panel, (x, 0)); x += panel.width
+    output.save(path)
