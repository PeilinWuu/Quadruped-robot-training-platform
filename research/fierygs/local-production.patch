+"""Record native renderer carbonization spatial and semantic distributions."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+RUNS = {
+    "table_medium": "office_table_medium",
+    "table_high": "office_table_high",
+    "sofa_high": "office_sofa_high",
+    "curtain_high": "office_curtain_high",
+}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--batch-validation", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy().astype(bool)
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    labels = np.load(args.labels)[mask]
+    scenarios = []
+    for family, validation_name in RUNS.items():
+        sim = args.root / family / "run_200/sim_output"
+        initial = np.load(args.batch_validation / validation_name / "available_fuel_grid.npy")
+        mapped_initial = initial[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+        records, first = [], None
+        for frame in range(200):
+            occ = np.load(sim / "occupancy" / f"occupancy_{frame}.npz")["arr_0"]
+            mapped = occ[indices[:, 0], indices[:, 1], indices[:, 2]]
+            carbon = mapped_initial & (mapped < 0.7)
+            coords = np.unique(indices[carbon], axis=0)
+            ids, counts = np.unique(labels[carbon], return_counts=True)
+            object_counts = {str(int(i)): int(c) for i, c in zip(ids, counts)}
+            if np.any(carbon) and first is None:
+                first = frame
+            records.append({
+                "frame": frame, "carbonized_gaussian_count": int(np.count_nonzero(carbon)),
+                "carbonized_voxel_count": int(len(coords)),
+                "voxel_bbox_min": coords.min(0).tolist() if len(coords) else None,
+                "voxel_bbox_max": coords.max(0).tolist() if len(coords) else None,
+                "minimum_mapped_occupancy": float(mapped[carbon].min()) if np.any(carbon) else None,
+                "mean_mapped_occupancy": float(mapped[carbon].mean()) if np.any(carbon) else None,
+                "object_gaussian_counts": object_counts,
+            })
+        scenarios.append({"scenario": family, "first_carbonized_frame": first, "frames": records,
+                          "final": records[-1]})
+    payload = {
+        "metadata": {"scenario_name": "office_01_long_run_carbonization", "timestamp": timestamp(),
+                     "source_files": [str(args.voxel_dir.resolve()), str(args.labels.resolve())]},
+        "criterion": "mapped voxel was initially combustible and current native occupancy < 0.7",
+        "relationship": "occupancy is consumed only where native wood_temperature >= 1.0; renderer marks mapped Gaussians below 0.7 as carbonized/removed",
+        "scenarios": scenarios,
+    }
+    write_json(args.output, payload)
+    print(json.dumps({x["scenario"]: {"first": x["first_carbonized_frame"],
+                                     "final_gaussians": x["final"]["carbonized_gaussian_count"],
+                                     "final_voxels": x["final"]["carbonized_voxel_count"]} for x in scenarios}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
