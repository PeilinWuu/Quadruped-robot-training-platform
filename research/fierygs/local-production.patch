diff --git a/tools/prepare_interiorgs_scene.py b/tools/prepare_interiorgs_scene.py
new file mode 100644
index 0000000..8cacf1b
--- /dev/null
+++ b/tools/prepare_interiorgs_scene.py
@@ -0,0 +1,128 @@
+"""Build FieryGS voxel coupling files from one InteriorGS scene and fire ROI."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+from plyfile import PlyData
+
+
+def bounds_from_box(points: list[dict[str, float]]) -> tuple[np.ndarray, np.ndarray]:
+    xyz = np.asarray([[point[axis] for axis in ("x", "y", "z")] for point in points], dtype=np.float64)
+    return xyz.min(axis=0), xyz.max(axis=0)
+
+
+def save_preview(voxels: np.ndarray, ignition_min: np.ndarray, ignition_max: np.ndarray, path: Path) -> None:
+    projections = [
+        voxels.max(axis=2).T[::-1],
+        voxels.max(axis=1).T[::-1],
+        voxels.max(axis=0).T[::-1],
+    ]
+    labels = ["XY top", "XZ front", "YZ side"]
+    canvas = Image.new("RGB", (128 * 3, 152), (9, 14, 18))
+    draw = ImageDraw.Draw(canvas)
+    for index, (projection, label) in enumerate(zip(projections, labels)):
+        tile = np.zeros((128, 128, 3), dtype=np.uint8)
+        tile[projection > 0] = (236, 172, 65)
+        canvas.paste(Image.fromarray(tile), (index * 128, 0))
+        draw.text((index * 128 + 5, 134), label, fill=(210, 225, 232))
+    # Ignition bounds are recorded in diagnostics; the preview remains an unambiguous fuel-only view.
+    canvas.save(path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--scene-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--box-padding", type=float, default=0.03)
+    args = parser.parse_args()
+
+    scene_dir = args.scene_dir.resolve()
+    output_dir = args.output_dir.resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    roi = json.loads((scene_dir / "fire_roi.json").read_text(encoding="utf-8"))
+    labels = json.loads((scene_dir / "labels.json").read_text(encoding="utf-8"))
+    grid = roi["grid"]
+    dims = np.asarray(grid["dimensions"], dtype=np.int64)
+    lower = np.asarray(grid["lower"], dtype=np.float64)
+    upper = np.asarray(grid["upper"], dtype=np.float64)
+    voxel_size = float(grid["voxel_size_m"])
+    expected_upper = lower + dims * voxel_size
+    if not np.allclose(upper, expected_upper, atol=1e-6):
+        raise ValueError(f"ROI upper bound {upper} does not match lower+dims*voxel_size {expected_upper}")
+
+    ply = PlyData.read(str(scene_dir / "3dgs_explicit.ply"), mmap="r")
+    vertex = ply["vertex"].data
+    xyz = np.column_stack((vertex["x"], vertex["y"], vertex["z"])).astype(np.float64, copy=False)
+    total_gaussians = xyz.shape[0]
+
+    roi_mask = np.all((xyz >= lower) & (xyz < upper), axis=1)
+    selected_ids = set(roi["primary_combustible_instances"])
+    combustible_mask = np.zeros(total_gaussians, dtype=bool)
+    instance_counts: dict[str, dict[str, int | str]] = {}
+    padding = float(args.box_padding)
+    for item in labels:
+        instance_id = str(item.get("ins_id", ""))
+        if instance_id not in selected_ids or "bounding_box" not in item:
+            continue
+        box_lower, box_upper = bounds_from_box(item["bounding_box"])
+        inside = np.all((xyz >= box_lower - padding) & (xyz <= box_upper + padding), axis=1) & roi_mask
+        combustible_mask |= inside
+        instance_counts[instance_id] = {"label": item["label"], "gaussians_in_box": int(inside.sum())}
+
+    grid_indices = np.floor((xyz[combustible_mask] - lower) / voxel_size).astype(np.int64)
+    valid = np.all((grid_indices >= 0) & (grid_indices < dims), axis=1)
+    if not np.all(valid):
+        raise RuntimeError(f"{int((~valid).sum())} selected Gaussian indices fell outside the configured grid")
+
+    voxel_grid = np.zeros(tuple(dims.tolist()), dtype=np.int32)
+    voxel_grid[grid_indices[:, 0], grid_indices[:, 1], grid_indices[:, 2]] = 1
+
+    ignition = roi["ignition"]
+    ignition_min = np.floor((np.asarray(ignition["lower"]) - lower) / voxel_size).astype(np.int64)
+    ignition_max = np.ceil((np.asarray(ignition["upper"]) - lower) / voxel_size).astype(np.int64)
+    ignition_min = np.clip(ignition_min, 0, dims - 1)
+    ignition_max = np.clip(ignition_max, ignition_min + 1, dims)
+    ignition_fuel_voxels = int(voxel_grid[
+        ignition_min[0]:ignition_max[0],
+        ignition_min[1]:ignition_max[1],
+        ignition_min[2]:ignition_max[2],
+    ].sum())
+
+    np.save(output_dir / "voxel_grid.npy", voxel_grid)
+    torch.save(torch.from_numpy(grid_indices), output_dir / "indices_pts_in_grids.pth")
+    torch.save(torch.from_numpy(combustible_mask), output_dir / "mask_pts_in_grids.pth")
+    save_preview(voxel_grid, ignition_min, ignition_max, output_dir / "voxel_preview.png")
+
+    diagnostics = {
+        "total_gaussians": total_gaussians,
+        "gaussians_in_roi": int(roi_mask.sum()),
+        "combustible_gaussians": int(combustible_mask.sum()),
+        "occupied_voxels": int(voxel_grid.sum()),
+        "occupancy_ratio": float(voxel_grid.mean()),
+        "grid_dimensions": dims.tolist(),
+        "voxel_size_m": voxel_size,
+        "bounding_box": {"min": lower.tolist(), "max": upper.tolist()},
+        "ignition_box_indices": {"min": ignition_min.tolist(), "max_exclusive": ignition_max.tolist()},
+        "ignition_fuel_voxels": ignition_fuel_voxels,
+        "box_padding_m": padding,
+        "instances": instance_counts,
+    }
+    (output_dir / "preprocess_diagnostics.json").write_text(
+        json.dumps(diagnostics, indent=2, ensure_ascii=False), encoding="utf-8"
+    )
+    print(json.dumps(diagnostics, indent=2, ensure_ascii=False))
+    if combustible_mask.sum() == 0 or voxel_grid.sum() == 0:
+        raise RuntimeError("No combustible Gaussian or voxel was generated")
+    if ignition_fuel_voxels == 0:
+        raise RuntimeError("Ignition box does not intersect any combustible voxel")
+
+
+if __name__ == "__main__":
+    main()
