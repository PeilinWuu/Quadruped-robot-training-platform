+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from .quality_validator import analyze_scenario
+
+
+class QualityValidatorTest(unittest.TestCase):
+    def test_pass_and_metadata(self):
+        with tempfile.TemporaryDirectory() as td:
+            root = Path(td) / "demo"
+            root.mkdir()
+            (root / "scenario_result.json").write_text(json.dumps({
+                "scenario_name": "demo", "ignition_object": 7,
+                "category": "table", "material": "wood", "severity": "HIGH",
+                "success": True, "propagation_targets": [{"target_id": 8}],
+            }), encoding="utf-8")
+            np.save(root / "temperature_000.npy", np.zeros((2, 2, 2), dtype=np.float32))
+            np.save(root / "temperature_001.npy", np.ones((2, 2, 2), dtype=np.float32))
+            np.save(root / "fuel_000.npy", np.ones((2, 2, 2), dtype=np.float32))
+            np.save(root / "occupancy_000.npy", np.ones((2, 2, 2), dtype=np.float32))
+            np.save(root / "occupancy_001.npy", np.zeros((2, 2, 2), dtype=np.float32))
+            report = analyze_scenario(root)
+            self.assertEqual(report["status"], "WARNING")  # carbonization unavailable
+            self.assertEqual(report["ignition_object"], 7)
+            self.assertEqual(report["occupancy_reduction"], 8.0)
+
+
+if __name__ == "__main__":
+    unittest.main()
