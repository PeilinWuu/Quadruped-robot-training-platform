+    color_path.write_text(json.dumps(color, indent=2) + "\n", encoding="utf-8")
+
+    smoke_path = report_dir / "smoke_ablation.json"
+    smoke = json.loads(smoke_path.read_text(encoding="utf-8"))
+    smoke["scalar_smoke_diagnostic"] = {
