+"""Prepare frozen FieryGS simulation configs and the Dataset v1 scenario manifest."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import yaml
+
+
+DATASET_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+WORK_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1_work")
+VALIDATION_ROOT = Path(r"D:\interiorgs_data\office_01\fire_scenarios_batch\validation")
+SCENARIO_ROOT = Path(r"D:\interiorgs_data\office_01\fire_scenarios_batch\scenarios\generated")
+PRODUCTION_ROOT = Path(r"D:\interiorgs_data\office_01\production_regression")
+CONFIG_ROOT = Path(__file__).resolve().parent / "configs"
+
+OBJECTS = ("table", "sofa", "curtain")
+LEVEL_FRAMES = {"low": 60, "medium": 120, "high": 200}
+LEVELS = tuple(LEVEL_FRAMES)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DATASET_ROOT)
+    parser.add_argument("--work-root", type=Path, default=WORK_ROOT)
+    return parser.parse_args()
+
+
+def npz_count(directory: Path, field: str) -> int:
+    field_dir = directory / field
+    return len(list(field_dir.glob(f"{field}_*.npz"))) if field_dir.is_dir() else 0
+
+
+def main() -> None:
+    args = parse_args()
+    manifest_dir = args.dataset_root / "manifests"
+    manifest_dir.mkdir(parents=True, exist_ok=True)
+    CONFIG_ROOT.mkdir(parents=True, exist_ok=True)
+
+    scenarios = []
+    for object_name in OBJECTS:
+        for level in LEVELS:
+            short_name = f"{object_name}_{level}"
+            full_name = f"office_{short_name}"
+            frame_count = LEVEL_FRAMES[level]
+            design_path = SCENARIO_ROOT / f"{full_name}.yaml"
+            validation_dir = VALIDATION_ROOT / full_name
+            source_config_path = validation_dir / "fierygs_solver_config.yaml"
+            if not design_path.is_file() or not source_config_path.is_file():
+                raise FileNotFoundError(f"Missing scenario inputs for {full_name}")
+
+            design = yaml.safe_load(design_path.read_text(encoding="utf-8"))
+            config = yaml.safe_load(source_config_path.read_text(encoding="utf-8"))
+            if level == "high":
+                simulation_dir = PRODUCTION_ROOT / short_name / "sim_output"
+                simulation_origin = "production_regression_reuse"
+            else:
+                simulation_dir = args.work_root / "simulations" / short_name / "sim_output"
+                simulation_origin = "dataset_v1_production_precompute"
+
+            config.update(
+                {
+                    "scene": f"{full_name}_dataset_v1",
+                    "fire_sim_root": simulation_dir.as_posix(),
+                    "sim_frames": frame_count,
+                    "save_npz": True,
+                    "save_vti": False,
+                    "dual_smoke": True,
+                    "render_smoke": True,
+                    "smoke_strength": 0.2,
+                    "ignition_lifetime": "sustained_source",
+                    "source_mode": "native_reignite",
+                }
+            )
+            config_path = CONFIG_ROOT / f"{short_name}_production.yaml"
+            config_path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
+
+            counts = {
+                field: npz_count(simulation_dir, field)
+                for field in ("fuel", "temperature", "occupancy", "wood_temperature", "color")
+            }
+            complete = all(count == frame_count for count in counts.values())
+            scenarios.append(
+                {
+                    "scenario_id": short_name,
+                    "scenario_name": full_name,
+                    "ignition_object": object_name,
+                    "ignition_object_ids": design["ignition"]["object_ids"],
+                    "object_metadata": design["object_metadata"],
+                    "fire_level": level,
+                    "simulation_seed": int(design["seed"]),
+                    "simulation_frames": frame_count,
+                    "target_temporal_states": 15,
+                    "target_cameras_per_state": 8,
+                    "expected_samples": 120,
+                    "simulation_dir": str(simulation_dir.resolve()),
+                    "simulation_config": str(config_path.resolve()),
+                    "simulation_origin": simulation_origin,
+                    "simulation_field_counts": counts,
+                    "simulation_complete": complete,
+                    "validation_dir": str(validation_dir.resolve()),
+                    "initial_occupancy": str((validation_dir / "fuel_occupancy_initial.npy").resolve()),
+                    "ignition_mask": str((validation_dir / "ignition_voxel_mask.npy").resolve()),
+                    "design_file": str(design_path.resolve()),
+                }
+            )
+
+    payload = {
+        "dataset_name": "robot_fire_dataset_v1",
+        "scenario_count": len(scenarios),
+        "expected_sample_count": sum(item["expected_samples"] for item in scenarios),
+        "production_profile": {
+            "source_mode": "native_reignite",
+            "xyz2rgb_clip_output": True,
+            "hdr_aces": False,
+            "strength": 0.005,
+            "smoke_strength": 0.2,
+            "render_seed": 42,
+            "coarse_samples": 64,
+            "fine_samples": 512,
+        },
+        "temporal_policy": {
+            "stages": ["ignition", "early", "established", "spread", "late"],
+            "states_per_stage": 3,
+            "states_per_scenario": 15,
+        },
+        "camera_policy": {"cameras_per_state": 8, "seed": 42},
+        "scenarios": scenarios,
+    }
+    output = manifest_dir / "scenario_manifest.json"
+    output.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "output": str(output.resolve()),
+                "scenarios": len(scenarios),
+                "complete_simulations": sum(item["simulation_complete"] for item in scenarios),
+                "pending_simulations": [item["scenario_id"] for item in scenarios if not item["simulation_complete"]],
+                "expected_samples": payload["expected_sample_count"],
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
