+"""Diagnose the optional XYZ2RGB HDR regression on existing FieryGS frames.
+
+The simulation is read-only.  Every path preserves the repository's original
+CAT02 -> linear sRGB -> sRGB transfer ordering and changes only the post-gamma
+clamp/exposure immediately before the existing ACES curve.
+"""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import json
+import sys
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from adapter.create_scene import create_scene
+from gaussian_renderer import renderer_with_fire as fire_renderer
+from rendering.volume_utils import interp_data, update_transmittance
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+
+
+def aces(value: torch.Tensor) -> torch.Tensor:
+    a, b, c, d, e = 2.51, 0.03, 2.43, 0.59, 0.14
+    return torch.clamp((value * (a * value + b)) / (value * (c * value + d) + e), 0.0, 1.0)
+
+
+def channel_stats(value: torch.Tensor) -> dict:
+    array = value.detach().float().cpu().numpy()
+    flat = array[np.isfinite(array)]
+    percentiles = np.percentile(flat, [0, 50, 90, 95, 99, 100])
+    return {
+        "min": float(percentiles[0]), "max": float(percentiles[5]),
+        "p50": float(percentiles[1]), "p90": float(percentiles[2]),
+        "p95": float(percentiles[3]), "p99": float(percentiles[4]),
+        "channel_fraction_lt_0": float(np.mean(flat < 0)),
+        "pixel_fraction_any_negative": float(np.mean(np.any(array < 0, axis=-1))),
+        "channel_fraction_gt_1": float(np.mean(flat > 1)),
+        "channel_fraction_gt_2": float(np.mean(flat > 2)),
+        "channel_fraction_gt_5": float(np.mean(flat > 5)),
+        "channel_fraction_gt_10": float(np.mean(flat > 10)),
+    }
+
+
+def rgb_to_hue_metrics(rgb: np.ndarray, mask: np.ndarray) -> dict:
+    pixels = np.clip(rgb[mask], 0.0, 1.0)
+    maximum, minimum = pixels.max(axis=1), pixels.min(axis=1)
+    delta = maximum - minimum
+    saturation = np.divide(delta, maximum, out=np.zeros_like(delta), where=maximum > 1e-8)
+    hue = np.zeros_like(maximum)
+    chromatic = delta > 1e-8
+    red = chromatic & (maximum == pixels[:, 0])
+    green = chromatic & (maximum == pixels[:, 1]) & ~red
+    blue = chromatic & ~(red | green)
+    hue[red] = np.mod((pixels[red, 1] - pixels[red, 2]) / delta[red], 6.0)
+    hue[green] = (pixels[green, 2] - pixels[green, 0]) / delta[green] + 2.0
+    hue[blue] = (pixels[blue, 0] - pixels[blue, 1]) / delta[blue] + 4.0
+    hue = hue / 6.0
+    useful = saturation > 0.05
+    histogram, edges = np.histogram(hue[useful], bins=12, range=(0.0, 1.0))
+    return {
+        "active_pixels": int(len(pixels)),
+        "chromatic_pixels": int(useful.sum()),
+        "low_saturation_fraction": float(np.mean(saturation <= 0.05)),
+        "saturation_p50": float(np.percentile(saturation, 50)),
+        "saturation_p90": float(np.percentile(saturation, 90)),
+        "hue_histogram_12_bins": histogram.tolist(),
+        "hue_bin_edges": edges.tolist(),
+    }
+
+
+def gradient_metrics(rgb: np.ndarray, mask: np.ndarray) -> dict:
+    luminance = rgb[..., 0] * 0.2126 + rgb[..., 1] * 0.7152 + rgb[..., 2] * 0.0722
+    horizontal_mask = mask[:, 1:] & mask[:, :-1]
+    vertical_mask = mask[1:, :] & mask[:-1, :]
+    values = np.concatenate([
+        np.abs(luminance[:, 1:] - luminance[:, :-1])[horizontal_mask],
+        np.abs(luminance[1:, :] - luminance[:-1, :])[vertical_mask],
+    ])
+    if not len(values):
+        return {"edge_samples": 0, "mean": 0.0, "p90": 0.0, "p95": 0.0, "std": 0.0}
+    return {
+        "edge_samples": int(len(values)), "mean": float(values.mean()),
+        "p90": float(np.percentile(values, 90)), "p95": float(np.percentile(values, 95)),
+        "std": float(values.std()),
+    }
+
+
+def image_metrics(image: torch.Tensor, legacy: torch.Tensor | None,
+                  active_mask: torch.Tensor) -> dict:
+    rgb = image.detach().permute(1, 2, 0).float().cpu().numpy()
+    mask = active_mask.detach().cpu().numpy()
+    active = rgb[mask]
+    white = np.all(active >= 0.95, axis=1)
+    saturated = np.any(active >= 0.99, axis=1)
+    result = {
+        "white_fire_pixel_fraction": float(white.mean()),
+        "saturated_fire_pixel_fraction": float(saturated.mean()),
+        "active_fire_rgb_mean": active.mean(axis=0).tolist(),
+        "active_fire_rgb_std": active.std(axis=0).tolist(),
+        "hue": rgb_to_hue_metrics(rgb, mask),
+        "internal_luminance_gradients": gradient_metrics(rgb, mask),
+    }
+    if legacy is not None:
+        reference = legacy.detach().permute(1, 2, 0).float().cpu().numpy()
+        non_fire = ~mask
+        delta = np.abs(rgb[non_fire] - reference[non_fire])
+        result["non_fire_scene_difference"] = {
+            "mae": float(delta.mean()), "max": float(delta.max()),
+            "fraction_channels_gt_1_over_255": float(np.mean(delta > 1.0 / 255.0)),
+        }
+    else:
+        result["non_fire_scene_difference"] = {"mae": 0.0, "max": 0.0, "fraction_channels_gt_1_over_255": 0.0}
+    return result
+
+
+class Capture:
+    def __init__(self, path: str, path_exposure: float):
+        self.path = path
+        self.path_exposure = path_exposure
+        self._strips: dict[str, list[torch.Tensor]] = {
+            "raw_rgb": [], "entering_aces": [], "sum_xyz": [], "sum_smoke": [],
+        }
+
+    def add(self, **values: torch.Tensor) -> None:
+        for name, value in values.items():
+            self._strips[name].append(value.detach())
+
+    def combined(self, name: str) -> torch.Tensor:
+        # render_fire processes contiguous image-width strips, dimension 1 in HWC.
+        return torch.cat(self._strips[name], dim=1)
+
+
+def make_renderer(capture: Capture):
+    def render_image_fire_smoke(
+        rays_o, rays_d, num_samples, t_vals, query_tensor, temp_converter,
+        batch_size=1024, strength=0.01, sigma_a=0.1, is_norm_samples=False,
+        args=None, depth_map=None, debug_mask=False, scale_ratio=0.12,
+        smoke_color=(1.0, 1.0, 1.0), threshold=0.4, smoke_strengh=1.0,
+        exposure=1.0, render_smoke=True, fuel2temp=None, color_field=None,
+    ):
+        del debug_mask, num_samples
+        batches = (t_vals.shape[-1] + batch_size - 1) // batch_size
+        sum_xyz = torch.zeros_like(rays_o)
+        sum_smoke = torch.zeros_like(rays_o)
+        transmittance = torch.ones_like(rays_o[..., :1])
+        delta_t = torch.cat([t_vals[..., 1:] - t_vals[..., :-1], t_vals[..., -1:] - t_vals[..., -2:-1]], -1)
+        height, width = rays_o.shape[:2]
+        default_smoke = torch.tensor(smoke_color, device=rays_o.device)
+        temperature_grid = fuel2temp(query_tensor)
+        valid_mask = (
+            t_vals <= depth_map.squeeze().view(height, width, 1)
+            if depth_map is not None else torch.ones_like(t_vals, dtype=torch.bool)
+        )
+        for index in range(batches):
+            start, end = index * batch_size, min((index + 1) * batch_size, t_vals.shape[-1])
+            batch_mask = valid_mask[..., start:end]
+            points = rays_o.unsqueeze(2) + rays_d.unsqueeze(2) * t_vals[..., start:end].unsqueeze(-1)
+            if is_norm_samples:
+                lower = torch.tensor(args.bounding_box["min"], dtype=torch.float32, device=points.device)
+                upper = torch.tensor(args.bounding_box["max"], dtype=torch.float32, device=points.device)
+                points = ((points - lower) / (upper - lower)) * 2.0 - 1.0
+            fuel = interp_data(points, query_tensor)
+            xyz = temp_converter(interp_data(points, temperature_grid) * scale_ratio)
+            density = copy.deepcopy(fuel)
+            density[density > 0] = sigma_a
+            sigma_dt = density * delta_t[..., start:end]
+            trans = transmittance * torch.cumprod(
+                torch.cat([torch.ones((height, width, 1), device=rays_o.device), 1.0 - sigma_dt[..., :-1]], -1), -1
+            )
+            if depth_map is not None:
+                xyz = xyz * batch_mask.unsqueeze(-1)
+            sum_xyz += torch.sum(trans.unsqueeze(-1) * xyz * strength * delta_t[..., start:end].unsqueeze(-1), 2)
+            smoke = copy.deepcopy(fuel)
+            smoke[smoke > threshold] = 0.0
+            smoke[smoke > 1e-3] = sigma_a
+            smoke_dt = smoke * delta_t[..., start:end]
+            smoke_rgb = interp_data(points, color_field) if color_field is not None else default_smoke
+            sum_smoke += torch.sum(
+                smoke_rgb * trans.unsqueeze(-1) * smoke_dt.unsqueeze(-1) * smoke_strengh * batch_mask.unsqueeze(-1), -2
+            )
+            transmittance = update_transmittance(trans, batch_mask, transmittance)
+
+        unclipped = temp_converter.XYZ2RGB(sum_xyz, clip_output=False)
+        if capture.path == "A_legacy":
+            raw_rgb = torch.clamp(unclipped, 0.0, 1.0)
+        elif capture.path == "B_current_hdr":
+            raw_rgb = unclipped
+        else:
+            raw_rgb = torch.clamp_min(unclipped, 0.0)
+        joint = raw_rgb + (sum_smoke if render_smoke else 0.0)
+        entering_aces = joint * capture.path_exposure
+        fire_rgb = aces(entering_aces) if render_smoke else raw_rgb
+        capture.add(raw_rgb=raw_rgb, entering_aces=entering_aces, sum_xyz=sum_xyz, sum_smoke=sum_smoke)
+        return fire_rgb, transmittance
+    return render_image_fire_smoke
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--frames", default="20,60,199")
+    parser.add_argument("--strength", type=float, default=0.005)
+    parser.add_argument("--smoke-strength", type=float, default=0.2)
+    parser.add_argument("--coarse-samples", type=int, default=32)
+    parser.add_argument("--fine-samples", type=int, default=128)
+    parser.add_argument("--seed", type=int, default=42)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    frames_dir = args.output_dir / "frames"
+    frames_dir.mkdir(exist_ok=True)
+
+    scene = create_scene(args.ply, args.camera)
+    gaussians, camera = scene.gaussians, scene.cameras[0]
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mapped_mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    rows = torch.nonzero(mapped_mask, as_tuple=False).squeeze(1)
+    initial = torch.from_numpy(np.load(args.simulation_dir / "occupancy/occupancy_0.npz")["arr_0"]).cuda().float()
+    mapped_initial = initial[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    voxel_report = json.loads(args.voxel_report.read_text(encoding="utf-8"))
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    render_args = Namespace(
+        dual_smoke=False, hdr_aces=False, near=0.1, far=6.0,
+        num_samples_coarse=args.coarse_samples, num_samples_fine=args.fine_samples,
+        sampling_smooth_factor=0.5, sampling_chunk_size=32, spec_intensity=1e-8,
+        strength=args.strength, smoke_strength=args.smoke_strength, sigma_a=1.0,
+        render_smoke=True, darkness=1.0, ks=0.5, char_darkening_factor=0.5,
+        bounding_box=voxel_report["bounding_box"],
+    )
+    converter = TemperatureToRGB(T_max=12000, device="cuda")
+    fuel2temp = FuelToTemperatureLUT(device="cuda")
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    variants = [
+        ("A_legacy", 0.8), ("B_current_hdr", 0.8), ("C_positive_hdr", 0.8),
+        *[(f"D_positive_hdr_exposure_{value:g}", value) for value in (0.05, 0.1, 0.2, 0.5, 1.0)],
+    ]
+    original_renderer = fire_renderer.render_image_fire_smoke
+    report_frames = []
+    try:
+        with torch.no_grad():
+            for frame in map(int, args.frames.split(",")):
+                fuel_np = np.load(args.simulation_dir / f"fuel/fuel_{frame}.npz")["arr_0"]
+                occupancy_np = np.load(args.simulation_dir / f"occupancy/occupancy_{frame}.npz")["arr_0"]
+                fuel = torch.from_numpy(fuel_np).cuda().float()
+                occupancy = torch.from_numpy(occupancy_np).cuda().float()
+                mapped = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+                keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+                keep[rows] = (~mapped_initial) | ((mapped.abs() >= 0.7) & (mapped.abs() <= 1.0))
+                carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), device="cuda")
+                carbon[rows[mapped_initial]] = mapped[mapped_initial, None].repeat(1, 3)
+                gaussians.update_per_frame(keep, 0.7, carbon)
+                rendered = {}
+                captures = {}
+                for name, path_exposure in variants:
+                    torch.manual_seed(args.seed)
+                    torch.cuda.manual_seed_all(args.seed)
+                    capture = Capture(name, path_exposure)
+                    fire_renderer.render_image_fire_smoke = make_renderer(capture)
+                    output = fire_renderer.render_fire(
+                        camera, gaussians, pipeline, background,
+                        query_tensor=fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0),
+                        temp2rgb_converter=converter, args=render_args, scale_ratio=1440 / 12000,
+                        add_sepc_light=False, fuel2temp=fuel2temp, color_field=None,
+                    )["render"].clamp(0.0, 1.0)
+                    rendered[name], captures[name] = output, capture
+                    image = output.mul(255).byte().permute(1, 2, 0).cpu().numpy()
+                    Image.fromarray(image, mode="RGB").save(frames_dir / f"frame_{frame:03d}_{name}.png")
+
+                legacy_capture = captures["A_legacy"]
+                active_mask = (
+                    torch.clamp(legacy_capture.combined("raw_rgb"), 0.0, 1.0).amax(dim=-1) > 0.02
+                ) | (legacy_capture.combined("sum_smoke").amax(dim=-1) > 0.02)
+                frame_record = {"frame": frame, "active_fire_pixels": int(active_mask.sum()), "variants": {}}
+                for name, path_exposure in variants:
+                    capture = captures[name]
+                    frame_record["variants"][name] = {
+                        "exposure_entering_aces": path_exposure,
+                        "rgb_from_xyz_before_smoke_and_aces": channel_stats(capture.combined("raw_rgb")),
+                        "joint_rgb_entering_aces": channel_stats(capture.combined("entering_aces")),
+                        "final": image_metrics(rendered[name], rendered["A_legacy"], active_mask),
+                    }
+                report_frames.append(frame_record)
+
+                panels = []
+                for name, _ in variants:
+                    image = Image.open(frames_dir / f"frame_{frame:03d}_{name}.png").convert("RGB")
+                    panel = Image.new("RGB", (image.width, image.height + 28), (10, 10, 10))
+                    panel.paste(image, (0, 28)); ImageDraw.Draw(panel).text((8, 8), name, fill="white")
+                    panels.append(panel)
+                montage = Image.new("RGB", (camera.image_width * 4, (camera.image_height + 28) * 2), (0, 0, 0))
+                for index, panel in enumerate(panels):
+                    montage.paste(panel, ((index % 4) * panel.width, (index // 4) * panel.height))
+                montage.save(args.output_dir / f"frame_{frame:03d}_montage.png")
+                print(f"frame {frame}: rendered {len(variants)} paths", flush=True)
+    finally:
+        fire_renderer.render_image_fire_smoke = original_renderer
+
+    report = {
+        "source_order_audit": {
+            "original_order": [
+                "XYZ", "CAT02 adaptation", "XYZ to linear sRGB", "sRGB transfer/gamma",
+                "clip [0,1]", "add smoke", "exposure 0.8", "ACES", "final clip",
+            ],
+            "order_changed_by_this_test": False,
+        },
+        "simulation_modified": False,
+        "settings": {
+            "frames": list(map(int, args.frames.split(","))), "strength": args.strength,
+            "smoke_strength": args.smoke_strength, "samples": [args.coarse_samples, args.fine_samples],
+            "seed": args.seed,
+        },
+        "paths": {
+            "A_legacy": "post-gamma clamp [0,1], smoke, exposure 0.8, ACES",
+            "B_current_hdr": "post-gamma unclipped RGB, smoke, exposure 0.8, ACES",
+            "C_positive_hdr": "post-gamma clamp negatives only, smoke, exposure 0.8, ACES",
+            "D_positive_hdr_exposure": "C with exposure in {0.05,0.1,0.2,0.5,1.0}",
+        },
+        "frames": report_frames,
+    }
+    report_path = args.output_dir / "xyz2rgb_hdr_regression_raw.json"
+    report_path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(report_path)
+
+
+if __name__ == "__main__":
+    main()
