@@ -0,0 +1,101 @@
+"""Build the long-horizon comparison and curtain camera diagnosis reports."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+FAMILIES = ("table_medium", "table_high", "sofa_high", "curtain_high")
+
+
+def rgb_metrics(base: Path, rendered: Path) -> dict:
+    a = np.asarray(Image.open(base).convert("RGB"), dtype=np.int16)
+    b = np.asarray(Image.open(rendered).convert("RGB"), dtype=np.int16)
+    delta = np.abs(a - b)
+    return {"rgb_changed_percent_threshold_8": float(np.mean(np.max(delta, axis=2) > 8) * 100),
+            "rgb_mean_absolute_change": float(np.mean(delta))}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--batch-root", type=Path, required=True)
+    args = parser.parse_args()
+    scenarios, sources = [], []
+    for family in FAMILIES:
+        metric_path = args.root / "metrics" / f"{family}_metrics.json"
+        prop_path = args.root / "propagation" / f"{family}_object_propagation_timeline.json"
+        stage_path = args.root / "stages" / family / "fire_stage_timeline.json"
+        metrics = json.loads(metric_path.read_text(encoding="utf-8"))
+        prop = json.loads(prop_path.read_text(encoding="utf-8"))
+        stages = json.loads(stage_path.read_text(encoding="utf-8"))
+        secondary = []
+        ids = set(prop["genuine_secondary_ignition_object_ids"])
+        for obj in prop["objects"]:
+            if obj["object_id"] in ids:
+                secondary.append({"object_id": obj["object_id"], "semantic_label": obj["semantic_label"],
+                                  "material": obj["material"], "first_native_ignition_frame": obj["first_native_ignition_frame"],
+                                  "first_occupancy_loss_frame": obj["first_occupancy_loss_frame"],
+                                  "first_carbonization_frame": obj["first_carbonization_frame"]})
+        rows = metrics["frames"]
+        scenarios.append({
+            "scenario": metrics["metadata"]["scenario_name"], "frames": metrics["frame_count"],
+            "stability_status": "passed" if metrics["passed"] else "failed",
+            "final_burning_extent_m": metrics["final"]["burning_extent_m"],
+            "final_burning_bbox_volume_m3": metrics["final"]["burning_bbox_volume_m3"],
+            "maximum_temperature": max(x["maximum_temperature"] for x in rows),
+            "peak_active_temperature_voxel_count": max(x["active_temperature_voxel_count"] for x in rows),
+            "peak_fuel_metric": max(x["active_fuel_voxel_count"] for x in rows),
+            "final_consumed_occupancy_mass": metrics["final"]["consumed_occupancy_mass"],
+            "first_surrounding_object_heating_frame": prop["first_surrounding_object_heating_frame"],
+            "first_genuine_secondary_ignition_frame": prop["first_genuine_secondary_ignition_frame"],
+            "genuine_secondary_objects": secondary,
+            "first_carbonization_frame": metrics["first_carbonized_frame"],
+            "final_carbonized_gaussian_count": metrics["final"]["carbonized_gaussian_count"],
+            "physical_stage_method": stages["method"], "physical_stage_boundaries": stages["stages"],
+            "representative_frames": stages["representative_frames"],
+        })
+        sources.extend(map(lambda p: str(p.resolve()), (metric_path, prop_path, stage_path)))
+
+    canonical_base = args.batch_root / "renders/baselines/curtain.png"
+    canonical_frame = args.batch_root / "renders/office_curtain_high/office_curtain_high_preview_frames/frame_029.png"
+    diagnostic_base = args.root / "renders/curtain_diagnostic_baseline.png"
+    diagnostic_frame = args.root / "renders/curtain_camera_diagnosis_frame29_frames/frame_029.png"
+    curtain_metrics = next(x for x in scenarios if x["scenario"] == "office_curtain_high_long_200")
+    frame29 = json.loads((args.root / "metrics/curtain_high_metrics.json").read_text(encoding="utf-8"))["frames"][29]
+    diagnosis = {
+        "physical_frame": 29, "same_renderer_parameters": True,
+        "canonical_camera": rgb_metrics(canonical_base, canonical_frame),
+        "diagnostic_camera": rgb_metrics(diagnostic_base, diagnostic_frame),
+        "frame_29_active_temperature_voxels": frame29["active_temperature_voxel_count"],
+        "peak_active_temperature_voxels_over_200": curtain_metrics["peak_active_temperature_voxel_count"],
+        "frame_29_fraction_of_peak_temperature_volume": frame29["active_temperature_voxel_count"] / curtain_metrics["peak_active_temperature_voxel_count"],
+        "conclusion": "Weak frame-29 response is primarily an early/weak physical state (less than 5% of the 200-frame peak temperature volume). Canonical upper-boundary framing is a secondary visibility limitation; the wider diagnostic view still shows only a small upper-edge flame at frame 29.",
+        "canonical_frame": str(canonical_frame.resolve()), "diagnostic_frame": str(diagnostic_frame.resolve()),
+    }
+    payload = {
+        "metadata": {"scenario_name": "office_01_long_horizon_comparison", "timestamp": timestamp(),
+                     "source_files": sources},
+        "passed": all(x["stability_status"] == "passed" for x in scenarios),
+        "field_semantics": str((Path(__file__).with_name("long_run_metric_semantics.md")).resolve()),
+        "shared_renderer_parameters": {"fire_strength": 0.05, "smoke_strength": 1.0,
+                                       "coarse_samples": 32, "fine_samples": 128},
+        "scenarios": scenarios, "curtain_camera_diagnosis": diagnosis,
+        "notes": ["fuel is an advected combustion coefficient, not remaining solid fuel",
+                  "secondary ignition requires native wood-temperature ignition plus occupancy consumption",
+                  "no combustion thresholds or renderer brightness were changed"],
+    }
+    write_json(args.root / "reports/long_horizon_fire_comparison_report.json", payload)
+    write_json(args.root / "reports/curtain_camera_diagnosis_report.json", diagnosis)
+    print(json.dumps({"passed": payload["passed"], "scenarios": len(scenarios), "curtain": diagnosis}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
