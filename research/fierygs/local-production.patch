+"""Compare two single-variable FieryGS buoyancy runs at one frame."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def load_npz(path: Path, key: str | None = None) -> np.ndarray:
+    with np.load(path) as data:
+        return data[key] if key else data["arr_0"]
+
+
+def summarize(root: Path, frame: int) -> dict:
+    fuel = load_npz(root / "fuel" / f"fuel_{frame}.npz")
+    temp = load_npz(root / "temperature" / f"temperature_{frame}.npz")
+    flow_path = root / "flow_diagnostics" / f"flow_{frame}.npz"
+    speed = load_npz(flow_path, "velocity_magnitude")
+    vertical = load_npz(flow_path, "velocity_vertical")
+    active = np.argwhere(fuel > 1e-4)
+    return {
+        "fuel_sum": float(fuel.sum()), "active_fuel_voxels": int(len(active)),
+        "active_fuel_extent_voxels": (np.ptp(active, axis=0) + 1).tolist() if len(active) else [0, 0, 0],
+        "temperature_sum": float(temp.sum()), "temperature_max": float(temp.max()),
+        "speed_mean": float(speed.mean()), "speed_max": float(speed.max()),
+        "vertical_mean": float(vertical.mean()), "vertical_max": float(vertical.max()),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--variant", type=Path, required=True)
+    parser.add_argument("--frame", type=int, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    baseline = summarize(args.baseline, args.frame)
+    variant = summarize(args.variant, args.frame)
+    delta_pct = {
+        key: (variant[key] / value - 1.0) * 100.0
+        for key, value in baseline.items()
+        if isinstance(value, (int, float)) and value != 0
+    }
+    report = {
+        "controlled_variable": "alpha only: 120 -> 132 (+10%); k remains 0.3",
+        "frame": args.frame, "baseline_alpha120": baseline,
+        "variant_alpha132": variant, "variant_delta_percent": delta_pct,
+        "interpretation": (
+            "This measures the native buoyancy response without conflating it "
+            "with fuel-decay changes; visual desirability requires rendering."
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
