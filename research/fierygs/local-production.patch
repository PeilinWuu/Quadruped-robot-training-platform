@@ -0,0 +1,66 @@
+"""Measure whether table-fire fields reached nearby material-labelled objects."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch-root", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--simulation-root", type=Path, required=True)
+    parser.add_argument("--nearby-limit", type=int, default=10)
+    args = parser.parse_args()
+
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy().astype(bool)
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    labels = np.load(args.labels)[mask]
+    prop_path = args.batch_root / "validation" / "office_table_low" / "propagation_object_report.json"
+    nearby = json.loads(prop_path.read_text(encoding="utf-8"))["nearby_objects"][: args.nearby_limit]
+    scenarios = []
+    for level in ("low", "medium", "high"):
+        sim = args.simulation_root / f"office_table_{level}_30f" / "sim_output"
+        fuel = np.load(sim / "fuel" / "fuel_29.npz")["arr_0"]
+        temp = np.load(sim / "temperature" / "temperature_29.npz")["arr_0"]
+        objects = []
+        for item in nearby:
+            coords = np.unique(indices[labels == item["object_id"]], axis=0)
+            if len(coords):
+                values_f = fuel[coords[:, 0], coords[:, 1], coords[:, 2]]
+                values_t = temp[coords[:, 0], coords[:, 1], coords[:, 2]]
+                fuel_hits, temp_hits = int(np.count_nonzero(values_f > 0.05)), int(np.count_nonzero(values_t > 0.05))
+            else:
+                fuel_hits = temp_hits = 0
+            objects.append({**item, "mapped_voxel_count": int(len(coords)), "fuel_field_voxels": fuel_hits,
+                            "temperature_field_voxels": temp_hits, "reached_by_field": bool(fuel_hits or temp_hits)})
+        scenarios.append({"scenario": f"office_table_{level}", "frame": 29, "nearby_objects": objects,
+                          "reached_object_count": sum(x["reached_by_field"] for x in objects),
+                          "nearby_fuel_field_voxels": sum(x["fuel_field_voxels"] for x in objects),
+                          "nearby_temperature_field_voxels": sum(x["temperature_field_voxels"] for x in objects)})
+    fuel_trend = [x["nearby_fuel_field_voxels"] for x in scenarios]
+    temp_trend = [x["nearby_temperature_field_voxels"] for x in scenarios]
+    report = {"metadata": {"scenario_name": "office_table_propagation_sanity_30f", "timestamp": timestamp(),
+                           "source_files": [str(prop_path.resolve()), str(args.labels.resolve()), str(args.voxel_dir.resolve())]},
+              "initial_ignition_object_id": 113, "field_threshold": 0.05,
+              "interpretation": "Field contact is diagnostic evidence, not a declaration that an object has ignited.",
+              "ordering_checks": {
+                  "nearby_fuel_contact_high_gt_medium_gt_low": fuel_trend[2] > fuel_trend[1] > fuel_trend[0],
+                  "nearby_temperature_contact_high_gt_medium_gt_low": temp_trend[2] > temp_trend[1] > temp_trend[0],
+              },
+              "scenarios": scenarios}
+    output = args.batch_root / "reports" / "table_propagation_sanity_report.json"
+    write_json(output, report)
+    print(json.dumps({"output": str(output), "reached": {x["scenario"]: x["reached_object_count"] for x in scenarios}}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
