+"""Build non-destructive visual QA sheets from the completed Dataset v1."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+from adapter.fire_dataset.build_sample_qa_panel import main as _unused_main
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+STAGES = ("ignition", "early", "established", "spread", "late")
+CAMERA_SUFFIXES = ("cam00", "cam02", "cam04", "cam06")
+LABEL_HEIGHT = 28
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    return parser.parse_args()
+
+
+def tile(image_path: Path, label: str) -> Image.Image:
+    image = Image.open(image_path).convert("RGB")
+    result = Image.new("RGB", (image.width, image.height + LABEL_HEIGHT), "white")
+    result.paste(image, (0, LABEL_HEIGHT))
+    ImageDraw.Draw(result).text((8, 7), label, fill="black")
+    return result
+
+
+def make_sheet(tiles: list[Image.Image], columns: int) -> Image.Image:
+    width, height = tiles[0].size
+    rows = (len(tiles) + columns - 1) // columns
+    sheet = Image.new("RGB", (columns * width, rows * height), "white")
+    for index, item in enumerate(tiles):
+        sheet.paste(item, ((index % columns) * width, (index // columns) * height))
+    return sheet
+
+
+def main() -> None:
+    args = parse_args()
+    samples = [
+        json.loads(line)
+        for line in (args.dataset_root / "manifests" / "dataset_v1_manifest.jsonl")
+        .read_text(encoding="utf-8")
+        .splitlines()
+        if line
+    ]
+    output_root = args.dataset_root / "previews" / "dataset_v1_visual_qa"
+    output_root.mkdir(parents=True, exist_ok=True)
+    scenario_outputs = []
+    scenarios = sorted({sample["scenario"] for sample in samples})
+    for scenario in scenarios:
+        selected = []
+        for stage in STAGES:
+            stage_samples = [
+                sample
+                for sample in samples
+                if sample["scenario"] == scenario
+                and sample["physical_stage"] == stage
+                and sample["state_id"].endswith(("1", "4", "7", "0", "3"))
+            ]
+            # Exactly one middle state per stage, then four diverse cameras.
+            state_ids = sorted({sample["state_id"] for sample in stage_samples})
+            state_id = state_ids[len(state_ids) // 2]
+            for suffix in CAMERA_SUFFIXES:
+                sample = next(
+                    item
+                    for item in samples
+                    if item["scenario"] == scenario
+                    and item["physical_stage"] == stage
+                    and item["state_id"] == state_id
+                    and item["camera_id"].endswith(suffix)
+                )
+                selected.append(sample)
+        tiles = [
+            tile(
+                Path(sample["outputs"]["rgb"]),
+                f"{sample['physical_stage']} f{sample['simulation_frame']} {sample['camera_id']}",
+            )
+            for sample in selected
+        ]
+        output = output_root / f"{scenario}_stages_cameras.png"
+        make_sheet(tiles, 4).save(output)
+        scenario_outputs.append(str(output.resolve()))
+
+    curtain_review_samples = []
+    for level in ("low", "medium", "high"):
+        for stage in STAGES:
+            for suffix in ("cam06", "cam07"):
+                candidates = [
+                    sample
+                    for sample in samples
+                    if sample["scenario"] == f"curtain_{level}"
+                    and sample["physical_stage"] == stage
+                    and sample["camera_id"].endswith(suffix)
+                ]
+                curtain_review_samples.append(candidates[len(candidates) // 2])
+    curtain_tiles = [
+        tile(
+            Path(sample["outputs"]["rgb"]),
+            f"{sample['scenario']} {sample['physical_stage']} {sample['camera_id']}",
+        )
+        for sample in curtain_review_samples
+    ]
+    curtain_output = output_root / "curtain_cam06_cam07_review.png"
+    make_sheet(curtain_tiles, 5).save(curtain_output)
+
+    report = {
+        "scenario_contact_sheets": scenario_outputs,
+        "curtain_cam06_cam07_review": str(curtain_output.resolve()),
+        "scenario_sheet_count": len(scenario_outputs),
+        "images_per_scenario_sheet": 20,
+        "curtain_review_images": len(curtain_review_samples),
+    }
+    report_path = output_root / "visual_qa_manifest.json"
+    report_path.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps({**report, "report": str(report_path.resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
