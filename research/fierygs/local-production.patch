+"""Render only assigned Gaussians with the native FieryGS renderer."""
+
+from __future__ import annotations
+
+import argparse
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+
+from adapter.semantic_bridge.render_gaussian_maps import make_camera
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.common import load_cameras
+from gaussian_renderer import render
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--view", type=int, default=0)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    labels = np.load(args.labels)
+    assigned = labels >= 0
+    gaussians = load_interiorgs_gaussians(args.ply)
+    if labels.size != gaussians.get_xyz.shape[0]:
+        raise ValueError(f"Label length {labels.size} != Gaussian count {gaussians.get_xyz.shape[0]}")
+    camera = make_camera(load_cameras(args.cameras)[args.view], args.view)
+    filtered_mask = torch.from_numpy(~assigned).to(device="cuda")
+    result = render(camera, gaussians, Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False),
+                    torch.tensor([0.04, 0.04, 0.04], device="cuda"), filtered_mask=filtered_mask)
+    rgb = result["render"].detach().clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    Image.fromarray(rgb, mode="RGB").save(args.output)
+    print(f"assigned={int(assigned.sum())} output={args.output.resolve()}")
+
+
+if __name__ == "__main__":
+    main()
+
