+            arrays[field] = len(list(directory.glob("*.npz"))) if directory.exists() else 0
+        prior = args.long_root / "renders" / family / "long_run_stage_preview.mp4"
+        baseline = args.visual_root / "renders" / family / "baseline_full/baseline_full.mp4"
+        scenarios.append({
+            "scenario": family, "simulation_directory": str(sim.resolve()),
+            "simulation_frame_count": arrays["fuel"], "available_simulation_arrays": arrays,
+            "camera_config": str(camera.resolve()), "camera_available": camera.exists(),
+            "previous_render": str(prior.resolve()) if prior.exists() else None,
