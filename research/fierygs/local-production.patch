+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+
+
+def bbox_world(array_xyz: np.ndarray, bbox: dict, threshold: float = 1e-6):
+    active = np.argwhere(array_xyz > threshold)
+    if not len(active):
+        return None
+    minimum = np.asarray(bbox["min"], dtype=np.float64)
+    maximum = np.asarray(bbox["max"], dtype=np.float64)
+    spacing = (maximum - minimum) / np.asarray(array_xyz.shape)
+    return {
+        "min": (minimum + active.min(0) * spacing).tolist(),
+        "max": (minimum + (active.max(0) + 1) * spacing).tolist(),
+        "extent": ((active.max(0) - active.min(0) + 1) * spacing).tolist(),
+    }
+
+
+def prepare(field_xyz: np.ndarray, method: str) -> tuple[torch.Tensor, np.ndarray]:
+    native = torch.from_numpy(field_xyz).cuda().float().unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+    if method == "native":
+        return native, field_xyz
+    if method == "dense_trilinear_2x":
+        tensor = F.interpolate(native, scale_factor=2, mode="trilinear", align_corners=True)
+        return tensor, tensor.squeeze(0).squeeze(0).permute(2, 1, 0).cpu().numpy()
+    if method == "conservative_gaussian":
+        active = field_xyz > 0
+        support = binary_dilation(active, iterations=1)
+        filtered = gaussian_filter(field_xyz, sigma=0.65, mode="constant", cval=0.0)
+        filtered[~support] = 0.0
+        filtered[filtered < 1e-3] = 0.0
+        # Preserve original peak scale without modifying the saved source.
+        if filtered.max() > 0:
+            filtered *= field_xyz.max() / filtered.max()
+        tensor = torch.from_numpy(filtered.astype(np.float32)).cuda().unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+        return tensor, filtered
+    raise ValueError(method)
+
+
+def edge_metrics(image: np.ndarray) -> dict[str, float]:
+    luminance = image.astype(np.float32).mean(-1) / 255.0
+    dx, dy = np.abs(np.diff(luminance, axis=1)), np.abs(np.diff(luminance, axis=0))
+    return {
+        "mean_horizontal_gradient": float(dx.mean()),
+        "mean_vertical_gradient": float(dy.mean()),
+        "p99_axis_gradient": float(max(np.percentile(dx, 99), np.percentile(dy, 99))),
+        "axis_gradient_anisotropy": float(abs(dx.mean() - dy.mean()) / (dx.mean() + dy.mean() + 1e-12)),
+    }
+
+
