@@ -0,0 +1,64 @@
+"""Validate recovered FieryGS simulation outputs before a longer run."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def load(path: Path) -> np.ndarray:
+    with np.load(path) as data:
+        return data["arr_0"]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--frame", type=int, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--require-active-fuel", action="store_true")
+    args = parser.parse_args()
+    arrays = {
+        name: load(args.simulation_dir / name / f"{name}_{args.frame}.npz")
+        for name in ("fuel", "temperature", "occupancy", "wood_temperature", "color")
+    }
+    initial_occupancy = load(args.simulation_dir / "occupancy" / "occupancy_0.npz")
+    with np.load(args.simulation_dir / "flow_diagnostics" / f"flow_{args.frame}.npz") as flow:
+        curl = flow["curl"]
+        confinement = flow["confinement_force"]
+    color = arrays["color"]
+    unique_colors = np.unique(color.reshape(-1, 3), axis=0)
+    checks = {
+        "all_arrays_finite": all(np.isfinite(value).all() for value in arrays.values()),
+        "dual_smoke_color_exported": color.shape[-1] == 3,
+        "vorticity_nonzero": bool(np.count_nonzero(curl)),
+        "confinement_force_nonzero": bool(np.count_nonzero(confinement)),
+    }
+    active_fuel_remains = bool(np.count_nonzero(arrays["fuel"] > 1e-4))
+    if args.require_active_fuel:
+        checks["active_fuel_remains"] = active_fuel_remains
+    report = {
+        "frame": args.frame, "checks": checks, "passed": all(checks.values()),
+        "active_fuel_remains": active_fuel_remains,
+        "active_fuel_required": args.require_active_fuel,
+        "fuel": {"sum": float(arrays["fuel"].sum()), "active_voxels": int(np.count_nonzero(arrays["fuel"] > 1e-4))},
+        "temperature": {"sum": float(arrays["temperature"].sum()), "max": float(arrays["temperature"].max())},
+        "renderer_temperature_source": "FuelToTemperatureLUT(fuel), not exported auxiliary temperature field",
+        "auxiliary_temperature_nonzero": bool(np.count_nonzero(arrays["temperature"] > 1e-4)),
+        "occupancy_consumed_voxel_equivalent": float((initial_occupancy - arrays["occupancy"]).sum()),
+        "color": {"unique_rgb_count": int(len(unique_colors)), "min": float(color.min()), "max": float(color.max())},
+        "curl_max": float(np.linalg.norm(curl, axis=-1).max()),
+        "confinement_force_max": float(np.linalg.norm(confinement, axis=-1).max()),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+    if not report["passed"]:
+        raise RuntimeError("Integrated run validation failed")
+
+
+if __name__ == "__main__":
+    main()
