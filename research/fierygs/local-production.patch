+            native_active = fuel_np > 0
+            for method in methods:
+                diff = np.abs(images[method].astype(np.float32) / 255.0 - baseline)
+                per_method[method]["image_mae_from_native"] = float(diff.mean())
+                per_method[method]["image_p95_difference_from_native"] = float(np.percentile(diff, 95))
+                if fields[method].shape == fuel_np.shape:
+                    per_method[method]["native_active_core_retention"] = float(np.mean(fields[method][native_active] > 1e-3))
+                else:
+                    per_method[method]["native_active_core_retention"] = None
+            records.append({"frame": frame, "methods": per_method})
+
+            label_h = 32
+            canvas = Image.new("RGB", (camera.image_width * len(methods), camera.image_height + label_h), "black")
+            draw = ImageDraw.Draw(canvas)
+            for i, method in enumerate(methods):
+                canvas.paste(Image.fromarray(images[method]), (i * camera.image_width, label_h))
+                draw.text((i * camera.image_width + 8, 8), method, fill="white")
+            canvas.save(args.output_dir / "side_by_side" / f"frame_{frame:03d}.png")
+            print(f"completed frame {frame}", flush=True)
+
+    report = {
+        "experiment": "render-only reconstruction of fixed 5 cm Table HIGH fuel fields",
+        "source_voxel_spacing_m": voxel_meta["voxel_size_m"],
+        "methods": {
+            "native": "unchanged native tensor",
+            "dense_trilinear_2x": "2x torch trilinear resampling, same world bounding box",
+            "conservative_gaussian": "sigma=0.65 source voxels; support limited to one-voxel dilation; values below 1e-3 zeroed",
+        },
+        "frames": records,
+        "warning": "All reconstructions are display-time inputs only; saved physics arrays are unchanged.",
+    }
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+
+    root_cause = {
+        "source_voxel_spacing_m": voxel_meta["voxel_size_m"],
+        "source_resolution_xyz": voxel_meta["voxel_resolution"],
+        "spatial_query": "torch.grid_sample on 5-D volume with mode=bilinear, which is trilinear",
+        "align_corners": True,
+        "nearest_neighbor_lookup_found": False,
+        "hard_discontinuities": [
+            "density_batch[density_batch > 0] = sigma_a makes absorption binary",
+            "smoke_batch > threshold is zeroed, then smoke_batch > 1e-3 becomes binary sigma_a",
+            "zero padding outside the volume creates a hard domain boundary",
+            "physical scalar evolution remains limited to the 5 cm solver lattice",
+        ],
+        "hypothesis": "Visible blockiness is dominated by coarse physical scalar topology plus binary absorption/smoke masks, not ray-sample count or nearest-neighbor interpolation.",
+        "evidence_report": str(args.report.resolve()),
+    }
+    args.root_cause_report.write_text(json.dumps(root_cause, indent=2) + "\n", encoding="utf-8")
+    print(args.report.resolve())
+
+
+if __name__ == "__main__":
+    main()
