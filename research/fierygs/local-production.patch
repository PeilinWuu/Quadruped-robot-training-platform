@@ -0,0 +1,103 @@
+"""Render native RGB/depth and a separate Gaussian-index map for each camera."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image
+from pytorch3d.renderer.points.rasterize_points import rasterize_points
+from pytorch3d.structures import Pointclouds
+
+from adapter.create_scene import look_at_colmap
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.common import camera_basis, encode_ids, load_cameras
+from gaussian_renderer import render_with_depth
+from scene.cameras import Camera
+from utils.graphics_utils import focal2fov
+
+
+def make_camera(config: dict, uid: int) -> Camera:
+    position = np.asarray(config["position"], dtype=np.float64)
+    target = np.asarray(config["target"], dtype=np.float64)
+    up = np.asarray(config.get("up", [0, 0, 1]), dtype=np.float64)
+    rotation, translation = look_at_colmap(position, target, up)
+    width, height = int(config["width"]), int(config["height"])
+    return Camera(
+        colmap_id=uid, R=rotation, T=translation,
+        FoVx=focal2fov(float(config["fx"]), width), FoVy=focal2fov(float(config["fy"]), height),
+        image=torch.zeros((3, height, width)), gt_alpha_mask=None, image_path="",
+        image_name=f"semantic_{uid:03d}", uid=uid,
+        cx=float(config["cx"]), cy=float(config["cy"]), data_device="cuda", preload_img=False,
+    )
+
+
+def gaussian_id_map(xyz: torch.Tensor, opacity: torch.Tensor, radii: torch.Tensor, camera: dict,
+                    opacity_min: float, max_radius_px: float) -> np.ndarray:
+    rotation_np, translation_np = camera_basis(camera)
+    rotation = torch.as_tensor(rotation_np, dtype=xyz.dtype, device=xyz.device)
+    translation = torch.as_tensor(translation_np, dtype=xyz.dtype, device=xyz.device)
+    cam = xyz @ rotation.T + translation
+    z = cam[:, 2]
+    u = float(camera["fx"]) * cam[:, 0] / z + float(camera["cx"])
+    v = float(camera["fy"]) * cam[:, 1] / z + float(camera["cy"])
+    height, width = int(camera["height"]), int(camera["width"])
+    scale = min(height, width) / 2.0
+    valid = (z > 0.01) & (u > -max_radius_px) & (u < width + max_radius_px) & (v > -max_radius_px) & (v < height + max_radius_px)
+    valid &= (radii > 0) & (opacity.squeeze(1) >= opacity_min)
+    source_ids = torch.nonzero(valid, as_tuple=False).squeeze(1)
+    ndc = torch.stack(((width / 2.0 - u[valid]) / scale, (height / 2.0 - v[valid]) / scale, z[valid]), dim=1)
+    radius = radii[valid].float().clamp(1.0, max_radius_px).unsqueeze(0) / scale
+    cloud = Pointclouds(points=[ndc])
+    idx, _, _ = rasterize_points(cloud, image_size=(height, width), radius=radius, points_per_pixel=1)
+    local = idx[0, :, :, 0].long()
+    result = torch.full_like(local, -1, dtype=torch.long)
+    hit = local >= 0
+    result[hit] = source_ids[local[hit]]
+    return result.cpu().numpy()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--views-dir", type=Path, required=True)
+    parser.add_argument("--opacity-min", type=float, default=0.05)
+    parser.add_argument("--max-id-radius-px", type=float, default=12.0)
+    args = parser.parse_args()
+    cameras = load_cameras(args.cameras)
+    gaussians = load_interiorgs_gaussians(args.ply)
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    diagnostics = []
+    for index, config in enumerate(cameras):
+        camera = make_camera(config, index)
+        output = render_with_depth(camera, gaussians, pipeline, background)
+        ids = gaussian_id_map(gaussians.get_xyz, gaussians.get_opacity, output["radii"], config,
+                              args.opacity_min, args.max_id_radius_px)
+        view_dir = args.views_dir / f"view_{index:03d}"
+        view_dir.mkdir(parents=True, exist_ok=True)
+        rgb = output["render"].detach().clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+        depth = output["depth"].detach().squeeze().cpu().numpy()
+        depth_mm = np.clip(np.rint(depth * 1000), 0, 65535).astype(np.uint16)
+        Image.fromarray(rgb, mode="RGB").save(view_dir / "rgb.png")
+        Image.fromarray(depth_mm, mode="I;16").save(view_dir / "depth.png")
+        Image.fromarray(encode_ids(ids), mode="RGB").save(view_dir / "gaussian_id.png")
+        diagnostics.append({
+            "view": index, "native_visible": int(output["visibility_filter"].sum()),
+            "id_map_unique": int(np.unique(ids[ids >= 0]).size), "id_pixels": int((ids >= 0).sum()),
+            "depth_min_m": float(depth.min()), "depth_max_m": float(depth.max()),
+        })
+        print(f"rendered view {index + 1}/{len(cameras)}")
+    report = args.views_dir / "render_diagnostics.json"
+    report.write_text(json.dumps(diagnostics, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"gaussians": int(gaussians.get_xyz.shape[0]), "views": len(cameras), "report": str(report.resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
+
