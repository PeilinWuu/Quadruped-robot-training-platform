+"""Build baseline-vs-improved media and the controlled-ablation scorecard."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import imageio.v2 as imageio
+import numpy as np
+from PIL import Image, ImageDraw
+
+
+FRAMES = (20, 60, 100, 140, 180, 199)
+
+
+def load(path: Path) -> np.ndarray:
+    return np.asarray(Image.open(path).convert("RGB"))
+
+
+def frame_metrics(baseline: np.ndarray, improved: np.ndarray, static: np.ndarray) -> dict:
+    b, i, s = [x.astype(np.float32) / 255.0 for x in (baseline, improved, static)]
+    active = (np.max(np.abs(b - s), -1) > 2 / 255) | (np.max(np.abs(i - s), -1) > 2 / 255)
+    def one(image):
+        values = image[active] if np.any(active) else image.reshape(-1, 3)
+        luminance = values.mean(-1)
+        chroma = values.max(-1) - values.min(-1)
+        return {
+            "active_region_channel_ge_0_99_percent": float(100 * np.mean(values >= 0.99)),
+            "active_region_near_white_pixel_percent": float(100 * np.mean(np.min(values, -1) >= 0.9)),
+            "active_region_luminance_std": float(np.std(luminance)),
+            "active_region_chroma_median": float(np.median(chroma)),
+            "whole_image_channel_ge_0_99_percent": float(100 * np.mean(image >= 0.99)),
+        }
+    return {
+        "baseline": one(b), "improved": one(i),
+        "whole_image_mae": float(np.mean(np.abs(i - b))),
+        "unchanged_region_mae": float(np.mean(np.abs(i[~active] - b[~active]))) if np.any(~active) else 0.0,
+        "active_pixel_percent": float(100 * np.mean(active)),
+    }
+
+
+def augment_reports(report_dir: Path, metrics: list[dict]) -> None:
+    dynamic_path = report_dir / "flame_dynamic_range_report.json"
+    dynamic = json.loads(dynamic_path.read_text(encoding="utf-8"))
+    dynamic["diagnosis"] = {
+        "primary": "early clipping in TemperatureToRGB.XYZ2RGB before the existing ACES-like mapping",
+        "contributors": ["white binary scalar-smoke addition", "final fire+GS compositing can exceed display range"],
+        "not_primary": ["ray sample count", "final writer clipping alone"],
+        "evidence": "Unclipped linear RGB reaches about 70-99 at late frames; native RGB is clipped before tone mapping, and 1.4-1.8% of whole-image channels are clipped again at final save.",
+    }
+    dynamic_path.write_text(json.dumps(dynamic, indent=2) + "\n", encoding="utf-8")
+
+    color_path = report_dir / "color_mapping_ablation.json"
+    color = json.loads(color_path.read_text(encoding="utf-8"))
+    color["conclusion"] = {
+        "tone_mapping_alone_accepted": False,
+        "finding": "Unclipped Reinhard/ACES candidates preserve mathematical range but do not improve the full image because native white smoke dominates; ACES-like candidate increases white regions.",
+        "background_unchanged": True,
+        "selected_follow_up": "Use lower native linear strength only together with reduced invalid scalar-smoke weight.",
