index 0000000..1cc3b60
--- /dev/null
+++ b/adapter/fire_scenario/run_scenario_solver.py
@@ -0,0 +1,136 @@
+"""Run FieryGS FireSolver while exporting the active TexPair buffers correctly."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from types import MethodType
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from adapter.fire_scenario.common import timestamp, write_json
+from simulation.fire_main import FireSolver
+
+
+class ScenarioFireSolver:
+    """Composition wrapper around the native solver.
+
+    FireSolver is Taichi ``@data_oriented``; subclassing it makes inherited
+    kernels resolve against a second data-oriented class.  Keep all Taichi
+    methods on the original FireSolver instance and bind only adapter hooks.
+    """
+
+    def __init__(self, *args, **kwargs):
+        self.solver = FireSolver(*args, **kwargs)
+        self._native_init_wood = self.solver.init_wood
+        self.solver._scenario_adapter_native_init_wood = self._native_init_wood
+        self.solver.init_wood = MethodType(ScenarioFireSolver.init_wood, self.solver)
+        self.solver.save_npz = MethodType(ScenarioFireSolver.save_npz, self.solver)
+
+    def __getattr__(self, name):
+        return getattr(self.solver, name)
+
+    def init_wood(self):
+        exact_path = getattr(self.args, "scenario_metadata", {}).get("exact_ignition_mask")
+        exact_required = bool(getattr(self.args, "scenario_metadata", {}).get("exact_ignition_required", False))
+        if not exact_required:
+            return self._scenario_adapter_native_init_wood()
+        mask = np.load(exact_path).astype(bool)
+        if tuple(mask.shape) != tuple(self.res):
+            raise ValueError(f"Exact ignition mask shape {mask.shape} does not match solver grid {self.res}")
+        occupancy = self.occupancy.to_numpy() > 0
+        temperature = np.where(mask & occupancy, self.T_max_wood, self.T_air_wood).astype(np.float32)
+        self.wood_temperature_pair.cur.from_numpy(temperature)
+        self.wood_temperature_pair.nxt.from_numpy(temperature)
+        if self.ignition_lifetime == "initial_only":
+            # The paper initializes reaction coordinate Y once at selected
+            # combustible ignition voxels.  Seed both TexPair slots because the
+            # first step advects immediately after initialization.
+            reaction = (mask & occupancy).astype(np.float32)
+            self.coef_pair.cur.from_numpy(reaction)
+            self.coef_pair.nxt.from_numpy(reaction)
+
+    def save_npz(self, frame):
+        Path(self._data_dir, "wood_temperature").mkdir(parents=True, exist_ok=True)
+        np.savez_compressed(
+            f"{self._data_dir}/temperature/temperature_{frame}.npz",
+            self.temperature_pair.cur.to_numpy(),
+        )
+        np.savez_compressed(
+            f"{self._data_dir}/fuel/fuel_{frame}.npz",
+            self.coef_pair.cur.to_numpy(),
+        )
+        np.savez_compressed(
+            f"{self._data_dir}/occupancy/occupancy_{frame}.npz",
+            self.occupancy.to_numpy(),
+        )
+        np.savez_compressed(
+            f"{self._data_dir}/wood_temperature/wood_temperature_{frame}.npz",
+            self.wood_temperature_pair.cur.to_numpy(),
+        )
+        if self.args.dual_smoke:
+            np.savez_compressed(
+                f"{self._data_dir}/color/color_{frame}.npz",
+                self.color_buffer.cur.to_numpy(),
+            )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config-file", type=Path, required=True)
+    parser.add_argument("--run-report", type=Path)
+    parser.add_argument("--scene")
+    parser.add_argument("--frames", type=int)
+    cli = parser.parse_args()
+
+    config = yaml.safe_load(cli.config_file.read_text(encoding="utf-8"))
+    if cli.scene:
+        config["scene"] = cli.scene
+    if cli.frames is not None:
+        if cli.frames < 1:
+            raise ValueError("--frames must be positive")
+        config["sim_frames"] = cli.frames
+    args = Namespace(**config)
+    args.nu = getattr(args, "nu", 0.1)
+    args.dual_smoke = getattr(args, "dual_smoke", False)
+    args.epilon_decay = getattr(args, "epilon_decay", 1.0)
+    # Backward compatibility: already generated configs omitted this key and
+    # must reproduce the historical sustained-source baseline.
+    args.ignition_lifetime = getattr(args, "ignition_lifetime", "sustained_source")
+    args.fire_sim_root = str(Path("output") / args.scene / "sim_output")
+    dims = args.voxel_grid["dims"]
+
+    adapter = ScenarioFireSolver(
+        args, dims[0], dims[1], dims[2], args.scene,
+        T_white=args.T_white, T_max=args.T_max, T_air=args.T_air,
+        k=args.k, burn_rate=args.burn_rate, beta=args.beta, alpha=args.alpha,
+        epsilon=args.epsilon, sim_frames=args.sim_frames,
+        load_path=args.load_path, nu=args.nu,
+    )
+    adapter.set_max_iter(30)
