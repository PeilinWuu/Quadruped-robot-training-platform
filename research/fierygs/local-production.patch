+"""Write evidence-based 2.5 cm cost and native smoke audit reports."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    native = np.array([252, 203, 71], dtype=np.int64)
+    fine = native * 2
+    n0, n1 = int(np.prod(native)), int(np.prod(fine))
+    # Explicit FireSolver allocation audit: 15 vector-component floats and 13 scalar floats/cell.
+    floats_per_cell = 28
+    gpu_total = torch.cuda.get_device_properties(0).total_memory
+    cost = {
+        "experiment": "Table HIGH 0.025 m physical-resolution feasibility gate",
+        "native": {"spacing_m": 0.05, "dims_xyz": native.tolist(), "cells": n0},
+        "candidate": {"spacing_m": 0.025, "dims_xyz": fine.tolist(), "cells": n1,
+                      "cell_multiplier": n1 / n0},
+        "hardware": {"gpu": torch.cuda.get_device_name(0), "gpu_memory_bytes": gpu_total,
+                     "gpu_memory_gib": gpu_total / 2**30},
+        "allocation_lower_bound": {
+            "audited_float32_components_per_cell": floats_per_cell,
+            "native_gib": n0 * floats_per_cell * 4 / 2**30,
+            "candidate_gib": n1 * floats_per_cell * 4 / 2**30,
+            "excludes": ["Taichi allocator overhead", "kernel temporaries", "CIE/PyTorch tensors", "input arrays", "driver/runtime memory"],
+        },
+        "output_cost": {"four_float32_fields_per_frame_gib": n1 * 16 / 2**30,
+                        "30_frames_uncompressed_gib": n1 * 16 * 30 / 2**30,
+                        "60_frames_uncompressed_gib": n1 * 16 * 60 / 2**30},
+        "implementation_validity": {
+            "native_solver_dx": 1.0, "native_solver_dt": 0.04,
+            "voxel_size_consumed_by_solver": False,
+            "finding": "FireSolver receives grid dimensions but never physical voxel_size; dx remains 1.0. Doubling dimensions is therefore not a physically comparable 2.5 cm discretization without a numerical-scaling refactor.",
+        },
+        "decision": {
+            "short_run_started": False,
+            "reason": "The requested comparable physical-time experiment is not valid in the native implementation. A naive 2x grid would cost 8x cells while changing the normalized domain/dynamics, so its visual result could not answer the acceptance question.",
+            "quality_justifies_cost": None,
+            "required_follow_up": "Make dx/physical spacing, dt stability and coefficient scaling explicit, then validate convergence on a small cropped domain before a room-scale run.",
+        },
+    }
+    (args.output_dir / "voxel_resolution_cost_quality_report.json").write_text(json.dumps(cost, indent=2) + "\n", encoding="utf-8")
+
+    smoke_md = """# FieryGS native smoke pipeline audit
+
+## Current scalar-smoke path
+
+The current Table HIGH simulation has `dual_smoke=false` and contains no `color/` sequence. The renderer derives the visible smoke from the same saved fuel field used for flames. After trilinear sampling it applies two hard assignments: fuel above `0.6` is removed from smoke, then every remaining sample above `1e-3` becomes `sigma_a=1`. Its default color is constant white `[1,1,1]`. The contribution is added as white emission-like RGB, but it does **not** update the returned background transmittance separately. This explains both the white appearance and voxel-shaped layers when smoke strength is raised.
+
+## Native `dual_smoke` branch
+
+The solver allocates a passive three-channel `color_buffer`, initializes it from `material_grid.npy`, and advects it with the velocity field. `assign_smoke_color()` hard-codes encoded material value `4` to black and all other cells to white. For this office adapter, encoded value `4` means plastic (`material_id 3 + 1`), not a general soot/material rule. The renderer uses this advected color only as `base_color`; it does not add a separate smoke density model, change absorption, or eliminate the hard scalar thresholds.
+
+## Controlled-test decision
+
+A baseline-versus-native-dual render cannot be made from the validated 200-frame state: the required advected color frames were not saved, and velocity was not exported, so they cannot be reconstructed from fuel alone. Re-running with `dual_smoke=true` would create a new passive-color simulation rather than keep the exact validated state. More importantly, the branch's hard-coded `material==4` semantics do not match the current material catalog. It is therefore not a usable native improvement for this scene without first making that mapping scene-aware. No invented smoke model and no solver change were made.
+"""
+    (args.output_dir / "smoke_pipeline_audit.md").write_text(smoke_md, encoding="utf-8")
+    smoke_ablation = {
+        "experiment": "Table HIGH baseline vs native dual_smoke",
+        "status": "not_run_after_native-branch_audit",
+        "baseline": {"dual_smoke": False, "color_sequence_available": False},
+        "native_dual_smoke": {
+            "separate_density_field": False,
+            "separate_advected_color_field": True,
+            "initialization": "material_grid encoded value 4 -> black; every other cell -> white",
+            "semantic_compatibility": "invalid for office catalog: encoded 4 is plastic",
+        },
+        "reason": "No matching advected color sequence exists for the fixed physical run, and the native mapping is not scene-compatible.",
+        "conclusion": "Native dual_smoke, as implemented, is not expected to solve blocky density and cannot be fairly tested on the fixed state.",
+    }
+    (args.output_dir / "smoke_ablation.json").write_text(json.dumps(smoke_ablation, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
+
