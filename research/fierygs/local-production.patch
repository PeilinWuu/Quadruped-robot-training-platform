@@ -0,0 +1,86 @@
+"""Build contact sheets from already-rendered production regression frames."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from PIL import Image, ImageDraw
+
+
+ROOT = Path(r"D:\interiorgs_data\office_01\production_regression\renders")
+FRAMES = (0, 20, 40, 60, 80, 100, 120, 199)
+SCENARIOS = (
+    ("table_high", "Table HIGH"),
+    ("sofa_high", "Sofa HIGH"),
+    ("curtain_high", "Curtain HIGH"),
+)
+FRAME_SIZE = (640, 360)
+LABEL_HEIGHT = 30
+
+
+def load_frame(scenario: str, frame: int) -> Image.Image:
+    path = (
+        ROOT
+        / scenario
+        / f"{scenario}_production_preview_frames"
+        / f"frame_{frame:03d}.png"
+    )
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    image = Image.open(path).convert("RGB")
+    if image.size != FRAME_SIZE:
+        raise ValueError(f"Unexpected image size {image.size}: {path}")
+    return image
+
+
+def labeled(image: Image.Image, text: str) -> Image.Image:
+    tile = Image.new("RGB", (FRAME_SIZE[0], FRAME_SIZE[1] + LABEL_HEIGHT), "white")
+    tile.paste(image, (0, LABEL_HEIGHT))
+    ImageDraw.Draw(tile).text((10, 8), text, fill="black")
+    return tile
+
+
+def build_scenario_sheet(scenario: str, title: str) -> Path:
+    width = FRAME_SIZE[0] * 4
+    height = (FRAME_SIZE[1] + LABEL_HEIGHT) * 2
+    sheet = Image.new("RGB", (width, height), "white")
+    for index, frame in enumerate(FRAMES):
+        tile = labeled(load_frame(scenario, frame), f"{title} | frame {frame}")
+        sheet.paste(tile, ((index % 4) * tile.width, (index // 4) * tile.height))
+    output = ROOT / scenario / f"{scenario}_production_contact_sheet.png"
+    sheet.save(output)
+    return output
+
+
+def build_synchronized_sheet() -> Path:
+    tile_width = FRAME_SIZE[0]
+    tile_height = FRAME_SIZE[1] + LABEL_HEIGHT
+    sheet = Image.new(
+        "RGB", (tile_width * len(FRAMES), tile_height * len(SCENARIOS)), "white"
+    )
+    for row, (scenario, title) in enumerate(SCENARIOS):
+        for column, frame in enumerate(FRAMES):
+            tile = labeled(load_frame(scenario, frame), f"{title} | frame {frame}")
+            sheet.paste(tile, (column * tile_width, row * tile_height))
+    output = ROOT / "production_regression_synchronized_contact_sheet.png"
+    sheet.save(output)
+    return output
+
+
+def main() -> None:
+    outputs = [build_scenario_sheet(*scenario) for scenario in SCENARIOS]
+    outputs.append(build_synchronized_sheet())
+    manifest = {
+        "scenarios": [name for name, _ in SCENARIOS],
+        "frames": list(FRAMES),
+        "source_resolution": list(FRAME_SIZE),
+        "outputs": [str(path.resolve()) for path in outputs],
+    }
+    manifest_path = ROOT / "production_regression_contact_sheets.json"
+    manifest_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == "__main__":
+    main()
