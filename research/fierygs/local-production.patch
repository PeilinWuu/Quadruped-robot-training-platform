+"""Run the resumable Robot Fire Dataset v1 production pipeline."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+DATASET_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+WORK_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1_work")
+FIELDS = ("fuel", "temperature", "occupancy", "wood_temperature", "color")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--phase", choices=("preflight", "precompute", "render", "all"), default="preflight")
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--dataset-root", type=Path, default=DATASET_ROOT)
+    parser.add_argument("--work-root", type=Path, default=WORK_ROOT)
+    return parser.parse_args()
+
+
+def run_module(module: str, *arguments: str) -> None:
+    command = [sys.executable, "-m", module, *map(str, arguments)]
+    print("RUN:", subprocess.list2cmdline(command), flush=True)
+    subprocess.run(command, cwd=REPO_ROOT, check=True)
+
+
+def field_counts(simulation_dir: Path) -> dict[str, int]:
+    return {
+        field: len(list((simulation_dir / field).glob(f"{field}_*.npz")))
+        if (simulation_dir / field).is_dir()
+        else 0
+        for field in FIELDS
+    }
+
+
+def complete(simulation_dir: Path, frames: int) -> bool:
+    return all(value == frames for value in field_counts(simulation_dir).values())
+
+
+def load_manifest(dataset_root: Path) -> dict:
+    return json.loads((dataset_root / "manifests" / "scenario_manifest.json").read_text(encoding="utf-8"))
+
+
+def prepare_manifest(args: argparse.Namespace) -> dict:
+    run_module(
+        "adapter.fire_dataset.prepare_dataset_v1_assets",
+        "--dataset-root",
+        str(args.dataset_root),
+        "--work-root",
+        str(args.work_root),
+    )
+    return load_manifest(args.dataset_root)
+
+
+def preflight(args: argparse.Namespace, manifest: dict) -> dict:
+    camera_report = args.dataset_root / "cameras" / "robot_camera_generation_report.json"
+    camera_preview = args.dataset_root / "previews" / "robot_cameras" / "robot_camera_preview_report.json"
+    checks = {
+        "python": sys.executable,
+        "scenario_count": len(manifest["scenarios"]),
+        "expected_samples": manifest["expected_sample_count"],
+        "camera_report_exists": camera_report.is_file(),
+        "camera_preview_exists": camera_preview.is_file(),
+        "camera_preview_numeric_pass": json.loads(camera_preview.read_text(encoding="utf-8"))["passed_numeric_sanity"]
+        if camera_preview.is_file()
+        else False,
+        "production_profile_frozen": manifest["production_profile"],
+        "simulations": [],
+    }
+    for scenario in manifest["scenarios"]:
+        simulation_dir = Path(scenario["simulation_dir"])
+        counts = field_counts(simulation_dir)
+        checks["simulations"].append(
+            {
+                "scenario_id": scenario["scenario_id"],
+                "required_frames": scenario["simulation_frames"],
+                "counts": counts,
+                "complete": all(value == scenario["simulation_frames"] for value in counts.values()),
+            }
+        )
+    checks["complete_simulations"] = sum(item["complete"] for item in checks["simulations"])
+    checks["pending_simulations"] = [
+        item["scenario_id"] for item in checks["simulations"] if not item["complete"]
+    ]
+    checks["passed_static_inputs"] = bool(
+        checks["scenario_count"] == 9
+        and checks["expected_samples"] == 1080
+        and checks["camera_report_exists"]
+        and checks["camera_preview_numeric_pass"]
+    )
+    report = args.dataset_root / "reports" / "dataset_v1_preflight.json"
+    report.write_text(json.dumps(checks, indent=2), encoding="utf-8")
+    print(json.dumps(checks, indent=2), flush=True)
+    if not checks["passed_static_inputs"]:
+        raise RuntimeError("Dataset v1 static preflight failed")
+    return checks
+
+
+def run_precompute(args: argparse.Namespace, manifest: dict) -> dict:
+    reports = args.work_root / "reports"
+    reports.mkdir(parents=True, exist_ok=True)
+    for scenario in manifest["scenarios"]:
+        simulation_dir = Path(scenario["simulation_dir"])
+        frames = int(scenario["simulation_frames"])
+        if complete(simulation_dir, frames):
+            print(f"SIMULATION SKIP {scenario['scenario_id']}: complete {frames} frames", flush=True)
+            continue
+        diagnostic_frames = sorted({0, frames // 4, frames // 2, (3 * frames) // 4, frames - 1})
+        run_module(
+            "adapter.fire_scenario.run_long_scenario_solver",
+            "--config-file",
+            scenario["simulation_config"],
+            "--frames",
+            str(frames),
+            "--scene",
+            f"{scenario['scenario_name']}_dataset_v1",
+            "--output-dir",
+            str(simulation_dir),
+            "--run-report",
+            str(reports / f"{scenario['scenario_id']}_run_report.json"),
+            "--buffer-report",
+            str(reports / f"{scenario['scenario_id']}_buffer_report.json"),
+            "--verify-export",
+            "--flow-diagnostic-frames",
+            *map(str, diagnostic_frames),
+        )
+        if not complete(simulation_dir, frames):
+            raise RuntimeError(
+                f"Simulation incomplete after successful process: {scenario['scenario_id']} "
+                f"{field_counts(simulation_dir)}"
+            )
+
+    manifest = prepare_manifest(args)
+    for scenario in manifest["scenarios"]:
+        output = args.dataset_root / "metadata" / "temporal" / f"{scenario['scenario_id']}_states.json"
+        run_module(
+            "adapter.fire_dataset.select_temporal_states",
+            "--scenario-manifest",
+            str(args.dataset_root / "manifests" / "scenario_manifest.json"),
+            "--scenario-id",
+            scenario["scenario_id"],
+            "--output",
+            str(output),
+        )
+    run_module(
+        "adapter.fire_dataset.build_sample_manifest",
+        "--dataset-root",
+        str(args.dataset_root),
+    )
+    return load_manifest(args.dataset_root)
+
+
+def run_render(args: argparse.Namespace) -> None:
+    arguments = ["--dataset-root", str(args.dataset_root)]
+    if args.resume:
+        arguments.append("--resume")
+    run_module("adapter.fire_dataset.render_dataset_v1", *arguments)
+
+
+def main() -> None:
+    args = parse_args()
+    manifest = prepare_manifest(args)
+    preflight(args, manifest)
+    if args.phase == "preflight":
+        return
+    if args.phase in {"precompute", "all"}:
+        manifest = run_precompute(args, manifest)
+    if args.phase in {"render", "all"}:
+        pending = [
+            item["scenario_id"]
+            for item in manifest["scenarios"]
+            if not complete(Path(item["simulation_dir"]), int(item["simulation_frames"]))
+        ]
+        if pending:
+            raise RuntimeError(f"Cannot render; incomplete simulations: {pending}")
+        run_render(args)
+
+
+if __name__ == "__main__":
+    main()
