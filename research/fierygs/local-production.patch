@@ -0,0 +1,42 @@
+"""Export bridge labels with a compact FieryGS part ID while preserving PLY order."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--input", type=Path, required=True)
+    parser.add_argument("--instance-id", type=int, default=113)
+    parser.add_argument("--object-name", default="table")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    source = np.load(args.input)
+    # FieryGS material assignment asserts that every Gaussian has a valid part.
+    # Part 1 is a conservative, unburnable catch-all for this single-object test.
+    labels = np.full(source.shape, 1, dtype=np.int32)
+    labels[source == args.instance_id] = 0
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    np.save(args.output, labels)
+    manifest = {
+        "gaussian_count": int(labels.size), "unassigned_value": None,
+        "parts": [
+            {"part_id": 0, "instance_id": str(args.instance_id), "object_name": args.object_name,
+             "gaussian_count": int((labels == 0).sum()), "source": "InteriorGS_bbox_multiview_vote"},
+            {"part_id": 1, "instance_id": None, "object_name": "unassigned_scene",
+             "gaussian_count": int((labels == 1).sum()), "source": "adapter_safe_background",
+             "material_policy": "unburnable"},
+        ],
+        "ordering": "unchanged row order from InteriorGS explicit PLY",
+    }
+    args.output.with_name("parts.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(manifest, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/semantic_bridge/extract_material_voxels.py b/adapter/semantic_bridge/extract_material_voxels.py
