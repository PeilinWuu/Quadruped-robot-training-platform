+            "full_200_frame_render_exists": baseline.exists(),
+            "full_render_action": "reuse" if baseline.exists() else "generate",
+        })
+    payload = {
+        "metadata": {"scenario_name": "office_01_visual_inspection_input_audit", "timestamp": timestamp()},
+        "passed": all(x["simulation_frame_count"] == 200 and x["camera_available"] for x in scenarios),
+        "shared_render_config": {"renderer": "native renderer_with_fire via adapter",
+                                 "fire_strength": 0.05, "smoke_strength": 1.0,
+                                 "coarse_samples": 32, "fine_samples": 128,
+                                 "resolution": [640, 360], "dual_smoke_simulation": False},
+        "scenarios": scenarios,
+    }
+    write_json(args.visual_root / "reports/visual_inspection_input_audit.json", payload)
