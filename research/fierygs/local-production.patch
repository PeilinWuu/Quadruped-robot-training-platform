+"""Merge instrumented HDR distributions and actual core-render comparisons."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+
+def load(path: Path) -> np.ndarray:
+    return np.asarray(Image.open(path).convert("RGB"))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--baseline-stats", type=Path, required=True)
+    parser.add_argument("--hdr-stats", type=Path, required=True)
+    parser.add_argument("--baseline-frames", type=Path, required=True)
+    parser.add_argument("--hdr-frames", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    baseline = json.loads(args.baseline_stats.read_text(encoding="utf-8"))
+    hdr = json.loads(args.hdr_stats.read_text(encoding="utf-8"))
+    records = []
+    for b, h in zip(baseline["frames"], hdr["frames"]):
+        frame = b["frame"]
+        if frame != h["frame"]:
+            raise ValueError("Frame mismatch")
+        before = load(args.baseline_frames / f"frame_{frame:03d}.png")
+        after = load(args.hdr_frames / f"frame_{frame:03d}.png")
+        b_float, h_float = before.astype(np.float32) / 255, after.astype(np.float32) / 255
+        canvas = Image.new("RGB", (before.shape[1] * 2, before.shape[0] + 30), "black")
+        canvas.paste(Image.fromarray(before), (0, 30)); canvas.paste(Image.fromarray(after), (before.shape[1], 30))
+        draw = ImageDraw.Draw(canvas); draw.text((8, 8), "baseline early clip -> ACES", fill="white")
+        draw.text((before.shape[1] + 8, 8), "unclipped HDR -> existing ACES", fill="white")
+        canvas.save(args.output_dir / f"frame_{frame:03d}.png")
+        records.append({
+            "frame": frame,
+            "pre_aces": {
+                "baseline": b["rgb_before_display_mapping"], "hdr": h["rgb_before_display_mapping"],
+                "hdr_gamma_unclipped": h["gamma_rgb_unclipped"],
+            },
+            "final": {
+                "baseline_saturated_channel_percent": float(100 * np.mean(b_float >= 0.99)),
+                "hdr_saturated_channel_percent": float(100 * np.mean(h_float >= 0.99)),
+                "image_mae": float(np.mean(np.abs(h_float - b_float))),
+            },
+        })
+    report = {
+        "feature": "optional unclipped HDR through existing FieryGS ACES stage",
+        "backward_compatible": True,
+        "baseline_switch": "args.hdr_aces=false (default)",
+        "recovered_switch": "args.hdr_aces=true",
+        "fixed_physics": True,
+        "render_settings": {"strength": 0.05, "smoke_strength": 1.0, "samples": [32, 128]},
+        "frames": records,
+        "decision_note": "This test determines whether the previous strength=0.005 workaround remains necessary after the actual native-stage clamp fix.",
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(args.output.resolve())
+
+
+if __name__ == "__main__":
+    main()
