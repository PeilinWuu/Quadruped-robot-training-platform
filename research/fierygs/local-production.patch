+            fuel_np = np.load(args.simulation_dir / f"fuel/fuel_{frame}.npz")["arr_0"]
+            occ_np = np.load(args.simulation_dir / f"occupancy/occupancy_{frame}.npz")["arr_0"]
+            occupancy = torch.from_numpy(occ_np).cuda().float()
+            mapped = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+            keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+            keep[rows] = (~mapped_initial) | ((mapped.abs() >= 0.7) & (mapped.abs() <= 1.0))
