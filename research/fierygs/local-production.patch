@@ -0,0 +1,112 @@
+"""Audit FieryGS' native supplemental material fields on three representatives.
+
+This intentionally does not rewrite the full-scene material catalogue.  It calls
+the repository's GPTtools_supp entry point for one table, sofa and curtain image
+and records the native five-field response for parity analysis.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+from utils.vlm_utils import GPTtools_supp
+
+
+MATERIAL_LIBRARY = (
+    "wood, sand, metal, plastic, glass, fabric, foam, food, ceramic, paper, "
+    "leather, plant, stone, cement, concrete, soil, clay, composite, sky"
+)
+
+PROMPT = f"""The image contains an original scene, a blue target-mask overlay,
+and a cropped target part. Identify the target part and its dominant material.
+Return the native FieryGS supplemental material fields: caption, material,
+burnable/unburnable, thermal diffusivity ratio relative to wood, and typical
+smoke color. Choose material from: {MATERIAL_LIBRARY}. Use an approximate known
+thermal diffusivity ratio and a typical combustion smoke color. Output through
+the required function call only."""
+
+REPRESENTATIVES = {
+    "table": 17,
+    "sofa": 51,
+    "curtain": 14,
+}
+
+
+def parse_native_response(text: str) -> dict:
+    parts = [item.strip() for item in text.split(",")]
+    if len(parts) != 5:
+        raise ValueError(f"Expected five native fields, got {text!r}")
+    caption, material, burnability, ratio, smoke_color = parts
+    ratio_value = float(ratio)
+    if ratio_value <= 0:
+        raise ValueError(f"Thermal diffusivity ratio must be positive: {ratio_value}")
+    return {
+        "caption": caption,
+        "material": material.lower(),
+        "burnability": burnability.lower(),
+        "thermal_diffusivity_ratio_vs_wood": ratio_value,
+        "smoke_color": smoke_color.lower(),
+        "raw_response": text,
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--model-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    image_dir = args.model_dir / "gpt_input" / "gpt_input_single"
+    results = {}
+    if args.output.exists():
+        previous = json.loads(args.output.read_text(encoding="utf-8"))
+        results.update(previous.get("representatives", {}))
+    for object_name, part_id in REPRESENTATIVES.items():
+        if results.get(object_name, {}).get("status") == "complete":
+            print(f"{object_name}: already complete", flush=True)
+            continue
+        image_path = image_dir / f"{part_id:03d}.png"
+        if not image_path.exists():
+            raise FileNotFoundError(image_path)
+        try:
+            response = GPTtools_supp(str(image_path), PROMPT)
+            results[object_name] = {
+                "status": "complete", "part_id": part_id,
+                "image": str(image_path), **parse_native_response(response),
+            }
+            print(f"{object_name}: {response}", flush=True)
+        except Exception as exc:  # Save progress without obscuring API/model failures.
+            results[object_name] = {
+                "status": "failed", "part_id": part_id,
+                "image": str(image_path), "error": f"{type(exc).__name__}: {exc}",
+            }
+            print(f"{object_name}: {type(exc).__name__}: {exc}", flush=True)
+
+    report = {
+        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
+        "scope": "representative_only_no_catalog_overwrite",
+        "native_schema": [
+            "caption", "material", "burnability",
+            "thermal_diffusivity_ratio_vs_wood", "smoke_color",
+        ],
+        "solver_limit": (
+            "Released FireSolver accepts one global beta scalar; these ratios "
+            "are audited but are not silently converted into a per-voxel field."
+        ),
+        "representatives": results,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(f"Saved {args.output}")
+
+
+if __name__ == "__main__":
+    main()
