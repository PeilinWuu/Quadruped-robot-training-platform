@@ -0,0 +1,148 @@
+"""Render adaptive close-up VLM panels for bboxes absent from shared views."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from argparse import Namespace
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+from adapter.create_scene import look_at_colmap
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.common import bbox_corners
+from gaussian_renderer import render
+from scene.cameras import Camera
+from utils.graphics_utils import focal2fov
+
+
+def make_camera(corners: np.ndarray, width: int, height: int, vertical_fov: float) -> tuple[Camera, dict]:
+    lower, upper = corners.min(axis=0), corners.max(axis=0)
+    target = (lower + upper) / 2
+    extent = float(np.max(upper - lower))
+    radius = float(np.clip(extent / (2 * math.tan(math.radians(vertical_fov) / 2)) * 2.2, 0.3, 4.0))
+    direction = np.asarray([1.0, -1.0, 0.55], dtype=np.float64)
+    direction /= np.linalg.norm(direction)
+    position = target + radius * direction
+    fy = height / (2 * math.tan(math.radians(vertical_fov) / 2))
+    rotation, translation = look_at_colmap(position, target, np.asarray([0, 0, 1], dtype=np.float64))
+    camera = Camera(
+        colmap_id=0, R=rotation, T=translation,
+        FoVx=focal2fov(fy, width), FoVy=focal2fov(fy, height),
+        image=torch.zeros((3, height, width)), gt_alpha_mask=None,
+        image_path="", image_name="fallback_bbox", uid=0,
+        cx=width / 2, cy=height / 2, data_device="cuda", preload_img=False,
+    )
+    return camera, {
+        "width": width, "height": height, "fx": fy, "fy": fy,
+        "cx": width / 2, "cy": height / 2,
+        "position": position.tolist(), "target": target.tolist(), "up": [0, 0, 1],
+    }
+
+
+def panel(full: np.ndarray, isolated: np.ndarray, name: str) -> Image.Image:
+    height, width = full.shape[:2]
+    foreground = isolated.mean(axis=2) > 8
+    if foreground.any():
+        foreground = cv2.morphologyEx(
+            foreground.astype(np.uint8), cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8)
+        ).astype(bool)
+        ys, xs = np.nonzero(foreground)
+        x0, x1, y0, y1 = int(xs.min()), int(xs.max()) + 1, int(ys.min()), int(ys.max()) + 1
+    else:
+        # The camera is target-centred, so retain a conservative central crop.
+        x0, x1, y0, y1 = width // 4, 3 * width // 4, height // 4, 3 * height // 4
+        foreground[y0:y1, x0:x1] = True
+    overlay = np.ascontiguousarray(full, dtype=np.float32)
+    blue = np.zeros_like(overlay); blue[..., 0] = 51; blue[..., 1] = 102; blue[..., 2] = 255
+    overlay[foreground] = 0.4 * overlay[foreground] + 0.6 * blue[foreground]
+    overlay = np.ascontiguousarray(np.clip(overlay, 0, 255).astype(np.uint8))
+    cv2.rectangle(overlay, (x0, y0), (x1 - 1, y1 - 1), (255, 0, 0), 2)
+
+    crop = isolated[y0:y1, x0:x1]
+    if not np.any(crop):
+        crop = full[y0:y1, x0:x1]
+    canvas = np.full_like(full, 255)
+    scale = min(height / max(1, crop.shape[0]), width / max(1, crop.shape[1]))
+    resized = cv2.resize(crop, (max(1, int(crop.shape[1] * scale)), max(1, int(crop.shape[0] * scale))))
+    top, left = (height - resized.shape[0]) // 2, (width - resized.shape[1]) // 2
+    canvas[top:top + resized.shape[0], left:left + resized.shape[1]] = resized
+    gap, header = 20, 50
+    grid = np.full((height + header, width * 3 + gap * 4, 3), 255, dtype=np.uint8)
+    for column, image in enumerate((full, overlay, canvas)):
+        start = gap + column * (width + gap)
+        grid[header:, start:start + width] = image
+    result = Image.fromarray(grid, mode="RGB")
+    ImageDraw.Draw(result).text((gap, 15), f"original | masked {name} | isolated bbox", fill=(0, 0, 0))
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--model-dir", type=Path, required=True)
+    parser.add_argument("--width", type=int, default=480)
+    parser.add_argument("--height", type=int, default=270)
+    parser.add_argument("--vertical-fov", type=float, default=55.0)
+    args = parser.parse_args()
+
+    manifest_path = args.model_dir / "parts.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    records = {str(item.get("ins_id")): item for item in json.loads(args.labels.read_text(encoding="utf-8"))}
+    part_labels = np.load(args.model_dir / "points_label_mulscale.npy")
+    gaussians = load_interiorgs_gaussians(args.ply)
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    black = torch.tensor([0.0, 0.0, 0.0], dtype=torch.float32, device="cuda")
+    output_dir = args.model_dir / "gpt_input" / "gpt_input_single"
+    fallback = [part for part in manifest["parts"] if part.get("vlm_status") == "fallback_required"]
+    diagnostics = []
+    with torch.no_grad():
+        for position, part in enumerate(fallback, 1):
+            instance = records[part["instance_id"]]
+            camera, camera_json = make_camera(
+                bbox_corners(instance), args.width, args.height, args.vertical_fov
+            )
+            full_out = render(camera, gaussians, pipeline, background)
+            full = full_out["render"].clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+            selected = part_labels == int(part["part_id"])
+            if selected.any():
+                filtered = torch.from_numpy(~selected).cuda()
+                isolated_out = render(camera, gaussians, pipeline, black, filtered_mask=filtered)
+                isolated = isolated_out["render"].clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+            else:
+                isolated = np.zeros_like(full)
+            target = output_dir / f"{int(part['part_id']):03d}.png"
+            panel(full, isolated, part["object_name"]).save(target)
+            part["vlm_status"] = "ready"
+            part["best_view"] = "adaptive_fallback"
+            diagnostics.append({
+                "part_id": part["part_id"], "instance_id": part["instance_id"],
+                "object_name": part["object_name"], "gaussian_count": part["gaussian_count"],
+                "camera": camera_json, "output": str(target.resolve()),
+            })
+            if position % 25 == 0 or position == len(fallback):
+                print(f"fallback panels {position}/{len(fallback)}", flush=True)
+
+    manifest["vlm_ready_count"] = sum(
+        part.get("vlm_status") == "ready" for part in manifest["parts"] if part.get("instance_id") is not None
+    )
+    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    report = {
+        "fallback_rendered": len(diagnostics), "vlm_ready_count": manifest["vlm_ready_count"],
+        "total_instances": manifest["bbox_count"], "items": diagnostics,
+    }
+    (args.model_dir / "fallback_render_report.json").write_text(
+        json.dumps(report, indent=2) + "\n", encoding="utf-8"
+    )
+    print(json.dumps({key: value for key, value in report.items() if key != "items"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/semantic_bridge/render_gaussian_maps.py b/adapter/semantic_bridge/render_gaussian_maps.py
