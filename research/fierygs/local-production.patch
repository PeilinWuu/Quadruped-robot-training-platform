@@ -0,0 +1,86 @@
+"""Minimal scene/camera adapter for rendering an external InteriorGS PLY."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from scene.cameras import Camera
+from scene.gaussian_model import GaussianModel
+from utils.graphics_utils import focal2fov
+
+
+@dataclass
+class InteriorGSScene:
+    gaussians: GaussianModel
+    cameras: list[Camera]
+    ply_path: Path
+
+
+def look_at_colmap(position: np.ndarray, target: np.ndarray, up: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    """Build FieryGS/3DGS R,T using an OpenCV camera (right, down, forward)."""
+    forward = target - position
+    forward /= np.linalg.norm(forward)
+    right = np.cross(forward, up)
+    right /= np.linalg.norm(right)
+    down = np.cross(forward, right)
+    world_to_camera_rotation = np.stack((right, down, forward), axis=0)
+    translation = -world_to_camera_rotation @ position
+    return world_to_camera_rotation.T.astype(np.float32), translation.astype(np.float32)
+
+
+def camera_from_json(path: str | Path) -> Camera:
+    config = json.loads(Path(path).read_text(encoding="utf-8"))
+    width, height = int(config["width"]), int(config["height"])
+    fx, fy = float(config["fx"]), float(config["fy"])
+    position = np.asarray(config["position"], dtype=np.float64)
+    target = np.asarray(config["target"], dtype=np.float64)
+    up = np.asarray(config.get("up", [0, 0, 1]), dtype=np.float64)
+    rotation, translation = look_at_colmap(position, target, up)
+    image = torch.zeros((3, height, width), dtype=torch.float32)
+    return Camera(
+        colmap_id=0, R=rotation, T=translation,
+        FoVx=focal2fov(fx, width), FoVy=focal2fov(fy, height),
+        image=image, gt_alpha_mask=None, image_path="", image_name="interiorgs_test",
+        uid=0, cx=float(config.get("cx", width / 2)), cy=float(config.get("cy", height / 2)),
+        data_device="cuda", preload_img=False,
+    )
+
+
+def create_scene(ply_path: str | Path, camera_path: str | Path) -> InteriorGSScene:
+    return InteriorGSScene(
+        gaussians=load_interiorgs_gaussians(ply_path),
+        cameras=[camera_from_json(camera_path)],
+        ply_path=Path(ply_path).resolve(),
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    args = parser.parse_args()
+    scene = create_scene(args.ply, args.camera)
+    camera = scene.cameras[0]
+    print(json.dumps({
+        "gaussians": int(scene.gaussians.get_xyz.shape[0]),
+        "sh_degree": scene.gaussians.active_sh_degree,
+        "xyz_shape": list(scene.gaussians.get_xyz.shape),
+        "opacity_shape": list(scene.gaussians.get_opacity.shape),
+        "scaling_shape": list(scene.gaussians.get_scaling.shape),
+        "rotation_shape": list(scene.gaussians.get_rotation.shape),
+        "features_shape": list(scene.gaussians.get_features.shape),
+        "camera_size": [camera.image_width, camera.image_height],
+        "camera_center": camera.camera_center.detach().cpu().tolist(),
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
