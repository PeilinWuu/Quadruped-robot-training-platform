+# FieryGS Long-run Metric Semantics
+
+The meanings below come from `simulation/fire_main.py`; they are not inferred from filenames.
+
+- `fuel`: `coef_pair.cur`, an advected combustion coefficient/gaseous fuel field. Burning
+  solid cells set it to `1.0`; elsewhere it decays by `k * dt`. It is **not remaining solid fuel**.
+- `temperature`: `temperature_pair.cur`, the gas/fire temperature field derived from the
+  current combustion coefficient and subsequently advected. Values are solver-normalized,
+  not Kelvin.
+- `wood_temperature`: `wood_temperature_pair.cur`, the combustible solid's normalized
+  temperature. The native ignition condition is `wood_temperature >= T_ign_wood` where
+  `T_ign_wood = 1.0`.
+- `occupancy`: remaining solid combustible occupancy. It begins at `1.0` for permitted
+  combustible voxels and decreases only when native wood ignition is satisfied. The renderer's
+  original carbonization/removal mapping regards Gaussian-mapped occupancy below `0.7` as the
+  relevant consumed/carbonized regime.
+- `color`: advected native material/smoke color, exported only when `dual_smoke` is enabled.
+- `velocity`: native fluid velocity drives advection and buoyancy. The current scenario
+  exporter does not serialize it, so no velocity statistic is claimed.
+
+Frame `N` is written after native physical step `N` (zero-based). Long-run exports always read
+the active `.cur` member of each double-buffer pair. `occupancy` is a single in-place field.
+
+The staged 60/120/200 runs are deterministic restarts from frame zero because the native solver
+does not expose a complete checkpoint containing every fluid and pressure buffer. Prefix equality
+is checked between stages; pretending to resume from incomplete NPZ fields would be physically
+incorrect.
diff --git a/adapter/fire_scenario/material_voxel_builder.py b/adapter/fire_scenario/material_voxel_builder.py
new file mode 100644
index 0000000..91de65e
--- /dev/null
+++ b/adapter/fire_scenario/material_voxel_builder.py
@@ -0,0 +1,130 @@
+"""Build full-scene material and confirmed-combustibility voxel assets."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import torch
+from plyfile import PlyData
+
+from adapter.fire_scenario.common import MATERIALS, load_scenario, metadata, save_voxel_ply, write_json
+
+
+def load_ply_arrays(path: Path) -> tuple[np.ndarray, np.ndarray]:
+    vertex = PlyData.read(str(path), mmap=True)["vertex"].data
+    xyz = np.stack((vertex["x"], vertex["y"], vertex["z"]), axis=1).astype(np.float32)
+    opacity = np.asarray(vertex["opacity"], dtype=np.float32)
+    return xyz, opacity
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--material-dir", type=Path, required=True)
+    parser.add_argument("--catalog", type=Path, required=True)
+    parser.add_argument("--confirmed", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    xyz, opacity = load_ply_arrays(args.ply)
+    materials = np.load(args.material_dir / "points_materials.npy").astype(np.int32, copy=False)
+    burnability = np.load(args.material_dir / "points_burnability.npy").astype(np.int32, copy=False)
+    instance_ids = np.load(args.material_dir / "gaussian_instance_ids.npy").astype(np.int32, copy=False)
+    if any(array.shape != (len(xyz),) for array in (materials, burnability, instance_ids)):
+        raise ValueError("Gaussian material/instance arrays must match PLY row count")
+    catalog = json.loads(args.catalog.read_text(encoding="utf-8"))
+    confirmed_payload = json.loads(args.confirmed.read_text(encoding="utf-8"))
+    confirmed_ids = np.asarray([item["object_id"] for item in confirmed_payload["confirmed"]], dtype=np.int32)
+
+    bounds_min = np.min(np.asarray([item["bbox_min"] for item in catalog], dtype=np.float64), axis=0)
+    bounds_max = np.max(np.asarray([item["bbox_max"] for item in catalog], dtype=np.float64), axis=0)
+    voxel_config = scenario.get("voxelization", {})
+    voxel_size = float(voxel_config.get("target_voxel_size_m", 0.05))
+    margin = float(voxel_config.get("margin_m", 0.15))
+    lower = np.floor((bounds_min - margin) / voxel_size) * voxel_size
+    upper_required = bounds_max + margin
+    dims = np.ceil((upper_required - lower) / voxel_size).astype(np.int32)
+    upper = lower + dims * voxel_size
+
+    grid_indices = np.floor((xyz - lower) / voxel_size).astype(np.int32)
+    valid = np.all((grid_indices >= 0) & (grid_indices < dims), axis=1) & (instance_ids >= 0)
+    valid_rows = np.flatnonzero(valid)
+    valid_indices = grid_indices[valid]
+    flat = np.ravel_multi_index(valid_indices.T, tuple(dims.tolist()))
+    cell_count = int(np.prod(dims, dtype=np.int64))
+
+    # Faithful vectorized equivalent of FieryGS map_points_to_voxels_materials:
+    # point index = floor((xyz-min)/voxel_size), material cell = material_id+1.
+    # For collisions, the highest-opacity Gaussian deterministically wins.
+    order = np.lexsort((-opacity[valid], flat))
+    sorted_flat = flat[order]
+    first = np.r_[True, sorted_flat[1:] != sorted_flat[:-1]]
+    winners = order[first]
+    material_flat = np.zeros(cell_count, dtype=np.int16)
+    material_flat[flat[winners]] = (materials[valid][winners] + 1).astype(np.int16)
+    material_grid = material_flat.reshape(tuple(dims.tolist()))
+
+    point_confirmed = np.isin(instance_ids, confirmed_ids) & (burnability == 0) & valid
+    confirmed_rows = np.flatnonzero(point_confirmed)
+    confirmed_indices = grid_indices[point_confirmed]
+    confirmed_flat = np.ravel_multi_index(confirmed_indices.T, tuple(dims.tolist()))
+    burnability_flat = np.zeros(cell_count, dtype=np.uint8)
+    burnability_flat[np.unique(confirmed_flat)] = 1
+    burnability_grid = burnability_flat.reshape(tuple(dims.tolist()))
+
+    gaussian_voxel_indices = np.full((len(xyz), 3), -1, dtype=np.int32)
+    gaussian_voxel_indices[valid] = valid_indices
+    mask_confirmed = point_confirmed.astype(bool)
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "material_grid.npy", material_grid)
+    np.save(args.output_dir / "burnability_grid.npy", burnability_grid)
+    np.save(args.output_dir / "combustible_voxel_grid.npy", burnability_grid.astype(np.float32))
+    np.save(args.output_dir / "voxel_grid.npy", burnability_grid.astype(np.float32))
+    np.save(args.output_dir / "gaussian_voxel_indices.npy", gaussian_voxel_indices)
+    torch.save(torch.from_numpy(confirmed_indices.astype(np.int64)), args.output_dir / "indices_pts_in_grids.pth")
+    torch.save(torch.from_numpy(mask_confirmed), args.output_dir / "mask_pts_in_grids.pth")
+    save_voxel_ply(burnability_grid, lower, voxel_size, args.output_dir / "combustible_voxels.ply", (230, 132, 34))
+
+    material_distribution = {}
+    for encoded_id, count in zip(*np.unique(material_grid[material_grid > 0], return_counts=True)):
+        material_distribution[MATERIALS[int(encoded_id) - 1]] = int(count)
+    report = {
+        "metadata": metadata(scenario, len(xyz), [
+            args.scenario, args.ply, args.material_dir / "points_materials.npy",
+            args.material_dir / "points_burnability.npy", args.material_dir / "gaussian_instance_ids.npy",
+            args.catalog, args.confirmed,
+        ]),
+        "mapping": "FieryGS floor((xyz-min)/voxel_size), material_id_plus_one; vectorized collision resolution by opacity",
+        "voxel_resolution": dims.tolist(), "voxel_size_m": voxel_size,
+        "bounding_box": {"min": lower.tolist(), "max": upper.tolist()},
+        "semantic_gaussians_in_domain": int(len(valid_rows)),
+        "confirmed_combustible_objects": int(len(confirmed_ids)),
+        "confirmed_combustible_gaussians": int(len(confirmed_rows)),
+        "occupied_material_voxels": int((material_grid > 0).sum()),
+        "combustible_voxel_count": int(burnability_grid.sum()),
+        "material_distribution_voxels": material_distribution,
+        "artifacts": [
+            "material_grid.npy", "burnability_grid.npy", "combustible_voxel_grid.npy", "voxel_grid.npy",
+            "gaussian_voxel_indices.npy", "indices_pts_in_grids.pth", "mask_pts_in_grids.pth",
+            "combustible_voxels.ply",
+        ],
+    }
+    write_json(args.output_dir / "material_voxel_report.json", report)
+    write_json(args.output_dir / "artifact_manifest.json", {
+        "metadata": report["metadata"],
+        "artifacts": [
+            {"file": name, "metadata_sidecar": "material_voxel_report.json"}
+            for name in report["artifacts"]
+        ],
+    })
+    print(json.dumps({key: value for key, value in report.items() if key != "metadata"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
