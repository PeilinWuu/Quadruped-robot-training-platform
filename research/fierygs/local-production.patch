new file mode 100644
index 0000000..59973c2
--- /dev/null
+++ b/adapter/semantic_bridge/generate_views.py
@@ -0,0 +1,66 @@
+"""Generate deterministic orbit cameras around one InteriorGS instance."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+from adapter.semantic_bridge.common import bbox_corners, load_instance
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--instance-id", default="113")
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--views", type=int, default=24)
+    parser.add_argument("--width", type=int, default=640)
+    parser.add_argument("--height", type=int, default=360)
+    parser.add_argument("--vertical-fov", type=float, default=60.0)
+    parser.add_argument("--radius", type=float, default=1.8)
+    args = parser.parse_args()
+    if args.views < 3:
+        raise ValueError("At least three views are required")
+
+    instance = load_instance(args.labels, args.instance_id)
+    corners = bbox_corners(instance)
+    lower, upper = corners.min(axis=0), corners.max(axis=0)
+    target = (lower + upper) / 2
+    target[2] = lower[2] + 0.55 * (upper[2] - lower[2])
+    fy = args.height / (2 * math.tan(math.radians(args.vertical_fov) / 2))
+    elevations = (0.95, 1.35, 1.75)
+    cameras = []
+    for index in range(args.views):
+        azimuth = 2 * math.pi * index / args.views
+        ring = index % len(elevations)
+        position = target + np.array([
+            args.radius * math.cos(azimuth),
+            args.radius * math.sin(azimuth),
+            elevations[ring] - target[2],
+        ])
+        cameras.append({
+            "id": index,
+            "width": args.width, "height": args.height,
+            "fx": fy, "fy": fy, "cx": args.width / 2, "cy": args.height / 2,
+            "position": position.tolist(), "target": target.tolist(), "up": [0, 0, 1],
+            "azimuth_degrees": math.degrees(azimuth), "camera_height": elevations[ring],
+        })
+    payload = {
+        "coordinate_system": "InteriorGS original XYZ: right, back, up; metres",
+        "camera_convention": "OpenCV right/down/forward look-at",
+        "instance_id": str(args.instance_id), "object_name": instance["label"],
+        "bbox_lower": lower.tolist(), "bbox_upper": upper.tolist(),
+        "cameras": cameras,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"output": str(args.output.resolve()), "views": len(cameras), "target": target.tolist()}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
+
diff --git a/adapter/semantic_bridge/map_native_materials.py b/adapter/semantic_bridge/map_native_materials.py
