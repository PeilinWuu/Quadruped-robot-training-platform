index 0000000..48c0ea0
--- /dev/null
+++ b/adapter/semantic_bridge/extract_material_voxels.py
@@ -0,0 +1,204 @@
+"""Run FieryGS native material-aware point-to-voxel extraction on InteriorGS."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from PIL import Image, ImageDraw
+from plyfile import PlyData, PlyElement
+from scipy import ndimage
+
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from extract_voxel import create_voxel_grid, map_points_to_voxels_materials
+
+
+def save_voxel_ply(voxels: np.ndarray, lower: np.ndarray, voxel_size: np.ndarray, path: Path) -> None:
+    indices = np.argwhere(voxels > 0)
+    centers = lower + (indices + 0.5) * voxel_size
+    data = np.empty(len(centers), dtype=[
+        ("x", "f4"), ("y", "f4"), ("z", "f4"),
+        ("red", "u1"), ("green", "u1"), ("blue", "u1"),
+    ])
+    data["x"], data["y"], data["z"] = centers[:, 0], centers[:, 1], centers[:, 2]
+    data["red"], data["green"], data["blue"] = 230, 132, 34
+    PlyData([PlyElement.describe(data, "vertex")]).write(str(path))
+
+
+def save_preview(voxels: np.ndarray, ignition_min: np.ndarray, ignition_max: np.ndarray, path: Path) -> None:
+    ignition = np.zeros_like(voxels, dtype=bool)
+    ignition[
+        ignition_min[0]:ignition_max[0],
+        ignition_min[1]:ignition_max[1],
+        ignition_min[2]:ignition_max[2],
+    ] = True
+    panels = [
+        (voxels.max(axis=2).T[::-1], ignition.max(axis=2).T[::-1], "XY top"),
+        (voxels.max(axis=1).T[::-1], ignition.max(axis=1).T[::-1], "XZ front"),
+        (voxels.max(axis=0).T[::-1], ignition.max(axis=0).T[::-1], "YZ side"),
+    ]
+    size = voxels.shape[0]
+    canvas = Image.new("RGB", (size * 3, size + 26), (8, 12, 16))
+    draw = ImageDraw.Draw(canvas)
+    for panel_index, (fuel, ignite, label) in enumerate(panels):
+        rgb = np.zeros((size, size, 3), dtype=np.uint8)
+        rgb[fuel > 0] = (230, 132, 34)
+        rgb[(ignite > 0) & (fuel > 0)] = (255, 45, 45)
+        canvas.paste(Image.fromarray(rgb), (panel_index * size, 0))
+        draw.text((panel_index * size + 5, size + 7), label, fill=(215, 225, 232))
+    canvas.save(path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--material-dir", type=Path, required=True)
+    parser.add_argument("--fire-roi", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--grid-resolution", type=int, default=None,
+                        help="Override the cubic grid resolution from fire_roi.json")
+    args = parser.parse_args()
+
+    output_dir = args.output_dir.resolve()
+    output_dir.mkdir(parents=True, exist_ok=True)
+    roi = json.loads(args.fire_roi.read_text(encoding="utf-8"))
+    dims = np.asarray(roi["grid"]["dimensions"], dtype=np.int64)
+    if args.grid_resolution is not None:
+        if args.grid_resolution < 16:
+            raise ValueError("grid-resolution must be at least 16")
+        dims = np.repeat(args.grid_resolution, 3).astype(np.int64)
+    lower_np = np.asarray(roi["grid"]["lower"], dtype=np.float32)
+    upper_np = np.asarray(roi["grid"]["upper"], dtype=np.float32)
+    if len(set(dims.tolist())) != 1:
+        raise ValueError("FieryGS create_voxel_grid currently requires a cubic grid")
+
+    gaussians = load_interiorgs_gaussians(args.ply)
+    labels_np = np.load(args.material_dir / "points_label_mulscale.npy")
+    materials_np = np.load(args.material_dir / "points_materials.npy")
+    burnability_np = np.load(args.material_dir / "points_burnability.npy")
+    count = int(gaussians.get_xyz.shape[0])
+    if any(array.shape != (count,) for array in (labels_np, materials_np, burnability_np)):
+        raise ValueError("Part/material/burnability arrays must match the Gaussian count")
+
+    burnability = torch.from_numpy(burnability_np).cuda()
+    materials = torch.from_numpy(materials_np).cuda()
+    lower = torch.from_numpy(lower_np).cuda()
+    upper = torch.from_numpy(upper_np).cuda()
+    points = gaussians.get_xyz
+    inside_domain = torch.all((points >= lower) & (points < upper), dim=1)
+    selected = (burnability == 0) & inside_domain
+    selected_count = int(selected.sum())
+    if selected_count == 0:
+        raise RuntimeError("No burnable Gaussian lies inside the configured simulation domain")
+    if not np.all(labels_np[burnability_np == 0] == 0):
+        raise RuntimeError("A burnable Gaussian does not belong to table part 0")
+    if not np.all(materials_np[burnability_np == 0] == 0):
+        raise RuntimeError("A burnable Gaussian is not mapped to FieryGS wood material ID 0")
+
+    voxel_grid, grid_size = create_voxel_grid(lower, upper, voxel_size=int(dims[0]))
+    previous_cwd = Path.cwd()
+    try:
+        os.chdir(output_dir)  # The native mapper writes its opacity diagnostic to cwd.
+        voxel_grid, material_grid, indices = map_points_to_voxels_materials(
+            points[selected].detach(), lower, gaussians.get_opacity[selected].detach(), grid_size,
+            voxel_grid, materials[selected],
+        )
+    finally:
+        os.chdir(previous_cwd)
+
+    voxel_np = voxel_grid.cpu().numpy().astype(np.int32)
+    material_np = material_grid.cpu().numpy().astype(np.int64)
+    selected_rows = torch.nonzero(selected, as_tuple=False).squeeze(1)
+    if indices.shape[0] != selected_rows.shape[0]:
+        raise RuntimeError("Some selected Gaussians fell outside the voxel grid")
+    np.save(output_dir / "voxel_grid.npy", voxel_np)
+    np.save(output_dir / "material_grid.npy", material_np)
+    torch.save(indices.cpu(), output_dir / "indices_pts_in_grids.pth")
+    torch.save(selected.cpu(), output_dir / "mask_pts_in_grids.pth")
+
+    occupied = np.argwhere(voxel_np > 0)
+    occupied_min, occupied_max = occupied.min(axis=0), occupied.max(axis=0)
+    voxel_size_np = grid_size.detach().cpu().numpy()
+    fuel_lower = lower_np + occupied_min * voxel_size_np
+    fuel_upper = lower_np + (occupied_max + 1) * voxel_size_np
+    components, component_count = ndimage.label(voxel_np > 0, structure=ndimage.generate_binary_structure(3, 1))
+    component_sizes = np.bincount(components.ravel())[1:]
+
+    ignition_lower = np.asarray(roi["ignition"]["lower"], dtype=np.float32)
+    ignition_upper = np.asarray(roi["ignition"]["upper"], dtype=np.float32)
+    ignition_min = np.floor((ignition_lower - lower_np) / voxel_size_np).astype(np.int64)
+    ignition_max = np.ceil((ignition_upper - lower_np) / voxel_size_np).astype(np.int64)
+    ignition_min = np.clip(ignition_min, 0, dims - 1)
+    ignition_max = np.clip(ignition_max, ignition_min + 1, dims)
+    ignition_fuel = int(voxel_np[
+        ignition_min[0]:ignition_max[0],
+        ignition_min[1]:ignition_max[1],
+        ignition_min[2]:ignition_max[2],
+    ].sum())
+
+    # These files describe exactly the solver's state before its first step.
+    fuel_coefficient = np.zeros_like(voxel_np, dtype=np.float32)
+    wood_temperature = np.zeros_like(voxel_np, dtype=np.float32)
+    ignition_slices = tuple(slice(ignition_min[i], ignition_max[i]) for i in range(3))
+    wood_temperature[ignition_slices] = (voxel_np[ignition_slices] > 0).astype(np.float32) * 1.2
+    np.save(output_dir / "fuel_occupancy_initial.npy", voxel_np.astype(np.float32))
+    np.save(output_dir / "fuel_coefficient_initial.npy", fuel_coefficient)
+    np.save(output_dir / "wood_temperature_initial.npy", wood_temperature)
+
+    save_voxel_ply(voxel_np, lower_np, voxel_size_np, output_dir / "fuel_voxels.ply")
+    save_preview(voxel_np, ignition_min, ignition_max, output_dir / "fuel_voxels.png")
+    simulation_config = {
+        "voxel_grid": {"dims": dims.tolist(), "voxel_size": float(voxel_size_np[0])},
+        "bounding_box": {"min": lower_np.tolist(), "max": upper_np.tolist()},
+        "ignition_box": {"min": ignition_min.tolist(), "max_exclusive": ignition_max.tolist()},
+        "load_path": str((output_dir / "voxel_grid.npy").resolve()).replace("\\", "/"),
+        "load_path_indices_pts_in_grids": str((output_dir / "indices_pts_in_grids.pth").resolve()).replace("\\", "/"),
+        "load_path_mask_pts_in_grids": str((output_dir / "mask_pts_in_grids.pth").resolve()).replace("\\", "/"),
+        "material_path": str((output_dir / "material_grid.npy").resolve()).replace("\\", "/"),
+    }
+    (output_dir / "simulation_voxel.yaml").write_text(yaml.safe_dump(simulation_config, sort_keys=False), encoding="utf-8")
+
+    occupied_count = int((voxel_np > 0).sum())
+    largest_count = int(component_sizes.max(initial=0))
+    largest_fraction = largest_count / occupied_count if occupied_count else 0.0
+    validation_issues = []
+    if ignition_fuel == 0:
+        validation_issues.append("ignition region does not intersect fuel")
+    if int((material_np == 1).sum()) != occupied_count:
+        validation_issues.append("not every occupied voxel is encoded as wood")
+    if largest_fraction < 0.5:
+        validation_issues.append("largest 6-neighbor component contains less than 50% of fuel voxels")
+    diagnostics = {
+        "source": "FieryGS extract_voxel.create_voxel_grid + map_points_to_voxels_materials",
+        "gaussian_count": count,
+        "table_part_id": 0, "table_material": "wood", "table_material_id": 0,
+        "burnability_id": 0, "combustible_gaussians": selected_count,
+        "combustible_voxels": occupied_count,
+        "wood_voxels": int((material_np == 1).sum()),
+        "material_grid_values": np.unique(material_np).tolist(),
+        "grid_dimensions": dims.tolist(), "voxel_size_m": voxel_size_np.tolist(),
+        "simulation_domain": {"min": lower_np.tolist(), "max": upper_np.tolist()},
+        "fuel_region_bbox_m": {"min": fuel_lower.tolist(), "max": fuel_upper.tolist()},
+        "connected_components_6_neighbor": int(component_count),
+        "largest_component_voxels": largest_count,
+        "largest_component_fraction": largest_fraction,
+        "ignition_box_indices": {"min": ignition_min.tolist(), "max_exclusive": ignition_max.tolist()},
+        "ignition_fuel_voxels": ignition_fuel,
+        "validation_passed": not validation_issues,
+        "validation_issues": validation_issues,
+    }
+    (output_dir / "voxel_diagnostics.json").write_text(json.dumps(diagnostics, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(diagnostics, indent=2))
+    if occupied_count != int((material_np == 1).sum()):
+        raise RuntimeError("Not every occupied voxel is encoded as wood")
+    if ignition_fuel == 0:
+        raise RuntimeError("Configured ignition region does not intersect material-aware fuel")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/semantic_bridge/gaussian_vote.py b/adapter/semantic_bridge/gaussian_vote.py
new file mode 100644
index 0000000..4d2ca5e
--- /dev/null
+++ b/adapter/semantic_bridge/gaussian_vote.py
@@ -0,0 +1,104 @@
+"""Accumulate visible/inside votes from RGB24 Gaussian ID maps."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+from plyfile import PlyData
+
+from adapter.semantic_bridge.common import bbox_corners, decode_ids, load_instance, points_in_oriented_bbox
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--views-dir", type=Path, required=True)
+    parser.add_argument("--object-name", default="table")
+    parser.add_argument("--instance-id", type=int, default=113)
+    parser.add_argument("--gaussian-count", type=int, required=True)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--min-visible-views", type=int, default=3)
+    parser.add_argument("--threshold", type=float, default=0.7)
+    parser.add_argument("--bbox-padding", type=float, default=0.02)
+    parser.add_argument("--floor-clearance", type=float, default=0.03)
+    parser.add_argument("--overlap-padding", type=float, default=0.005)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    visible = np.zeros(args.gaussian_count, dtype=np.uint16)
+    inside = np.zeros(args.gaussian_count, dtype=np.uint16)
+    view_dirs = sorted(p for p in args.views_dir.glob("view_*") if p.is_dir())
+    if not view_dirs:
+        raise FileNotFoundError(f"No view_* directories under {args.views_dir}")
+    for view_dir in view_dirs:
+        ids = decode_ids(np.asarray(Image.open(view_dir / "gaussian_id.png").convert("RGB")))
+        mask = np.asarray(Image.open(view_dir / f"{args.object_name}_mask.png").convert("L")) > 0
+        visible_ids = np.unique(ids[ids >= 0])
+        inside_ids = np.unique(ids[(ids >= 0) & mask])
+        visible[visible_ids] += 1
+        inside[inside_ids] += 1
+    scores = np.divide(inside, visible, out=np.zeros(args.gaussian_count, dtype=np.float32), where=visible > 0)
+    ply = PlyData.read(str(args.ply), mmap=True)
+    vertex = ply["vertex"].data
+    xyz = np.stack((np.asarray(vertex["x"]), np.asarray(vertex["y"]), np.asarray(vertex["z"])), axis=1)
+    if len(xyz) != args.gaussian_count:
+        raise ValueError(f"PLY has {len(xyz)} vertices, expected {args.gaussian_count}")
+    instance = load_instance(args.labels, str(args.instance_id))
+    spatial_candidate = points_in_oriented_bbox(
+        xyz, bbox_corners(instance), padding=args.bbox_padding, floor_clearance=args.floor_clearance
+    )
+    target_corners = bbox_corners(instance)
+    target_lower, target_upper = target_corners.min(axis=0), target_corners.max(axis=0)
+    all_instances = json.loads(args.labels.read_text(encoding="utf-8"))
+    conflict = np.zeros(args.gaussian_count, dtype=bool)
+    candidate_rows = np.flatnonzero(spatial_candidate)
+    candidate_xyz = xyz[candidate_rows]
+    overlapping_instances = []
+    for other in all_instances:
+        if str(other.get("ins_id")) == str(args.instance_id) or len(other.get("bounding_box", [])) != 8:
+            continue
+        other_corners = bbox_corners(other)
+        other_lower, other_upper = other_corners.min(axis=0), other_corners.max(axis=0)
+        if np.any(other_upper < target_lower) or np.any(other_lower > target_upper):
+            continue
+        local_conflict = points_in_oriented_bbox(
+            candidate_xyz, other_corners, padding=args.overlap_padding, floor_clearance=-args.overlap_padding
+        )
+        if local_conflict.any():
+            conflict[candidate_rows[local_conflict]] = True
+            overlapping_instances.append({
+                "instance_id": str(other.get("ins_id")), "label": other.get("label"),
+                "excluded_candidates": int(local_conflict.sum()),
+            })
+    vote_candidate = (visible >= args.min_visible_views) & (scores >= args.threshold)
+    assigned = vote_candidate & spatial_candidate & ~conflict
+    labels = np.full(args.gaussian_count, -1, dtype=np.int32)
+    labels[assigned] = args.instance_id
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    np.save(args.output, labels)
+    np.save(args.output.with_name("gaussian_vote_scores.npy"), scores)
+    np.save(args.output.with_name("gaussian_visible_views.npy"), visible)
+    report = {
+        "views": len(view_dirs), "gaussian_count": args.gaussian_count,
+        "instance_id": args.instance_id, "object_name": args.object_name,
+        "min_visible_views": args.min_visible_views, "threshold": args.threshold,
+        "bbox_padding_m": args.bbox_padding, "floor_clearance_m": args.floor_clearance,
+        "ever_visible": int((visible > 0).sum()),
+        "vote_candidates_before_spatial_gate": int(vote_candidate.sum()),
+        "oriented_bbox_candidates": int(spatial_candidate.sum()),
+        "overlapping_instance_count": len(overlapping_instances),
+        "conflict_candidates": int((spatial_candidate & conflict).sum()),
+        "overlapping_instances": overlapping_instances,
+        "assigned_gaussians": int(assigned.sum()),
+        "assigned_score_min": float(scores[assigned].min()) if assigned.any() else None,
+        "assigned_score_mean": float(scores[assigned].mean()) if assigned.any() else None,
+    }
+    args.output.with_name("gaussian_vote_report.json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
