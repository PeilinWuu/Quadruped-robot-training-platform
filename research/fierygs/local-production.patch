@@ -0,0 +1,82 @@
+"""Measure the released FieryGS Phong pass on fixed Table HIGH states."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+from adapter.create_scene import create_scene
+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+
+
+def stats(tensor: torch.Tensor) -> dict:
+    x = tensor.detach().float()
+    return {"mean": float(x.mean()), "max": float(x.max()),
+            "affected_channel_percent_gt_1e-6": float(100 * (x.abs() > 1e-6).float().mean())}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True); parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True); parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True); parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True); parser.add_argument("--frames", default="20,60")
+    args = parser.parse_args(); args.output_dir.mkdir(parents=True, exist_ok=True)
+    scene = create_scene(args.ply, args.camera); gaussians, camera = scene.gaussians, scene.cameras[0]
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    rows = torch.nonzero(mask, as_tuple=False).squeeze(1)
+    initial = torch.from_numpy(np.load(args.simulation_dir / "occupancy/occupancy_0.npz")["arr_0"]).cuda().float()
+    mapped_initial = initial[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    bbox = json.loads(args.voxel_report.read_text(encoding="utf-8"))["bounding_box"]
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    render_args = Namespace(dual_smoke=False, hdr_aces=False, near=0.1, far=6.0, num_samples_coarse=32,
+        num_samples_fine=128, sampling_smooth_factor=0.5, sampling_chunk_size=32,
+        spec_intensity=1e-8, strength=0.05, smoke_strength=1.0, sigma_a=1.0,
+        render_smoke=True, darkness=1.0, ks=0.5, bounding_box=bbox, collect_phong_diagnostics=True)
+    converter = TemperatureToRGB(T_max=12000, device="cuda"); fuel2temp = FuelToTemperatureLUT(device="cuda")
+    background = torch.tensor([0.04, 0.04, 0.04], device="cuda")
+    records = []
+    with torch.no_grad():
+        for frame in map(int, args.frames.split(",")):
+            fuel = torch.from_numpy(np.load(args.simulation_dir / f"fuel/fuel_{frame}.npz")["arr_0"]).cuda().float()
+            occ = torch.from_numpy(np.load(args.simulation_dir / f"occupancy/occupancy_{frame}.npz")["arr_0"]).cuda().float()
+            mapped = occ[indices[:, 0], indices[:, 1], indices[:, 2]]
+            keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+            keep[rows] = (~mapped_initial) | ((mapped.abs() >= 0.7) & (mapped.abs() <= 1.0))
+            carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), device="cuda")
+            carbon[rows[mapped_initial]] = mapped[mapped_initial, None].repeat(1, 3)
+            gaussians.update_per_frame(keep, 0.7, carbon)
+            query = fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+            no = render_fire(camera, gaussians, pipeline, background, query_tensor=query, temp2rgb_converter=converter,
+                             args=render_args, scale_ratio=0.12, add_sepc_light=False, fuel2temp=fuel2temp)
+            yes = render_fire(camera, gaussians, pipeline, background, query_tensor=query, temp2rgb_converter=converter,
+                              args=render_args, scale_ratio=0.12, add_sepc_light=True, fuel2temp=fuel2temp)
+            a, b = no["render"].clamp(0,1), yes["render"].clamp(0,1)
+            au8 = a.mul(255).byte().permute(1,2,0).cpu().numpy(); bu8 = b.mul(255).byte().permute(1,2,0).cpu().numpy()
+            canvas = Image.new("RGB", (camera.image_width*2, camera.image_height+30), "black")
+            canvas.paste(Image.fromarray(au8),(0,30)); canvas.paste(Image.fromarray(bu8),(camera.image_width,30))
+            draw=ImageDraw.Draw(canvas); draw.text((8,8),"without native Phong",fill="white"); draw.text((camera.image_width+8,8),"with native Phong",fill="white")
+            canvas.save(args.output_dir/f"frame_{frame:03d}.png")
+            diff=(b-a).abs()
+            records.append({"frame":frame,"light_voxels":yes["phong_light_voxel_count"],
+                "valid_normal_pixels":yes["phong_valid_normal_pixel_count"],"total_pixels":camera.image_width*camera.image_height,
+                "phong_rgb":stats(yes["phong_map"]),"diffuse_xyz_unscaled":stats(yes["phong_diffuse_xyz"]),
+                "specular_xyz_unscaled":stats(yes["phong_specular_xyz"]),"final_image_difference":stats(diff),
+                "affected_pixel_percent":float(100*(diff.max(0).values>1e-6).float().mean())})
+            print(f"frame {frame} lights={records[-1]['light_voxels']} affected={records[-1]['affected_pixel_percent']:.3f}%",flush=True)
+    report={"feature":"released FieryGS volumetric-light Phong pass","adapter_bypassed":True,
+            "adapter_location":"tools/render_material_fire_video.py previously hard-coded add_sepc_light=False",
+            "settings":{"spec_intensity":1e-8,"ks":0.5},"frames":records}
+    args.output.parent.mkdir(parents=True,exist_ok=True); args.output.write_text(json.dumps(report,indent=2)+"\n",encoding="utf-8")
+    print(args.output.resolve())
+
+if __name__ == "__main__": main()
