+from __future__ import annotations
+import argparse, json, math
+from pathlib import Path
+import numpy as np
+
+DEFAULT_ADJ=0.5
+CONTACT_EPS=0.01
+VERT_EPS=0.15
+
+def load_json(p): return json.loads(p.read_text(encoding='utf-8'))
+def bbox(item):
+    lo=np.asarray(item.get('bbox_min') or item.get('bbox',{}).get('min'),dtype=float)
+    hi=np.asarray(item.get('bbox_max') or item.get('bbox',{}).get('max'),dtype=float)
+    if lo.shape!=(3,) or hi.shape!=(3,) or not np.all(np.isfinite(np.r_[lo,hi])) or np.any(hi<lo): raise ValueError(f'invalid bbox for {item}')
+    return lo,hi
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument('input_dir',type=Path); ap.add_argument('--output-dir',type=Path); ap.add_argument('--adjacency-threshold',type=float,default=DEFAULT_ADJ); args=ap.parse_args()
+    inp=args.input_dir; out=args.output_dir or inp.parent/'semantic_graph'; out.mkdir(parents=True,exist_ok=True)
+    catalog=load_json(inp/'objects_material_catalog.json'); parts=load_json(inp/'parts.json')
+    part_by={str(x.get('instance_id',x.get('part_id'))):x for x in parts.get('parts',[])}
+    nodes=[]; boxes={}
+    for i,item in enumerate(catalog):
+        lo,hi=bbox(item); size=hi-lo; center=(lo+hi)/2
+        iid=str(item.get('instance_id',item.get('part_id',i))); p=part_by.get(iid,{})
+        node={'id':int(item.get('part_id',i)),'instance_id':iid,'category':item.get('object_name','unknown'),'material':item.get('material','unknown'),'burnability':item.get('burnability','unknown'),'burnability_confidence':item.get('confidence'),'gaussian_count':int(item.get('gaussian_count',p.get('gaussian_count',0))),'bbox':{'min':lo.tolist(),'max':hi.tolist()},'center':center.tolist(),'size':size.tolist(),'height':float(size[2]),'quality_status':item.get('quality_status',item.get('material_status',p.get('gaussian_mapping_status','unknown')))}
+        nodes.append(node); boxes[node['id']]=(lo,hi)
+    edges=[]; adj_count=contact_count=overlap_count=0; rel_counts={k:0 for k in ['above','below','same_level']}; distances=[]
+    for ai,a in enumerate(nodes):
+      alo,ahi=boxes[a['id']]
+      for b in nodes[ai+1:]:
+        blo,bhi=boxes[b['id']]
+        gap=np.maximum(np.maximum(blo-ahi,alo-bhi),0); dist=float(np.linalg.norm(gap)); distances.append(dist)
+        inter=np.maximum(np.minimum(ahi,bhi)-np.maximum(alo,blo),0); iv=float(np.prod(inter)); va=float(np.prod(ahi-alo)); vb=float(np.prod(bhi-blo)); overlap=float(iv/max(min(va,vb),1e-12))
+        dz=float(b['center'][2]-a['center'][2]); vr='above' if dz>VERT_EPS else 'below' if dz < -VERT_EPS else 'same_level'
+        adjacency=dist < args.adjacency_threshold; contact=bool(overlap>0 or (dist<=CONTACT_EPS and not adjacency))
+        if not (adjacency or contact or overlap>0 or vr!='same_level'): continue
+        e={'source':a['id'],'target':b['id'],'distance_m':dist,'overlap_ratio':overlap,'adjacency':adjacency,'contact':contact,'vertical_relation':vr,'confidence':'derived_bbox','derivation_method':'aabb_gap_overlap_center'}; edges.append(e)
+        adj_count+=adjacency; contact_count+=contact; overlap_count+=overlap>0; rel_counts[vr]+=1
+    report={'total_nodes':len(nodes),'total_edges':len(edges),'adjacency_count':adj_count,'contact_count':contact_count,'overlap_count':overlap_count,'vertical_relation_counts':rel_counts,'distance_distribution':{'min':min(distances) if distances else None,'mean':float(np.mean(distances)) if distances else None,'max':max(distances) if distances else None},'burnable_nodes':sum(n['burnability']=='burnable' for n in nodes),'unburnable_nodes':sum(n['burnability']=='unburnable' for n in nodes),'parameters':{'adjacency_threshold_m':args.adjacency_threshold,'contact_surface_threshold_m':CONTACT_EPS,'vertical_epsilon_m':VERT_EPS},'derivation':'bbox only'}
+    (out/'semantic_graph.json').write_text(json.dumps({'schema_version':1,'nodes':nodes,'edges':edges},ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
+    with (out/'semantic_graph_edges.jsonl').open('w',encoding='utf-8') as f:
+      for e in edges: f.write(json.dumps(e,ensure_ascii=False)+'\n')
+    (out/'semantic_graph_report.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
+    nearest=sorted(edges,key=lambda e:e['distance_m'])[:20]; burn={n['id'] for n in nodes if n['burnability']=='burnable'}; bn=[e for e in edges if e['source'] in burn or e['target'] in burn]; bn=sorted(bn,key=lambda e:e['distance_m'])[:20]
+    lines=['# Semantic Graph Debug Report','',f"Nodes: {len(nodes)}",f"Edges: {len(edges)}",'','## 最近的20组对象','']
+    for e in nearest: lines.append(f"- {e['source']} ↔ {e['target']} · distance: {e['distance_m']:.3f}m · adjacency={e['adjacency']} · contact={e['contact']}")
+    lines += ['','## 可燃对象最近邻','']
+    for e in bn: lines.append(f"- {e['source']} ↔ {e['target']} · distance: {e['distance_m']:.3f}m")
+    (out/'graph_debug_report.md').write_text('\n'.join(lines)+'\n',encoding='utf-8')
+    print(json.dumps({'output_dir':str(out.resolve()),'nodes':len(nodes),'edges':len(edges)},ensure_ascii=False))
