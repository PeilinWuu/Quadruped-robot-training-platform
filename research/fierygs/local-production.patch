+"""Project all eight corners of an InteriorGS 3D bbox into every view."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from PIL import Image
+
+from adapter.semantic_bridge.common import bbox_corners, load_cameras, load_instance, projected_bbox_mask
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--instance-id", default="113")
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--views-dir", type=Path, required=True)
+    args = parser.parse_args()
+    instance = load_instance(args.labels, args.instance_id)
+    corners = bbox_corners(instance)
+    records = []
+    for index, camera in enumerate(load_cameras(args.cameras)):
+        mask, hull = projected_bbox_mask(corners, camera)
+        view_dir = args.views_dir / f"view_{index:03d}"
+        view_dir.mkdir(parents=True, exist_ok=True)
+        path = view_dir / f"{instance['label']}_mask.png"
+        Image.fromarray(mask, mode="L").save(path)
+        records.append({"view": index, "mask_pixels": int((mask > 0).sum()), "projected_hull": hull.tolist()})
+    report = args.views_dir / "bbox_projection.json"
+    report.write_text(json.dumps(records, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"views": len(records), "report": str(report.resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
+
