@@ -0,0 +1,49 @@
+"""Validate the stored Gaussian-to-voxel mapping against the explicit PLY."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from plyfile import PlyData
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--roi", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    args = parser.parse_args()
+    roi = json.loads(args.roi.read_text(encoding="utf-8"))
+    vertex = PlyData.read(args.ply, mmap=True)["vertex"]
+    xyz = np.column_stack((vertex["x"], vertex["y"], vertex["z"]))
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    voxel = np.load(args.voxel_dir / "voxel_grid.npy")
+    lower = np.asarray(roi["grid"]["lower"])
+    voxel_size = float(roi["grid"]["voxel_size_m"])
+    recomputed = np.floor((xyz[mask] - lower) / voxel_size).astype(np.int64)
+    in_bounds = np.all((recomputed >= 0) & (recomputed < np.asarray(voxel.shape)), axis=1)
+    exact = np.all(recomputed == indices, axis=1)
+    occupied = voxel[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    result = {
+        "gaussian_count": int(len(xyz)),
+        "mask_length": int(len(mask)),
+        "selected_gaussians": int(mask.sum()),
+        "indices_rows": int(len(indices)),
+        "all_recomputed_in_bounds": bool(in_bounds.all()),
+        "exact_index_matches": int(exact.sum()),
+        "exact_index_match_ratio": float(exact.mean()),
+        "all_indices_occupied": bool(occupied.all()),
+        "occupied_voxels": int(np.count_nonzero(voxel)),
+    }
+    print(json.dumps(result, indent=2))
+    if len(mask) != len(xyz) or len(indices) != int(mask.sum()) or not exact.all() or not occupied.all():
+        raise SystemExit("Gaussian-to-voxel mapping validation failed")
+
+
+if __name__ == "__main__":
+    main()
