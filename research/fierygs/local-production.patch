@@ -0,0 +1,70 @@
+"""Summarize selected FieryGS velocity/curl/confinement diagnostic volumes."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def stats(array: np.ndarray) -> dict:
+    finite = np.asarray(array)[np.isfinite(array)]
+    return {
+        "min": float(finite.min()), "max": float(finite.max()),
+        "mean": float(finite.mean()), "p95": float(np.percentile(finite, 95)),
+        "nonzero": int(np.count_nonzero(finite)),
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--diagnostic-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    frames = []
+    paths = sorted(
+        args.diagnostic_dir.glob("flow_*.npz"),
+        key=lambda item: int(item.stem.split("_")[-1]),
+    )
+    for path in paths:
+        with np.load(path) as data:
+            speed = data["velocity_magnitude"]
+            vertical = data["velocity_vertical"]
+            curl = data["curl"]
+            force = data["confinement_force"]
+        curl_mag = np.linalg.norm(curl, axis=-1)
+        force_mag = np.linalg.norm(force, axis=-1)
+        # Recover lateral magnitude from |v| and vertical component without
+        # needing to duplicate the full velocity vector in the diagnostic NPZ.
+        lateral = np.sqrt(np.maximum(speed * speed - vertical * vertical, 0.0))
+        frames.append({
+            "frame": int(path.stem.split("_")[-1]),
+            "velocity_magnitude": stats(speed),
+            "vertical_component": stats(vertical),
+            "lateral_velocity_magnitude": stats(lateral),
+            "curl_magnitude": stats(curl_mag),
+            "confinement_force_magnitude": stats(force_mag),
+        })
+    if not frames:
+        raise FileNotFoundError(f"No flow_*.npz in {args.diagnostic_dir}")
+    last = frames[-1]
+    report = {
+        "frames": frames,
+        "native_vorticity_active": bool(last["curl_magnitude"]["nonzero"]),
+        "native_confinement_active": bool(last["confinement_force_magnitude"]["nonzero"]),
+        "nonzero_lateral_motion": bool(last["lateral_velocity_magnitude"]["nonzero"]),
+        "interpretation": (
+            "Nonzero curl, confinement force and lateral velocity demonstrate "
+            "that the native vorticity path is active; this is a solver-field "
+            "audit and does not claim visually sufficient turbulence by itself."
+        ),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
