diff --git a/adapter/fire_scenario/run_long_scenario_solver.py b/adapter/fire_scenario/run_long_scenario_solver.py
new file mode 100644
index 0000000..b409896
--- /dev/null
+++ b/adapter/fire_scenario/run_long_scenario_solver.py
@@ -0,0 +1,228 @@
+"""Run a long FieryGS scenario with active-buffer exports and optional exact audits."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from adapter.fire_scenario.common import timestamp, write_json
+from adapter.fire_scenario.run_scenario_solver import ScenarioFireSolver
+
+
+class AuditedLongFireSolver(ScenarioFireSolver):
+    """Adapter-only exporter; combustion and fluid stepping remain native."""
+
+    def __init__(self, *args, verify_export: bool = False,
+                 flow_diagnostic_frames: set[int] | None = None, **kwargs):
+        self.verify_export = verify_export
+        self.flow_diagnostic_frames = flow_diagnostic_frames or set()
+        self.buffer_audit: list[dict] = []
+        super().__init__(*args, **kwargs)
+
+    def init_output(self):
+        super().init_output()
+        Path(self._data_dir, "wood_temperature").mkdir(parents=True, exist_ok=True)
+        if self.flow_diagnostic_frames:
+            Path(self._data_dir, "flow_diagnostics").mkdir(parents=True, exist_ok=True)
+        if self.source_mode in {"limited_solid_source", "consumption_coupled_source", "finite_reservoir_source"}:
+            Path(self._data_dir, "solid_source").mkdir(parents=True, exist_ok=True)
+
+    @staticmethod
+    def _slot(pair, base) -> str:
+        return "base" if pair.cur is base else "alternate"
+
+    def save_npz(self, frame):
+        # run() invokes this after step(), therefore every array below represents
+        # the active state after physical step `frame` (zero-based).
+        arrays = {
+            "temperature": self.temperature_pair.cur.to_numpy(),
+            "fuel": self.coef_pair.cur.to_numpy(),
+            "occupancy": self.occupancy.to_numpy(),
+            "wood_temperature": self.wood_temperature_pair.cur.to_numpy(),
+        }
+        paths = {}
+        for name, array in arrays.items():
+            path = Path(self._data_dir, name, f"{name}_{frame}.npz")
+            np.savez_compressed(path, array)
+            paths[name] = path
+        if self.args.dual_smoke:
+            color = self.color_buffer.cur.to_numpy()
+            path = Path(self._data_dir, "color", f"color_{frame}.npz")
+            np.savez_compressed(path, color)
+            arrays["color"], paths["color"] = color, path
+
+        if frame in self.flow_diagnostic_frames:
+            velocity = self.velocities_pair.cur.to_numpy()
+            curl = self.curl.to_numpy()
+            normal = self.N.to_numpy()
+            # Exact source used by update_velocity before multiplication by dt.
+            # epsilon decay occurs after update_velocity, so recover that step's
+            # epsilon when a non-unit decay is configured.
+            decay = float(self.args.epilon_decay)
+            step_epsilon = float(self.epsilon / decay) if decay else float(self.epsilon)
+            confinement_force = step_epsilon * self.dx * np.cross(normal, curl)
+            flow_path = Path(self._data_dir, "flow_diagnostics", f"flow_{frame}.npz")
+            np.savez_compressed(
+                flow_path,
+                velocity_magnitude=np.linalg.norm(velocity, axis=-1),
+                velocity_vertical=velocity[..., 2],
+                curl=curl,
+                confinement_force=confinement_force,
+            )
+
+        source_diag = None
+        if self.source_mode in {"limited_solid_source", "consumption_coupled_source", "finite_reservoir_source"}:
+            source = self.source_accum.to_numpy()
+            candidates = self.source_candidate_mask.to_numpy() > 0
+            np.savez_compressed(Path(self._data_dir, "solid_source", f"source_{frame}.npz"),
+                                source_accum=source, source_candidate_mask=candidates.astype(np.uint8),
+                                eligible_source_mask=self.eligible_source_mask.to_numpy().astype(np.uint8),
+                                effective_source_mask=self.effective_source_mask.to_numpy().astype(np.uint8),
+                                consumption_ema=self.consumption_ema.to_numpy(),
+                                reservoir=self.gas_source_reservoir.to_numpy(),
+                                reservoir_initialized_mask=self.reservoir_initialized_mask.to_numpy().astype(np.uint8),
+                                reservoir_source_mask=self.reservoir_source_mask.to_numpy().astype(np.uint8))
+            active = np.argwhere(source > 0)
+            source_diag = {
+                "active_solid_source_voxels": int(self.source_solid_count[None]),
+                "receiving_air_voxels": int(self.source_air_count[None]),
+                "total_injected_y": float(source.sum()),
+                "mean_injected_y": float(source[source > 0].mean()) if np.any(source > 0) else 0.0,
+                "max_injected_y": float(source.max()),
+                "source_bbox_min": active.min(axis=0).tolist() if len(active) else None,
+                "source_bbox_max_exclusive": (active.max(axis=0) + 1).tolist() if len(active) else None,
+                "source_centroid": active.mean(axis=0).tolist() if len(active) else None,
+                "source_clamp_count": int(self.source_clamp_count[None]),
+                "source_solid_occupancy_mean": float(self.occupancy.to_numpy()[candidates].mean()) if np.any(candidates) else 0.0,
+                "source_solid_temperature_mean": float(self.wood_temperature.to_numpy()[candidates].mean()) if np.any(candidates) else 0.0,
+                "effective_source_voxels": int(self.effective_source_mask.to_numpy().sum()),
+                "eligible_source_voxels": int(self.eligible_source_mask.to_numpy().sum()),
+                "consumption_ema_mean": float(self.consumption_ema.to_numpy()[candidates].mean()) if np.any(candidates) else 0.0,
+                "consumption_ema_max": float(self.consumption_ema.to_numpy()[candidates].max()) if np.any(candidates) else 0.0,
+                "reservoir_total": float(self.gas_source_reservoir.to_numpy().sum()),
+                "reservoir_active_voxels": int((self.gas_source_reservoir.to_numpy()>0).sum()),
+                "reservoir_initialized_voxels": int(self.reservoir_initialized_mask.to_numpy().sum()),
+                "reservoir_reinitialization_count": int(self.reservoir_reinitialization_count[None]),
+            }
+            Path(self._data_dir, "solid_source", f"source_{frame}.json").write_text(json.dumps(source_diag, indent=2), encoding="utf-8")
+
+        record = {
+            "frame": frame,
+            "state_after_step": frame,
+            "active_slots": {
+                "fuel": self._slot(self.coef_pair, self._coef_buffer),
+                "temperature": self._slot(self.temperature_pair, self._temperature_buffer),
+                "wood_temperature": self._slot(self.wood_temperature_pair, self.wood_temperature),
+            },
+            "non_finite_values": int(sum(np.size(a) - np.count_nonzero(np.isfinite(a)) for a in arrays.values())),
+            "active_nonzero": {name: int(np.count_nonzero(array)) for name, array in arrays.items()},
+        }
+        if self.verify_export:
+            record["export_exactly_equals_active"] = {
+                name: bool(np.array_equal(np.load(path)["arr_0"], arrays[name], equal_nan=True))
+                for name, path in paths.items()
+            }
+            record["active_equals_inactive"] = {
+                "fuel": bool(np.array_equal(arrays["fuel"], self.coef_pair.nxt.to_numpy(), equal_nan=True)),
+                "temperature": bool(np.array_equal(arrays["temperature"], self.temperature_pair.nxt.to_numpy(), equal_nan=True)),
+                "wood_temperature": bool(np.array_equal(arrays["wood_temperature"], self.wood_temperature_pair.nxt.to_numpy(), equal_nan=True)),
+            }
+        self.buffer_audit.append(record)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config-file", type=Path, required=True)
+    parser.add_argument("--frames", type=int, required=True)
+    parser.add_argument("--scene", required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--run-report", type=Path, required=True)
+    parser.add_argument("--buffer-report", type=Path, required=True)
+    parser.add_argument("--verify-export", action="store_true")
+    parser.add_argument(
+        "--flow-diagnostic-frames", type=int, nargs="*", default=[],
+        help="Selected zero-based frames for velocity/curl/confinement NPZ export",
+    )
+    cli = parser.parse_args()
+    if cli.frames < 1:
+        raise ValueError("frames must be positive")
+    if cli.output_dir.exists() and any(cli.output_dir.iterdir()):
+        raise FileExistsError(f"Refusing to overwrite non-empty output: {cli.output_dir}")
+
+    config = yaml.safe_load(cli.config_file.read_text(encoding="utf-8"))
+    config.update(scene=cli.scene, sim_frames=cli.frames, fire_sim_root=str(cli.output_dir.resolve()))
+    args = Namespace(**config)
+    args.nu = getattr(args, "nu", 0.1)
+    args.dual_smoke = getattr(args, "dual_smoke", False)
+    args.epilon_decay = getattr(args, "epilon_decay", 1.0)
+    # Preserve legacy configs; newly generated scenario configs carry the
+    # paper-faithful initial_only value explicitly.
+    args.ignition_lifetime = getattr(args, "ignition_lifetime", "sustained_source")
+    args.source_mode = getattr(args, "source_mode", "initial_only" if args.ignition_lifetime == "initial_only" else "native_reignite")
+    args.source_model = getattr(args, "source_model", "state_based")
+    args.source_eta = getattr(args, "source_eta", 0.0)
+    args.consumption_ema_lambda = getattr(args, "consumption_ema_lambda", 0.35)
+    args.consumption_ref = getattr(args, "consumption_ref", 0.01)
+    args.bootstrap_steps = getattr(args, "bootstrap_steps", 5)
+    args.nominal_source_lifetime_steps = getattr(args, "nominal_source_lifetime_steps", 40)
+    args.reservoir_scale = getattr(args, "reservoir_scale", 1.0)
+    args.source_conversion = getattr(args, "source_conversion", 1.0)
+    args.source_max_per_solid = getattr(args, "source_max_per_solid", 1.0)
+    args.source_max_per_air = getattr(args, "source_max_per_air", 1.0)
+    args.max_total_source_per_frame = getattr(args, "max_total_source_per_frame", 1.0e9)
+    dims = args.voxel_grid["dims"]
+    solver = AuditedLongFireSolver(
+        args, *dims, args.scene, T_white=args.T_white, T_max=args.T_max, T_air=args.T_air,
+        k=args.k, burn_rate=args.burn_rate, beta=args.beta, alpha=args.alpha,
+        epsilon=args.epsilon, sim_frames=args.sim_frames, load_path=args.load_path,
+        nu=args.nu, verify_export=cli.verify_export,
+        flow_diagnostic_frames=set(cli.flow_diagnostic_frames),
+    )
+    solver.set_max_iter(30)
+    solver.sim_wood = True
+    solver.run()
+
+    exact_ok = all(all(x.get("export_exactly_equals_active", {}).values()) for x in solver.buffer_audit) if cli.verify_export else None
+    finite_ok = all(x["non_finite_values"] == 0 for x in solver.buffer_audit)
+    first = solver.buffer_audit[0]
+    nonzero_first = first["active_nonzero"]["fuel"] > 0 and first["active_nonzero"]["temperature"] > 0
+    buffer_report = {
+        "metadata": {"scenario_name": cli.scene, "timestamp": timestamp(),
+                     "source_files": [str(cli.config_file.resolve()), str(cli.output_dir.resolve())]},
+        "frame_semantics": "frame N is serialized immediately after native physical step N (zero-based)",
+        "verified_every_frame": cli.verify_export,
+        "export_exactly_equals_active_all_frames": exact_ok,
+        "all_arrays_finite": finite_ok,
+        "frame_0_active_fire_nonzero": nonzero_first,
+        "no_fixed_buffer_export": True,
+        "active_slot_sequence": [x["active_slots"] for x in solver.buffer_audit],
+        "frames": solver.buffer_audit,
+    }
+    write_json(cli.buffer_report, buffer_report)
+    completed = finite_ok and nonzero_first and (exact_ok is not False)
+    run_report = {
+        "metadata": {"scenario_name": cli.scene, "timestamp": timestamp(),
+                     "source_files": [str(cli.config_file.resolve()), str(cli.buffer_report.resolve())]},
+        "completed": completed, "frames": cli.frames, "voxel_shape": dims,
+        "output_directory": str(cli.output_dir.resolve()), "native_solver_step_unchanged": True,
+        "adapter_exports": ["fuel", "temperature", "occupancy", "wood_temperature"] + (["color"] if args.dual_smoke else []),
+        "velocity_exported": False, "dual_smoke": bool(args.dual_smoke),
+        "flow_diagnostic_frames": sorted(cli.flow_diagnostic_frames),
+        "source_mode": solver.source_mode,
+        "source_model": solver.source_model,
+        "source_eta": solver.source_eta,
+        "ignition_lifetime": args.ignition_lifetime,
+    }
+    write_json(cli.run_report, run_report)
+    print(json.dumps(run_report, indent=2))
+    if not completed:
+        raise RuntimeError("Long-run validation failed")
+
+
+if __name__ == "__main__":
+    main()
