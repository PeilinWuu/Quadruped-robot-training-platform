+"""Audit existing long-run arrays, cameras, and render readiness."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+RUNS = {
+    "table_medium": "table",
+    "table_high": "table",
+    "sofa_high": "sofa",
+    "curtain_high": "curtain",
+}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--long-root", type=Path, required=True)
+    parser.add_argument("--camera-root", type=Path, required=True)
+    parser.add_argument("--visual-root", type=Path, required=True)
+    args = parser.parse_args()
+    scenarios = []
+    for family, camera_name in RUNS.items():
+        sim = args.long_root / family / "run_200/sim_output"
+        camera = args.camera_root / f"{camera_name}.json"
+        arrays = {}
