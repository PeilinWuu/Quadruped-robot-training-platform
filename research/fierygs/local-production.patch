diff --git a/tools/render_material_fire_video.py b/tools/render_material_fire_video.py
new file mode 100644
index 0000000..a887740
--- /dev/null
+++ b/tools/render_material_fire_video.py
@@ -0,0 +1,193 @@
+"""Batch-render a FieryGS fire sequence while loading the Gaussian scene once."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+import warnings
+from argparse import Namespace
+from pathlib import Path
+
+import imageio.v2 as imageio
+import numpy as np
+import torch
+from PIL import Image
+
+from adapter.create_scene import create_scene
+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+from adapter.fire_scenario.common import timestamp
+
+
+def frame_indices(simulation_dir: Path, step: int) -> list[int]:
+    indices = sorted(int(path.stem.split("_")[-1]) for path in (simulation_dir / "fuel").glob("fuel_*.npz"))
+    if not indices:
+        raise FileNotFoundError(f"No fuel frames under {simulation_dir}")
+    chosen = indices[::step]
+    if chosen[-1] != indices[-1]:
+        chosen.append(indices[-1])
+    return chosen
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--scenario-name", default="office_table_fire")
+    parser.add_argument("--frame-step", type=int, default=2)
+    parser.add_argument("--frames", help="Optional comma-separated exact frame indices")
+    parser.add_argument("--fps", type=int, default=20)
+    parser.add_argument("--coarse-samples", type=int, default=64)
+    parser.add_argument("--fine-samples", type=int, default=512)
+    parser.add_argument("--strength", type=float, default=0.01)
+    parser.add_argument("--smoke-strength", type=float, default=0.5)
+    parser.add_argument(
+        "--hdr-aces", action="store_true",
+        help="EXPERIMENTAL: pass raw post-gamma RGB to ACES; known to cause white/pink regression",
+    )
+    parser.add_argument("--native-phong", action="store_true", help="Enable the released FieryGS Phong fire illumination")
+    parser.add_argument("--spec-intensity", type=float, default=1e-8)
+    parser.add_argument("--carbonized-threshold", type=float, default=0.7)
+    parser.add_argument("--char-darkening-factor", type=float, default=0.5)
+    parser.add_argument("--render-seed", type=int, help="Optional deterministic importance-sampling seed")
+    parser.add_argument(
+        "--use-simulation-color", action="store_true",
+        help="Load native dual-smoke color volumes exported by the simulation",
+    )
+    args = parser.parse_args()
+    if args.frame_step < 1:
+        raise ValueError("frame-step must be positive")
+    if not 0 < args.carbonized_threshold <= 1:
+        raise ValueError("carbonized-threshold must be in (0, 1]")
+    if args.char_darkening_factor < 0:
+        raise ValueError("char-darkening-factor must be non-negative")
+    if args.render_seed is not None:
+        np.random.seed(args.render_seed)
+        torch.manual_seed(args.render_seed)
+        torch.cuda.manual_seed_all(args.render_seed)
+    if args.hdr_aces:
+        warnings.warn(
+            "--hdr-aces is experimental and known to create white/pink fire artifacts; "
+            "legacy clipped XYZ2RGB is the recommended default.",
+            RuntimeWarning,
+        )
+
+    available = frame_indices(args.simulation_dir, 1)
+    if args.frames:
+        chosen = [int(value) for value in args.frames.split(",")]
+        missing = sorted(set(chosen) - set(available))
+        if missing:
+            raise ValueError(f"Requested frames are unavailable: {missing}")
+    else:
+        chosen = available[::args.frame_step]
+        if chosen[-1] != available[-1]:
+            chosen.append(available[-1])
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    frames_dir = args.output.with_name(args.output.stem + "_frames")
+    frames_dir.mkdir(parents=True, exist_ok=True)
+    scene = create_scene(args.ply, args.camera)
+    gaussians, camera = scene.gaussians, scene.cameras[0]
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    gaussian_rows = torch.nonzero(mask, as_tuple=False).squeeze(1)
+    initial_occupancy_np = np.load(args.simulation_dir / "occupancy" / "occupancy_0.npz")["arr_0"]
+    initial_occupancy = torch.from_numpy(initial_occupancy_np).cuda().float()
+    mapped_initial = initial_occupancy[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    voxel_report = json.loads(args.voxel_report.read_text(encoding="utf-8"))
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    render_args = Namespace(
+        dual_smoke=args.use_simulation_color, hdr_aces=args.hdr_aces, near=0.1, far=6.0,
+        num_samples_coarse=args.coarse_samples, num_samples_fine=args.fine_samples,
+        sampling_smooth_factor=0.5, sampling_chunk_size=32,
+        spec_intensity=args.spec_intensity, strength=args.strength, smoke_strength=args.smoke_strength,
+        sigma_a=1.0, render_smoke=True, darkness=1.0, ks=0.5,
+        char_darkening_factor=args.char_darkening_factor,
+        bounding_box=voxel_report["bounding_box"],
+    )
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    converter = TemperatureToRGB(T_max=12000, device="cuda")
+    fuel_to_temperature = FuelToTemperatureLUT(device="cuda")
+    diagnostics = []
+    writer = imageio.get_writer(str(args.output), fps=args.fps, codec="libx264", quality=8, macro_block_size=1)
+    started = time.perf_counter()
+    try:
+        with torch.no_grad():
+            for position, frame in enumerate(chosen):
+                frame_start = time.perf_counter()
+                fuel_np = np.load(args.simulation_dir / "fuel" / f"fuel_{frame}.npz")["arr_0"]
+                occupancy_np = np.load(args.simulation_dir / "occupancy" / f"occupancy_{frame}.npz")["arr_0"]
+                fuel = torch.from_numpy(fuel_np).cuda().float()
+                query_tensor = fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+                occupancy = torch.from_numpy(occupancy_np).cuda().float()
+                mapped = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+                keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+                keep[gaussian_rows] = (~mapped_initial) | (
+                    (mapped.abs() >= args.carbonized_threshold) & (mapped.abs() <= 1.0)
+                )
+                carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), dtype=torch.float32, device="cuda")
+                carbon[gaussian_rows[mapped_initial]] = mapped[mapped_initial].unsqueeze(1).repeat(1, 3)
+                gaussians.update_per_frame(keep, args.carbonized_threshold, carbon)
+                color_field = None
+                if args.use_simulation_color:
+                    color_path = args.simulation_dir / "color" / f"color_{frame}.npz"
+                    if not color_path.exists():
+                        raise FileNotFoundError(f"Missing dual-smoke color frame: {color_path}")
+                    color_np = np.load(color_path)["arr_0"]
+                    color_field = torch.from_numpy(color_np).cuda().float().permute(3, 2, 1, 0).unsqueeze(0)
+                result = render_fire(
+                    camera, gaussians, pipeline, background,
+                    query_tensor=query_tensor, temp2rgb_converter=converter,
+                    args=render_args, scale_ratio=1440 / 12000,
+                    add_sepc_light=args.native_phong, fuel2temp=fuel_to_temperature, color_field=color_field,
+                )
+                rgb = result["render"].clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+                writer.append_data(rgb)
+                # Keep lossless representative frames so RGB-change validation is not
+                # polluted by JPEG compression artifacts.
+                Image.fromarray(rgb, mode="RGB").save(frames_dir / f"frame_{frame:03d}.png")
+                elapsed = time.perf_counter() - frame_start
+                diagnostics.append({
+                    "frame": frame, "fuel_voxels": int(np.count_nonzero(fuel_np)),
+                    "carbonized_gaussians": int((~keep).sum()), "render_seconds": elapsed,
+                })
+                print(f"[{position + 1:03d}/{len(chosen):03d}] frame={frame:03d} "
+                      f"fuel={diagnostics[-1]['fuel_voxels']} carbon={diagnostics[-1]['carbonized_gaussians']} "
+                      f"seconds={elapsed:.2f}", flush=True)
+    finally:
+        writer.close()
+    report = {
+        "metadata": {
+            "scenario_name": args.scenario_name, "timestamp": timestamp(),
+            "gaussian_count": int(gaussians.get_xyz.shape[0]),
+            "source_files": [str(path.resolve()) for path in [
+                args.ply, args.camera, args.voxel_report, args.simulation_dir,
+            ]],
+        },
+        "output": str(args.output.resolve()), "source_frames": len(chosen),
+        "first_frame": chosen[0], "last_frame": chosen[-1], "frame_step": args.frame_step,
+        "fps": args.fps, "resolution": [camera.image_width, camera.image_height],
+        "duration_seconds": len(chosen) / args.fps,
+        "render_wall_seconds": time.perf_counter() - started,
+        "strength": args.strength, "smoke_strength": args.smoke_strength,
+        "hdr_aces": args.hdr_aces, "native_phong": args.native_phong,
+        "spec_intensity": args.spec_intensity,
+        "carbonized_threshold": args.carbonized_threshold,
+        "char_darkening_factor": args.char_darkening_factor,
+        "use_simulation_color": args.use_simulation_color,
+        "render_seed": args.render_seed,
+        "samples": [args.coarse_samples, args.fine_samples],
+        "bounding_box": voxel_report["bounding_box"],
+        "frames": diagnostics,
+    }
+    args.output.with_suffix(".json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({key: value for key, value in report.items() if key != "frames"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
