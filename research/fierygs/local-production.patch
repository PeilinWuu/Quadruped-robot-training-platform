+"""Resolve scenario object IDs to exact Gaussian row IDs."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import load_scenario, metadata, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--instance-labels", type=Path, required=True)
+    parser.add_argument("--catalog", type=Path, required=True)
+    parser.add_argument("--confirmed", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    labels = np.load(args.instance_labels)
+    object_ids = np.asarray(scenario["ignition"]["object_ids"], dtype=np.int32)
+    catalog = {int(item["instance_id"]): item for item in json.loads(args.catalog.read_text(encoding="utf-8"))}
+    confirmed_payload = json.loads(args.confirmed.read_text(encoding="utf-8"))
+    confirmed_ids = {int(item["object_id"]) for item in confirmed_payload["confirmed"]}
+    missing = [int(value) for value in object_ids if int(value) not in catalog]
+    if missing:
+        raise ValueError(f"Ignition object IDs are absent from catalog: {missing}")
+    rejected = [int(value) for value in object_ids if int(value) not in confirmed_ids]
+    if rejected:
+        raise ValueError(f"Ignition objects are not confirmed combustible: {rejected}")
+    mask = np.isin(labels, object_ids)
+    gaussian_ids = np.flatnonzero(mask).astype(np.int64)
+    if not len(gaussian_ids):
+        raise RuntimeError("Selected ignition objects have no assigned Gaussians")
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "ignition_gaussian_ids.npy", gaussian_ids)
+    np.save(args.output_dir / "ignition_gaussian_mask.npy", mask)
+    report = {
+        "metadata": metadata(scenario, len(labels), [args.scenario, args.instance_labels, args.catalog, args.confirmed]),
+        "object_ids": object_ids.tolist(), "ignition_gaussian_count": int(len(gaussian_ids)),
+        "objects": [{
+            "object_id": int(value), "object_name": catalog[int(value)]["object_name"],
+            "material": catalog[int(value)]["material"],
+            "gaussian_count": int((labels == value).sum()),
+        } for value in object_ids],
+        "artifacts": ["ignition_gaussian_ids.npy", "ignition_gaussian_mask.npy"],
+    }
+    write_json(args.output_dir / "ignition_report.json", report)
+    print(json.dumps({key: value for key, value in report.items() if key != "metadata"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/fire_scenario/generate_object_surface_ignition.py b/adapter/fire_scenario/generate_object_surface_ignition.py
new file mode 100644
index 0000000..43860ab
--- /dev/null
+++ b/adapter/fire_scenario/generate_object_surface_ignition.py
@@ -0,0 +1,121 @@
+"""Generate deterministic, object-owned exposed-surface ignition patches."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import load_scenario, metadata, save_voxel_ply, save_voxel_preview, write_json
+
+
+def exposed_surface(object_voxels: np.ndarray, layers: int) -> tuple[np.ndarray, int]:
+    """Use robust upper exposed XY columns, avoiding lower component/leg tops."""
+    xy = object_voxels[:, :2]
+    unique_xy, inverse = np.unique(xy, axis=0, return_inverse=True)
+    top = np.full(len(unique_xy), -1, dtype=np.int32)
+    np.maximum.at(top, inverse, object_voxels[:, 2])
+    upper_threshold = int(np.floor(np.quantile(top, 0.75)))
+    keep_column = top[inverse] >= upper_threshold
+    keep_layer = object_voxels[:, 2] >= top[inverse] - layers + 1
+    return object_voxels[keep_column & keep_layer], upper_threshold
+
+
+def farthest_seeds(surface: np.ndarray, count: int, rng: np.random.Generator) -> np.ndarray:
+    xy = surface[:, :2].astype(np.float64)
+    first = int(rng.integers(len(surface)))
+    chosen = [first]
+    minimum_distance = np.sum((xy - xy[first]) ** 2, axis=1)
+    for _ in range(1, min(count, len(surface))):
+        candidates = np.flatnonzero(minimum_distance == minimum_distance.max())
+        selected = int(rng.choice(candidates))
+        chosen.append(selected)
+        minimum_distance = np.minimum(minimum_distance, np.sum((xy - xy[selected]) ** 2, axis=1))
+    return surface[np.asarray(chosen)]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--instance-labels", type=Path, required=True)
+    parser.add_argument("--gaussian-voxels", type=Path, required=True)
+    parser.add_argument("--combustible-grid", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    object_ids = np.asarray(scenario["ignition"]["object_ids"], dtype=np.int32)
+    labels = np.load(args.instance_labels)
+    mapping = np.load(args.gaussian_voxels)
+    available = np.load(args.combustible_grid).astype(bool)
+    rows = np.flatnonzero(np.isin(labels, object_ids))
+    mapped = mapping[rows]
+    mapped = mapped[np.all(mapped >= 0, axis=1)]
+    object_mask = np.zeros(available.shape, dtype=bool)
+    if len(mapped): object_mask[tuple(mapped.T)] = True
+    object_mask &= available
+    object_voxels = np.argwhere(object_mask)
+    if not len(object_voxels):
+        raise RuntimeError("Selected object has no object-owned combustible voxels")
+
+    ignition = scenario["ignition"]
+    layers = int(ignition["surface_layers"])
+    patch_count = int(ignition["patch_count"])
+    surface, upper_threshold = exposed_surface(object_voxels, layers)
+    fraction = ignition.get("target_ignition_fraction")
+    requested = int(np.ceil(len(surface) * float(fraction))) if fraction is not None else int(ignition["target_ignition_voxels"])
+    target_count = min(max(requested, patch_count), len(surface))
+    rng = np.random.default_rng(int(scenario["seed"]))
+    seeds = farthest_seeds(surface, patch_count, rng)
+    distances = np.stack([np.sum((surface[:, :2] - seed[:2]) ** 2, axis=1) for seed in seeds], axis=1)
+    ownership = np.argmin(distances, axis=1)
+    selected_rows = []
+    base_quota, remainder = divmod(target_count, len(seeds))
+    for patch in range(len(seeds)):
+        candidates = np.flatnonzero(ownership == patch)
+        quota = base_quota + (patch < remainder)
+        order = np.lexsort((rng.random(len(candidates)), distances[candidates, patch]))
+        selected_rows.extend(candidates[order[:quota]].tolist())
+    if len(selected_rows) < target_count:
+        remaining = np.setdiff1d(np.arange(len(surface)), np.asarray(selected_rows), assume_unique=False)
+        score = distances[remaining].min(axis=1)
+        selected_rows.extend(remaining[np.argsort(score)[:target_count-len(selected_rows)]].tolist())
+    selected = np.unique(surface[np.asarray(selected_rows[:target_count])], axis=0)
+    mask = np.zeros(available.shape, dtype=np.uint8)
+    mask[tuple(selected.T)] = 1
+    accidental = int(np.count_nonzero((mask > 0) & ~object_mask))
+    if accidental:
+        raise RuntimeError(f"Generated {accidental} non-target ignition voxels")
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "ignition_voxel_coordinates.npy", selected.astype(np.int32))
+    np.save(args.output_dir / "ignition_voxel_mask.npy", mask)
+    report_data = json.loads(args.voxel_report.read_text(encoding="utf-8"))
+    lower = np.asarray(report_data["bounding_box"]["min"], dtype=float)
+    voxel_size = float(report_data["voxel_size_m"])
+    save_voxel_ply(mask, lower, voxel_size, args.output_dir / "ignition_voxels.ply", (255, 40, 40))
+    save_voxel_preview(object_mask, mask, args.output_dir / "ignition_surface_preview.png")
+    patch_ids = np.argmin(np.stack([np.sum((selected[:, :2] - seed[:2]) ** 2, axis=1) for seed in seeds], axis=1), axis=1)
+    report = {
+        "metadata": metadata(scenario, len(labels), [args.scenario, args.instance_labels, args.gaussian_voxels, args.combustible_grid]),
+        "target_object_ids": object_ids.tolist(), "ignition_mode": scenario["ignition_mode"],
+        "ignition_distribution": ignition["distribution"],
+        "seed": int(scenario["seed"]), "surface_layers": layers,
+        "upper_exposed_column_quantile": 0.75, "upper_surface_min_z": upper_threshold,
+        "object_combustible_voxels": int(len(object_voxels)), "exposed_surface_voxels": int(len(surface)),
+        "requested_ignition_voxels": requested, "ignition_voxel_count": int(mask.sum()),
+        "patch_count_requested": patch_count, "patch_count_generated": int(len(np.unique(patch_ids))),
+        "patch_seed_coordinates": seeds.tolist(),
+        "patch_voxel_counts": {str(i): int((patch_ids == i).sum()) for i in np.unique(patch_ids)},
+        "accidental_non_target_ignition_count": accidental,
+        "artifacts": ["ignition_voxel_coordinates.npy", "ignition_voxel_mask.npy", "ignition_voxels.ply", "ignition_surface_preview.png"],
+    }
+    write_json(args.output_dir / "surface_ignition_report.json", report)
+    print(json.dumps({k: v for k, v in report.items() if k != "metadata"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/fire_scenario/generate_propagation_report.py b/adapter/fire_scenario/generate_propagation_report.py
new file mode 100644
index 0000000..4b0ace0
--- /dev/null
+++ b/adapter/fire_scenario/generate_propagation_report.py
@@ -0,0 +1,72 @@
+"""Separate initial ignition objects from later propagation candidates."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import load_scenario, metadata, write_json
+
+
+def aabb_distance(a_min, a_max, b_min, b_max) -> float:
+    gap = np.maximum(0.0, np.maximum(np.asarray(a_min) - np.asarray(b_max), np.asarray(b_min) - np.asarray(a_max)))
+    return float(np.linalg.norm(gap))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--candidates", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    payload = json.loads(args.candidates.read_text(encoding="utf-8"))
+    objects = {int(item["object_id"]): item for item in payload["objects"]}
+    ignition_ids = {int(value) for value in scenario["ignition"]["object_ids"]}
+    missing = sorted(ignition_ids - objects.keys())
+    if missing:
+        raise ValueError(f"Ignition objects absent from candidates catalog: {missing}")
+    propagation = scenario["propagation"]
+    blocked = {int(value) for value in propagation.get("blocked_object_ids", [])}
+    allowed_spec = propagation.get("allowed_object_ids", "auto")
+    if allowed_spec == "auto":
+        allowed = {object_id for object_id, item in objects.items() if item["recommended_for_ignition"]}
+    else:
+        allowed = {int(value) for value in allowed_spec}
+    if not propagation.get("enabled", True):
+        allowed = set(ignition_ids)
+    allowed = (allowed | ignition_ids) - blocked
+
+    ignition_objects = [objects[value] for value in sorted(ignition_ids)]
+    entries = []
+    for object_id, item in objects.items():
+        if object_id in ignition_ids:
+            continue
+        distance = min(aabb_distance(item["bbox_min"], item["bbox_max"], source["bbox_min"], source["bbox_max"])
+                       for source in ignition_objects)
+        status = "blocked" if object_id in blocked else "propagation_candidate" if object_id in allowed else "not_allowed"
+        entries.append({
+            "object_id": object_id, "semantic_label": item["semantic_label"], "material": item["material"],
+            "status": status, "initial_distance_to_ignition_m": distance,
+            "gaussian_count": item["gaussian_count"], "quality_status": item["quality_status"],
+        })
+    entries.sort(key=lambda item: (item["initial_distance_to_ignition_m"], item["object_id"]))
+    report = {
+        "metadata": metadata(scenario, payload["metadata"]["gaussian_count"], [args.scenario, args.candidates]),
+        "propagation_enabled": bool(propagation.get("enabled", True)),
+        "initial_ignition_objects": [{k: item[k] for k in ("object_id", "semantic_label", "material", "gaussian_count")} for item in ignition_objects],
+        "allowed_object_ids": sorted(allowed), "blocked_object_ids": sorted(blocked),
+        "counts": {"ignition": len(ignition_ids), "propagation_candidates": sum(x["status"] == "propagation_candidate" for x in entries),
+                   "blocked": sum(x["status"] == "blocked" for x in entries), "not_allowed": sum(x["status"] == "not_allowed" for x in entries)},
+        "nearby_objects": entries,
+    }
+    write_json(args.output, report)
+    print(json.dumps({"counts": report["counts"], "nearest": entries[:10]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
