+"""Create a deterministic test camera from InteriorGS viewer settings."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+
+def yup_to_original(point: list[float]) -> list[float]:
+    # Viewer uses (x, z, -y); invert to original InteriorGS (x, y, z).
+    return [point[0], -point[2], point[1]]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--viewer-settings", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--width", type=int, default=960)
+    parser.add_argument("--height", type=int, default=540)
+    parser.add_argument("--position-original", type=float, nargs=3, default=None)
+    parser.add_argument("--target-original", type=float, nargs=3, default=None)
+    args = parser.parse_args()
+    settings = json.loads(args.viewer_settings.read_text(encoding="utf-8"))
+    initial = settings["cameras"][0]["initial"]
+    vertical_fov = math.radians(float(initial["fov"]))
+    fy = args.height / (2 * math.tan(vertical_fov / 2))
+    fx = fy
+    result = {
+        "coordinate_system": "InteriorGS original Z-up; OpenCV camera generated by adapter",
+        "width": args.width, "height": args.height,
+        "fx": fx, "fy": fy, "cx": args.width / 2, "cy": args.height / 2,
+        "position": args.position_original or yup_to_original(initial["position"]),
+        "target": args.target_original or yup_to_original(initial["target"]),
+        "up": [0, 0, 1],
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/create_scene.py b/adapter/create_scene.py
