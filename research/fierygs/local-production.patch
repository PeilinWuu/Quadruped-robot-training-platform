@@ -0,0 +1,58 @@
+"""Prepare explicit production-regression configs without running simulations."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import yaml
+
+
+ROOT = Path("D:/interiorgs_data/office_01")
+REPO_OUTPUT = Path(__file__).resolve().parent / "production_regression"
+SCENARIOS = {
+    "table_high": "office_table_high",
+    "sofa_high": "office_sofa_high",
+    "curtain_high": "office_curtain_high",
+}
+
+
+def main() -> None:
+    REPO_OUTPUT.mkdir(parents=True, exist_ok=True)
+    audit = {"production_profile": "fierygs_robot_fire_production_v1", "scenarios": {}}
+    for short_name, scenario_name in SCENARIOS.items():
+        source = ROOT / "fire_scenarios_batch" / "validation" / scenario_name / "fierygs_solver_config.yaml"
+        config = yaml.safe_load(source.read_text(encoding="utf-8"))
+        previous_dual_smoke = bool(config.get("dual_smoke", False))
+        config.update(
+            scene=f"{scenario_name}_production_regression_200",
+            ignition_lifetime="sustained_source",
+            source_mode="native_reignite",
+            dual_smoke=True,
+            render_smoke=True,
+            smoke_strength=0.2,
+            sim_frames=200,
+        )
+        config["fire_sim_root"] = str(
+            ROOT / "production_regression" / short_name / "sim_output"
+        ).replace("\\", "/")
+        target = REPO_OUTPUT / f"{short_name}_production_200.yaml"
+        target.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
+        existing = ROOT / "fire_long_horizon" / short_name / "run_200" / "sim_output"
+        audit["scenarios"][short_name] = {
+            "existing_simulation": str(existing),
+            "existing_frames": len(list((existing / "fuel").glob("fuel_*.npz"))),
+            "existing_legacy_source_semantics": "native_reignite (implicit sustained_source default)",
+            "existing_dual_smoke": previous_dual_smoke,
+            "production_physics_reusable_except_material_smoke": existing.exists() and not previous_dual_smoke,
+            "prepared_config": str(target),
+            "new_output": config["fire_sim_root"],
+        }
+    report = ROOT / "production_regression" / "production_compatibility_audit.json"
+    report.parent.mkdir(parents=True, exist_ok=True)
+    report.write_text(json.dumps(audit, indent=2), encoding="utf-8")
+    print(json.dumps(audit, indent=2))
+
+
+if __name__ == "__main__":
+    main()
