diff --git a/adapter/fire_dataset/finalize_dataset_v1_qa.py b/adapter/fire_dataset/finalize_dataset_v1_qa.py
new file mode 100644
index 0000000..340877e
--- /dev/null
+++ b/adapter/fire_dataset/finalize_dataset_v1_qa.py
@@ -0,0 +1,125 @@
+"""Finalize Dataset v1 integrity QA and write non-destructive recommendations."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+EXPECTED_SIZE = (640, 360)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    manifest_path = args.dataset_root / "manifests" / "dataset_v1_manifest.jsonl"
+    samples = [json.loads(line) for line in manifest_path.read_text(encoding="utf-8").splitlines() if line]
+    errors = []
+    group_splits: dict[str, set[str]] = defaultdict(set)
+    zero_fire = []
+    finite_contributions = True
+
+    for index, sample in enumerate(samples, start=1):
+        sample_id = sample["sample_id"]
+        outputs = {key: Path(value) for key, value in sample["outputs"].items()}
+        group_splits[sample["group_id"]].add(sample["split"])
+        try:
+            for key in ("rgb", "depth", "fire_binary", "smoke_binary"):
+                with Image.open(outputs[key]) as image:
+                    image.verify()
+                with Image.open(outputs[key]) as image:
+                    if image.size != EXPECTED_SIZE:
+                        raise ValueError(f"{key} size {image.size}")
+            semantic = np.load(outputs["semantic"])
+            expected_keys = {"gaussian_id", "instance_id", "part_id", "material_id", "burnability"}
+            if set(semantic.files) != expected_keys:
+                raise ValueError(f"semantic keys {semantic.files}")
+            if any(semantic[key].shape != (360, 640) for key in semantic.files):
+                raise ValueError("semantic shape mismatch")
+            for key in ("fire_contribution", "smoke_contribution"):
+                contribution = np.load(outputs[key], mmap_mode="r")
+                if contribution.shape != (360, 640) or contribution.dtype != np.float32:
+                    raise ValueError(f"{key} shape/dtype {contribution.shape}/{contribution.dtype}")
+                if not np.isfinite(contribution).all():
+                    finite_contributions = False
+                    raise ValueError(f"{key} contains non-finite values")
+            metadata = json.loads(outputs["metadata"].read_text(encoding="utf-8"))
+            if metadata["sample_id"] != sample_id:
+                raise ValueError("metadata sample_id mismatch")
+            if metadata["diagnostics"]["fire_mask_fraction"] == 0:
+                zero_fire.append(sample_id)
+        except Exception as error:
+            errors.append({"sample_id": sample_id, "error": repr(error)})
+        if index % 100 == 0:
+            print(f"checked {index}/{len(samples)}", flush=True)
+
+    leakage = {group: sorted(splits) for group, splits in group_splits.items() if len(splits) != 1}
+    recommended_exclusion_ids = sorted(
+        sample["sample_id"] for sample in samples if sample["camera_id"] == "curtain_cam07"
+    )
+    exclusion_reasons = [
+        {
+            "sample_id": sample_id,
+            "reason": "curtain_cam07 is dominated by a near wall/pillar and has poor task visibility",
+            "action": "exclude from the recommended training manifest; retain original files for audit",
+        }
+        for sample_id in recommended_exclusion_ids
+    ]
+    recommended = [sample for sample in samples if sample["sample_id"] not in set(recommended_exclusion_ids)]
+    recommended_path = args.dataset_root / "manifests" / "dataset_v1_manifest_recommended.jsonl"
+    recommended_path.write_text(
+        "".join(json.dumps(sample, separators=(",", ":")) + "\n" for sample in recommended),
+        encoding="utf-8",
+    )
+    exclusion_path = args.dataset_root / "reports" / "dataset_v1_recommended_exclusions.json"
+    exclusion_path.write_text(json.dumps(exclusion_reasons, indent=2), encoding="utf-8")
+
+    dataset_bytes = sum(path.stat().st_size for path in args.dataset_root.rglob("*") if path.is_file())
+    report = {
+        "passed_integrity": not errors,
+        "passed_alignment_shapes": not errors,
+        "passed_contribution_finiteness": finite_contributions,
+        "passed_group_split_no_leakage": not leakage,
+        "sample_count": len(samples),
+        "integrity_errors": errors,
+        "split_leakage_groups": leakage,
+        "zero_fire_samples": len(zero_fire),
+        "zero_fire_interpretation": "valid ignition-stage negative/occluded views; retained",
+        "recommended_exclusion_count": len(recommended_exclusion_ids),
+        "recommended_sample_count": len(recommended),
+        "recommended_manifest": str(recommended_path.resolve()),
+        "recommended_exclusions": str(exclusion_path.resolve()),
+        "recommended_distribution": {
+            "scenario": dict(Counter(sample["scenario"] for sample in recommended)),
+            "stage": dict(Counter(sample["physical_stage"] for sample in recommended)),
+            "split": dict(Counter(sample["split"] for sample in recommended)),
+        },
+        "visual_findings": {
+            "camera_geometry": "24 cameras render valid indoor views; curtain_cam07 is visually dominated by a near wall/pillar",
+            "fire_rooting": "table, sofa, and curtain fire remain rooted at their intended ignition objects",
+            "temporal_evolution": "all five stages show increasing fire extent; ignition includes useful no-visible-fire negatives",
+            "hdr_regression": "no irregular white/pink HDR regression observed",
+            "known_bias": "native_reignite torch-like columns and regular curtain-sheet flames remain visible, especially in established/late stages",
+            "annotation_alignment": "pilot five-panel RGB/depth/semantic/fire/smoke inspection passed",
+        },
+        "dataset_bytes": dataset_bytes,
+        "dataset_gib": dataset_bytes / 1024**3,
+    }
+    report_path = args.dataset_root / "reports" / "dataset_v1_final_qa.json"
+    report_path.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/fire_dataset/generate_robot_cameras.py b/adapter/fire_dataset/generate_robot_cameras.py
new file mode 100644
index 0000000..6bcd418
--- /dev/null
+++ b/adapter/fire_dataset/generate_robot_cameras.py
@@ -0,0 +1,398 @@
+"""Generate eight deterministic robot-height cameras per Dataset v1 ignition object."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import torch
+from scipy.ndimage import distance_transform_edt
+from scipy.spatial import cKDTree
+from plyfile import PlyData
+
+from adapter.create_scene import look_at_colmap
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from adapter.semantic_bridge.common import camera_basis
+from gaussian_renderer import render_mask
+from scene.cameras import Camera
+from utils.graphics_utils import focal2fov
+
+
+DEFAULT_DATASET_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+DEFAULT_CATALOG = Path(
+    r"D:\interiorgs_data\office_01\fire_scenarios_batch\candidates\fire_candidate_objects.json"
+)
+DEFAULT_VOXEL_DIR = Path(
+    r"D:\interiorgs_data\office_01\fire_scenarios\office_table_fire\voxel"
+)
+DEFAULT_PLY = Path(r"D:\interiorgs_data\office_01\3dgs_explicit.ply")
+DEFAULT_LABELS = Path(
+    r"D:\interiorgs_data\office_01\semantic_bridge_all\gaussian_instance_ids.npy"
+)
+OBJECT_IDS = {"table": 113, "sofa": 135, "curtain": 62}
+TARGET_Z = {"table": 0.62, "sofa": 0.58, "curtain": 1.30}
+WIDTH, HEIGHT = 640, 360
+FX = FY = 311.7691453623979
+CX, CY = WIDTH / 2, HEIGHT / 2
+SEED = 42
+RASTER_VISIBILITY_MIN_PIXELS = {"table": 35, "sofa": 50, "curtain": 120}
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_DATASET_ROOT)
+    parser.add_argument("--catalog", type=Path, default=DEFAULT_CATALOG)
+    parser.add_argument("--voxel-dir", type=Path, default=DEFAULT_VOXEL_DIR)
+    parser.add_argument("--ply", type=Path, default=DEFAULT_PLY)
+    parser.add_argument("--labels", type=Path, default=DEFAULT_LABELS)
+    return parser.parse_args()
+
+
+def angle_separation(a: float, b: float) -> float:
+    value = abs(a - b) % 360.0
+    return min(value, 360.0 - value)
+
+
+def voxel_index(point: np.ndarray, lower: np.ndarray, voxel_size: float) -> np.ndarray:
+    return np.floor((point - lower) / voxel_size).astype(int)
+
+
+def line_occupancy(
+    position: np.ndarray,
+    target: np.ndarray,
+    occupied: np.ndarray,
+    lower: np.ndarray,
+    voxel_size: float,
+) -> int:
+    # Ignore the last 18% because the target object is expected to be occupied.
+    samples = position[None, :] + np.linspace(0.08, 0.82, 32)[:, None] * (
+        target - position
+    )[None, :]
+    indices = np.floor((samples - lower) / voxel_size).astype(int)
+    valid = np.all((indices >= 0) & (indices < np.asarray(occupied.shape)), axis=1)
+    indices = indices[valid]
+    return int(np.count_nonzero(occupied[indices[:, 0], indices[:, 1], indices[:, 2]]))
+
+
+def load_xyz(path: Path) -> np.ndarray:
+    vertex = PlyData.read(path)["vertex"].data
+    return np.column_stack((vertex["x"], vertex["y"], vertex["z"])).astype(np.float32)
+
+
+def visibility_metrics(
+    camera: dict,
+    scene_points: np.ndarray,
+    target_points: np.ndarray,
+    width: int = 160,
+    height: int = 90,
+) -> dict:
+    rotation, translation = camera_basis(camera)
+    scale_x, scale_y = width / WIDTH, height / HEIGHT
+    fx, fy, cx, cy = FX * scale_x, FY * scale_y, CX * scale_x, CY * scale_y
+
+    scene_cam = scene_points @ rotation.T + translation
+    z = scene_cam[:, 2]
+    valid = (z > 0.10) & (z < 20.0)
+    u = np.rint(fx * scene_cam[:, 0] / np.maximum(z, 1e-6) + cx).astype(np.int32)
+    v = np.rint(fy * scene_cam[:, 1] / np.maximum(z, 1e-6) + cy).astype(np.int32)
+    valid &= (u >= 0) & (u < width) & (v >= 0) & (v < height)
+    pixels = v[valid] * width + u[valid]
+    depths = z[valid]
+    depth_buffer = np.full(width * height, np.inf, dtype=np.float32)
+    np.minimum.at(depth_buffer, pixels, depths.astype(np.float32))
+
+    target_cam = target_points @ rotation.T + translation
+    target_z = target_cam[:, 2]
+    target_valid = (target_z > 0.10) & (target_z < 20.0)
+    target_u = np.rint(fx * target_cam[:, 0] / np.maximum(target_z, 1e-6) + cx).astype(np.int32)
+    target_v = np.rint(fy * target_cam[:, 1] / np.maximum(target_z, 1e-6) + cy).astype(np.int32)
+    target_valid &= (
+        (target_u >= 0) & (target_u < width) & (target_v >= 0) & (target_v < height)
+    )
+    target_pixels = target_v[target_valid] * width + target_u[target_valid]
+    target_depths = target_z[target_valid]
+    target_visible = target_depths <= depth_buffer[target_pixels] + 0.10
+    visible_pixels = int(np.unique(target_pixels[target_visible]).size)
+    projected_pixels = int(np.unique(target_pixels).size)
+    scene_pixels = int(np.unique(pixels).size)
+    finite_depth = depth_buffer[np.isfinite(depth_buffer)]
+    return {
+        "target_visible_pixels_160x90": visible_pixels,
+        "target_projected_pixels_160x90": projected_pixels,
+        "target_visibility_ratio": float(visible_pixels / max(projected_pixels, 1)),
+        "scene_coverage_ratio": float(scene_pixels / (width * height)),
+        "near_scene_fraction": float(np.mean(finite_depth < 0.35)) if finite_depth.size else 1.0,
+    }
+
+
+def low_resolution_camera(camera: dict) -> Camera:
+    width, height = 160, 90
+    position = np.asarray(camera["position"], dtype=np.float64)
+    target = np.asarray(camera["target"], dtype=np.float64)
+    up = np.asarray(camera.get("up", [0.0, 0.0, 1.0]), dtype=np.float64)
+    rotation, translation = look_at_colmap(position, target, up)
+    return Camera(
+        colmap_id=0,
+        R=rotation,
+        T=translation,
+        FoVx=focal2fov(FX * width / WIDTH, width),
+        FoVy=focal2fov(FY * height / HEIGHT, height),
+        image=torch.zeros((3, height, width), dtype=torch.float32),
+        gt_alpha_mask=None,
+        image_path="",
+        image_name="robot_camera_candidate",
+        uid=0,
+        cx=CX * width / WIDTH,
+        cy=CY * height / HEIGHT,
+        data_device="cuda",
+        preload_img=False,
+    )
+
+
+def select_cameras(candidates: list[dict], count: int = 8) -> list[dict]:
+    if len(candidates) < count:
+        raise RuntimeError(f"Only {len(candidates)} valid camera candidates")
+    minimum_occlusion = min(item["occlusion_samples"] for item in candidates)
+    pool = [item for item in candidates if item["occlusion_samples"] <= minimum_occlusion + 3]
+    pool.sort(key=lambda item: (item["score"], item["azimuth_degrees"], item["distance_m"]))
+    selected = [pool.pop(0)]
+    while len(selected) < count:
+        def diversity(item: dict) -> tuple[float, float]:
+            position = np.asarray(item["position"])
+            min_xy = min(
+                np.linalg.norm(position[:2] - np.asarray(existing["position"])[:2])
+                for existing in selected
+            )
+            min_angle = min(
+                angle_separation(item["azimuth_degrees"], existing["azimuth_degrees"])
+                for existing in selected
+            )
+            value = min_xy + 0.025 * min_angle - 0.08 * item["score"]
+            return value, -item["score"]
+
+        choice = max(pool, key=diversity)
+        pool.remove(choice)
+        selected.append(choice)
+    return sorted(selected, key=lambda item: item["azimuth_degrees"])
+
+
+def main() -> None:
+    args = parse_args()
+    rng = np.random.default_rng(SEED)
+    catalog = json.loads(args.catalog.read_text(encoding="utf-8"))
+    objects = {item["object_id"]: item for item in catalog["objects"]}
+    report = json.loads((args.voxel_dir / "material_voxel_report.json").read_text(encoding="utf-8"))
+    material_grid = np.load(args.voxel_dir / "material_grid.npy")
+    occupied = material_grid > 0
+    voxel_size = float(report["voxel_size_m"])
+    lower = np.asarray(report["bounding_box"]["min"], dtype=np.float64)
+    upper = np.asarray(report["bounding_box"]["max"], dtype=np.float64)
+    clearance = distance_transform_edt(~occupied) * voxel_size
+    xyz = load_xyz(args.ply)
+    labels = np.load(args.labels, mmap_mode="r")
+    if len(labels) != len(xyz):
+        raise ValueError(f"Label/Gaussian mismatch: {len(labels)} != {len(xyz)}")
+    surface_tree = cKDTree(xyz)
+    # Camera generation is a one-time QA step. Use every Gaussian here so thin
+    # walls, chair backs, and pillars cannot disappear through point sampling.
+    scene_sample = xyz
+    gaussians = load_interiorgs_gaussians(args.ply)
+    pipeline = type("Pipeline", (), {
+        "compute_cov3D_python": False,
+        "convert_SHs_python": False,
+        "debug": False,
+    })()
+    background = torch.zeros(3, dtype=torch.float32, device="cuda")
+
+    output_root = args.dataset_root / "cameras"
+    output_root.mkdir(parents=True, exist_ok=True)
+    summary = {"seed": SEED, "camera_count_per_object": 8, "objects": {}}
+
+    for object_name, object_id in OBJECT_IDS.items():
+        item = objects[object_id]
+        center = np.asarray(item["bbox_center"], dtype=np.float64)
+        target_points = xyz[np.asarray(labels) == object_id]
+        if len(target_points) < 100:
+            raise RuntimeError(f"{object_name}: only {len(target_points)} target Gaussians")
+        target = center.copy()
+        target[2] = TARGET_Z[object_name]
+        candidates = []
+        for azimuth in np.arange(0.0, 360.0, 5.0):
+            angle = math.radians(float(azimuth))
+            direction = np.asarray([math.cos(angle), math.sin(angle), 0.0])
+            for distance in (2.2, 2.8, 3.4, 4.0, 4.6, 5.2):
+                for height in (0.45, 0.55, 0.65):
+                    position = target - distance * direction
+                    position[2] = height
+                    if np.any(position[:2] < lower[:2] + 0.35) or np.any(
+                        position[:2] > upper[:2] - 0.35
+                    ):
+                        continue
+                    index = voxel_index(position, lower, voxel_size)
+                    if np.any(index < 0) or np.any(index >= np.asarray(occupied.shape)):
+                        continue
+                    local_clearance = float(clearance[tuple(index)])
+                    if local_clearance < 0.30:
+                        continue
+                    gaussian_clearance = float(surface_tree.query(position, k=1)[0])
+                    if gaussian_clearance < 0.48:
+                        continue
+                    horizontal = float(np.linalg.norm((target - position)[:2]))
+                    pitch = math.degrees(math.atan2(target[2] - position[2], horizontal))
+                    if abs(pitch) > 22.0:
+                        continue
+                    occlusion = line_occupancy(position, target, occupied, lower, voxel_size)
+                    camera_stub = {
+                        "position": position.tolist(),
+                        "target": target.tolist(),
+                        "up": [0.0, 0.0, 1.0],
+                    }
+                    visibility = visibility_metrics(camera_stub, scene_sample, target_points)
+                    if visibility["target_visible_pixels_160x90"] < 18:
+                        continue
+                    if visibility["target_visibility_ratio"] < 0.08:
+                        continue
+                    if visibility["near_scene_fraction"] > 0.18:
+                        continue
+                    score = (
+                        2.0 * occlusion
+                        + abs(distance - 3.5)
+                        + 0.5 * abs(height - 0.55)
+                        - min(local_clearance, 1.0)
+                        - min(visibility["target_visible_pixels_160x90"], 300) / 80.0
+                        + float(rng.uniform(0.0, 1e-5))
+                    )
+                    candidates.append(
+                        {
+                            "position": position.tolist(),
+                            "target": target.tolist(),
+                            "up": [0.0, 0.0, 1.0],
+                            "azimuth_degrees": float(azimuth),
+                            "distance_m": float(distance),
+                            "camera_height_m": float(height),
+                            "pitch_degrees": float(pitch),
+                            "geometry_clearance_m": local_clearance,
+                            "gaussian_surface_clearance_m": gaussian_clearance,
+                            "occlusion_samples": occlusion,
+                            **visibility,
+                            "score": float(score),
+                        }
+                    )
+
+        target_mask = torch.from_numpy((np.asarray(labels) == object_id).astype(np.float32)).cuda()
+        raster_candidates = []
+        with torch.no_grad():
+            for candidate in candidates:
+                candidate_camera = low_resolution_camera(candidate)
+                rendered = render_mask(
+                    candidate_camera,
+                    gaussians,
+                    pipeline,
+                    background,
+                    precomputed_mask=target_mask,
+                )["mask"][0].clamp(0, 1)
+                strong_pixels = int(torch.count_nonzero(rendered > 0.20).item())
+                weak_pixels = int(torch.count_nonzero(rendered > 0.05).item())
+                contribution = float(rendered.sum().item())
+                candidate["raster_target_strong_pixels_160x90"] = strong_pixels
+                candidate["raster_target_weak_pixels_160x90"] = weak_pixels
+                candidate["raster_target_contribution_160x90"] = contribution
+                candidate["score"] -= min(strong_pixels, 500) / 60.0
+                if strong_pixels >= RASTER_VISIBILITY_MIN_PIXELS[object_name]:
+                    raster_candidates.append(candidate)
+        candidates = raster_candidates
+        selected = select_cameras(candidates)
+        object_dir = output_root / object_name
+        object_dir.mkdir(parents=True, exist_ok=True)
+        camera_records = []
+        for camera_index, candidate in enumerate(selected):
+            camera_id = f"{object_name}_cam{camera_index:02d}"
+            camera = {
+                "camera_id": camera_id,
+                "width": WIDTH,
+                "height": HEIGHT,
+                "fx": FX,
+                "fy": FY,
+                "cx": CX,
+                "cy": CY,
+                **{key: candidate[key] for key in ("position", "target", "up")},
+                "metadata": {
+                    "camera_role": "robot_training",
+                    "robot_height_approximation": "Go2-like first-pass, not calibrated hardware intrinsics",
+                    "seed": SEED,
+                    "ignition_object": object_name,
+                    "object_id": object_id,
+                    **{
+                        key: candidate[key]
+                        for key in (
+                            "azimuth_degrees",
+                            "distance_m",
+                            "camera_height_m",
+                            "pitch_degrees",
+                            "geometry_clearance_m",
+                            "gaussian_surface_clearance_m",
+                            "occlusion_samples",
+                            "target_visible_pixels_160x90",
+                            "target_visibility_ratio",
+                            "scene_coverage_ratio",
+                            "near_scene_fraction",
+                            "raster_target_strong_pixels_160x90",
+                            "raster_target_weak_pixels_160x90",
+                            "raster_target_contribution_160x90",
+                        )
+                    },
+                },
+            }
+            rotation, translation = camera_basis(camera)
+            camera["extrinsics"] = {
+                "convention": "OpenCV world-to-camera; right/down/forward",
+                "rotation": rotation.tolist(),
+                "translation": translation.tolist(),
+            }
+            path = object_dir / f"{camera_id}.json"
+            path.write_text(json.dumps(camera, indent=2), encoding="utf-8")
+            camera_records.append({"camera_id": camera_id, "path": str(path.resolve()), **camera})
+
+        set_path = object_dir / "camera_set.json"
+        set_payload = {
+            "ignition_object": object_name,
+            "object_id": object_id,
+            "seed": SEED,
+            "coordinate_system": "InteriorGS XYZ: right, back, up; metres",
+            "collision_test": "material voxel occupancy clearance >= 0.30 m",
+            "cameras": camera_records,
+        }
+        set_path.write_text(json.dumps(set_payload, indent=2), encoding="utf-8")
+        summary["objects"][object_name] = {
+            "object_id": object_id,
+            "candidate_count": len(candidates),
+            "camera_set": str(set_path.resolve()),
+            "camera_ids": [camera["camera_id"] for camera in camera_records],
+            "minimum_clearance_m": min(
+                camera["metadata"]["geometry_clearance_m"] for camera in camera_records
+            ),
+            "minimum_gaussian_surface_clearance_m": min(
+                camera["metadata"]["gaussian_surface_clearance_m"] for camera in camera_records
+            ),
+            "minimum_target_visible_pixels_160x90": min(
+                camera["metadata"]["target_visible_pixels_160x90"] for camera in camera_records
+            ),
+            "minimum_raster_target_strong_pixels_160x90": min(
+                camera["metadata"]["raster_target_strong_pixels_160x90"]
+                for camera in camera_records
+            ),
+            "maximum_absolute_pitch_degrees": max(
+                abs(camera["metadata"]["pitch_degrees"]) for camera in camera_records
+            ),
+        }
+
+    summary_path = output_root / "robot_camera_generation_report.json"
+    summary_path.write_text(json.dumps(summary, indent=2), encoding="utf-8")
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
