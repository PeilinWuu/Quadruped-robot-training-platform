diff --git a/adapter/fire_scenario/build_batch_physics_report.py b/adapter/fire_scenario/build_batch_physics_report.py
new file mode 100644
index 0000000..faeeaeb
--- /dev/null
+++ b/adapter/fire_scenario/build_batch_physics_report.py
@@ -0,0 +1,93 @@
+"""Summarize comparable short physical simulations for a scenario family."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def load_field(root: Path, kind: str, frame: int) -> np.ndarray:
+    return np.load(root / kind / f"{kind}_{frame}.npz")["arr_0"]
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch-root", type=Path, required=True)
+    parser.add_argument("--repo-output", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--family", default="table")
+    parser.add_argument("--frames", type=int, default=30)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    voxel_report = json.loads((args.voxel_dir / "material_voxel_report.json").read_text(encoding="utf-8"))
+    voxel_size = float(voxel_report["voxel_size_m"])
+    point_indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    entries = []
+    source_files = []
+    for level in ("low", "medium", "high"):
+        name = f"office_{args.family}_{level}"
+        validation_dir = args.batch_root / "validation" / name
+        simulation_dir = args.repo_output / f"{name}_30f" / "sim_output"
+        ignition_coords = np.load(validation_dir / "ignition_voxel_coordinates.npy")
+        initial_available = np.load(validation_dir / "available_fuel_grid.npy") > 0
+        mapped_initial = initial_available[point_indices[:, 0], point_indices[:, 1], point_indices[:, 2]]
+        per_frame = []
+        for frame in range(args.frames):
+            temperature = load_field(simulation_dir, "temperature", frame)
+            fuel = load_field(simulation_dir, "fuel", frame)
+            occupancy = load_field(simulation_dir, "occupancy", frame)
+            burning = np.argwhere(fuel > 1e-6)
+            if len(burning):
+                extent = (burning.max(axis=0) - burning.min(axis=0) + 1) * voxel_size
+                delta = burning[:, None, :] - ignition_coords[None, :, :]
+                propagation_distance = float(np.sqrt(np.min(np.sum(delta * delta, axis=2), axis=1)).max() * voxel_size)
+            else:
+                extent = np.zeros(3)
+                propagation_distance = 0.0
+            mapped_occupancy = occupancy[point_indices[:, 0], point_indices[:, 1], point_indices[:, 2]]
+            carbonized = int(np.count_nonzero(mapped_initial & (mapped_occupancy < 0.7)))
+            nonfinite = int(sum(np.size(field) - np.isfinite(field).sum() for field in (temperature, fuel, occupancy)))
+            per_frame.append({
+                "frame": frame, "fuel_voxel_count": int(np.count_nonzero(fuel > 1e-6)),
+                "temperature_voxel_count": int(np.count_nonzero(temperature > 0)),
+                "occupancy_voxel_count": int(np.count_nonzero(occupancy > 0)),
+                "carbonized_gaussian_count": carbonized,
+                "maximum_temperature": float(temperature.max()), "non_finite_value_count": nonfinite,
+                "burning_extent_m": extent.tolist(), "propagation_distance_m": propagation_distance,
+            })
+        surface = json.loads((validation_dir / "surface_ignition_report.json").read_text(encoding="utf-8"))
+        validation = json.loads((validation_dir / "validation_report.json").read_text(encoding="utf-8"))
+        entries.append({
+            "scenario": name, "fire_level": level, "passed": validation["passed"] and all(x["non_finite_value_count"] == 0 for x in per_frame),
+            "initial_ignition_voxel_count": surface["ignition_voxel_count"],
+            "patch_count": surface["patch_count_generated"], "frames": per_frame,
+            "final": per_frame[-1], "simulation_directory": str(simulation_dir.resolve()),
+        })
+        source_files.extend([str((validation_dir / "validation_report.json").resolve()), str(simulation_dir.resolve())])
+    final_counts = [[entry["final"][key] for entry in entries] for key in ("fuel_voxel_count", "temperature_voxel_count")]
+    ordering = {
+        "initial_ignition_high_gt_medium_gt_low": entries[2]["initial_ignition_voxel_count"] > entries[1]["initial_ignition_voxel_count"] > entries[0]["initial_ignition_voxel_count"],
+        "final_fuel_high_gt_medium_gt_low": final_counts[0][2] > final_counts[0][1] > final_counts[0][0],
+        "final_temperature_high_gt_medium_gt_low": final_counts[1][2] > final_counts[1][1] > final_counts[1][0],
+    }
+    report = {"metadata": {"scenario_name": f"office_{args.family}_fire_30f_comparison", "timestamp": timestamp(),
+                           "source_files": source_files},
+              "passed": all(entry["passed"] for entry in entries) and all(ordering.values()),
+              "shared_native_solver_parameters": True, "shared_frame_count": args.frames,
+              "ordering_checks": ordering, "scenarios": entries}
+    write_json(args.output, report)
+    print(json.dumps({"passed": report["passed"], "ordering_checks": ordering,
+                      "finals": [{"scenario": x["scenario"], "initial": x["initial_ignition_voxel_count"], **x["final"]} for x in entries]}, indent=2))
+    if not report["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
