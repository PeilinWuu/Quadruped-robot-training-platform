+    }
+    smoke_path.write_text(json.dumps(smoke, indent=2) + "\n", encoding="utf-8")
+
+    cost_path = report_dir / "voxel_resolution_cost_quality_report.json"
+    cost = json.loads(cost_path.read_text(encoding="utf-8"))
+    cost["runtime_estimate"] = {
+        "observed_native_200_state_timestamp_span_seconds": 60.8897671,
+        "observed_native_seconds_per_frame_approx": 60.8897671 / 199,
+        "candidate_seconds_per_frame_cell_count_scaling_estimate": 8 * 60.8897671 / 199,
+        "candidate_30_frame_estimate_seconds": 30 * 8 * 60.8897671 / 199,
+        "candidate_60_frame_estimate_seconds": 60 * 8 * 60.8897671 / 199,
+        "qualification": "Timestamp-derived and 8x-cell scaling estimates only; no invalid 0.025 m run was started.",
+    }
+    cost_path.write_text(json.dumps(cost, indent=2) + "\n", encoding="utf-8")
+
+    scorecard = {
+        "experiment": "Table HIGH fire visual-quality scorecard (independent dimensions, no scalar total)",
+        "selected_preview": {"strength": 0.005, "smoke_strength": 0.2, "physics": "unchanged validated 200 frames"},
+        "representative_frame_metrics": metrics,
+        "dimensions": {
+            "flame_internal_detail": {"baseline": "poor", "improved": "better", "evidence": "orange/yellow gradients and table objects remain readable instead of a pale white veil"},
+            "overexposure": {"baseline": "poor", "improved": "better", "evidence": "10x lower linear emission and 5x lower white-smoke weight reduce near-white coverage"},
+            "voxel_blockiness": {"baseline": "poor", "improved": "poor", "evidence": "2x trilinear and conservative smoothing did not remove the physical column or hard-mask layers"},
+            "temporal_naturalness": {"baseline": "poor", "improved": "poor", "evidence": "same deterministic physical states; torch-column motion is unchanged"},
+            "smoke_realism": {"baseline": "very poor", "improved": "poor/limited", "evidence": "white artifact is reduced, but no physically valid dark smoke model is present"},
+            "carbonization_visibility": {"baseline": "weak", "improved": "weak", "evidence": "carbon-only frame 199 changes just 0.71% of pixels above 2/255"},
+            "GS_fire_compositing": {"baseline": "poor", "improved": "better", "evidence": "less white overlay and less display clipping; unaffected regions remain bit-identical"},
+            "physical_consistency": {"baseline": "validated", "improved": "validated fields / altered display weights", "evidence": "no solver array, threshold, material or scenario YAML was modified"},
+            "computational_cost": {"baseline": "~0.55 s/frame", "improved": "~0.56 s/frame", "evidence": "same 32/128 samples; full improved render took about 113 seconds for 200 frames"},
+        },
+        "selection_rationale": "The preview uses only the smallest demonstrated render-only changes. It is improved for flame visibility and compositing, not claimed to solve morphology, smoke physics or carbonization.",
+    }
+    (report_dir / "fire_visual_quality_scorecard.json").write_text(json.dumps(scorecard, indent=2) + "\n", encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
