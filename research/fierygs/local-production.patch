+"""Build LOW/MEDIUM/HIGH table-fire contact sheet, montage video, and metrics."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import imageio.v2 as imageio
+import numpy as np
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+LEVELS = ("low", "medium", "high")
+SAMPLES = (0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 199)
+
+
+def load(path: Path) -> np.ndarray:
+    return np.asarray(Image.open(path).convert("RGB"))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--visual-root", type=Path, required=True)
+    parser.add_argument("--baseline", type=Path, required=True)
+    args = parser.parse_args()
+    output = args.visual_root / "renders/comparisons"
+    output.mkdir(parents=True, exist_ok=True)
+    dirs = {level: args.visual_root / "renders" / f"table_{level}" / "baseline_full/baseline_full_frames"
+            for level in LEVELS}
+    baseline = load(args.baseline).astype(np.int16)
+    thumb = (240, 135)
+    sheet = Image.new("RGB", (thumb[0] * len(SAMPLES), (thumb[1] + 28) * 3), "white")
+    draw = ImageDraw.Draw(sheet)
+    sampled = []
+    for row, level in enumerate(LEVELS):
+        for col, frame in enumerate(SAMPLES):
+            image = load(dirs[level] / f"frame_{frame:03d}.png")
+            change = float(np.mean(np.max(np.abs(image.astype(np.int16) - baseline), axis=2) > 8) * 100)
+            sampled.append({"level": level, "frame": frame, "rgb_change_from_static_percent": change})
+            x, y = col * thumb[0], row * (thumb[1] + 28)
+            sheet.paste(Image.fromarray(image).resize(thumb, Image.Resampling.LANCZOS), (x, y + 28))
+            draw.text((x + 5, y + 8), f"{level.upper()} {frame:03d} | {change:.1f}%", fill="black")
+    sheet.save(output / "table_low_medium_high_contact_sheet.png")
+
+    pairwise = []
+    writer = imageio.get_writer(str(output / "table_low_medium_high_montage.mp4"), fps=25,
+                                codec="libx264", quality=8, macro_block_size=1)
+    try:
+        for frame in range(200):
+            images = {level: load(dirs[level] / f"frame_{frame:03d}.png") for level in LEVELS}
+            pairwise.append({"frame": frame,
+                             "low_vs_medium_changed_percent": float(np.mean(np.max(np.abs(images["low"].astype(np.int16) - images["medium"].astype(np.int16)), axis=2) > 8) * 100),
+                             "medium_vs_high_changed_percent": float(np.mean(np.max(np.abs(images["medium"].astype(np.int16) - images["high"].astype(np.int16)), axis=2) > 8) * 100)})
+            writer.append_data(np.concatenate([images[level] for level in LEVELS], axis=1))
+    finally:
+        writer.close()
+    report = {
+        "metadata": {"scenario_name": "office_table_low_medium_high_visual_comparison", "timestamp": timestamp(),
+                     "source_files": [str(d.resolve()) for d in dirs.values()]},
+        "shared_renderer_parameters": {"fire_strength": 0.05, "smoke_strength": 1.0,
+                                       "coarse_samples": 32, "fine_samples": 128},
+        "contact_sheet": str((output / "table_low_medium_high_contact_sheet.png").resolve()),
+        "montage_video": str((output / "table_low_medium_high_montage.mp4").resolve()),
+        "sampled_static_change": sampled, "pairwise_per_frame": pairwise,
+        "visual_conclusion": "Levels are distinguishable mainly by ignition onset and early growth speed. In established/late stages all three converge toward a similarly saturated vertical plume, reducing semantic fire-level readability.",
+    }
+    write_json(args.visual_root / "reports/table_fire_level_visual_comparison.json", report)
+    print(json.dumps({"contact_sheet": report["contact_sheet"], "video": report["montage_video"],
+                      "frame199": pairwise[-1]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
