index 0000000..ffa1afd
--- /dev/null
+++ b/adapter/semantic_bridge/common.py
@@ -0,0 +1,93 @@
+"""Shared geometry and file helpers for the semantic bridge."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+
+def load_instance(labels_path: str | Path, instance_id: str) -> dict:
+    labels = json.loads(Path(labels_path).read_text(encoding="utf-8"))
+    matches = [item for item in labels if str(item.get("ins_id")) == str(instance_id)]
+    if len(matches) != 1:
+        raise ValueError(f"Expected one instance {instance_id!r}, found {len(matches)}")
+    item = matches[0]
+    if "bounding_box" not in item or len(item["bounding_box"]) != 8:
+        raise ValueError(f"Instance {instance_id!r} has no eight-corner bounding_box")
+    return item
+
+
+def bbox_corners(instance: dict) -> np.ndarray:
+    return np.asarray([[p["x"], p["y"], p["z"]] for p in instance["bounding_box"]], dtype=np.float64)
+
+
+def points_in_oriented_bbox(points: np.ndarray, corners: np.ndarray, padding: float = 0.02,
+                            floor_clearance: float = 0.03) -> np.ndarray:
+    """Test points against the oriented box encoded by InteriorGS corner order."""
+    origin = corners[0]
+    edges = np.stack((corners[1] - origin, corners[3] - origin, corners[4] - origin))
+    lengths = np.linalg.norm(edges, axis=1)
+    axes = edges / lengths[:, None]
+    local = (points - origin) @ axes.T
+    lower = np.array([-padding, -padding, floor_clearance], dtype=np.float64)
+    upper = lengths + padding
+    return np.all((local >= lower) & (local <= upper), axis=1)
+
+
+def camera_basis(camera: dict) -> tuple[np.ndarray, np.ndarray]:
+    """Return OpenCV-style world-to-camera R,t (right, down, forward)."""
+    position = np.asarray(camera["position"], dtype=np.float64)
+    target = np.asarray(camera["target"], dtype=np.float64)
+    up = np.asarray(camera.get("up", [0.0, 0.0, 1.0]), dtype=np.float64)
+    forward = target - position
+    forward /= np.linalg.norm(forward)
+    right = np.cross(forward, up)
+    right /= np.linalg.norm(right)
+    down = np.cross(forward, right)
+    rotation = np.stack((right, down, forward), axis=0)
+    return rotation, -rotation @ position
+
+
+def project_points(points: np.ndarray, camera: dict) -> tuple[np.ndarray, np.ndarray]:
+    rotation, translation = camera_basis(camera)
+    cam = points @ rotation.T + translation
+    z = cam[:, 2]
+    uv = np.empty((len(points), 2), dtype=np.float64)
+    uv[:, 0] = float(camera["fx"]) * cam[:, 0] / z + float(camera["cx"])
+    uv[:, 1] = float(camera["fy"]) * cam[:, 1] / z + float(camera["cy"])
+    return uv, z
+
+
+def projected_bbox_mask(corners: np.ndarray, camera: dict) -> tuple[np.ndarray, np.ndarray]:
+    uv, depth = project_points(corners, camera)
+    if np.any(depth <= 0):
+        raise ValueError("A bbox corner is behind the camera")
+    hull = cv2.convexHull(np.rint(uv).astype(np.int32))
+    mask = np.zeros((int(camera["height"]), int(camera["width"])), dtype=np.uint8)
+    cv2.fillConvexPoly(mask, hull, 255)
+    return mask, hull[:, 0, :]
+
+
+def load_cameras(path: str | Path) -> list[dict]:
+    payload = json.loads(Path(path).read_text(encoding="utf-8"))
+    cameras = payload.get("cameras", payload)
+    if not isinstance(cameras, list) or not cameras:
+        raise ValueError("cameras.json must contain a non-empty cameras list")
+    return cameras
+
+
+def encode_ids(ids: np.ndarray) -> np.ndarray:
+    """Losslessly encode Gaussian IDs as RGB24; black means background."""
+    values = ids.astype(np.int64) + 1
+    values[ids < 0] = 0
+    if values.max(initial=0) >= 2**24:
+        raise ValueError("RGB24 ID encoding supports fewer than 16,777,215 Gaussians")
+    return np.stack((values & 255, (values >> 8) & 255, (values >> 16) & 255), axis=-1).astype(np.uint8)
+
+
+def decode_ids(rgb: np.ndarray) -> np.ndarray:
+    values = rgb[..., 0].astype(np.int64) | (rgb[..., 1].astype(np.int64) << 8) | (rgb[..., 2].astype(np.int64) << 16)
+    return values - 1
