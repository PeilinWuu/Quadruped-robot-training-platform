@@ -0,0 +1,97 @@
+"""Build room-batch physics/RGB reports and a lossless comparison sheet."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+LEVELS = ("low", "medium", "high")
+FAMILIES = ("table", "sofa", "curtain")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch-root", type=Path, required=True)
+    args = parser.parse_args()
+    reports, renders = args.batch_root / "reports", args.batch_root / "renders"
+    scenarios, source_files = [], []
+    family_checks = {}
+    sheet = Image.new("RGB", (640 * 3, 390 * 3), "white")
+    draw = ImageDraw.Draw(sheet)
+
+    for row, family in enumerate(FAMILIES):
+        physics_path = reports / f"{family}_batch_physics_report.json"
+        physics = json.loads(physics_path.read_text(encoding="utf-8"))
+        source_files.append(str(physics_path.resolve()))
+        by_level = {item["fire_level"]: item for item in physics["scenarios"]}
+        base = np.asarray(Image.open(renders / "baselines" / f"{family}.png").convert("RGB"), dtype=np.int16)
+        family_rows = []
+        for col, level in enumerate(LEVELS):
+            item = by_level[level]
+            name = f"office_{family}_{level}"
+            frame_path = renders / name / f"{name}_preview_frames" / "frame_029.png"
+            render_report_path = renders / name / f"{name}_preview.json"
+            image = Image.open(frame_path).convert("RGB")
+            rgb = np.asarray(image, dtype=np.int16)
+            delta = np.max(np.abs(rgb - base), axis=2)
+            metrics = {
+                "scenario": name,
+                "object_family": family,
+                "fire_level": level,
+                "initial_ignition_voxel_count": item["initial_ignition_voxel_count"],
+                "patch_count": item["patch_count"],
+                **item["final"],
+                "rgb_changed_percent_threshold_8": float(np.mean(delta > 8) * 100),
+                "rgb_mean_absolute_change": float(np.mean(np.abs(rgb - base))),
+                "representative_frame": str(frame_path.resolve()),
+                "render_report": str(render_report_path.resolve()),
+            }
+            scenarios.append(metrics)
+            family_rows.append(metrics)
+            sheet.paste(image, (col * 640, row * 390 + 30))
+            draw.text((col * 640 + 8, row * 390 + 8), f"{family.upper()} / {level.upper()} / frame 29", fill="black")
+            source_files.extend([str(frame_path.resolve()), str(render_report_path.resolve())])
+        fuel = [x["fuel_voxel_count"] for x in family_rows]
+        temp = [x["temperature_voxel_count"] for x in family_rows]
+        ignition = [x["initial_ignition_voxel_count"] for x in family_rows]
+        extent_volume = [float(np.prod(x["burning_extent_m"])) for x in family_rows]
+        rgb_change = [x["rgb_changed_percent_threshold_8"] for x in family_rows]
+        family_checks[family] = {
+            "initial_ignition_high_gt_medium_gt_low": ignition[2] > ignition[1] > ignition[0],
+            "final_fuel_high_gt_medium_gt_low": fuel[2] > fuel[1] > fuel[0],
+            "final_temperature_high_gt_medium_gt_low": temp[2] > temp[1] > temp[0],
+            "burning_extent_volume_high_gt_medium_gt_low": extent_volume[2] > extent_volume[1] > extent_volume[0],
+            "rgb_change_high_gt_medium_gt_low": rgb_change[2] > rgb_change[1] > rgb_change[0],
+        }
+
+    passed = all(all(checks.values()) for checks in family_checks.values())
+    payload = {
+        "metadata": {"scenario_name": "office_01_room_fire_batch_30f", "timestamp": timestamp(),
+                     "source_files": source_files},
+        "passed": passed, "scenario_count": len(scenarios), "frame_count": 30,
+        "shared_render_parameters": {"strength": 0.05, "smoke_strength": 1.0,
+                                     "coarse_samples": 32, "fine_samples": 128,
+                                     "representative_frames": [0, 10, 20, 29]},
+        "family_ordering_checks": family_checks, "scenarios": scenarios,
+        "notes": [
+            "RGB metrics compare lossless frame 29 against the same-family static Gaussian baseline.",
+            "Carbonization is zero at 30 frames; the short validation horizon is insufficient to cross the native 0.7 occupancy threshold.",
+        ],
+    }
+    write_json(reports / "batch_physics_report.json", payload)
+    write_json(reports / "fire_level_comparison_report.json", payload)
+    sheet_path = args.batch_root / "comparisons" / "fire_level_frame29_grid.png"
+    sheet_path.parent.mkdir(parents=True, exist_ok=True)
+    sheet.save(sheet_path)
+    print(json.dumps({"passed": passed, "scenarios": len(scenarios), "comparison": str(sheet_path)}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
