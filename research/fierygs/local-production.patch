@@ -0,0 +1,91 @@
+"""Create contact sheets, key-event packages, and complete render metadata."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+SAMPLES = (0, 20, 40, 60, 80, 100, 120, 140, 160, 180, 199)
+
+
+def changed_percent(base: np.ndarray, path: Path) -> float:
+    image = np.asarray(Image.open(path).convert("RGB"), dtype=np.int16)
+    return float(np.mean(np.max(np.abs(image - base), axis=2) > 8) * 100)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", required=True)
+    parser.add_argument("--baseline-dir", type=Path, required=True)
+    parser.add_argument("--static-baseline", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--metrics", type=Path, required=True)
+    parser.add_argument("--propagation", type=Path, required=True)
+    args = parser.parse_args()
+    frames_dir = args.baseline_dir / "baseline_full_frames"
+    paths = {frame: frames_dir / f"frame_{frame:03d}.png" for frame in range(200)}
+    missing = [frame for frame, path in paths.items() if not path.exists()]
+    if missing:
+        raise FileNotFoundError(f"Missing rendered frames: {missing[:10]}")
+    base = np.asarray(Image.open(args.static_baseline).convert("RGB"), dtype=np.int16)
+    changes = [changed_percent(base, paths[frame]) for frame in range(200)]
+    first_visible = next((frame for frame, value in enumerate(changes) if value >= 0.5), 0)
+    metrics = json.loads(args.metrics.read_text(encoding="utf-8"))
+    propagation = json.loads(args.propagation.read_text(encoding="utf-8"))
+    secondary = propagation["first_genuine_secondary_ignition_frame"]
+    carbon = metrics["first_carbonized_frame"]
+
+    thumb = (320, 180)
+    sheet = Image.new("RGB", (thumb[0] * 4, (thumb[1] + 26) * 3), "white")
+    draw = ImageDraw.Draw(sheet)
+    for index, frame in enumerate(SAMPLES):
+        x, y = (index % 4) * thumb[0], (index // 4) * (thumb[1] + 26)
+        image = Image.open(paths[frame]).convert("RGB").resize(thumb, Image.Resampling.LANCZOS)
+        sheet.paste(image, (x, y + 26))
+        draw.text((x + 6, y + 7), f"frame {frame:03d} | RGB change {changes[frame]:.1f}%", fill="black")
+    sheet.save(args.baseline_dir / "contact_sheet.png")
+
+    event_reasons: dict[int, list[str]] = {0: ["first exported frame after native step 0"],
+                                          first_visible: ["first frame with >=0.5% changed pixels"]}
+    if secondary is not None:
+        event_reasons.setdefault(int(secondary), []).append("first native secondary ignition and occupancy-loss evidence")
+    if carbon is not None:
+        event_reasons.setdefault(int(carbon), []).append("first reported native occupancy<0.7 carbonization")
+    event_reasons.setdefault(199, []).append("final 200-frame state")
+    event_dir = args.baseline_dir.parent / "key_events"
+    event_dir.mkdir(parents=True, exist_ok=True)
+    events = []
+    for frame, reasons in sorted(event_reasons.items()):
+        destination = event_dir / f"frame_{frame:03d}.png"
+        shutil.copy2(paths[frame], destination)
+        events.append({"frame": frame, "file": str(destination.resolve()), "reasons": reasons,
+                       "rgb_changed_percent_threshold_8": changes[frame]})
+    write_json(event_dir / "event_index.json", {
+        "metadata": {"scenario_name": args.scenario, "timestamp": timestamp(),
+                     "source_files": [str(args.metrics.resolve()), str(args.propagation.resolve())]},
+        "first_visible_operational_definition": ">=0.5% pixels differ by more than 8/255 from static GS baseline",
+        "events": events,
+    })
+    original_metadata = json.loads((args.baseline_dir / "baseline_full.json").read_text(encoding="utf-8"))
+    write_json(args.baseline_dir / "render_metadata.json", {
+        **original_metadata,
+        "camera_config": str(args.camera.resolve()),
+        "camera": json.loads(args.camera.read_text(encoding="utf-8")),
+        "static_baseline": str(args.static_baseline.resolve()),
+        "full_frame_count": 200,
+    })
+    print(json.dumps({"scenario": args.scenario, "frames": 200, "first_visible": first_visible,
+                      "secondary": secondary, "carbonization": carbon,
+                      "contact_sheet": str((args.baseline_dir / 'contact_sheet.png').resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
