+"""Write exact RGB difference metrics for two lossless render outputs."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--variant", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--label", required=True)
+    args = parser.parse_args()
+    a = np.asarray(Image.open(args.baseline).convert("RGB"), dtype=np.int16)
+    b = np.asarray(Image.open(args.variant).convert("RGB"), dtype=np.int16)
+    if a.shape != b.shape:
+        raise ValueError(f"Image shapes differ: {a.shape} vs {b.shape}")
+    delta = np.abs(b - a)
+    report = {
+        "label": args.label,
+        "baseline": str(args.baseline.resolve()), "variant": str(args.variant.resolve()),
+        "changed_pixels": int(np.any(delta > 0, axis=-1).sum()),
+        "changed_pixel_fraction": float(np.any(delta > 0, axis=-1).mean()),
+        "mean_absolute_rgb_delta_8bit": float(delta.mean()),
+        "max_absolute_rgb_delta_8bit": int(delta.max()),
+        "pixels_changed_by_at_least_2": int(np.any(delta >= 2, axis=-1).sum()),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
