+   if e.get('vertical_relation') in {'above','below','same_level'}: reasons.append(e['vertical_relation'])
+   rows.append({'source_id':sid,'target_id':str(target['instance_id']),'source_category':source.get('category'),'target_category':target.get('category'),'distance':round(d,6),'relationship':rel,'material':target.get('material'),'score':round(score,6),'reason':reasons})
+  rows.sort(key=lambda x:x['score'],reverse=True); per[sid]=rows; out.extend(rows)
+ a.output_dir.mkdir(parents=True,exist_ok=True); (a.output_dir/'propagation_candidates.json').write_text(json.dumps(out,ensure_ascii=False,indent=2)+'\n',encoding='utf8'); all_d=[x['distance'] for x in out]; report={'ignition_count':len(c),'total_propagation_candidates':len(out),'average_candidates_per_ignition':len(out)/len(c) if c else 0,'top10_by_ignition':{k:v[:10] for k,v in per.items()},'nearest_distance_statistics':{'min':min(all_d) if all_d else None,'mean':sum(all_d)/len(all_d) if all_d else None,'max':max(all_d) if all_d else None},'no_propagation_targets':[k for k,v in per.items() if not v],'parameters':{'max_distance_m':1.5,'weights':{'proximity':.35,'contact_or_adjacency':.25,'material_suitability':.20,'object_scale':.10,'gaussian_coverage':.10}}}; (a.output_dir/'propagation_report.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\n',encoding='utf8'); print(json.dumps({'ignition_count':len(c),'total_candidates':len(out),'average':report['average_candidates_per_ignition'],'top_by_ignition':{k:v[:3] for k,v in per.items()}},ensure_ascii=False))
