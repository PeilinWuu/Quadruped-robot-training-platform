@@ -0,0 +1,54 @@
+"""Create a deterministic close camera facing a candidate object's ignition surface."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--candidates", type=Path, required=True)
+    parser.add_argument("--object-id", type=int, required=True)
+    parser.add_argument("--scenario-name", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--width", type=int, default=640)
+    parser.add_argument("--height", type=int, default=360)
+    args = parser.parse_args()
+
+    payload = json.loads(args.candidates.read_text(encoding="utf-8"))
+    item = next((value for value in payload["objects"] if value["object_id"] == args.object_id), None)
+    if item is None:
+        raise ValueError(f"Object {args.object_id} absent from candidates")
+    lower, upper = np.asarray(item["bbox_min"], float), np.asarray(item["bbox_max"], float)
+    center, extent = (lower + upper) / 2, upper - lower
+    target = center.copy()
+    target[2] = upper[2] - min(0.15, max(0.0, extent[2] * 0.15))
+    room_center = np.asarray([3.0, -2.5, 1.2])
+    horizontal_axis = int(np.argmin(extent[:2]))
+    direction = np.zeros(3)
+    direction[horizontal_axis] = np.sign(room_center[horizontal_axis] - center[horizontal_axis]) or 1.0
+    distance = max(2.0, min(3.2, float(max(extent[:2]) * 1.4 + 1.2)))
+    position = target + direction * distance
+    position[2] = min(2.4, max(1.2, target[2] + 0.35))
+    vertical_fov = np.deg2rad(60.0)
+    fy = 0.5 * args.height / np.tan(vertical_fov / 2)
+    camera = {
+        "width": args.width, "height": args.height, "fx": float(fy), "fy": float(fy),
+        "cx": args.width / 2, "cy": args.height / 2,
+        "position": position.tolist(), "target": target.tolist(), "up": [0, 0, 1],
+        "metadata": {"scenario_name": args.scenario_name, "timestamp": timestamp(),
+                     "source_file": str(args.candidates.resolve()), "object_id": args.object_id,
+                     "semantic_label": item["semantic_label"], "camera_axis": horizontal_axis},
+    }
+    write_json(args.output, camera)
+    print(json.dumps(camera, indent=2))
+
+
+if __name__ == "__main__":
+    main()
