@@ -0,0 +1,36 @@
+"""Select one camera from a semantic-bridge camera set for scenario rendering."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--index", type=int, default=0)
+    parser.add_argument("--scenario-name", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    payload = json.loads(args.cameras.read_text(encoding="utf-8"))
+    cameras = payload.get("cameras", payload)
+    if not 0 <= args.index < len(cameras):
+        raise IndexError(f"Camera index {args.index} outside 0..{len(cameras) - 1}")
+    selected = dict(cameras[args.index])
+    selected["metadata"] = {
+        "scenario_name": args.scenario_name, "timestamp": timestamp(),
+        "source_file": str(args.cameras.resolve()), "source_camera_index": args.index,
+        "source_instance_id": payload.get("instance_id"),
+        "source_object_name": payload.get("object_name"),
+    }
+    write_json(args.output, selected)
+    print(json.dumps(selected, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/adapter/fire_scenario/summarize_scenario_validation.py b/adapter/fire_scenario/summarize_scenario_validation.py
new file mode 100644
index 0000000..963cf6d
--- /dev/null
