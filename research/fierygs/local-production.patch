+++ b/adapter/fire_scenario/validate_fire_render.py
@@ -0,0 +1,91 @@
+"""Compare native fire compositing with a no-volume baseline."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def labelled_panel(image: Image.Image, label: str) -> Image.Image:
+    panel = Image.new("RGB", (image.width, image.height + 28), (8, 12, 16))
+    panel.paste(image, (0, 0))
+    ImageDraw.Draw(panel).text((8, image.height + 6), label, fill=(230, 235, 240))
+    return panel
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--fire-image", type=Path, required=True)
+    parser.add_argument("--baseline-image", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    fire = np.asarray(Image.open(args.fire_image).convert("RGB"), dtype=np.int16)
+    baseline = np.asarray(Image.open(args.baseline_image).convert("RGB"), dtype=np.int16)
+    if fire.shape != baseline.shape:
+        raise ValueError(f"Image shapes differ: {fire.shape} vs {baseline.shape}")
+    difference = np.abs(fire - baseline)
+    changed = np.max(difference, axis=2) >= 3
+    changed_pixels = int(changed.sum())
+    if changed_pixels:
+        rows, columns = np.where(changed)
+        changed_bbox = [int(columns.min()), int(rows.min()), int(columns.max() + 1), int(rows.max() + 1)]
+    else:
+        changed_bbox = None
+
+    amplified = np.clip(difference * 6, 0, 255).astype(np.uint8)
+    panels = [
+        labelled_panel(Image.fromarray(baseline.astype(np.uint8)), "Gaussian baseline (volume disabled)"),
+        labelled_panel(Image.fromarray(fire.astype(np.uint8)), "FieryGS native fire composite"),
+        labelled_panel(Image.fromarray(amplified), "Absolute RGB difference x6"),
+    ]
+    comparison = Image.new("RGB", (sum(p.width for p in panels), max(p.height for p in panels)), (8, 12, 16))
+    cursor = 0
+    for panel in panels:
+        comparison.paste(panel, (cursor, 0)); cursor += panel.width
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    comparison_path = args.output_dir / "fire_render_comparison.png"
+    comparison.save(comparison_path)
+
+    fire_report = json.loads(args.fire_image.with_suffix(".json").read_text(encoding="utf-8"))
+    baseline_report = json.loads(args.baseline_image.with_suffix(".json").read_text(encoding="utf-8"))
+    checks = {
+        "same_resolution": fire.shape == baseline.shape,
+        "fire_volume_enabled": fire_report["volume_enabled"] is True,
+        "baseline_volume_disabled": baseline_report["volume_enabled"] is False,
+        "source_fire_state_nonempty": fire_report["source_fuel_nonzero_voxels"] > 0,
+        "native_composite_changes_rgb": changed_pixels > 0,
+        "all_pixels_finite": bool(np.isfinite(fire).all() and np.isfinite(baseline).all()),
+    }
+    report = {
+        "metadata": {
+            "scenario_name": fire_report["metadata"]["scenario_name"], "timestamp": timestamp(),
+            "gaussian_count": fire_report["metadata"]["gaussian_count"],
+            "source_files": [str(args.fire_image.resolve()), str(args.baseline_image.resolve())],
+        },
+        "passed": all(checks.values()), "checks": checks,
+        "frame": fire_report["frame"], "resolution": [fire.shape[1], fire.shape[0]],
+        "source_fuel_nonzero_voxels": fire_report["source_fuel_nonzero_voxels"],
+        "changed_pixels_threshold_3": changed_pixels,
+        "changed_pixel_fraction": changed_pixels / (fire.shape[0] * fire.shape[1]),
+        "changed_region_xyxy": changed_bbox,
+        "absolute_difference_mean": float(difference.mean()),
+        "absolute_difference_max": int(difference.max()),
+        "comparison_image": str(comparison_path.resolve()),
+        "renderer": "gaussian_renderer.renderer_with_fire.render_fire",
+        "core_renderer_modified": False,
+    }
+    write_json(args.output_dir / "fire_render_validation_report.json", report)
+    print(json.dumps(report, indent=2))
+    if not report["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
