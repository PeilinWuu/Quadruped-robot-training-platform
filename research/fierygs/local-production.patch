@@ -0,0 +1,70 @@
+"""Consolidate active-buffer and deterministic staged-prefix validation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+FIELDS = ("fuel", "temperature", "occupancy", "wood_temperature")
+
+
+def compare_prefix(short: Path, long: Path, count: int) -> dict:
+    mismatches = {name: [] for name in FIELDS}
+    for frame in range(count):
+        for name in FIELDS:
+            left = np.load(short / name / f"{name}_{frame}.npz")["arr_0"]
+            right = np.load(long / name / f"{name}_{frame}.npz")["arr_0"]
+            if not np.array_equal(left, right, equal_nan=True):
+                mismatches[name].append(frame)
+    return {"frames_compared": count, "fields": list(FIELDS), "exact": not any(mismatches.values()),
+            "mismatch_frames": mismatches}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", type=Path, required=True)
+    args = parser.parse_args()
+    reports = args.root / "reports"
+    table60 = json.loads((reports / "table_high_60_buffer_validation.json").read_text(encoding="utf-8"))
+    stage_reports = []
+    for path in sorted(reports.glob("*_buffer_validation.json")):
+        stage = json.loads(path.read_text(encoding="utf-8"))
+        stage_reports.append({"scenario": stage["metadata"]["scenario_name"],
+                              "all_arrays_finite": stage["all_arrays_finite"],
+                              "frame_0_active_fire_nonzero": stage["frame_0_active_fire_nonzero"],
+                              "frames": len(stage["frames"]), "source": str(path.resolve())})
+    comparisons = {
+        "60_to_120": compare_prefix(args.root / "table_high/run_60/sim_output",
+                                     args.root / "table_high/run_120/sim_output", 60),
+        "120_to_200": compare_prefix(args.root / "table_high/run_120/sim_output",
+                                      args.root / "table_high/run_200/sim_output", 120),
+    }
+    slots = [x["active_slots"] for x in table60["frames"]]
+    fuel_alternates = all(slots[i]["fuel"] != slots[i - 1]["fuel"] for i in range(1, len(slots)))
+    payload = {
+        "metadata": {"scenario_name": "office_01_long_run_buffer_validation", "timestamp": timestamp(),
+                     "source_files": [x["source"] for x in stage_reports]},
+        "passed": bool(table60["export_exactly_equals_active_all_frames"] and fuel_alternates and
+                       all(x["all_arrays_finite"] and x["frame_0_active_fire_nonzero"] for x in stage_reports) and
+                       all(x["exact"] for x in comparisons.values())),
+        "frame_semantics": "frame N equals state immediately after native step N (zero-based)",
+        "table_high_60_every_frame_export_equals_active": table60["export_exactly_equals_active_all_frames"],
+        "table_high_60_active_fuel_slot_alternates": fuel_alternates,
+        "frame_0_not_accidental_zero": table60["frame_0_active_fire_nonzero"],
+        "staged_execution_policy": "deterministic restart because no complete native fluid/pressure checkpoint exists",
+        "prefix_comparisons": comparisons, "stage_reports": stage_reports,
+        "velocity_exported": False, "smoke_exported": False,
+    }
+    output = reports / "long_run_buffer_validation_report.json"
+    write_json(output, payload)
+    print(json.dumps({"passed": payload["passed"], "prefix": comparisons}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
