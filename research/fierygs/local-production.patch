@@ -0,0 +1,82 @@
+"""Map native FieryGS VLM output back to bridged Gaussian part labels."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from vis_material_seg import (
+    BURNABILITY_MAPPING,
+    MATERIAL_MAPPING,
+    assign_material_and_burnability_to_points,
+    parse_label_files_to_json,
+)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--model-dir", type=Path, required=True)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--vlm", default="gpttool")
+    args = parser.parse_args()
+
+    single = args.model_dir / "gpt_input" / "gpt_input_single" / f"gpt_input_single_{args.vlm}.txt"
+    multi = args.model_dir / "gpt_input" / "gpt_input_mul" / f"gpt_input_mul_{args.vlm}.txt"
+    sources = [path for path in (single, multi) if path.is_file() and path.stat().st_size > 0]
+    if not sources:
+        raise FileNotFoundError("No non-empty native FieryGS VLM prediction file found")
+
+    mapping_path = args.model_dir / "label_mapping_hierachical.json"
+    parse_label_files_to_json(
+        [str(path) for path in sources], MATERIAL_MAPPING, BURNABILITY_MAPPING, str(mapping_path)
+    )
+    mapping = json.loads(mapping_path.read_text(encoding="utf-8"))
+    if "000" not in mapping:
+        raise ValueError("Native VLM output did not produce part 000")
+    if mapping["000"]["material_id"] < 0 or mapping["000"]["burnability_id"] < 0:
+        raise ValueError(f"Unsupported native prediction: {mapping['000']}")
+
+    # This run deliberately classifies only the table. Part 1 is the remainder
+    # of the scene and receives a conservative non-burnable placeholder so the
+    # unmodified FieryGS mapper can satisfy its all-points invariant.
+    mapping["001"] = {
+        "material": "composite",
+        "material_id": MATERIAL_MAPPING["composite"],
+        "burnanility": "unburnable",
+        "burnability_id": BURNABILITY_MAPPING["unburnable"],
+        "adapter_policy": "unprocessed_scene_safe_background",
+    }
+    mapping_path.write_text(json.dumps(mapping, indent=2) + "\n", encoding="utf-8")
+
+    labels_np = np.load(args.model_dir / "points_label_mulscale.npy")
+    gaussians = load_interiorgs_gaussians(args.ply)
+    if labels_np.shape != (gaussians.get_xyz.shape[0],):
+        raise ValueError(f"Label shape {labels_np.shape} does not match Gaussian count {gaussians.get_xyz.shape[0]}")
+    labels = torch.from_numpy(labels_np).to(device="cuda")
+    materials, burnability = assign_material_and_burnability_to_points(
+        gaussians.get_xyz, labels, str(mapping_path)
+    )
+    np.save(args.model_dir / "points_materials.npy", materials.cpu().numpy().astype(np.int32))
+    np.save(args.model_dir / "points_burnability.npy", burnability.cpu().numpy().astype(np.int32))
+    report = {
+        "gaussian_count": int(labels.numel()),
+        "table_gaussians": int((labels == 0).sum()),
+        "background_gaussians": int((labels == 1).sum()),
+        "table_prediction": mapping["000"],
+        "background_policy": mapping["001"],
+        "outputs": ["points_materials.npy", "points_burnability.npy"],
+    }
+    (args.model_dir / "material_mapping_report.json").write_text(
+        json.dumps(report, indent=2) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
+
diff --git a/adapter/semantic_bridge/prepare_all_instances.py b/adapter/semantic_bridge/prepare_all_instances.py
new file mode 100644
index 0000000..536975d
--- /dev/null
+++ b/adapter/semantic_bridge/prepare_all_instances.py
@@ -0,0 +1,258 @@
+"""Prepare FieryGS-native VLM inputs for every InteriorGS instance bbox.
+
+This is the scene-wide counterpart of the validated single-table bridge.  It
+reuses a shared set of rendered RGB/Gaussian-ID views, assigns every Gaussian
+to at most one bbox (smallest enclosing bbox wins), and emits compact FieryGS
+part labels plus one three-panel VLM image per resolved instance.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import cv2
+import numpy as np
+from PIL import Image, ImageDraw
+from plyfile import PlyData
+
+from adapter.semantic_bridge.common import bbox_corners, decode_ids, load_cameras, projected_bbox_mask
+
+
+def load_xyz(path: Path) -> np.ndarray:
+    vertex = PlyData.read(str(path), mmap=True)["vertex"].data
+    return np.stack(
+        (np.asarray(vertex["x"]), np.asarray(vertex["y"]), np.asarray(vertex["z"])), axis=1
+    ).astype(np.float32, copy=False)
+
+
+def valid_instances(path: Path) -> list[dict]:
+    records = json.loads(path.read_text(encoding="utf-8"))
+    result = []
+    seen = set()
+    for record in records:
+        instance_id = str(record.get("ins_id", ""))
+        if not instance_id or instance_id in seen or len(record.get("bounding_box", [])) != 8:
+            continue
+        seen.add(instance_id)
+        corners = bbox_corners(record)
+        origin = corners[0]
+        edges = np.stack((corners[1] - origin, corners[3] - origin, corners[4] - origin))
+        lengths = np.linalg.norm(edges, axis=1)
+        if np.any(lengths <= 1e-5):
+            continue
+        item = dict(record)
+        item["_corners"] = corners
+        item["_origin"] = origin
+        item["_axes"] = edges / lengths[:, None]
+        item["_lengths"] = lengths
+        item["_volume"] = float(np.prod(lengths))
+        result.append(item)
+    return result
+
+
+def candidate_indices(xyz: np.ndarray, instance: dict, padding: float) -> np.ndarray:
+    corners = instance["_corners"]
+    lower = corners.min(axis=0) - padding
+    upper = corners.max(axis=0) + padding
+    aabb = np.all((xyz >= lower) & (xyz <= upper), axis=1)
+    rows = np.flatnonzero(aabb)
+    if not len(rows):
+        return rows
+    local = (xyz[rows] - instance["_origin"]) @ instance["_axes"].T
+    inside = np.all((local >= -padding) & (local <= instance["_lengths"] + padding), axis=1)
+    return rows[inside]
+
+
+def load_shared_views(cameras: list[dict], views_dir: Path) -> tuple[list[np.ndarray], list[np.ndarray]]:
+    rgbs, ids = [], []
+    for index, _camera in enumerate(cameras):
+        view_dir = views_dir / f"view_{index:03d}"
+        rgb_path, id_path = view_dir / "rgb.png", view_dir / "gaussian_id.png"
+        if not rgb_path.is_file() or not id_path.is_file():
+            raise FileNotFoundError(f"Missing shared render for camera {index}: {view_dir}")
+        rgbs.append(np.asarray(Image.open(rgb_path).convert("RGB")))
+        ids.append(decode_ids(np.asarray(Image.open(id_path).convert("RGB"))))
+    return rgbs, ids
+
+
+def make_panel(original: np.ndarray, visible_mask: np.ndarray, hull_mask: np.ndarray,
+               object_name: str) -> Image.Image:
+    height, width = original.shape[:2]
+    target = visible_mask.astype(np.uint8)
+    target = cv2.dilate(target, np.ones((3, 3), np.uint8), iterations=1).astype(bool)
+    target &= hull_mask
+    ys, xs = np.nonzero(target)
+    if not len(xs):
+        ys, xs = np.nonzero(hull_mask)
+    x0, x1 = int(xs.min()), int(xs.max()) + 1
+    y0, y1 = int(ys.min()), int(ys.max()) + 1
+    margin = max(4, int(0.08 * max(x1 - x0, y1 - y0)))
+    x0, x1 = max(0, x0 - margin), min(width, x1 + margin)
+    y0, y1 = max(0, y0 - margin), min(height, y1 + margin)
+
+    overlay = original.astype(np.float32)
+    blue = np.zeros_like(overlay)
+    blue[..., 0], blue[..., 1], blue[..., 2] = 51, 102, 255
+    overlay[target] = 0.4 * overlay[target] + 0.6 * blue[target]
+    overlay = np.clip(overlay, 0, 255).astype(np.uint8)
+    cv2.rectangle(overlay, (x0, y0), (x1 - 1, y1 - 1), (255, 0, 0), 2)
+
+    crop = original[y0:y1, x0:x1].copy()
+    crop_mask = hull_mask[y0:y1, x0:x1]
+    isolated = np.full_like(crop, 255)
+    isolated[crop_mask] = crop[crop_mask]
+    canvas = np.full_like(original, 255)
+    scale = min(height / max(1, crop.shape[0]), width / max(1, crop.shape[1]))
+    resized = cv2.resize(
+        isolated,
+        (max(1, int(crop.shape[1] * scale)), max(1, int(crop.shape[0] * scale))),
+        interpolation=cv2.INTER_LINEAR,
+    )
+    top, left = (height - resized.shape[0]) // 2, (width - resized.shape[1]) // 2
+    canvas[top:top + resized.shape[0], left:left + resized.shape[1]] = resized
+
+    gap, header = 20, 50
+    grid = np.full((height + header, width * 3 + gap * 4, 3), 255, dtype=np.uint8)
+    for column, image in enumerate((original, overlay, canvas)):
+        start = gap + column * (width + gap)
+        grid[header:, start:start + width] = image
+    result = Image.fromarray(grid, mode="RGB")
+    ImageDraw.Draw(result).text(
+        (gap, 15), f"original | masked {object_name} | isolated bbox crop", fill=(0, 0, 0)
+    )
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--cameras", type=Path, required=True)
+    parser.add_argument("--views-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--bbox-padding", type=float, default=0.01)
+    parser.add_argument("--min-gaussians", type=int, default=8)
+    args = parser.parse_args()
+
+    xyz = load_xyz(args.ply)
+    instances = valid_instances(args.labels)
+    cameras = load_cameras(args.cameras)
+    rgbs, id_maps = load_shared_views(cameras, args.views_dir)
+    print(f"Loaded {len(xyz):,} Gaussians, {len(instances)} bboxes and {len(cameras)} shared views")
+
+    candidates: dict[str, np.ndarray] = {}
+    for position, instance in enumerate(instances, 1):
+        rows = candidate_indices(xyz, instance, args.bbox_padding)
+        candidates[str(instance["ins_id"])] = rows
+        if position % 50 == 0 or position == len(instances):
+            print(f"bbox candidates {position}/{len(instances)}", flush=True)
+
+    # Resolve nested/overlapping boxes deterministically.  Small object boxes
+    # (fruit, cups, plates) claim their own Gaussians before enclosing furniture.
+    instance_by_id = {str(item["ins_id"]): item for item in instances}
+    source_instance = np.full(len(xyz), -1, dtype=np.int32)
+    raw_assignment: dict[str, int] = {}
+    for instance in sorted(instances, key=lambda item: (item["_volume"], str(item["ins_id"]))):
+        instance_id = str(instance["ins_id"])
+        rows = candidates[instance_id]
+        free = rows[source_instance[rows] < 0]
+        if len(free):
+            source_instance[free] = int(instance_id)
+        raw_assignment[instance_id] = int(len(free))
+
+    # Every valid bbox receives a stable part ID, even if its Gaussian support
+    # is weak.  Weak parts remain useful for scene-level material planning and
+    # are explicitly marked instead of silently disappearing.
+    resolved = sorted(instances, key=lambda value: int(value["ins_id"]))
+    background_part = len(resolved)
+    part_labels = np.full(len(xyz), background_part, dtype=np.int32)
+    parts = []
+    for part_id, instance in enumerate(resolved):
+        instance_id = str(instance["ins_id"])
+        selected = source_instance == int(instance_id)
+        part_labels[selected] = part_id
+        parts.append({
+            "part_id": part_id, "instance_id": instance_id,
+            "object_name": str(instance.get("label", "object")),
+            "gaussian_count": int(selected.sum()),
+            "gaussian_mapping_status": (
+                "reliable" if int(selected.sum()) >= args.min_gaussians else "insufficient_gaussians"
+            ),
+            "bbox_volume_m3": instance["_volume"],
+            "source": "InteriorGS_bbox_shared_multiview",
+        })
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    single_dir = args.output_dir / "gpt_input" / "gpt_input_single"
+    multi_dir = args.output_dir / "gpt_input" / "gpt_input_mul"
+    single_dir.mkdir(parents=True, exist_ok=True)
+    multi_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "points_label_mulscale.npy", part_labels)
+    np.save(args.output_dir / "gaussian_instance_ids.npy", source_instance)
+
+    part_maps = []
+    for ids in id_maps:
+        mapped = np.full(ids.shape, -1, dtype=np.int32)
+        valid = ids >= 0
+        mapped[valid] = part_labels[ids[valid]]
+        part_maps.append(mapped)
+
+    completed, fallback_required = 0, []
+    for part in parts:
+        part_id = part["part_id"]
+        counts = [int(np.count_nonzero(part_map == part_id)) for part_map in part_maps]
+        best_view = int(np.argmax(counts))
+        part["best_view"] = best_view
+        part["best_view_pixels"] = counts[best_view]
+        if counts[best_view] == 0:
+            part["vlm_status"] = "fallback_required"
+            fallback_required.append(part["instance_id"])
+            continue
+        instance = instance_by_id[part["instance_id"]]
+        try:
+            projected, _ = projected_bbox_mask(instance["_corners"], cameras[best_view])
+            hull_mask = projected > 0
+        except ValueError:
+            hull_mask = part_maps[best_view] == part_id
+        panel = make_panel(
+            rgbs[best_view], part_maps[best_view] == part_id, hull_mask, part["object_name"]
+        )
+        panel.save(single_dir / f"{part_id:03d}.png")
+        part["vlm_status"] = "ready"
+        completed += 1
+        if completed % 50 == 0:
+            print(f"VLM panels {completed}/{len(parts)}", flush=True)
+
+    parts.append({
+        "part_id": background_part, "instance_id": None,
+        "object_name": "unassigned_scene", "gaussian_count": int((part_labels == background_part).sum()),
+        "source": "adapter_safe_background", "material_policy": "unburnable",
+    })
+    manifest = {
+        "gaussian_count": int(len(xyz)), "bbox_count": len(instances),
+        "resolved_instance_count": len(resolved), "vlm_ready_count": completed,
+        "background_part_id": background_part, "parts": parts,
+        "ordering": "unchanged row order from InteriorGS explicit PLY",
+    }
+    (args.output_dir / "parts.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    report = {
+        "bbox_count": len(instances), "resolved_instance_count": len(resolved),
+        "below_min_gaussians_count": sum(
+            part["gaussian_mapping_status"] == "insufficient_gaussians" for part in parts[:-1]
+        ),
+        "vlm_ready_count": completed, "fallback_required_count": len(fallback_required),
+        "fallback_required_instance_ids": fallback_required,
+        "min_gaussians": args.min_gaussians, "bbox_padding_m": args.bbox_padding,
+        "shared_view_count": len(cameras),
+        "outputs": ["points_label_mulscale.npy", "gaussian_instance_ids.npy", "parts.json", "gpt_input"],
+    }
+    (args.output_dir / "batch_preparation_report.json").write_text(
+        json.dumps(report, indent=2) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
