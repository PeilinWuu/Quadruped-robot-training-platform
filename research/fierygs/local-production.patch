+"""Build an RGB/depth/semantic/fire/smoke alignment panel for one rendered sample."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw
+
+
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+LABEL_HEIGHT = 30
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    parser.add_argument("--sample-id", required=True)
+    parser.add_argument("--output", type=Path)
+    return parser.parse_args()
+
+
+def colorize_depth(depth_mm: np.ndarray) -> np.ndarray:
+    valid = depth_mm > 0
+    result = np.zeros((*depth_mm.shape, 3), dtype=np.uint8)
+    if valid.any():
+        lo, hi = np.percentile(depth_mm[valid], [2, 98])
+        normalized = np.clip((depth_mm.astype(np.float32) - lo) / max(hi - lo, 1), 0, 1)
+        result[..., 0] = (255 * normalized).astype(np.uint8)
+        result[..., 1] = (255 * (1 - np.abs(2 * normalized - 1))).astype(np.uint8)
+        result[..., 2] = (255 * (1 - normalized)).astype(np.uint8)
+        result[~valid] = 0
+    return result
+
+
+def colorize_labels(labels: np.ndarray) -> np.ndarray:
+    result = np.zeros((*labels.shape, 3), dtype=np.uint8)
+    valid = labels >= 0
+    values = labels[valid].astype(np.uint32)
+    result[valid, 0] = ((values * 37 + 67) % 251 + 4).astype(np.uint8)
+    result[valid, 1] = ((values * 73 + 29) % 251 + 4).astype(np.uint8)
+    result[valid, 2] = ((values * 109 + 13) % 251 + 4).astype(np.uint8)
+    return result
+
+
+def overlay(rgb: np.ndarray, mask: np.ndarray, color: tuple[int, int, int]) -> np.ndarray:
+    output = rgb.astype(np.float32).copy()
+    tint = np.asarray(color, dtype=np.float32)
+    output[mask] = 0.45 * output[mask] + 0.55 * tint
+    return np.clip(output, 0, 255).astype(np.uint8)
+
+
+def main() -> None:
+    args = parse_args()
+    metadata_path = args.dataset_root / "metadata" / "samples" / f"{args.sample_id}.json"
+    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+    paths = {key: Path(value) for key, value in metadata["outputs"].items()}
+    rgb = np.asarray(Image.open(paths["rgb"]).convert("RGB"))
+    depth = np.asarray(Image.open(paths["depth"]))
+    semantic = np.load(paths["semantic"])["instance_id"]
+    fire = np.asarray(Image.open(paths["fire_binary"]).convert("L")) > 0
+    smoke = np.asarray(Image.open(paths["smoke_binary"]).convert("L")) > 0
+    panels = (
+        ("RGB", rgb),
+        ("Solid depth (mm)", colorize_depth(depth)),
+        ("Instance semantic", colorize_labels(semantic)),
+        ("Fire contribution mask", overlay(rgb, fire, (255, 45, 0))),
+        ("Smoke contribution mask", overlay(rgb, smoke, (80, 160, 255))),
+    )
+    height, width = rgb.shape[:2]
+    sheet = Image.new("RGB", (width * len(panels), height + LABEL_HEIGHT), "white")
+    draw = ImageDraw.Draw(sheet)
+    for index, (label, array) in enumerate(panels):
+        x = index * width
+        sheet.paste(Image.fromarray(array, mode="RGB"), (x, LABEL_HEIGHT))
+        draw.text((x + 8, 8), label, fill="black")
+    output = args.output or args.dataset_root / "previews" / f"{args.sample_id}__qa.png"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    sheet.save(output)
+    print(json.dumps({"sample_id": args.sample_id, "output": str(output.resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
