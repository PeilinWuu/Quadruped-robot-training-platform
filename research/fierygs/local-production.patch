+"""Render a quick static contact sheet for the 24 Dataset v1 robot cameras."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+from adapter.create_scene import camera_from_json
+from adapter.interiorgs_loader import load_interiorgs_gaussians
+from gaussian_renderer import render
+
+
+DEFAULT_PLY = Path(r"D:\interiorgs_data\office_01\3dgs_explicit.ply")
+DEFAULT_ROOT = Path(r"D:\interiorgs_data\office_01\robot_fire_dataset_v1")
+OBJECTS = ("table", "sofa", "curtain")
+LABEL_HEIGHT = 28
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ply", type=Path, default=DEFAULT_PLY)
+    parser.add_argument("--dataset-root", type=Path, default=DEFAULT_ROOT)
+    return parser.parse_args()
+
+
+def make_sheet(images: list[tuple[str, Image.Image]], columns: int) -> Image.Image:
+    width, height = images[0][1].size
+    rows = (len(images) + columns - 1) // columns
+    sheet = Image.new("RGB", (columns * width, rows * (height + LABEL_HEIGHT)), "white")
+    for index, (label, image) in enumerate(images):
+        x = (index % columns) * width
+        y = (index // columns) * (height + LABEL_HEIGHT)
+        sheet.paste(image, (x, y + LABEL_HEIGHT))
+        ImageDraw.Draw(sheet).text((x + 8, y + 7), label, fill="black")
+    return sheet
+
+
+def main() -> None:
+    args = parse_args()
+    preview_root = args.dataset_root / "previews" / "robot_cameras"
+    preview_root.mkdir(parents=True, exist_ok=True)
+    gaussians = load_interiorgs_gaussians(args.ply)
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    all_images: list[tuple[str, Image.Image]] = []
+    records = []
+    with torch.no_grad():
+        for object_name in OBJECTS:
+            object_images = []
+            camera_paths = sorted((args.dataset_root / "cameras" / object_name).glob(f"{object_name}_cam*.json"))
+            if len(camera_paths) != 8:
+                raise RuntimeError(f"{object_name}: expected 8 cameras, found {len(camera_paths)}")
+            object_dir = preview_root / object_name
+            object_dir.mkdir(parents=True, exist_ok=True)
+            for path in camera_paths:
+                camera = camera_from_json(path)
+                output = render(camera, gaussians, pipeline, background)["render"]
+                rgb = (
+                    output.clamp(0, 1)
+                    .permute(1, 2, 0)
+                    .mul(255)
+                    .byte()
+                    .cpu()
+                    .numpy()
+                )
+                image = Image.fromarray(rgb, mode="RGB")
+                output_path = object_dir / f"{path.stem}.png"
+                image.save(output_path)
+                label = path.stem
+                object_images.append((label, image))
+                all_images.append((label, image))
+                records.append(
+                    {
+                        "camera_id": label,
+                        "image": str(output_path.resolve()),
+                        "rgb_mean": float(rgb.mean()),
+                        "rgb_std": float(rgb.std()),
+                        "near_black_fraction": float(np.mean(np.max(rgb, axis=2) < 8)),
+                    }
+                )
+            make_sheet(object_images, 4).save(preview_root / f"{object_name}_camera_contact_sheet.png")
+    combined_path = preview_root / "robot_camera_contact_sheet.png"
+    make_sheet(all_images, 8).save(combined_path)
+    report = {
+        "passed_numeric_sanity": all(
+            row["rgb_std"] > 10 and row["near_black_fraction"] < 0.90 for row in records
+        ),
+        "camera_count": len(records),
+        "combined_contact_sheet": str(combined_path.resolve()),
+        "frames": records,
+    }
+    report_path = preview_root / "robot_camera_preview_report.json"
+    report_path.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(
+        json.dumps(
+            {
+                "passed_numeric_sanity": report["passed_numeric_sanity"],
+                "camera_count": len(records),
+                "combined_contact_sheet": str(combined_path.resolve()),
+                "report": str(report_path.resolve()),
+            },
+            indent=2,
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
