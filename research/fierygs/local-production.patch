@@ -0,0 +1,26 @@
+"""Summarize bounded-source and baseline runs without rendering changes."""
+from pathlib import Path
+import json, argparse
+import numpy as np
+
+def load_arr(folder, name, frame):
+    return np.load(folder / name / f"{name}_{frame}.npz")["arr_0"]
+
+def summarize(path, frames):
+    path=Path(path); out=[]
+    for f in frames:
+        fuel=load_arr(path,"fuel",f); occ=load_arr(path,"occupancy",f); wt=load_arr(path,"wood_temperature",f)
+        rec={"frame":f,"fuel_sum":float(fuel.sum()),"fuel_max":float(fuel.max()),"active_fuel_voxels":int((fuel>1e-5).sum()),
+             "occupancy_sum":float(occ.sum()),"hot_solid_voxels":int((wt>=1.0).sum()),"wood_temp_max":float(wt.max())}
+        p=path/"solid_source"/f"source_{f}.json"
+        if p.exists(): rec["source"]=json.loads(p.read_text())
+        out.append(rec)
+    return out
+
+def main():
+    ap=argparse.ArgumentParser(); ap.add_argument("--output",type=Path); ap.add_argument("--report",type=Path,required=True); ap.add_argument("paths",nargs="+"); a=ap.parse_args()
+    frames=[0,10,20,30,40,50,59]
+    report={"frames":frames,"runs":{str(Path(p).parent.name):summarize(p,frames) for p in a.paths}}
+    a.report.parent.mkdir(parents=True,exist_ok=True); a.report.write_text(json.dumps(report,indent=2),encoding="utf-8")
+    print(json.dumps(report,indent=2))
+if __name__ == "__main__": main()
