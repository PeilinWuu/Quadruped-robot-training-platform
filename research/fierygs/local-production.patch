+"""Render an InteriorGS explicit PLY with the native FieryGS Gaussian rasterizer."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import torch
+from PIL import Image
+
+from adapter.create_scene import create_scene
+from gaussian_renderer import render
+
+
+def save_rgb(tensor: torch.Tensor, path: Path) -> None:
+    rgb = tensor.detach().clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    Image.fromarray(rgb, mode="RGB").save(path)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    scene = create_scene(args.ply, args.camera)
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    torch.cuda.synchronize()
+    result = render(scene.cameras[0], scene.gaussians, pipeline, background)
+    torch.cuda.synchronize()
+    save_rgb(result["render"], args.output)
+    print(json.dumps({
+        "output": str(args.output.resolve()),
+        "image_shape": list(result["render"].shape),
+        "visible_gaussians": int(result["visibility_filter"].sum().item()),
+        "rgb_min": float(result["render"].min().item()),
+        "rgb_max": float(result["render"].max().item()),
+        "cuda_peak_memory_mb": round(torch.cuda.max_memory_allocated() / 1024**2, 1),
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/render_interiorgs_fire.py b/tests/render_interiorgs_fire.py
