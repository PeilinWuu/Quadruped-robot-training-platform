@@ -0,0 +1,140 @@
+"""Track native FieryGS thermal/combustion state per semantic object and frame."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+def first_frame(rows: list[dict], key: str) -> int | None:
+    return next((row["frame"] for row in rows if row[key] > 0), None)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario-name", required=True)
+    parser.add_argument("--source-object-id", type=int, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--initial-occupancy", type=Path, required=True)
+    parser.add_argument("--ignition-mask", type=Path, required=True)
+    parser.add_argument("--propagation-report", type=Path, required=True)
+    parser.add_argument("--labels", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    propagation = json.loads(args.propagation_report.read_text(encoding="utf-8"))
+    object_meta = {x["object_id"]: x for x in propagation["nearby_objects"]}
+    for x in propagation["initial_ignition_objects"]:
+        object_meta[x["object_id"]] = {**x, "status": "ignition_source", "initial_distance_to_ignition_m": 0.0}
+    map_mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy().astype(bool)
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cpu", weights_only=True).numpy()
+    labels = np.load(args.labels)[map_mask]
+    initial_occ = np.load(args.initial_occupancy).astype(np.float32)
+    ignition_mask = np.load(args.ignition_mask).astype(bool)
+    frames = sorted(int(p.stem.rsplit("_", 1)[1]) for p in (args.simulation_dir / "fuel").glob("fuel_*.npz"))
+    states = []
+    for object_id, meta in sorted(object_meta.items()):
+        local_rows = np.flatnonzero(labels == object_id)
+        if len(local_rows):
+            mapped_initial_solid = initial_occ[indices[local_rows, 0], indices[local_rows, 1], indices[local_rows, 2]] > 0
+            local_rows = local_rows[mapped_initial_solid]
+        all_coords = np.unique(indices[local_rows], axis=0) if len(local_rows) else np.empty((0, 3), dtype=int)
+        if object_id != args.source_object_id and len(all_coords):
+            shared = ignition_mask[all_coords[:, 0], all_coords[:, 1], all_coords[:, 2]]
+            coords = all_coords[~shared]
+            excluded_initial_voxels = int(np.count_nonzero(shared))
+            if len(local_rows):
+                local_shared = ignition_mask[indices[local_rows, 0], indices[local_rows, 1], indices[local_rows, 2]]
+                local_rows = local_rows[~local_shared]
+        else:
+            coords, excluded_initial_voxels = all_coords, 0
+        initial_values = initial_occ[coords[:, 0], coords[:, 1], coords[:, 2]] if len(coords) else np.empty(0)
+        states.append({"object_id": object_id, "meta": meta, "local_rows": local_rows,
+                       "coords": coords, "initial_values": initial_values,
+                       "initial_sum": float(initial_values.sum()), "timeline": [],
+                       "excluded_source_ignition_voxels": excluded_initial_voxels})
+
+    # Load each large field only once per frame, then query all semantic objects.
+    for frame in frames:
+        fuel = np.load(args.simulation_dir / "fuel" / f"fuel_{frame}.npz")["arr_0"]
+        gas_temp = np.load(args.simulation_dir / "temperature" / f"temperature_{frame}.npz")["arr_0"]
+        wood_temp = np.load(args.simulation_dir / "wood_temperature" / f"wood_temperature_{frame}.npz")["arr_0"]
+        occ = np.load(args.simulation_dir / "occupancy" / f"occupancy_{frame}.npz")["arr_0"]
+        for state in states:
+            coords, local_rows = state["coords"], state["local_rows"]
+            if len(coords):
+                xyz = (coords[:, 0], coords[:, 1], coords[:, 2])
+                f, gt, wt, oc = fuel[xyz], gas_temp[xyz], wood_temp[xyz], occ[xyz]
+                mapped_occ = occ[indices[local_rows, 0], indices[local_rows, 1], indices[local_rows, 2]]
+                row = {
+                    "frame": frame,
+                    "fuel_field_voxels": int(np.count_nonzero(f > 0)),
+                    "hot_gas_voxels": int(np.count_nonzero(gt > 0)),
+                    "maximum_gas_temperature": float(gt.max()),
+                    "heated_solid_voxels": int(np.count_nonzero(wt > 0)),
+                    "maximum_wood_temperature": float(wt.max()),
+                    "native_ignited_solid_voxels": int(np.count_nonzero((wt >= 1.0) & (oc > 0))),
+                    "affected_object_voxels": int(np.count_nonzero((gt > 0) | (wt > 0) | (oc < state["initial_values"]))),
+                    "occupancy_sum": float(oc.sum()),
+                    "occupancy_loss": float(state["initial_sum"] - oc.sum()),
+                    "carbonized_gaussian_count": int(np.count_nonzero(mapped_occ < 0.7)),
+                }
+            else:
+                row = {"frame": frame, "fuel_field_voxels": 0, "hot_gas_voxels": 0,
+                       "maximum_gas_temperature": 0.0, "heated_solid_voxels": 0,
+                       "maximum_wood_temperature": 0.0, "native_ignited_solid_voxels": 0,
+                       "affected_object_voxels": 0, "occupancy_sum": 0.0,
+                       "occupancy_loss": 0.0, "carbonized_gaussian_count": 0}
+            state["timeline"].append(row)
+
+    objects = []
+    for state in states:
+        object_id, meta, timeline = state["object_id"], state["meta"], state["timeline"]
+        coords, local_rows = state["coords"], state["local_rows"]
+        summary = {
+            "object_id": object_id, "semantic_label": meta.get("semantic_label"),
+            "material": meta.get("material"), "role": "ignition_source" if object_id == args.source_object_id else "propagation_candidate",
+            "initial_distance_to_ignition_m": meta.get("initial_distance_to_ignition_m"),
+            "mapped_voxel_count": int(len(coords)), "mapped_gaussian_count": int(len(local_rows)),
+            "excluded_shared_source_ignition_voxels": state["excluded_source_ignition_voxels"],
+            "first_gas_field_contact_frame": first_frame(timeline, "hot_gas_voxels"),
+            "first_solid_heating_frame": first_frame(timeline, "heated_solid_voxels"),
+            "first_native_ignition_frame": first_frame(timeline, "native_ignited_solid_voxels"),
+            "first_occupancy_loss_frame": next((x["frame"] for x in timeline if x["occupancy_loss"] > 1e-6), None),
+            "first_carbonization_frame": first_frame(timeline, "carbonized_gaussian_count"),
+            "final": timeline[-1], "timeline": timeline,
+        }
+        objects.append(summary)
+
+    secondary = [x for x in objects if x["role"] == "propagation_candidate" and
+                 x["first_native_ignition_frame"] is not None and x["first_occupancy_loss_frame"] is not None]
+    payload = {
+        "metadata": {"scenario_name": args.scenario_name, "timestamp": timestamp(),
+                     "source_files": [str(args.simulation_dir.resolve()), str(args.propagation_report.resolve()),
+                                      str(args.labels.resolve()), str(args.voxel_dir.resolve()), str(args.ignition_mask.resolve())]},
+        "native_ignition_criterion": "wood_temperature >= 1.0 while occupancy > 0",
+        "secondary_ignition_interpretation": "Only reported when native solid ignition and occupancy consumption are both observed.",
+        "voxel_alias_policy": "Exact source ignition voxels are excluded from propagation-candidate attribution because multiple object Gaussians may share a coarse voxel.",
+        "source_object_id": args.source_object_id, "tracked_object_count": len(objects),
+        "genuine_secondary_ignition_object_ids": [x["object_id"] for x in secondary],
+        "first_surrounding_object_heating_frame": min((x["first_solid_heating_frame"] for x in objects
+                                                        if x["role"] != "ignition_source" and x["first_solid_heating_frame"] is not None), default=None),
+        "first_genuine_secondary_ignition_frame": min((max(x["first_native_ignition_frame"], x["first_occupancy_loss_frame"])
+                                                        for x in secondary), default=None),
+        "objects": objects,
+    }
+    write_json(args.output, payload)
+    print(json.dumps({"tracked": len(objects), "secondary_ids": payload["genuine_secondary_ignition_object_ids"],
+                      "first_surrounding_heat": payload["first_surrounding_object_heating_frame"],
+                      "first_secondary": payload["first_genuine_secondary_ignition_frame"]}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
