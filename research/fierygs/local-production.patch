+++ b/adapter/fire_native_parity/build_native_recovery_reports.py
@@ -0,0 +1,262 @@
+"""Assemble the required FieryGS native-recovery reports from measured audits."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def read(path: Path) -> dict:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def write(path: Path, payload: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+
+
+def load_npz(path: Path) -> np.ndarray:
+    with np.load(path) as data:
+        return data["arr_0"]
+
+
+def field_timeline(root: Path, frames: list[int]) -> list[dict]:
+    occupancy0 = load_npz(root / "occupancy" / "occupancy_0.npz")
+    result = []
+    for frame in frames:
+        fuel = load_npz(root / "fuel" / f"fuel_{frame}.npz")
+        temperature = load_npz(root / "temperature" / f"temperature_{frame}.npz")
+        occupancy = load_npz(root / "occupancy" / f"occupancy_{frame}.npz")
+        active = np.argwhere(fuel > 1e-4)
+        extent = (np.ptp(active, axis=0) + 1).tolist() if len(active) else [0, 0, 0]
+        result.append({
+            "frame": frame, "fuel_sum": float(fuel.sum()),
+            "active_fuel_voxels": int(len(active)), "fuel_extent_voxels": extent,
+            "temperature_sum": float(temperature.sum()),
+            "temperature_max": float(temperature.max()),
+            "occupancy_consumed_voxel_equivalent": float((occupancy0 - occupancy).sum()),
+        })
+    return result
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--audit-root", type=Path, required=True)
+    parser.add_argument("--baseline-simulation", type=Path, required=True)
+    parser.add_argument("--recovered-simulation", type=Path, required=True)
+    parser.add_argument("--baseline-render-report", type=Path, required=True)
+    parser.add_argument("--workaround-render-report", type=Path, required=True)
+    parser.add_argument("--recovered-render-report", type=Path, required=True)
+    args = parser.parse_args()
+    reports = args.audit_root / "reports"
+
+    thermal_attempt = read(reports / "representative_thermal_smoke_audit.json")
+    thermal = {
+        "native_vlm_schema": thermal_attempt["native_schema"],
+        "native_prompt_and_tool_support_thermal_ratio": True,
+        "current_batch_output_fields": ["caption", "material", "burnability"],
+        "current_scene_has_distinct_beta_values": False,
+        "solver_consumption": {
+            "classification": "C: one global constant beta",
+            "value": 50.0,
+            "source": "FireSolver.update_wood_temperature uses self.beta for every occupied cell",
+            "per_material_field_supported_by_released_solver": False,
+        },
+        "representative_restoration": thermal_attempt["representatives"],
+        "restoration_status": "BLOCKED_EXTERNAL_API",
+        "blocker": (
+            "The configured compatible endpoint listed gpt-5.4/5.5/5.6 models, "
+            "but representative vision tool calls returned upstream 502/connection errors."
+        ),
+        "controlled_beta_comparison_run": False,
+        "reason_no_comparison": "No native-derived representative beta ratio was obtained; no constants were invented.",
+        "conclusion": (
+            "The adapter omitted a native VLM field, but the released solver also lacks "
+            "per-material beta consumption. Full material-aware thermal diffusion is not a low-cost restore."
+        ),
+    }
+    write(reports / "thermal_diffusivity_parity_report.json", thermal)
