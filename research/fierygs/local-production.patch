+"""Isolate native Gaussian carbonization from the overlying fire volume."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import torch
+from PIL import Image, ImageDraw
+
+from adapter.create_scene import create_scene
+from gaussian_renderer.renderer_with_fire import render_fire
+from simulation.color_mapping import TemperatureToRGB
+from simulation.fuel_temperature import FuelToTemperatureLUT
+
+
+def u8(tensor: torch.Tensor) -> np.ndarray:
+    return tensor.clamp(0, 1).mul(255).byte().permute(1, 2, 0).cpu().numpy()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ply", type=Path, required=True)
+    parser.add_argument("--camera", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--voxel-report", type=Path, required=True)
+    parser.add_argument("--simulation-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--frames", default="159,180,199")
+    args = parser.parse_args()
+    modes = ["normal_fire", "carbon_only", "reduced_flame"]
+    for mode in modes:
+        (args.output_dir / mode).mkdir(parents=True, exist_ok=True)
+    (args.output_dir / "side_by_side").mkdir(parents=True, exist_ok=True)
+
+    bbox = json.loads(args.voxel_report.read_text(encoding="utf-8"))["bounding_box"]
+    scene = create_scene(args.ply, args.camera)
+    gaussians, camera = scene.gaussians, scene.cameras[0]
+    indices = torch.load(args.voxel_dir / "indices_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    mask = torch.load(args.voxel_dir / "mask_pts_in_grids.pth", map_location="cuda", weights_only=True)
+    rows = torch.nonzero(mask, as_tuple=False).squeeze(1)
+    initial = torch.from_numpy(np.load(args.simulation_dir / "occupancy/occupancy_0.npz")["arr_0"]).cuda().float()
+    mapped_initial = initial[indices[:, 0], indices[:, 1], indices[:, 2]] > 0
+    pipeline = Namespace(compute_cov3D_python=False, convert_SHs_python=False, debug=False)
+    common = dict(dual_smoke=False, near=0.1, far=6.0, num_samples_coarse=32, num_samples_fine=128,
+                  sampling_smooth_factor=0.5, sampling_chunk_size=32, spec_intensity=1e-8,
+                  smoke_strength=1.0, sigma_a=1.0, darkness=1.0, ks=0.5, bounding_box=bbox)
+    converter = TemperatureToRGB(T_max=12000, device="cuda")
+    fuel2temp = FuelToTemperatureLUT(device="cuda")
+    background = torch.tensor([0.04, 0.04, 0.04], dtype=torch.float32, device="cuda")
+    records = []
+    with torch.no_grad():
+        for frame in map(int, args.frames.split(",")):
+            fuel_np = np.load(args.simulation_dir / f"fuel/fuel_{frame}.npz")["arr_0"]
+            occ_np = np.load(args.simulation_dir / f"occupancy/occupancy_{frame}.npz")["arr_0"]
+            fuel = torch.from_numpy(fuel_np).cuda().float()
+            zero = torch.zeros_like(fuel).unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+            query = fuel.unsqueeze(-1).permute(3, 2, 1, 0).unsqueeze(0)
+            occupancy = torch.from_numpy(occ_np).cuda().float()
+            mapped = occupancy[indices[:, 0], indices[:, 1], indices[:, 2]]
+            keep = torch.ones(gaussians.get_xyz.shape[0], dtype=torch.bool, device="cuda")
+            keep[rows] = (~mapped_initial) | ((mapped.abs() >= 0.7) & (mapped.abs() <= 1.0))
+            carbon = torch.zeros((gaussians.get_xyz.shape[0], 3), device="cuda")
+            carbon[rows[mapped_initial]] = mapped[mapped_initial, None].repeat(1, 3)
+
+            # Reference without any carbonization, used only for visibility metrics.
+            gaussians.update_per_frame(torch.ones_like(keep), 0.7, torch.zeros_like(carbon))
+            ref_args = Namespace(**common, strength=0.0, render_smoke=False)
+            reference = u8(render_fire(camera, gaussians, pipeline, background, query_tensor=zero,
+                                       temp2rgb_converter=converter, args=ref_args, scale_ratio=0.12,
+                                       add_sepc_light=False, fuel2temp=fuel2temp, color_field=None)["render"])
+
+            gaussians.update_per_frame(keep, 0.7, carbon)
+            mode_args = {
+                "normal_fire": (query, Namespace(**common, strength=0.05, render_smoke=True)),
+                "carbon_only": (zero, Namespace(**common, strength=0.0, render_smoke=False)),
+                "reduced_flame": (query, Namespace(**common, strength=0.005, render_smoke=False)),
+            }
+            images, metrics = {}, {}
+            for mode, (volume, render_args) in mode_args.items():
+                image = u8(render_fire(camera, gaussians, pipeline, background, query_tensor=volume,
+                                       temp2rgb_converter=converter, args=render_args, scale_ratio=0.12,
+                                       add_sepc_light=False, fuel2temp=fuel2temp, color_field=None)["render"])
+                images[mode] = image
+                Image.fromarray(image).save(args.output_dir / mode / f"frame_{frame:03d}.png")
+                diff_ref = np.abs(image.astype(np.float32) - reference.astype(np.float32)) / 255.0
+                metrics[mode] = {"mae_from_uncarbonized_static": float(diff_ref.mean()),
+                                 "changed_pixel_percentage_gt_2_255": float(100 * np.mean(np.max(diff_ref, -1) > 2 / 255))}
+            normal_vs_carbon = np.abs(images["normal_fire"].astype(np.float32) - images["carbon_only"].astype(np.float32)) / 255.0
+            records.append({"frame": frame, "carbonized_gaussians": int((~keep).sum().item()), "modes": metrics,
+                            "normal_vs_carbon_only_mae": float(normal_vs_carbon.mean())})
+
+            label_h = 32
+            canvas = Image.new("RGB", (camera.image_width * 3, camera.image_height + label_h), "black")
+            draw = ImageDraw.Draw(canvas)
+            for i, mode in enumerate(modes):
+                canvas.paste(Image.fromarray(images[mode]), (i * camera.image_width, label_h))
+                draw.text((i * camera.image_width + 8, 8), mode, fill="white")
+            canvas.save(args.output_dir / "side_by_side" / f"frame_{frame:03d}.png")
+            print(f"completed frame {frame}", flush=True)
+
