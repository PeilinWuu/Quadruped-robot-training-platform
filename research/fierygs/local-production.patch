@@ -0,0 +1,242 @@
+"""Create exact scenario fuel/temperature fields and FieryGS solver config."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from adapter.fire_scenario.common import (
+    load_scenario, metadata, save_voxel_ply, save_voxel_preview, write_json,
+)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scenario", type=Path, required=True)
+    parser.add_argument("--instance-labels", type=Path, required=True)
+    parser.add_argument("--ignition-dir", type=Path, required=True)
+    parser.add_argument("--voxel-dir", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+
+    scenario = load_scenario(args.scenario)
+    instance_ids = np.load(args.instance_labels)
+    ignition_gaussians = np.load(args.ignition_dir / "ignition_gaussian_ids.npy")
+    gaussian_voxels = np.load(args.voxel_dir / "gaussian_voxel_indices.npy")
+    available = np.load(args.voxel_dir / "combustible_voxel_grid.npy").astype(np.float32)
+    material_grid = np.load(args.voxel_dir / "material_grid.npy")
+    burnability_grid = np.load(args.voxel_dir / "burnability_grid.npy")
+    voxel_report = json.loads((args.voxel_dir / "material_voxel_report.json").read_text(encoding="utf-8"))
+    if len(instance_ids) != len(gaussian_voxels):
+        raise ValueError("Gaussian instance and voxel mapping lengths differ")
+
+    propagation = scenario["propagation"]
+    blocked_ids = np.asarray(propagation.get("blocked_object_ids", []), dtype=np.int32)
+    allowed_spec = propagation.get("allowed_object_ids", "auto")
+    if not propagation.get("enabled", True):
+        allowed_ids = np.asarray(scenario["ignition"]["object_ids"], dtype=np.int32)
+    elif allowed_spec == "auto":
+        allowed_ids = None
+    else:
+        allowed_ids = np.unique(np.r_[np.asarray(allowed_spec, dtype=np.int32), np.asarray(scenario["ignition"]["object_ids"], dtype=np.int32)])
+    valid_mapping = np.all(gaussian_voxels >= 0, axis=1)
+    if allowed_ids is not None:
+        allowed_grid = np.zeros_like(available, dtype=bool)
+        rows = valid_mapping & np.isin(instance_ids, allowed_ids)
+        allowed_grid[tuple(gaussian_voxels[rows].T)] = True
+        available *= allowed_grid.astype(np.float32)
+    if len(blocked_ids):
+        blocked_grid = np.zeros_like(available, dtype=bool)
+        rows = valid_mapping & np.isin(instance_ids, blocked_ids)
+        blocked_grid[tuple(gaussian_voxels[rows].T)] = True
+        available[blocked_grid] = 0
+
+    ignition_indices = gaussian_voxels[ignition_gaussians]
+    ignition_indices = ignition_indices[np.all(ignition_indices >= 0, axis=1)]
+    if not len(ignition_indices):
+        raise RuntimeError("Ignition Gaussians did not map to any voxel")
+    ignition_indices = np.unique(ignition_indices, axis=0)
+    object_mask = np.zeros_like(available, dtype=np.uint8)
+    object_mask[tuple(ignition_indices.T)] = 1
+    object_mask &= (available > 0).astype(np.uint8)
+    if not object_mask.any():
+        raise RuntimeError("Ignition object has no confirmed combustible voxel")
+
+    exact_mask_path = args.ignition_dir / "ignition_voxel_mask.npy"
+    surface_report_path = args.ignition_dir / "surface_ignition_report.json"
+    has_precomputed_exact_mask = exact_mask_path.exists() and surface_report_path.exists()
+
+    # The native solver accepts one axis-aligned ignition box. Select a compact
+    # region of the requested object, then prefer zero contamination and the
+    # largest number of target voxels.
+    object_voxels = np.argwhere(object_mask > 0)
+    ignition_mode = scenario["ignition_mode"]
+    if has_precomputed_exact_mask:
+        ignition_mask = np.load(exact_mask_path).astype(np.uint8)
+        if ignition_mask.shape != available.shape:
+            raise ValueError("Precomputed ignition mask shape does not match voxel grid")
+        if np.any((ignition_mask > 0) & ~object_mask.astype(bool)):
+            raise RuntimeError("Precomputed ignition mask contains non-target voxels")
+        occupied = np.argwhere(ignition_mask > 0)
+        if not len(occupied):
+            raise RuntimeError("Precomputed ignition mask is empty")
+        ignition_min, ignition_max = occupied.min(axis=0), occupied.max(axis=0) + 1
+        selected_center = np.median(occupied, axis=0).astype(np.int32)
+        half_extent = None
+        surface_depth = int(scenario["ignition"].get("surface_layers", 1))
+        box_slices = tuple(slice(int(ignition_min[i]), int(ignition_max[i])) for i in range(3))
+    elif ignition_mode == "object_top_surface":
+        half_extent = int(scenario["ignition"].get("surface_half_extent_xy_voxels", 3))
+        surface_depth = int(scenario["ignition"].get("surface_depth_voxels", 2))
+        if half_extent < 0 or surface_depth < 1:
+            raise ValueError("Surface ignition extents must be non-negative and depth must be positive")
+        surface_max_z = int(object_voxels[:, 2].max())
+        surface_min_z = surface_max_z - surface_depth + 1
+        candidate_voxels = object_voxels[object_voxels[:, 2] >= surface_min_z]
+        object_center = np.asarray([
+            np.median(candidate_voxels[:, 0]), np.median(candidate_voxels[:, 1]), surface_max_z,
+        ])
+    else:
+        half_extent = int(scenario["ignition"].get("center_half_extent_voxels", 3))
+        surface_depth = None
+        if half_extent < 0:
+            raise ValueError("ignition.center_half_extent_voxels must be non-negative")
+        candidate_voxels = object_voxels
+        object_center = np.median(object_voxels, axis=0)
+    if not has_precomputed_exact_mask:
+        candidate_order = np.argsort(np.sum((candidate_voxels - object_center) ** 2, axis=1))
+        candidate_voxels = candidate_voxels[candidate_order[:min(len(candidate_order), 1000)]]
+        best = None
+        for center in candidate_voxels:
+            if ignition_mode == "object_top_surface":
+                lower_box = np.maximum(np.asarray([center[0] - half_extent, center[1] - half_extent, surface_min_z]), 0)
+                upper_box = np.minimum(np.asarray([center[0] + half_extent + 1, center[1] + half_extent + 1, surface_max_z + 1]), available.shape)
+            else:
+                lower_box = np.maximum(center - half_extent, 0)
+                upper_box = np.minimum(center + half_extent + 1, available.shape)
+            slices = tuple(slice(int(lower_box[i]), int(upper_box[i])) for i in range(3))
+            target_count = int(object_mask[slices].sum())
+            available_count = int((available[slices] > 0).sum())
+            contamination_count = available_count - target_count
+            distance = float(np.sum((center - object_center) ** 2))
+            score = (contamination_count, -target_count, distance)
+            if best is None or score < best[0]:
+                best = (score, center, lower_box, upper_box)
+        _, selected_center, ignition_min, ignition_max = best
+        box_slices = tuple(slice(int(ignition_min[i]), int(ignition_max[i])) for i in range(3))
+        ignition_mask = np.zeros_like(object_mask)
+        ignition_mask[box_slices] = object_mask[box_slices]
+
+    fuel_scale = float(scenario["fire_parameters"]["fuel_scale"])
+    fuel_grid = ignition_mask.astype(np.float32) * fuel_scale
+    initial_kelvin = np.full(available.shape, 273.0, dtype=np.float32)
+    initial_kelvin[ignition_mask > 0] = float(scenario["initial_temperature"])
+    # FieryGS core uses T_ign_wood=1.0 and T_max_wood=1.2 internally.
+    normalized_temperature = np.zeros_like(available, dtype=np.float32)
+    normalized_temperature[ignition_mask > 0] = max(1.0, 1.2 * float(scenario["initial_temperature"]) / 1200.0)
+
+    box_available = available[box_slices] > 0
+    box_ignition = ignition_mask[box_slices] > 0
+    contamination = int(np.count_nonzero(box_available & ~box_ignition))
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    np.save(args.output_dir / "fuel_grid.npy", fuel_grid)
+    np.save(args.output_dir / "available_fuel_grid.npy", available)
+    np.save(args.output_dir / "ignition_voxel_mask.npy", ignition_mask)
+    np.save(args.output_dir / "initial_temperature_kelvin.npy", initial_kelvin)
+    np.save(args.output_dir / "fuel_occupancy_initial.npy", available)
+    np.save(args.output_dir / "fuel_coefficient_initial.npy", fuel_grid)
+    np.save(args.output_dir / "wood_temperature_initial.npy", normalized_temperature)
+
+    lower = np.asarray(voxel_report["bounding_box"]["min"], dtype=np.float64)
+    voxel_size = float(voxel_report["voxel_size_m"])
+    save_voxel_ply(ignition_mask, lower, voxel_size, args.output_dir / "ignition_voxels.ply", (255, 40, 40))
+    save_voxel_preview(available, ignition_mask, args.output_dir / "fuel_ignition_preview.png")
+
+    solver = scenario.get("solver_parameters", {})
+    solver_config = {
+        "scene": scenario["name"], "dataset_name": "office_01",
+        "ignition_lifetime": scenario["ignition_lifetime"],
+        "source_mode": scenario.get("source_mode", "initial_only"),
+        "source_model": scenario.get("source_model", "state_based"),
+        "source_eta": float(scenario.get("source_eta", 0.0)),
+        "source_max_per_solid": float(scenario.get("source_max_per_solid", 1.0)),
+        "source_max_per_air": float(scenario.get("source_max_per_air", 1.0)),
+        "max_total_source_per_frame": float(scenario.get("max_total_source_per_frame", 1.0e9)),
+        "x_rotation": 0, "fire_sim_root": f"output/{scenario['name']}/sim_output",
+        "voxel_grid": {"dims": list(available.shape), "voxel_size": voxel_size},
+        "bounding_box": voxel_report["bounding_box"],
+        "ignition_box": {"min": ignition_min.tolist(), "max_exclusive": ignition_max.tolist()},
+        "T_white": 12000, "T_max": 1440, "T_air": 273,
+        "k": float(solver.get("k", 0.3)), "burn_rate": float(solver.get("burn_rate", 0.045)),
+        "beta": float(solver.get("beta", 50)), "alpha": float(solver.get("alpha", 120)),
+        "epsilon": float(solver.get("epsilon", 5)), "nu": float(solver.get("nu", 0.1)),
+        "load_path": str((args.output_dir / "available_fuel_grid.npy").resolve()).replace("\\", "/"),
+        "load_path_indices_pts_in_grids": str((args.voxel_dir / "indices_pts_in_grids.pth").resolve()).replace("\\", "/"),
+        "load_path_mask_pts_in_grids": str((args.voxel_dir / "mask_pts_in_grids.pth").resolve()).replace("\\", "/"),
+        "material_path": str((args.voxel_dir / "material_grid.npy").resolve()).replace("\\", "/"),
+        "sim_frames": int(scenario["duration"]), "save_npz": True, "save_vti": False,
+        "dual_smoke": bool(scenario.get("material_smoke", {}).get("enabled", False)),
+        "epilon_decay": float(scenario.get("physics", {}).get("vorticity_decay", 1.0)),
+        "render_smoke": True,
+        "smoke_strength": float(scenario["environment"]["smoke_strength"]),
+        "scenario_metadata": {
+            "initial_temperature_kelvin": float(scenario["initial_temperature"]),
+            "fuel_scale": fuel_scale, "wind": scenario["environment"]["wind"],
+            "exact_ignition_mask": str((args.output_dir / "ignition_voxel_mask.npy").resolve()).replace("\\", "/"),
+            "exact_ignition_required": bool(has_precomputed_exact_mask),
+            "core_compatibility": "exact mask converted to minimal ignition_box; wind retained as metadata",
+        },
+    }
+    (args.output_dir / "fierygs_solver_config.yaml").write_text(
+        yaml.safe_dump(solver_config, sort_keys=False), encoding="utf-8"
+    )
+    report = {
+        "metadata": metadata(scenario, len(instance_ids), [
+            args.scenario, args.instance_labels, args.ignition_dir / "ignition_gaussian_ids.npy",
+            args.voxel_dir / "material_grid.npy", args.voxel_dir / "burnability_grid.npy",
+        ]),
+        "ignition_object_ids": scenario["ignition"]["object_ids"],
+        "ignition_mode": ignition_mode,
+        "ignition_gaussian_count": int(len(ignition_gaussians)),
+        "ignition_object_voxel_count": int(object_mask.sum()),
+        "ignition_voxel_count": int(ignition_mask.sum()),
+        "active_fuel_voxels": int((fuel_grid > 0).sum()),
+        "total_combustible_voxels": int((available > 0).sum()),
+        "inactive_available_fuel_voxels": int((available > 0).sum() - (fuel_grid > 0).sum()),
+        "ignition_box": solver_config["ignition_box"],
+        "ignition_center_voxel": selected_center.tolist(),
+        "ignition_center_half_extent_voxels": half_extent,
+        "ignition_surface_depth_voxels": surface_depth,
+        "precomputed_exact_ignition_mask": bool(has_precomputed_exact_mask),
+        "accidental_non_target_initial_ignition_count": int(np.count_nonzero((ignition_mask > 0) & ~object_mask.astype(bool))),
+        "non_ignition_fuel_voxels_inside_compatibility_box": contamination,
+        "initial_temperature_kelvin": float(scenario["initial_temperature"]),
+        "solver_config_valid": True,
+        "solver_core_notes": [
+            "FieryGS core initializes heat through ignition_box and occupied voxels.",
+            "Exact ignition_voxel_mask.npy is retained by the adapter.",
+            "Configured wind is metadata because the unmodified solver has no ambient-wind input field.",
+        ],
+        "artifacts": [
+            "fuel_grid.npy", "available_fuel_grid.npy", "ignition_voxel_mask.npy",
+            "initial_temperature_kelvin.npy", "fuel_occupancy_initial.npy",
+            "fuel_coefficient_initial.npy", "wood_temperature_initial.npy",
+            "ignition_voxels.ply", "fuel_ignition_preview.png", "fierygs_solver_config.yaml",
+        ],
+    }
+    write_json(args.output_dir / "scenario_initialization_report.json", report)
+    artifact_manifest = {
+        "metadata": report["metadata"],
+        "artifacts": [{"file": name, "metadata_sidecar": "scenario_initialization_report.json"} for name in report["artifacts"]],
+    }
+    write_json(args.output_dir / "artifact_manifest.json", artifact_manifest)
+    print(json.dumps({key: value for key, value in report.items() if key != "metadata"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
