+"""Write evidence-based qualitative reports after baseline visual inspection."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image
+
+from adapter.fire_scenario.common import timestamp, write_json
+
+
+ASSESSMENTS = {
+    "table_medium": {
+        "surface_ignition_correctness": ("good", "Flame first appears on the selected tabletop surface."),
+        "flame_growth_plausibility": ("poor", "Growth rapidly becomes a nearly fixed vertical torch column rather than a turbulent room fire."),
+        "visible_propagation_plausibility": ("weak", "Larger plume is visible, but nearby-chair secondary burning cannot be separated visually."),
+        "smoke_visibility_and_quality": ("poor", "A white blocky plume is visible; dual-smoke material/color state is absent."),
+        "carbonization_visibility": ("weak", "Frame 162 carbonization is numerical but not clearly distinguishable behind saturation."),
+        "geometry_occlusion_correctness": ("weak", "Scene geometry remains visible, but the plume overlaps ceiling fixtures without convincing depth cues."),
+        "voxel_blockiness_severity": ("poor", "Layered rectangular volume structure is obvious."),
+        "overexposure_severity": ("poor", "Large yellow-white regions lose internal flame detail."),
+        "scene_level_realism": ("poor", "Late fire resembles a glowing voxel torch more than a believable room fire."),
+        "consistency_with_physical_reports": ("acceptable", "Spatial growth is visible, but secondary ignition and carbonization are visually unresolved."),
+    },
+    "table_high": {
+        "surface_ignition_correctness": ("good", "The initial flame is centered on the selected tabletop patches."),
+        "flame_growth_plausibility": ("poor", "Fast growth is visible but converges to a narrow stationary vertical fire column."),
+        "visible_propagation_plausibility": ("weak", "HIGH grows faster than MEDIUM early, while reported chair ignition is not a distinct new visible source."),
+        "smoke_visibility_and_quality": ("poor", "White/gray smoke-like volume is visible but strongly blocky and partly clipped near the ceiling."),
+        "carbonization_visibility": ("weak", "The first 48 carbonized Gaussians at frame 159 and 1994 at frame 199 do not produce an obvious readable char pattern."),
+        "geometry_occlusion_correctness": ("weak", "The volume intersects/overlays the ceiling-lamp region with ambiguous occlusion."),
+        "voxel_blockiness_severity": ("poor", "The plume has clear voxel slabs and a hard-edged footprint."),
+        "overexposure_severity": ("poor", "The core is saturated yellow/white for most established and late frames."),
+        "scene_level_realism": ("poor", "Late state remains a local glowing column rather than a convincing fire scene."),
+        "consistency_with_physical_reports": ("acceptable", "Early/final extent changes agree, but object-aware events are hidden by saturation."),
+    },
+    "sofa_high": {
+        "surface_ignition_correctness": ("acceptable", "Fire appears along the labelled rear sofa/bench surface, though the mask is broad."),
+        "flame_growth_plausibility": ("weak", "Horizontal growth is clear but develops into a planar wall of fire."),
+        "visible_propagation_plausibility": ("acceptable", "The expanding horizontal front corresponds to the much larger physical spread, but individual new sources remain inseparable."),
+        "smoke_visibility_and_quality": ("poor", "White blocky smoke is present above the bench without detailed dark smoke structure."),
+        "carbonization_visibility": ("weak", "Some late gaps/dark areas appear, but cannot be confidently separated from occlusion and saturation."),
+        "geometry_occlusion_correctness": ("acceptable", "Foreground tables/chairs mostly remain in front, although the fire plane looks pasted against the wall."),
+        "voxel_blockiness_severity": ("poor", "Repeated vertical cells and rectangular edges are prominent."),
+        "overexposure_severity": ("poor", "The sofa region becomes a broad saturated yellow sheet."),
+        "scene_level_realism": ("poor", "Spread reads better than table fire, but late imagery is still not photorealistic."),
+        "consistency_with_physical_reports": ("good", "Large horizontal growth agrees with the larger fuel/temperature fields and earlier carbonization."),
+    },
+    "curtain_high": {
+        "surface_ignition_correctness": ("good", "Early flames appear along the upper curtain ignition region."),
+        "flame_growth_plausibility": ("weak", "Fire expands over a rectangular curtain sheet with limited turbulent structure."),
+        "visible_propagation_plausibility": ("weak", "Growth around frame 82 is visible as continuous expansion, not a distinct secondary source."),
+        "smoke_visibility_and_quality": ("poor", "Large white blocky clouds accumulate at the ceiling."),
+        "carbonization_visibility": ("weak", "Late missing/gray regions suggest consumption, but the frame-127 onset is not visually discrete."),
+        "geometry_occlusion_correctness": ("weak", "The lamp and upper image boundary obscure the plume and create ambiguous intersections."),
+        "voxel_blockiness_severity": ("poor", "Curtain-aligned rectangular fire cells are highly visible."),
+        "overexposure_severity": ("poor", "The curtain becomes a nearly solid yellow-white area."),
+        "scene_level_realism": ("poor", "Late result resembles an emissive rectangular volume rather than burning fabric."),
+        "consistency_with_physical_reports": ("acceptable", "Very large spread is visible, while exact secondary/carbonization events are hard to isolate."),
+    },
+}
+
+
+def image_stats(frames: Path, static: Path) -> dict:
+    base = np.asarray(Image.open(static).convert("RGB"), dtype=np.int16)
+    changes, new_saturation = [], []
+    for frame in range(200):
+        image = np.asarray(Image.open(frames / f"frame_{frame:03d}.png").convert("RGB"), dtype=np.int16)
+        changes.append(float(np.mean(np.max(np.abs(image - base), axis=2) > 8) * 100))
+        new_saturation.append(float(np.mean((image.max(2) >= 250) & (base.max(2) < 250)) * 100))
+    return {"peak_rgb_changed_percent": max(changes), "final_rgb_changed_percent": changes[-1],
+            "peak_new_saturated_pixel_percent": max(new_saturation),
+            "first_frame_rgb_change_ge_0_5_percent": next((i for i, x in enumerate(changes) if x >= 0.5), None)}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--visual-root", type=Path, required=True)
+    parser.add_argument("--baseline-root", type=Path, required=True)
+    args = parser.parse_args()
+    summaries = []
+    camera_name = {"table_medium": "table", "table_high": "table", "sofa_high": "sofa", "curtain_high": "curtain"}
+    for scenario, criteria in ASSESSMENTS.items():
+        baseline_dir = args.visual_root / "renders" / scenario / "baseline_full"
+        stats = image_stats(baseline_dir / "baseline_full_frames", args.baseline_root / f"{camera_name[scenario]}.png")
+        payload = {
+            "metadata": {"scenario_name": scenario, "timestamp": timestamp(),
+                         "source_files": [str((baseline_dir / "baseline_full.mp4").resolve()),
+                                          str((baseline_dir / "contact_sheet.png").resolve())]},
+            "visual_inspection": {key: {"rating": value[0], "explanation": value[1]} for key, value in criteria.items()},
+            "quantitative_image_evidence": stats,
+            "full_video": str((baseline_dir / "baseline_full.mp4").resolve()),
+            "contact_sheet": str((baseline_dir / "contact_sheet.png").resolve()),
+            "key_events": str((baseline_dir.parent / "key_events/event_index.json").resolve()),
+        }
+        write_json(args.visual_root / "reports" / f"{scenario}_visual_inspection_report.json", payload)
+        summaries.append({"scenario": scenario, "overall": "poor", "evidence": stats,
+                          "best_aspect": "correct semantic surface ignition" if scenario != "sofa_high" else "visible horizontal spread",
+                          "main_failure": criteria["scene_level_realism"][1]})
+    summary = {
+        "metadata": {"scenario_name": "office_01_visual_inspection_summary", "timestamp": timestamp()},
+        "baseline_inspection_complete": True, "scenarios": summaries,
+        "cross_scenario_answers": {
+            "correct_surface_emergence": "yes for table and curtain; broad but acceptable for sofa",
+            "natural_growth": "no; table becomes a torch column and sofa/curtain become emissive sheets",
+            "visual_matches_physical_spread": "coarse spatial trends match, individual object events do not resolve visually",
+            "secondary_ignition_visible": "no distinct new source can be isolated at reported event frames",
+            "smoke": "visible as white blocky volume; no dual-smoke color field was simulated",
+            "carbonization": "numerically present but visually weak/ambiguous",
+            "voxel_blockiness": "severe in all scenarios",
+            "overexposure": "severe in established and late stages",
+            "occlusion": "partly plausible, but ceiling fixtures and volume intersections are ambiguous",
+            "table_levels": "distinguishable early; converge to similar saturated columns late",
+            "late_stage": "still resembles local glowing voxels/volumes, not a believable room fire",
+        },
+    }
+    write_json(args.visual_root / "reports/visual_inspection_summary.json", summary)
+
+    diagnosis = {
+        "metadata": {"scenario_name": "office_01_render_issue_diagnosis", "timestamp": timestamp()},
+        "diagnosis_only_no_fixes_applied": True,
+        "issues": [
+            {"priority": 1, "issue": "fire overexposure", "severity": "severe", "likely_layer": "render transfer/exposure", "evidence": "yellow-white regions lose internal structure"},
+            {"priority": 2, "issue": "voxel blockiness", "severity": "severe", "likely_layer": "0.05 m voxel field plus volume reconstruction", "evidence": "rectangular slabs remain under higher sampling"},
+            {"priority": 3, "issue": "unrealistic plume topology", "severity": "severe", "likely_layer": "physics scale/advection plus saturation", "evidence": "table fire stabilizes as a narrow torch column"},
+            {"priority": 4, "issue": "smoke quality", "severity": "high", "likely_layer": "no dual-smoke field and scalar smoke rendering", "evidence": "white blocky ceiling clouds"},
+            {"priority": 5, "issue": "carbonization readability", "severity": "high", "likely_layer": "saturation/occlusion and removal mapping", "evidence": "reported onset is not visually discrete"},
+            {"priority": 6, "issue": "secondary ignition readability", "severity": "high", "likely_layer": "overlapping coarse voxels and merged fire volumes", "evidence": "no distinct new source at event frames"},
+            {"priority": 7, "issue": "curtain camera framing", "severity": "medium", "likely_layer": "camera", "evidence": "upper plume intersects lamp/image boundary; prior diagnostic camera confirms this is secondary to weak early physics"},
+        ],
+    }
+    write_json(args.visual_root / "reports/render_issue_diagnosis.json", diagnosis)
+    print(json.dumps({"reports": len(summaries), "summary": str((args.visual_root/'reports/visual_inspection_summary.json').resolve())}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
