index 0000000..d02d5cb
--- /dev/null
+++ b/adapter/fire_showcase/export_fire_playback.py
@@ -0,0 +1,247 @@
+"""Export a cropped, quantized FieryGS simulation as a browser playback asset.
+
+This tool never modifies the source simulation. It stores fuel and temperature as
+interleaved uint8 RG voxels in fixed-size chunks so the browser can upload a pair
+of WebGL2 3D textures and interpolate adjacent frames.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+
+
+SCHEMA = "fierygs-fire-playback-v1"
+CHANNELS = ("fuel", "temperature")
+DEFAULT_SIMULATION = Path(
+    r"D:\interiorgs_data\office_01\production_regression\table_high\sim_output"
+)
+DEFAULT_OUTPUT = Path(
+    r"D:\interiorgs_data\office_01\fire_playback\table_high"
+)
+DEFAULT_GRID_LOWER = (-2.65, -7.5, -0.2)
+DEFAULT_VOXEL_SIZE = 0.05
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--simulation-dir", type=Path, default=DEFAULT_SIMULATION)
+    parser.add_argument("--output-dir", type=Path, default=DEFAULT_OUTPUT)
+    parser.add_argument("--first-frame", type=int, default=28)
+    parser.add_argument("--last-frame", type=int, default=170)
+    parser.add_argument("--frame-step", type=int, default=2)
+    parser.add_argument("--fps", type=float, default=8.0)
+    parser.add_argument("--frames-per-chunk", type=int, default=16)
+    parser.add_argument("--threshold", type=float, default=1.0e-5)
+    parser.add_argument("--padding", type=int, default=2)
+    parser.add_argument("--voxel-size", type=float, default=DEFAULT_VOXEL_SIZE)
+    parser.add_argument("--grid-lower", type=float, nargs=3, default=DEFAULT_GRID_LOWER)
+    return parser.parse_args()
+
+
+def load_field(root: Path, field: str, frame: int) -> np.ndarray:
+    path = root / field / f"{field}_{frame}.npz"
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    with np.load(path) as archive:
+        value = archive[archive.files[0]]
+    if value.ndim != 3 or value.dtype.kind not in "fc":
+        raise ValueError(f"Unsupported {field} frame: {path} {value.shape} {value.dtype}")
+    if not np.isfinite(value).all():
+        raise ValueError(f"Non-finite values in {path}")
+    return value.astype(np.float32, copy=False)
+
+
+def selected_frames(args: argparse.Namespace) -> list[int]:
+    if args.first_frame < 0 or args.last_frame < args.first_frame or args.frame_step < 1:
+        raise ValueError("Invalid frame interval")
+    frames = list(range(args.first_frame, args.last_frame + 1, args.frame_step))
+    if len(frames) < 2:
+        raise ValueError("At least two playback frames are required")
+    return frames
+
+
+def union_active_bounds(
+    root: Path, frames: list[int], threshold: float, padding: int
+) -> tuple[np.ndarray, np.ndarray, tuple[int, int, int]]:
+    lower: np.ndarray | None = None
+    upper: np.ndarray | None = None
+    shape: tuple[int, int, int] | None = None
+    for frame in frames:
+        fuel = load_field(root, "fuel", frame)
+        temperature = load_field(root, "temperature", frame)
+        if fuel.shape != temperature.shape:
+            raise ValueError(f"Shape mismatch at frame {frame}")
+        if shape is None:
+            shape = tuple(int(value) for value in fuel.shape)
+        elif fuel.shape != shape:
+            raise ValueError(f"Grid shape changed at frame {frame}")
+        coordinates = np.argwhere((fuel > threshold) | (temperature > threshold))
+        if coordinates.size == 0:
+            continue
+        frame_lower = coordinates.min(axis=0)
+        frame_upper = coordinates.max(axis=0) + 1
+        lower = frame_lower if lower is None else np.minimum(lower, frame_lower)
+        upper = frame_upper if upper is None else np.maximum(upper, frame_upper)
+    if shape is None or lower is None or upper is None:
+        raise ValueError("Selected interval contains no active fire voxels")
+    lower = np.maximum(lower - padding, 0)
+    upper = np.minimum(upper + padding, np.asarray(shape))
+    return lower, upper, shape
+
+
+def quantize_pair(fuel: np.ndarray, temperature: np.ndarray) -> np.ndarray:
+    pair = np.stack((fuel, temperature), axis=-1)
+    return np.rint(np.clip(pair, 0.0, 1.0) * 255.0).astype(np.uint8)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def stage_for(frame: int) -> str:
+    if frame <= 69:
+        return "established"
+    if frame <= 141:
+        return "spread"
+    return "late"
+
+
+def main() -> None:
+    args = parse_args()
+    frames = selected_frames(args)
+    if args.frames_per_chunk < 1 or args.fps <= 0 or args.voxel_size <= 0:
+        raise ValueError("fps, voxel size and chunk size must be positive")
+    if args.padding < 0 or args.threshold < 0:
+        raise ValueError("padding and threshold must be non-negative")
+
+    crop_lower, crop_upper, full_shape = union_active_bounds(
+        args.simulation_dir, frames, args.threshold, args.padding
+    )
+    crop_shape = tuple(int(value) for value in crop_upper - crop_lower)
+    frame_bytes = math.prod(crop_shape) * len(CHANNELS)
+    slices = tuple(slice(int(crop_lower[i]), int(crop_upper[i])) for i in range(3))
+
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    chunks = []
+    frame_records = []
+    for chunk_index, start in enumerate(range(0, len(frames), args.frames_per_chunk)):
+        chunk_frames = frames[start : start + args.frames_per_chunk]
+        filename = f"frames_{chunk_index:03d}.bin"
+        path = args.output_dir / filename
+        with path.open("wb") as stream:
+            for local_index, frame in enumerate(chunk_frames):
+                fuel = load_field(args.simulation_dir, "fuel", frame)[slices]
+                temperature = load_field(args.simulation_dir, "temperature", frame)[slices]
+                payload = quantize_pair(fuel, temperature)
+                # NumPy C order is x-major in the source shape; the renderer records this
+                # layout explicitly and remaps it to WebGL (x-fastest) while loading.
+                stream.write(payload.tobytes(order="C"))
+                frame_records.append(
+                    {
+                        "playbackIndex": start + local_index,
+                        "sourceFrame": frame,
+                        "stage": stage_for(frame),
+                        "chunk": chunk_index,
+                        "offset": local_index * frame_bytes,
+                    }
+                )
+        chunks.append(
+            {
+                "index": chunk_index,
+                "file": filename,
+                "firstPlaybackIndex": start,
+                "frameCount": len(chunk_frames),
+                "byteLength": path.stat().st_size,
+                "sha256": sha256(path),
+            }
+        )
+
+    crop_world_lower = [
+        float(args.grid_lower[i] + crop_lower[i] * args.voxel_size) for i in range(3)
+    ]
+    crop_world_upper = [
+        float(args.grid_lower[i] + crop_upper[i] * args.voxel_size) for i in range(3)
+    ]
+    metadata = {
+        "schema": SCHEMA,
+        "scenarioId": "table_high",
+        "sourceMode": "native_reignite",
+        "rendererProfile": {
+            "xyz2rgbClipOutput": True,
+            "hdrAces": False,
+            "strength": 0.005,
+            "smokeStrength": 0.2,
+        },
+        "playback": {
+            "fps": args.fps,
+            "frameCount": len(frames),
+            "loopMode": "ping-pong",
+            "stages": ["established", "spread", "late"],
+        },
+        "grid": {
+            "sourceDimensions": list(full_shape),
+            "cropOrigin": crop_lower.tolist(),
+            "dimensions": list(crop_shape),
+            "voxelSize": args.voxel_size,
+            "sourceLower": list(args.grid_lower),
+            "worldLower": crop_world_lower,
