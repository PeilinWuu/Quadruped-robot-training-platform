VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:8080/ws
API_PORT=3001
AUTH_DB_PATH=data/auth.sqlite
# Express does not load this file automatically; set API variables in the shell.
# Leave NODE_ENV unset here so Vite builds select production mode normally.

# Vite only: external office_01 data directory (not committed or downloaded).
GS_SCENE_DATA_ROOT=D:/interiorgs_data/office_01
# Set to 0 for a desktop build without external fire/thermal playback assets.
BUNDLE_FIRE_PLAYBACK=1
