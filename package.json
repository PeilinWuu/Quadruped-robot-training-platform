{
  "name": "quadruped-fire-rescue-training-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:mujoco": "node scripts/fetch-mujoco.mjs",
    "setup:mpc": "node scripts/fetch-mpc-dependencies.mjs",
    "setup:go2": "node scripts/fetch-go2-menagerie.mjs",
    "verify:go2": "node scripts/verify-go2-menagerie.mjs",
    "build:go2-visuals": "node scripts/build-go2-visuals.mjs",
    "verify:go2-visuals": "node scripts/verify-go2-visuals.mjs",
    "build:sidecar": "node scripts/build-mujoco-sidecar.mjs",
    "build:desktop": "npm run build:sidecar && npm run build:go2-visuals && npm run verify:go2-visuals && npm run build",
    "dev": "concurrently -k -n WEB,API -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "npm run build:go2-visuals && npm run verify:go2-visuals && vite",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "npm run build:go2-visuals && npm run verify:go2-visuals && tsc -b && vite build",
    "lint": "oxlint src server",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run build:go2-visuals && npm run verify:go2-visuals && npm run test:node && npm run test:frontend",
    "test:node": "node --import tsx --test server/*.test.ts scripts/*.test.mjs",
    "test:frontend": "vitest run src/services/scenes src/services/simulation src/features/gaussian-viewer/robot src/features/gaussian-viewer/environment src/store src/components",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-stable-cli.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "antd": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1",
    "lucide-react": "^1.24.0",
    "playcanvas": "2.21.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "fast-xml-parser": "5.10.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "^30.0.1",
    "obj2gltf": "3.2.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
